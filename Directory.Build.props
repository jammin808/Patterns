<Project>
  <PropertyGroup>
    <!-- The runtime every project targets: .NET 10 (LTS). An older SDK still builds and tests the
         tree with `-p:PatternsTfm=net8.0` until .NET 10 is installed; CI and the published exe
         are .NET 10. -->
    <PatternsTfm Condition="'$(PatternsTfm)' == ''">net10.0</PatternsTfm>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Authors>jammin808</Authors>
    <Product>Patterns</Product>
    <Copyright>© 2026 jammin808 — MIT License</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!-- Round 70: the analyzers as fences. The SDK's rules, Sonar's, the threading analyzers and a banned-API
       list run in every build; .editorconfig at the root names each rule that fails the build and why, and
       BannedSymbols.txt the APIs the desk never calls. TreatWarningsAsErrors above makes a fence a stop. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.34.0.3385" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" Visible="false" Condition="!$(MSBuildProjectName.EndsWith('.Tests'))" />
  </ItemGroup>
</Project>
