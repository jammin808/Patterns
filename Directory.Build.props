<Project>
  <PropertyGroup>
    <!-- The runtime every project targets: .NET 10 (LTS). An older SDK still builds and tests the
         tree with `-p:PatternsTfm=net8.0` until .NET 10 is installed; CI and the published exe
         are .NET 10. -->
    <PatternsTfm Condition="'$(PatternsTfm)' == ''">net10.0</PatternsTfm>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Authors>jammin808</Authors>
    <Product>Patterns</Product>
    <Copyright>© 2026 jammin808 — MIT License</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>
</Project>
