<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             x:Class="Patterns.App.Views.Controls.WebPageControls"
             x:DataType="vm:MainViewModel">

  <!-- PAGE CONTROLS for the web page on air (the pattern's page, else the first web layer): the keyboard, the
       page's own actions, typed text and the keys. The Media page and the Layers page both carry it. -->
  <!-- Page controls: the keyboard for a web page shown by the pattern or a layer -->
  <StackPanel IsVisible="{Binding Media.HasWebPage}">
    <TextBlock Classes="h2" Text="PAGE CONTROLS" />
    <TextBlock Classes="label" Text="{Binding Media.WebControlsTarget}" TextWrapping="Wrap" />
    <WrapPanel Margin="0,4,0,0">
      <ToggleButton Classes="chip" Content="⌨ KEYS → PAGE" Margin="0,0,8,4" IsChecked="{Binding Media.KeysToPage, Mode=TwoWay}"
                    ToolTip.Tip="The keyboard belongs to the page — F5 starts a PowerPoint, the arrows move a deck, k plays a YouTube video, a search box or a sign-in takes typing. Press again or Ctrl+Alt+K to get the desk's keys back" />
      <!-- The page's own actions, from its service: YouTube's player, a deck's slides, a plain page's keys -->
      <ItemsControl ItemsSource="{Binding Media.WebPageActions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WebActionChip">
            <Button Classes="mini" Content="{Binding Label}" Margin="0,0,4,4" ToolTip.Tip="{Binding Hint}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Media.WebActionCommand}" CommandParameter="{Binding Id}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </WrapPanel>
    <Grid ColumnDefinitions="*,8,Auto">
      <TextBox Grid.Column="0" Watermark="Type into the page — the field you last clicked on the PREVIEW pane…"
               Text="{Binding Media.WebTypedText, Mode=TwoWay}" />
      <Button Grid.Column="2" Classes="chip" Content="SEND" Command="{Binding Media.SendWebTextCommand}" />
    </Grid>
    <WrapPanel Margin="0,4,0,0">
      <Button Classes="mini" Content="Enter" Command="{Binding Media.WebKeyCommand}" CommandParameter="Enter" Margin="0,0,4,4" />
      <Button Classes="mini" Content="Tab" Command="{Binding Media.WebKeyCommand}" CommandParameter="Tab" Margin="0,0,4,4" />
      <Button Classes="mini" Content="Esc" Command="{Binding Media.WebKeyCommand}" CommandParameter="Escape" Margin="0,0,4,4" />
      <Button Classes="mini" Content="⌫" Command="{Binding Media.WebKeyCommand}" CommandParameter="Backspace" Margin="0,0,4,4" />
      <Button Classes="mini" Content="Space" Command="{Binding Media.WebKeyCommand}" CommandParameter="Space" Margin="0,0,4,4" />
      <Button Classes="mini" Content="↑" Command="{Binding Media.WebKeyCommand}" CommandParameter="ArrowUp" Margin="0,0,4,4" />
      <Button Classes="mini" Content="↓" Command="{Binding Media.WebKeyCommand}" CommandParameter="ArrowDown" Margin="0,0,4,4" />
      <Button Classes="mini" Content="←" Command="{Binding Media.WebKeyCommand}" CommandParameter="ArrowLeft" Margin="0,0,4,4" />
      <Button Classes="mini" Content="→" Command="{Binding Media.WebKeyCommand}" CommandParameter="ArrowRight" Margin="0,0,4,4" />
      <Button Classes="mini" Content="PgUp" Command="{Binding Media.WebKeyCommand}" CommandParameter="PageUp" Margin="0,0,4,4" />
      <Button Classes="mini" Content="PgDn" Command="{Binding Media.WebKeyCommand}" CommandParameter="PageDown" Margin="0,0,4,4" />
      <Button Classes="mini" Content="Home" Command="{Binding Media.WebKeyCommand}" CommandParameter="Home" Margin="0,0,4,4" />
      <Button Classes="mini" Content="End" Command="{Binding Media.WebKeyCommand}" CommandParameter="End" Margin="0,0,12,4" />
      <Button Classes="mini" Content="◀ Back" Command="{Binding Media.WebBackCommand}" Margin="0,0,4,4" />
      <Button Classes="mini" Content="Forward ▶" Command="{Binding Media.WebForwardCommand}" Margin="0,0,4,4" />
      <Button Classes="mini" Content="Reload" Command="{Binding Media.WebReloadCommand}" Margin="0,0,4,4" />
    </WrapPanel>
    <TextBlock Classes="label" Text="{Binding Media.WebPageStatus}" TextWrapping="Wrap" />
    <!-- The armed web VT: set the video up here (the advert skipped, the sound checked), mark the start point, ARM —
         it plays from the mark the moment the page goes to air. Shown once the page has a player, or an arm on it. -->
    <Border Classes="stingerRow" Classes.air="{Binding Media.WebArmed}" CornerRadius="8" Padding="8,6" Margin="0,6,0,0" IsVisible="{Binding Media.WebHasPlayer}">
      <StackPanel Spacing="4">
        <WrapPanel>
          <TextBlock Classes="label" Text="ARMED VT" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Classes="go" Content="▶ ARM" Padding="10,4" Margin="0,0,6,0" Command="{Binding Media.WebArmCommand}"
                  ToolTip.Tip="Hold the video at the start point (the time beside, else the mark set, else where it is now) — it plays from there the moment the page goes to air: a TAKE, a cue, the clicker's NEXT. Arm it from the preview; a page on air is refused" />
          <TextBox Width="72" Watermark="1:23" Text="{Binding Media.WebArmText, Mode=TwoWay}" Margin="0,0,6,0"
                   ToolTip.Tip="The start point: 1:23, 83 or 1m23s. Empty = the mark set, else where the player is now" />
          <Button Classes="mini" Content="MARK" Margin="0,0,6,0" Command="{Binding Media.WebMarkCommand}"
                  ToolTip.Tip="Set the start point without arming — the time beside, else where the player is now" />
          <Button Classes="mini" Content="DISARM" Command="{Binding Media.WebDisarmCommand}" ToolTip.Tip="Clear the arm — the video plays as the page does" />
        </WrapPanel>
        <TextBlock Classes="label" Text="{Binding Media.WebVtWords}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <TextBlock Classes="hint tip"
               Text="The controls drive the page you last clicked on the PREVIEW pane (else the pattern's page, else its first web layer). Typing goes to the field that has the page's focus — click it first. The action chips are the page's own: on YouTube they drive the player itself, on Google Slides and PowerPoint for the web they are the slide keys, on any other page the arrows and page keys. KEYS → PAGE hands the page the whole keyboard until you press it again or Ctrl+Alt+K. Hold Alt while pressing on a web layer to drag its box instead of clicking into the page. The same actions run from a cue (Web page — key or action), the wire (WEB NEXT, WEB KEY …), OSC, the phone's SHOW tab and Companion. ARMED VT: set a YouTube, Vimeo or video page up in the preview — skip the advert (Patterns presses SKIP when the site shows it), check the sound, find the moment — then ARM: the video holds at the mark and plays from it the moment the page goes to air. WEB ARM 1:23 / WEB MARK / WEB DISARM on the wire, Web page — arm the video in a cue, the phone's SHOW tab and Companion; the look's own 'Play from' (above) arms a page by itself every time, and opens the next cue's page early." />
  </StackPanel>
</UserControl>
