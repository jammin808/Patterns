<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:svc="using:Patterns.Core.Services"
             xmlns:ctl="using:Patterns.App.Views.Controls"
             xmlns:lt="using:Patterns.Core.LowerThirds"
             x:Class="Patterns.App.Views.Controls.RunView"
             x:DataType="vm:IRunPage">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- LIVE strip: what is on air, by name, and the chips a caller glances at — and, under it, the glance line: the outputs' frames, the twin, the screens, the last box that said no, the plan, the lock -->
    <Border Grid.Row="0" Classes="runLive">
     <StackPanel>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Ellipse Classes="tally" Classes.air="{Binding !Run.IsBlackout}" Width="12" Height="12" />
          <TextBlock Classes="runTag" Text="LIVE" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
          <TextBlock Classes="runLiveText" Text="{Binding Run.LiveLabel}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="runNotes" Text="{Binding Run.ShowName}" Foreground="{StaticResource TextDimBrush}" />
        </StackPanel>
        <Border Grid.Column="2" Classes="runChip blackoutChip" IsVisible="{Binding Run.IsBlackout}"><TextBlock Text="BLACKOUT" /></Border>
        <Border Grid.Column="3" Classes="runChip holdChip" IsVisible="{Binding Run.IsHold}"><TextBlock Text="HOLD" /></Border>
        <Border Grid.Column="4" Classes="runChip armedChip" IsVisible="{Binding Run.IsArmed}"><TextBlock Text="ARMED" /></Border>
        <Border Grid.Column="5" Classes="runChip holdChip" IsVisible="{Binding IsPrepMode}" ToolTip.Tip="PREP mode: the outputs are held closed — cues run, the audience sees nothing"><TextBlock Text="PREP · OUTPUTS HELD" /></Border>
        <Border Grid.Column="6" Classes="runChip musicChip" IsVisible="{Binding Run.IsMusicPlaying}" ToolTip.Tip="{Binding Run.MusicTip}"><TextBlock Text="♪ BREAK MUSIC" /></Border>
        <Border Grid.Column="7" Classes="runChip holdChip" IsVisible="{Binding Run.IsStingHolding}"
                ToolTip.Tip="A stinger landed and is holding the screens — TAKE the preview or GO the next cue"><TextBlock Text="{Binding Run.StingHoldText}" /></Border>
        <Border Grid.Column="8" Classes="runChip holdChip" IsVisible="{Binding Run.IsDucked}" ToolTip.Tip="{Binding Run.DuckTip}"><TextBlock Text="DUCK" /></Border>
        <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0">
          <Border Classes="runChip vtChip" Classes.out="{Binding Run.VideoOut}" IsVisible="{Binding Run.HasVideo}" ToolTip.Tip="{Binding Run.VideoTip}"><TextBlock Text="{Binding Run.VideoChip}" /></Border>
          <Border Classes="runChip holdChip" IsVisible="{Binding Run.IsLate}" ToolTip.Tip="Behind the running order — the last GO against its planned start (or the standby cue's expected start against its plan)"><TextBlock Text="{Binding Run.OffsetText}" /></Border>
          <Border Classes="runChip armedChip" IsVisible="{Binding Run.IsOnPlan}" ToolTip.Tip="On or ahead of the running order"><TextBlock Text="{Binding Run.OffsetText}" /></Border>
          <Border Classes="runChip armedChip" IsVisible="{Binding HasStreak}" ToolTip.Tip="Rig day's on-time streak: GOs within the running order's drift, in a row — Machine page, RIG DAY GAMES turns it off"><TextBlock Text="{Binding StreakWords}" /></Border>
          <TextBlock Classes="runNotes" Text="{Binding Run.NextAutoText}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="mini" Content="POP OUT" Command="{Binding PopOutRunCommand}" Focusable="False"
                  ToolTip.Tip="Open the Run surface as a second window for the caller's own monitor" />
          <TextBlock Classes="runClock" Text="{Binding HeaderClock}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      <TextBlock Classes="runNotes" Text="{Binding Run.GlanceText}" IsVisible="{Binding Run.HasGlance}" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="The glance line: each output's frame rate, its p95 frame time and the frames it dropped in the last minute; the twin; the screens the room is short; the last box that said no; where the day stands against the plan; the lock" />
     </StackPanel>
    </Border>

    <!-- After a watchdog relaunch: the place came back, nothing fired -->
    <Border Grid.Row="1" Classes="runBanner" IsVisible="{Binding Run.HasBanner}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="runNotes" Text="{Binding Run.Banner}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="mini" Content="OK" Command="{Binding Run.DismissBannerCommand}" Focusable="False" />
      </Grid>
    </Border>

    <!-- The wall beside the list; the list is the only scrolling region. The divider between them
         drags and the show remembers it (the stack starts at about a third); the tiles collapse to
         vertical title bars when the stack wants the room. -->
    <Grid Grid.Row="2" Name="RunSplit" ColumnDefinitions="65*,12,35*" Margin="0,10,0,0">
      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,0,6" IsVisible="{Binding HasRunWall}">
          <TextBlock Classes="runTag" Text="THE WALL" VerticalAlignment="Center" />
          <ToggleButton Grid.Column="1" Name="RunWallToggle" Classes="mini" Content="{Binding RunWallToggleText}" IsChecked="{Binding IsRunWallCollapsed, Mode=TwoWay}" Focusable="False"
                        ToolTip.Tip="The wall's tiles as vertical title bars — the tally and the name on their side — so the stack has the room; press again for the full tiles. A pause over a tile pops it up large either way. The show remembers it" />
        </Grid>
        <!-- The wall's tiles, on a desk: built by the code-behind, which knows whether there is a wall behind this surface. -->
        <ContentControl Grid.Row="1" Name="WallHost" IsVisible="{Binding HasRunWall}" />
        <!-- The monitor (round 62): one screen drawn large for the caller's eye — the main screen by default;
             right-click for any screen, a canvas, the programme, or to hide it. The show remembers. -->
        <StackPanel Grid.Row="2" Name="RunMonitor" IsVisible="{Binding HasRunMonitor}" Margin="2,10,2,0" Background="Transparent" ctl:Menus.Kind="monitor">
          <Grid ColumnDefinitions="Auto,10,*">
            <TextBlock Classes="runTag" Text="MONITOR" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="runNotes" Text="{Binding RunMonitorTitle}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="Right-click: which screen this shows, the programme, or hide it (RUN MONITOR on the wire)" />
          </Grid>
          <ctl:AspectBox Ratio="{Binding RunMonitorRatio}" MaxHeight="440" Margin="0,4,0,0">
            <Border BorderBrush="#80E0342E" BorderThickness="1" ClipToBounds="True" Background="#0A0A0F">
              <ctl:MonitorTileControl Viewport="{Binding RunMonitorViewport}" />
            </Border>
          </ctl:AspectBox>
        </StackPanel>
        <TextBlock Grid.Row="3" Classes="runTag" Text="HISTORY" Margin="2,12,0,6" />
        <ItemsControl Grid.Row="4" ItemsSource="{Binding Run.History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:CueExecutionRecord">
              <Grid ColumnDefinitions="Auto,10,*,10,Auto,10,Auto" Margin="2,1">
                <TextBlock Grid.Column="0" Classes="runNotes" Text="{Binding TimeText}" FontFamily="Consolas,Menlo,monospace" Foreground="{StaticResource TextDimBrush}" />
                <TextBlock Grid.Column="2" Classes="runNotes" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Classes="runNotes runOutcome" Classes.failed="{Binding IsFailure}" Text="{Binding OutcomeWords}" />
                <TextBlock Grid.Column="6" Classes="runNotes" Text="{Binding Origin}" Foreground="{StaticResource TextDimBrush}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <GridSplitter Grid.Column="1" Name="RunSplitter" Width="12" Background="Transparent" ResizeDirection="Columns" DragCompleted="OnSplitterDragCompleted"
                    ToolTip.Tip="Drag: how much of the Run area the cue stack takes — the show remembers it" />

      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,8,Auto" Margin="2,0,2,6">
          <TextBlock Classes="runTag" Text="CUE STACK" />
          <TextBlock Grid.Column="1" Classes="runNotes" Text="{Binding Run.ValidationSummary}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
          <ToggleButton Grid.Column="3" Classes="mini" Content="{Binding Run.PadToggleText}" IsChecked="{Binding Run.IsPadOpen, Mode=TwoWay}" Focusable="False"
                        ToolTip.Tip="The show caller's pad: free words for the day — timings, names, what changed at the rehearsal — saved with the show. The assistant reads it too" />
        </Grid>
        <!-- The caller's pad: the day's own words beside the stack -->
        <Border Grid.Row="1" Classes="runBanner" Margin="0,0,0,6" IsVisible="{Binding Run.IsPadOpen}">
          <TextBox Text="{Binding Run.Scratchpad, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="180"
                   Watermark="The caller's pad — timings, names, what changed at the rehearsal. Saved with the show." />
        </Border>
        <!-- The day's clock: where the marks are expected, and the caller's four quick edits -->
        <Border Grid.Row="2" Classes="runBanner" IsVisible="{Binding Run.HasPlan}" Margin="0,0,0,6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="runNotes" Text="{Binding Run.ScheduleSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Classes="mini" Content="−1 MIN" Command="{Binding Run.ShiftEarlierCommand}" Focusable="False"
                      ToolTip.Tip="Pull every planned start from the standby cue on a minute earlier" />
              <Button Classes="mini" Content="+1 MIN" Command="{Binding Run.ShiftLaterCommand}" Focusable="False"
                      ToolTip.Tip="Push every planned start from the standby cue on a minute later" />
              <Button Classes="mini" Content="RESUME NOW" Command="{Binding Run.ResumeNowCommand}" Focusable="False"
                      ToolTip.Tip="The standby cue is planned for now; the rest of the day moves with it" />
              <Button Classes="mini" Content="CATCH UP" Command="{Binding Run.CatchUpCommand}" Focusable="False"
                      ToolTip.Tip="Behind the plan: squeeze the planned lengths before the next break, lunch or end, in proportion (never under 30 s), until the time is made up" />
            </StackPanel>
          </Grid>
        </Border>
        <!-- The caller's lower thirds (round 62): the show's designs as chips — a press puts one on air (or in the
             preview with PVW FIRST, on the desk); on a caller node the press goes to the desk as its other verbs do. -->
        <Border Grid.Row="3" Classes="runBanner" Margin="0,0,0,6" IsVisible="{Binding HasLowerThirds}">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,8,Auto,6,Auto,6,Auto">
              <TextBlock Classes="runTag" Text="LOWER THIRDS" VerticalAlignment="Center" />
              <ToggleButton Grid.Column="2" Classes="mini" Content="PVW FIRST" IsChecked="{Binding LowerThirdChipsToPreview, Mode=TwoWay}" IsVisible="{Binding HasRunWall}" Focusable="False"
                            ToolTip.Tip="The chips go to the preview for a sign-off instead of straight to air; TAKE then puts the signed-off one on" />
              <Button Grid.Column="4" Classes="go" Content="TAKE" Command="{Binding TakeLowerThirdCommand}" IsVisible="{Binding HasLowerThirdInPreview}" Focusable="False"
                      ToolTip.Tip="The signed-off lower third to air; the preview clears" />
              <Button Grid.Column="6" Classes="mini" Content="■ HIDE" Command="{Binding HideLowerThirdCommand}" Focusable="False"
                      ToolTip.Tip="The lower third on air leaves, the way it was designed to (LT OFF on the wire)" />
            </Grid>
            <ItemsControl ItemsSource="{Binding LowerThirds.Designs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="lt:LowerThirdDesign">
                  <Button Classes="chip" Classes.pvw="{Binding IsInPreview}" Classes.air="{Binding IsOnAir}" ctl:Menus.Kind="lowerthird" Margin="0,0,6,6" Padding="8,4" Focusable="False"
                          Command="{Binding $parent[UserControl].((vm:IRunPage)DataContext).ChipLowerThirdCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding OnAirText}">
                    <StackPanel Spacing="1">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="★ " IsVisible="{Binding IsDefault}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <TextBlock Classes="chipLine" Classes.pvw="{Binding IsInPreview}" Classes.air="{Binding IsOnAir}" Text="{Binding ChipText}" TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding ChipText, Converter={StaticResource NotEmpty}}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="runNotes" Text="{Binding LowerThirdStatus}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding LowerThirdStatus, Converter={StaticResource NotEmpty}}" />
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Run.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RunRow">
                <Border Classes="runRow" Classes.standby="{Binding IsStandby}" Classes.last="{Binding IsLast}" Classes.next="{Binding IsNext}"
                        Classes.broken="{Binding IsBroken}" Classes.off="{Binding !Enabled}"
                        ctl:Menus.Kind="cue">
                  <!-- Right-click: the cue's menu (round 60) — the row's own verbs, then the cue's look, its transition, its overlays, a lower third on a clock, the auto-follow; the window's view model builds it -->
                  <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Focusable="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Command="{Binding $parent[UserControl].((vm:IRunPage)DataContext).Run.SelectRowCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="Click: put this cue on standby (changes nothing on air). Right-click: the cue's menu — go now, a note, skip, its look and how it comes in, the overlays and the lower third it brings, the auto-follow, the editor. ✎: a note, for a touch screen">
                    <Grid ColumnDefinitions="88,Auto,*,Auto">
                      <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Classes="runNumber" Text="{Binding Number}" />
                        <TextBlock Classes="runNotes" Text="{Binding Plan}" IsVisible="{Binding HasPlan}" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                        <Border Classes="runTagChip" IsVisible="{Binding Tag, Converter={StaticResource NotEmpty}}">
                          <TextBlock Text="{Binding Tag}" />
                        </Border>
                        <Border Classes="runTagChip" IsVisible="{Binding HasMark}" ToolTip.Tip="A break, lunch or the end — what the estimates count down to">
                          <TextBlock Text="{Binding MarkTag}" />
                        </Border>
                        <Border Classes="runTagChip" IsVisible="{Binding HasFollow}" ToolTip.Tip="Auto-follow: after this cue fires, the next GOes by itself after this delay">
                          <TextBlock Text="{Binding FollowTag}" />
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2" Margin="10,0,0,0">
                        <TextBlock Classes="runName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="runNotes" Text="{Binding Summary}" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="runNotes runCueNotes" Text="{Binding Notes}" IsVisible="{Binding HasNotes}" TextWrapping="Wrap" />
                        <TextBlock Classes="runNotes runCueNotes" Foreground="{StaticResource TallyPvwBrush}" Text="{Binding LiveNotes}" IsVisible="{Binding HasLiveNotes}" TextWrapping="Wrap"
                                   ToolTip.Tip="The caller's in-show note on this cue" />
                        <TextBlock Classes="runNotes" Foreground="{StaticResource TallyPgmBrush}" Text="{Binding Problem}" IsVisible="{Binding IsBroken}" TextWrapping="Wrap" />
                        <!-- The note, typed in place: a TextBox takes the press, so typing here never moves standby -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsEditingNotes}">
                          <TextBox Text="{Binding Cue.LiveNotes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="120"
                                   Watermark="In-show note for this cue — saved with the show" />
                          <Button Classes="mini" Content="DONE" HorizontalAlignment="Right" Command="{Binding Owner.CloseNotesCommand}" CommandParameter="{Binding}" Focusable="False" />
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="3" Classes="mini" Content="✎" VerticalAlignment="Top" Margin="6,0,0,0" Focusable="False"
                              Command="{Binding Owner.EditNotesCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="A note on this cue — the caller's, in the show; the same as right-click ▸ NOTE… for a touch screen" />
                    </Grid>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Transport: the standby card, GO, and the guarded stops -->
    <Border Grid.Row="3" Classes="runTransport">
      <Grid ColumnDefinitions="Auto,12,*,12,Auto,Auto,Auto,Auto,12,Auto,Auto">
        <ToggleButton Grid.Column="0" Classes="runArm" Content="{Binding Run.ArmText}" IsChecked="{Binding Run.IsArmed, Mode=OneWay}"
                      Command="{Binding Run.ArmCommand}" Focusable="False"
                      ToolTip.Tip="ARMED gates GO from every origin and holds the schedule, part start times and plain F-keys. Always off when the app opens." />
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
          <Grid ColumnDefinitions="Auto,10,*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="runTag" Text="STANDBY" Foreground="{StaticResource TallyPvwBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="runStandby" Text="{Binding Run.StandbyText}" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="3" Classes="runChip holdChip" IsVisible="{Binding Run.StandbyReadyText, Converter={StaticResource NotEmpty}}" VerticalAlignment="Center"><TextBlock Text="{Binding Run.StandbyReadyText}" /></Border>
            <Border Grid.Column="4" Classes="runChip armedChip" Margin="6,0,0,0" IsVisible="{Binding Run.StandbyPreRollGood, Converter={StaticResource NotEmpty}}" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding Run.StandbyPreRollTip}"><TextBlock Text="{Binding Run.StandbyPreRollGood}" /></Border>
            <Border Grid.Column="5" Classes="runChip holdChip" Margin="6,0,0,0" IsVisible="{Binding Run.StandbyPreRollWait, Converter={StaticResource NotEmpty}}" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding Run.StandbyPreRollTip}"><TextBlock Text="{Binding Run.StandbyPreRollWait}" /></Border>
          </Grid>
          <TextBlock Classes="runNotes runCueNotes" Text="{Binding Run.StandbyNotes}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Run.StandbyNotes, Converter={StaticResource NotEmpty}}" />
          <TextBlock Classes="runNotes runCueNotes" Foreground="{StaticResource TallyPvwBrush}" Text="{Binding Run.StandbyLiveNotes}" TextWrapping="Wrap" IsVisible="{Binding Run.StandbyLiveNotes, Converter={StaticResource NotEmpty}}"
                     ToolTip.Tip="The caller's in-show note on the standby cue" />
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Run.StandbyPlanText, Converter={StaticResource NotEmpty}}">
            <TextBlock Classes="runNotes" Text="{Binding Run.StandbyPlanText}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
            <Border Classes="runChip holdChip" IsVisible="{Binding Run.HasFollow}" ToolTip.Tip="The next cue fires by itself when this runs out — press STOP FOLLOW, HOLD, or move standby to keep it"><TextBlock Text="{Binding Run.FollowText}" /></Border>
            <Button Classes="mini" Content="STOP FOLLOW" Command="{Binding Run.CancelFollowCommand}" IsVisible="{Binding Run.HasFollow}" Focusable="False" />
          </StackPanel>
          <TextBlock Classes="runNotes" Foreground="{StaticResource TallyPgmBrush}" Text="{Binding Run.StandbyProblem}" IsVisible="{Binding Run.StandbyIsBroken}" />
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Run.RunningText, Converter={StaticResource NotEmpty}}">
            <TextBlock Classes="runTag" Text="RUNNING" Foreground="{StaticResource TallyPgmBrush}" VerticalAlignment="Center" />
            <TextBlock Classes="runNotes runRunning" Classes.over="{Binding Run.RunningOverPlanned}" Text="{Binding Run.RunningText}" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="4" Classes="runStep" Content="▲" Command="{Binding Run.StandbyUpCommand}" Focusable="False" ToolTip.Tip="Standby up (↑) — no output change" />
        <Button Grid.Column="5" Classes="runStep" Content="▼" Command="{Binding Run.StandbyDownCommand}" Focusable="False" ToolTip.Tip="Standby down (↓) — no output change" />
        <Button Grid.Column="6" Classes="runGo" Classes.confirm="{Binding Run.IsConfirming}" Content="{Binding Run.GoText}" Command="{Binding Run.GoCommand}" Focusable="False"
                ToolTip.Tip="GO (Enter while armed): runs the standby cue and moves standby to the next. A cue that asks for confirmation needs a second GO within four seconds." />
        <ToggleButton Grid.Column="7" Classes="runHold" Content="HOLD" IsChecked="{Binding Run.IsHold, Mode=OneWay}" Command="{Binding Run.HoldCommand}" Focusable="False"
                      ToolTip.Tip="A latched GO inhibit and nothing else: GO from any origin is refused until released" />
        <ToggleButton Grid.Column="9" Classes="runBlackout" Content="BLACKOUT" IsChecked="{Binding IsBlackout, Mode=TwoWay}" Focusable="False"
                      ToolTip.Tip="Immediate black on every output (Space). While on, GO is refused rather than executing under black." />
        <Button Grid.Column="10" Classes="runStop" Content="STOP ALL" Command="{Binding Run.StopAllCommand}" Focusable="False"
                ToolTip.Tip="Stops the audio track, break music, any VOG or stinger (the previous content comes back — it never runs the stinger's ending) and the tone. Never outputs, blackout or the stream. Esc twice does the same." />
      </Grid>
    </Border>
  </Grid>
</UserControl>
