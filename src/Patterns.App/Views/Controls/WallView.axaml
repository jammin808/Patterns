<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:ctl="using:Patterns.App.Views.Controls"
             x:Class="Patterns.App.Views.Controls.WallView"
             x:DataType="vm:MainViewModel">

<!-- The wall: one tile per content target (PGM, joined canvases, single screens) with
     its PGM and PVW miniatures. Click = the panes and editors follow it; OWN = its own
     pattern; MON = draw the miniatures; ARM = the next CUT / TAKE changes it; OUT (on the
     title row) = OUTPUT on/off live; the tick = a SEND TO TICKED target (sandbox open) and
     a FADE TO BLACK "ticked" target (always); ▸ on the title row = this tile as a bar. -->
<UserControl.Styles>
  <!-- A tile shows one of two branches, never both: its body, or its vertical title bar when the
       wall is collapsed (the Run area's COLLAPSE TILES puts the "collapsed" class on the wall) or
       the tile itself is (the "tileCollapsed" class on its border). Decided by classes and these
       styles, in this order, on the visual tree itself — not by a binding up the tree that can
       resolve late and leave both branches showing with the name on its side over the buttons. -->
  <Style Selector="StackPanel.tileBar"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="StackPanel.tileBody"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="Button.tileExpand"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Border.tile.tileCollapsed StackPanel.tileBar"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="Border.tile.tileCollapsed StackPanel.tileBody"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Border.tile.tileCollapsed Button.tileExpand"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="ctl|WallView.collapsed StackPanel.tileBar"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="ctl|WallView.collapsed StackPanel.tileBody"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="ctl|WallView.collapsed Button.tileExpand"><Setter Property="IsVisible" Value="False" /></Style>
</UserControl.Styles>
<Grid ColumnDefinitions="*,8,Auto,Auto">
  <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding SwitcherTiles}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SwitcherTile">
          <!-- A pause over the tile pops it up large: PGM and PVW side by side, the same miniatures at a size a caller can read -->
          <Border Classes="tile" Classes.tileActive="{Binding IsSelected}" Classes.tileCollapsed="{Binding IsCollapsed}" Padding="6,4" ToolTip.ShowDelay="700" ToolTip.Placement="Bottom">
            <ToolTip.Tip>
              <StackPanel Spacing="6" Width="680">
                <TextBlock Classes="tileTitle" Classes.air="{Binding IsOnAir}" Classes.hold="{Binding IsHeld}" Text="{Binding Title}" FontWeight="Bold" FontSize="14" />
                <Grid ColumnDefinitions="*,10,*">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="label" Text="PGM — on air" Foreground="{StaticResource TallyPgmBrush}" />
                    <ctl:AspectBox Ratio="{Binding Ratio}">
                      <Border BorderBrush="#80E0342E" BorderThickness="1" ClipToBounds="True" Background="#0A0A0F">
                        <ctl:MonitorTileControl Viewport="{Binding PgmViewport}" />
                      </Border>
                    </ctl:AspectBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Classes="label" Text="PVW — what the next CUT / TAKE puts there" Foreground="{StaticResource TallyPvwBrush}" />
                    <ctl:AspectBox Ratio="{Binding Ratio}">
                      <Border BorderBrush="#802EE68A" BorderThickness="1" ClipToBounds="True" Background="#0A0A0F">
                        <ctl:MonitorTileControl Viewport="{Binding PvwViewport}" />
                      </Border>
                    </ctl:AspectBox>
                  </StackPanel>
                </Grid>
                <TextBlock Classes="hint" Text="{Binding FootText}" FontSize="11" />
              </StackPanel>
            </ToolTip.Tip>
            <!-- Both branches sit at the top of the tile: a tile taller than its content (the row is
                 as tall as its tallest tile) keeps its title row and its buttons where PGM keeps them -->
            <Panel VerticalAlignment="Top">
            <!-- Collapsed: a vertical title bar — the tally, the name on its side, the BLACK badge, and ▾ to open this tile again when it was this tile's own choice -->
            <StackPanel Name="TileBar" Classes="tileBar" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Top">
              <Ellipse Classes="tally" Classes.air="{Binding IsOnAir}" Classes.hold="{Binding IsHeld}" Width="8" Height="8" HorizontalAlignment="Center" Margin="0,2,0,0" />
              <Border Classes="roleBadge blackBadge" IsVisible="{Binding IsBlack}" ToolTip.Tip="Faded to black on its own">
                <TextBlock Text="B" />
              </Border>
              <LayoutTransformControl HorizontalAlignment="Center">
                <LayoutTransformControl.LayoutTransform>
                  <RotateTransform Angle="90" />
                </LayoutTransformControl.LayoutTransform>
                <Button Background="Transparent" BorderThickness="0" Padding="2" Cursor="Hand" Focusable="False"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectTileCommand}" CommandParameter="{Binding}">
                  <TextBlock Classes="tileTitle" Classes.air="{Binding IsOnAir}" Classes.hold="{Binding IsHeld}" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Button>
              </LayoutTransformControl>
              <Button Name="TileExpand" Classes="wall tileExpand" Content="▾" Command="{Binding ExpandCommand}" Focusable="False" HorizontalAlignment="Center" Margin="0"
                      ToolTip.Tip="Open this tile again — its miniatures and its buttons" />
            </StackPanel>
            <StackPanel Name="TileBody" Classes="tileBody" Spacing="3" Width="176" VerticalAlignment="Top">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                <Ellipse Classes="tally" Classes.air="{Binding IsOnAir}" Classes.hold="{Binding IsHeld}"
                         Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                         ToolTip.Tip="Tally: red = the audience sees it, amber = held through the next send, grey = not on air" />
                <!-- The role badge: CONF, INFO or REP; a main screen wears none. BLACK: faded to black on its own (the blackout shows on every tally instead) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Border Classes="roleBadge" IsVisible="{Binding HasBadge}" ToolTip.Tip="{Binding BadgeTip}">
                    <TextBlock Text="{Binding RoleBadge}" />
                  </Border>
                  <Border Classes="roleBadge blackBadge" IsVisible="{Binding IsBlack}"
                          ToolTip.Tip="Faded to black on its own — FADE TO BLACK on this tile, from the panel, a cue, the phone or Companion; FADE UP brings it back (a FADE UP on EVERY SCREEN brings back every tile like it)">
                    <TextBlock Text="BLACK" />
                  </Border>
                </StackPanel>
                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0,2" Cursor="Hand"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectTileCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Click: the big PROGRAM and PREVIEW panes show this target, and the editors work on it">
                  <TextBlock Classes="tileTitle" Classes.air="{Binding IsOnAir}" Classes.hold="{Binding IsHeld}"
                             Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Button>
                <!-- The tick — always there — joins SEND TO TICKED and FADE TO BLACK on the ticked. A wall toggle, not the
                     theme's checkbox: its template holds a 32 px grid that made a screen tile's title row 13 px taller than
                     PGM's, with its buttons that much lower -->
                <ToggleButton Grid.Column="3" Name="TileTick" Classes="wall tick" Content="✓" IsChecked="{Binding IsSendTarget, Mode=TwoWay}"
                              IsVisible="{Binding !IsProgramTile}" Margin="4,0,0,0" Focusable="False"
                              ToolTip.Tip="Tick: this tile joins SEND TO TICKED (with EDIT SAFE open) and the Show panel's FADE TO BLACK / FADE UP on THE TICKED SCREENS or THE TICKED GROUPS — lit while it is ticked. A group is a joined canvas (A, B…): screens dragged flush together on SETUP → Screens make one, dragged apart leave it" />
                <!-- OUTPUT: the screen on or off, live — a wall button that fits the tile (the switch it replaces hung outside it) -->
                <ToggleButton Grid.Column="4" Classes="wall output" Content="OUT" IsChecked="{Binding Enabled, Mode=TwoWay}"
                              IsVisible="{Binding !IsProgramTile}" Margin="4,0,0,0" Focusable="False"
                              ToolTip.Tip="OUTPUT: this screen's output on / off, live — green while it is on" />
                <!-- ▸ collapses this tile alone to its title bar; the Run area's COLLAPSE TILES does them all -->
                <Button Grid.Column="5" Name="TileCollapse" Classes="wall" Content="▸" Command="{Binding CollapseCommand}" Focusable="False" Margin="4,0,0,0"
                        ToolTip.Tip="Collapse this tile to its title bar — the tally and the name on their side; ▾ on the bar opens it again. ▸ COLLAPSE TILES on the Run area's wall collapses every tile at once. The show remembers it" />
              </Grid>
              <!-- PGM left, PVW right; the tile's own popup names them when the pointer rests here -->
              <Grid ColumnDefinitions="*,4,*" Height="54" IsVisible="{Binding IsMonitored}">
                <ctl:AspectBox Ratio="{Binding Ratio}">
                  <Border BorderBrush="#80E0342E" BorderThickness="1" ClipToBounds="True" Background="#0A0A0F">
                    <ctl:MonitorTileControl Viewport="{Binding PgmViewport}" />
                  </Border>
                </ctl:AspectBox>
                <ctl:AspectBox Grid.Column="2" Ratio="{Binding Ratio}">
                  <Border BorderBrush="#802EE68A" BorderThickness="1" ClipToBounds="True" Background="#0A0A0F">
                    <ctl:MonitorTileControl Viewport="{Binding PvwViewport}" />
                  </Border>
                </ctl:AspectBox>
              </Grid>
              <Grid Name="TileButtons" ColumnDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Top">
                <ToggleButton Classes="wall" Content="OWN" IsChecked="{Binding IsOwn, Mode=TwoWay}" IsVisible="{Binding !IsProgramTile}" IsEnabled="{Binding !IsMirror}"
                              ToolTip.Tip="OWN: this target shows its own pattern instead of the program (starts as a copy of the program, so nothing jumps). A repeater draws its source's picture and has none of its own" />
                <ToggleButton Grid.Column="1" Classes="wall" Content="MON" IsChecked="{Binding IsMonitored, Mode=TwoWay}"
                              ToolTip.Tip="MON: draw this target's PGM and PVW miniatures (off saves GPU on a big rig; changes nothing on air)" />
                <ToggleButton Grid.Column="2" Classes="wall" Content="ARM" IsChecked="{Binding IsArmed, Mode=TwoWay}" IsVisible="{Binding !IsProgramTile}"
                              ToolTip.Tip="ARM: the next CUT / TAKE changes this target. Un-armed, it keeps the picture the audience is seeing" />
                <ToggleButton Grid.Column="3" Classes="wall lock" Content="LOCK" IsChecked="{Binding IsLocked, Mode=TwoWay}" IsVisible="{Binding !IsProgramTile}"
                              ToolTip.Tip="LOCK: this target keeps its picture through every look, cue, clicker step, TAKE ALL and stinger — a confidence monitor, an info screen. SEND to it, or OWN and edit, when it should change. Saved with the show" />
              </Grid>
              <!-- The two ways between this tile and the preview, then the tile's foot (its size, or what it repeats).
                   SEND shows while the sandbox is open — a fact on the tile (CanSend), not a binding up the tree -->
              <Grid Name="TileSends" ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Top">
                <Button Name="TileSend" Classes="wall" Content="SEND" Command="{Binding SendHereCommand}" Focusable="False" IsVisible="{Binding CanSend}"
                        ToolTip.Tip="SEND: the preview lands on this tile alone, as its own pattern, live — every other target stays as it is, and the preview keeps the picture for the next send" />
                <Button Grid.Column="1" Name="TileToPreview" Classes="wall" Content="→ PVW" Command="{Binding ToPreviewCommand}" Focusable="False" IsVisible="{Binding !IsProgramTile}"
                        ToolTip.Tip="→ PVW: the picture this target shows on air — its own, or the program's — into the preview, to edit; the air is untouched (EDIT SAFE opens if it was off). Then SEND it to a screen, or TAKE" />
                <TextBlock Grid.Column="2" Classes="hint" Text="{Binding FootText}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding FootText}" />
              </Grid>
            </StackPanel>
            </Panel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding AnyHeld}">
    <TextBlock Classes="label" Foreground="{StaticResource TallyHoldBrush}" Text="{Binding TakeScopeText}" HorizontalAlignment="Center" />
    <Button Classes="mini" Content="ARM ALL" Focusable="False" Command="{Binding ArmAllCommand}"
            ToolTip.Tip="Arm every target again — the next CUT / TAKE goes everywhere" />
  </StackPanel>
  <!-- CUT and TAKE, and under them where they land: every armed screen, the focused tile, the ticked tiles or the ticked groups.
       Stacked, so the pair is no wider than it was and TAKE stays on the window with the screens column at its narrowest -->
  <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Classes="chip" Content="CUT" FontWeight="Bold" Focusable="False"
              Command="{Binding CutCommand}" IsEnabled="{Binding IsSandboxActive}"
              ToolTip.Tip="Preview becomes program instantly (no fade) where the picker under it says — every armed target, the focused tile, the ticked tiles or the ticked groups" />
      <Button Classes="go" Content="TAKE" FontWeight="Bold" Padding="16,6" Focusable="False"
              Command="{Binding TakeCommand}" IsEnabled="{Binding IsSandboxActive}"
              ToolTip.Tip="Preview fades up as the program (uses the transition time) where the picker under it says — every armed target, the focused tile, the ticked tiles or the ticked groups" />
    </StackPanel>
    <ComboBox Name="TakeScopePicker" HorizontalAlignment="Stretch" MinWidth="0" Focusable="False" FontSize="11"
              ItemsSource="{Binding TakeScopes}" SelectedItem="{Binding SelectedTakeScope, Mode=TwoWay}" IsEnabled="{Binding IsSandboxActive}"
              ToolTip.Tip="Where the next CUT / TAKE lands. ALL ARMED: ARM and LOCK on the tiles decide; FOCUSED: the wall tile you clicked (the PGM tile means every armed screen); TICKED / TICKED GROUPS: the tiles ticked on the wall (a group is a joined canvas — screens dragged flush together on SETUP → Screens). Everything outside the choice keeps its picture like an un-armed tile, and the next full TAKE lifts it" />
  </StackPanel>
</Grid>
</UserControl>
