<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:c="using:Patterns.App.Views.Controls"
             x:Class="Patterns.App.Views.Sections.OutputsSection"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1" Text="Screens" />

    <Border Background="#0B0C10" CornerRadius="10" BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1" Height="320" ClipToBounds="True">
      <c:ScreenArrangeControl />
    </Border>
    <TextBlock Classes="hint"
               Text="Tiles show the live content of each screen. Drag a screen flush against another to join them into one big canvas (it glows green when it will connect); drag it away to split. Click a tile to select it." />
    <TextBlock Classes="label" Text="{Binding GroupSummary}" Margin="0,2,0,0" />

    <TextBlock Classes="h2" Text="SELECTED SCREEN" />
    <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" IsVisible="{Binding HasSelection}">
      <StackPanel>
        <TextBlock Text="{Binding SelectedScreenTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <CheckBox Margin="0,6,0,0" Content="Output enabled"
                  IsChecked="{Binding SelectedEnabled, Mode=TwoWay}" />
        <CheckBox Content="Custom pattern for this screen"
                  IsChecked="{Binding SelectedUseCustom, Mode=TwoWay}"
                  IsEnabled="{Binding !SelectedIsGrouped}" />
        <TextBlock Classes="hint" IsVisible="{Binding SelectedIsGrouped}"
                   Text="This screen is part of a joined canvas — the canvas shows the program pattern. Drag it away to give it its own pattern." />
      </StackPanel>
    </Border>
    <TextBlock Classes="hint" IsVisible="{Binding !HasSelection}" Text="Click a screen tile to select it." />

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
      <Button Classes="chip" Content="Identify screens" Command="{Binding IdentifyCommand}" />
      <Button Classes="chip" Content="Reset layout" Command="{Binding ResetLayoutCommand}" />
    </StackPanel>
    <TextBlock Classes="hint"
               Text="Your main (primary) screen stays off by default when other screens are present, so GO never covers the controls — tick 'Output enabled' to include it anyway." />

    <TextBlock Classes="h2" Text="WINDOW BEHAVIOUR" />
    <CheckBox Content="Always on top" IsChecked="{Binding State.Output.Topmost}" />
    <CheckBox Content="Hide mouse cursor on outputs" IsChecked="{Binding State.Output.HideCursor}" />

    <TextBlock Classes="h2" Text="LIVE" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="go" Content="GO" Command="{Binding GoCommand}" />
      <Button Classes="stop" Content="STOP" Command="{Binding StopCommand}" />
    </StackPanel>
    <TextBlock Classes="hint"
               Text="On an output window: Esc closes outputs · Space/B blackout · I identify. Layout changes apply live while outputs run." />
  </StackPanel>
</UserControl>
