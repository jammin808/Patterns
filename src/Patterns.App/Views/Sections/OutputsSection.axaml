<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:c="using:Patterns.App.Views.Controls"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.OutputsSection"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-outputs" Text="Screens" />

    <TextBlock Classes="h2" Text="MODE" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ToggleButton Classes="mini" Content="PREP (pre-programming)" IsChecked="{Binding IsPrepMode, Mode=TwoWay}"
                    ToolTip.Tip="Build the rig at the desk with no hardware — the outputs stay held until you switch to SHOW" />
      <TextBlock Classes="label" Text="{Binding PrepSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock Classes="hint"
               Text="PREP is for the day before: add the screens the venue will have, arrange and label them, give each its pattern, type in the NDI and capture names the rig will use, and build every look — all without a display, a camera or a wall attached. Outputs are held closed so nothing can go live by accident. At the venue, switch to SHOW and adopt each planned screen onto the display it turned out to be; everything programmed against it comes with it." />

    <TextBlock Classes="h2" Text="PLANNED SCREENS" IsVisible="{Binding PlannedScreenCount, Converter={StaticResource Positive}}" />
    <ItemsControl ItemsSource="{Binding State.Output.Placements}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:ScreenPlacement">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="9,7" Margin="0,3"
                  IsVisible="{Binding Planned}">
            <StackPanel Spacing="5">
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Grid.Column="0" Watermark="Name (e.g. Main wall)" Text="{Binding CustomLabel}" />
                <Button Grid.Column="2" Classes="mini" Content="✕" ToolTip.Tip="Remove this planned screen"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemovePlannedScreenCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
              <Grid ColumnDefinitions="46,86,4,86,*">
                <TextBlock Classes="label" Text="Size" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="160" Maximum="16384" Increment="16" FormatString="0"
                               ShowButtonSpinner="False"
                               Value="{Binding PlannedWidth, Mode=TwoWay, Converter={StaticResource Num}}" />
                <NumericUpDown Grid.Column="3" Minimum="160" Maximum="16384" Increment="16" FormatString="0"
                               ShowButtonSpinner="False"
                               Value="{Binding PlannedHeight, Mode=TwoWay, Converter={StaticResource Num}}" />
              </Grid>
              <Grid ColumnDefinitions="*,8,Auto">
                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AdoptTargets}"
                          SelectedValue="{Binding AdoptTargetId, Mode=TwoWay}"
                          SelectedValueBinding="{Binding ScreenId, x:DataType=vm:EditTarget}"
                          PlaceholderText="At the venue: which display is this?" />
                <Button Grid.Column="2" Classes="chip" Content="Adopt"
                        ToolTip.Tip="Bind this planned screen to the chosen display — position, label, pattern, trims and looks all follow"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AdoptPlannedScreenCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
      <Button Classes="chip" Content="+ Plan a screen" Command="{Binding AddPlannedScreenCommand}" />
      <Button Classes="chip" Content="Refresh displays" Command="{Binding RefreshAdoptTargetsCommand}" />
    </StackPanel>

    <Border Background="#0B0C10" CornerRadius="10" BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1" Height="320" ClipToBounds="True">
      <c:ScreenArrangeControl />
    </Border>
    <TextBlock Classes="hint"
               Text="Tiles show the live content of each screen. Drag a screen flush against another to join them into one big canvas (it glows green when it will connect); drag it away to split. Click a tile to select it." />
    <TextBlock Classes="label" Text="{Binding GroupSummary}" Margin="0,2,0,0" />

    <TextBlock Classes="h2" Text="SELECTED SCREEN" />
    <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" IsVisible="{Binding HasSelection}">
      <StackPanel>
        <TextBlock Text="{Binding SelectedScreenTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="86,*" Margin="0,6,0,0">
          <TextBlock Classes="label" Text="Label" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Watermark="e.g. Stage left LED (shown everywhere)"
                   Text="{Binding SelectedScreenLabel, Mode=TwoWay}" />
        </Grid>
        <Grid ColumnDefinitions="86,*" Margin="0,4,0,0" IsVisible="{Binding SelectedIsInCanvas}">
          <TextBlock Classes="label" Text="Canvas name" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Watermark="e.g. Main wall (names the joined canvas)"
                   Text="{Binding SelectedCanvasName, Mode=TwoWay}" />
        </Grid>

        <CheckBox Margin="0,6,0,0" Content="Output enabled"
                  IsChecked="{Binding SelectedEnabled, Mode=TwoWay}" />
        <CheckBox Content="Custom pattern for this screen"
                  IsChecked="{Binding SelectedUseCustom, Mode=TwoWay}"
                  IsEnabled="{Binding !SelectedIsGrouped}" />
        <TextBlock Classes="hint" IsVisible="{Binding SelectedIsGrouped}"
                   Text="This screen is part of a joined canvas — the canvas shows the program pattern. Drag it away to give it its own pattern." />

        <TextBlock Classes="label" Text="Orientation" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding Rotations}"
                  SelectedValue="{Binding SelectedRotation, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
        <TextBlock Classes="hint"
                   Text="For displays mounted in portrait or upside down: content is rendered upright and rotated at output. The overview above shows the rotated shape." />

        <TextBlock Classes="label" Text="Output trims" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="86,*,44" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="label" Text="Brightness" VerticalAlignment="Center" />
          <Slider Grid.Row="0" Grid.Column="1" Minimum="10" Maximum="150" TickFrequency="5"
                  Value="{Binding SelectedBrightness, Mode=TwoWay}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedBrightness, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="1" Classes="label" Text="Gamma" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="0.4" Maximum="2.5" TickFrequency="0.05"
                  Value="{Binding SelectedGamma, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedGamma, StringFormat={}{0:0.00}}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Red" VerticalAlignment="Center" />
          <Slider Grid.Row="2" Grid.Column="1" Minimum="25" Maximum="175" TickFrequency="5"
                  Value="{Binding SelectedTrimR, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedTrimR, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Green" VerticalAlignment="Center" />
          <Slider Grid.Row="3" Grid.Column="1" Minimum="25" Maximum="175" TickFrequency="5"
                  Value="{Binding SelectedTrimG, Mode=TwoWay}" />
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedTrimG, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="4" Classes="label" Text="Blue" VerticalAlignment="Center" />
          <Slider Grid.Row="4" Grid.Column="1" Minimum="25" Maximum="175" TickFrequency="5"
                  Value="{Binding SelectedTrimB, Mode=TwoWay}" />
          <TextBlock Grid.Row="4" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedTrimB, StringFormat={}{0:0}%}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Content="Reset trims" Command="{Binding ResetTrimsCommand}" />
        </StackPanel>
        <TextBlock Classes="hint"
                   Text="Per-screen brightness / gamma / RGB balance for matching mismatched house displays. Applies to this output only — NDI and other screens are untouched." />

        <TextBlock Classes="label" Text="Corner warp (keystone) — px offsets" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="76,*,6,*,12,76,*,6,*" RowDefinitions="Auto,4,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Top-left" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpTlx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpTly, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
          <TextBlock Grid.Row="0" Grid.Column="5" Classes="label" Text="Top-right" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="6" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpTrx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="0" Grid.Column="8" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpTry, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Bottom-left" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpBlx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpBly, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
          <TextBlock Grid.Row="2" Grid.Column="5" Classes="label" Text="Bottom-right" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="6" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpBrx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="2" Grid.Column="8" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpBry, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Content="Reset warp" Command="{Binding ResetWarpCommand}" />
        </StackPanel>
        <TextBlock Classes="hint"
                   Text="Pulls each corner of this output by the given pixels — a light keystone for casually placed projectors, not a full warp engine. Positive X moves right, positive Y moves down." />
      </StackPanel>
    </Border>
    <TextBlock Classes="hint" IsVisible="{Binding !HasSelection}" Text="Click a screen tile to select it." />

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
      <Button Classes="chip" Content="Identify screens" Command="{Binding IdentifyCommand}" />
      <Button Classes="chip" Content="Reset layout" Command="{Binding ResetLayoutCommand}" />
    </StackPanel>
    <TextBlock Classes="hint"
               Text="Your main (primary) screen stays off by default when other screens are present, so OUTPUTS ON never covers the controls — tick 'Output enabled' to include it anyway." />

    <TextBlock Classes="h2" Text="WINDOW BEHAVIOUR" />
    <CheckBox Content="Always on top" IsChecked="{Binding State.Output.Topmost}" />
    <CheckBox Content="Hide mouse cursor on outputs" IsChecked="{Binding State.Output.HideCursor}" />

    <TextBlock Classes="h2" Text="LIVE" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="go" Content="OUTPUTS ON" Command="{Binding GoCommand}" Focusable="False" />
      <Button Classes="stop" Content="OUTPUTS OFF" Command="{Binding StopCommand}" Focusable="False" />
    </StackPanel>
    <TextBlock Classes="hint"
               Text="On an output window: Esc twice within a second closes outputs · Space/B blackout · I identify. Layout changes apply live while outputs run." />
  </StackPanel>
</UserControl>
