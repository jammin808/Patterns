<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:c="using:Patterns.App.Views.Controls"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.OutputsSection"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-outputs" Text="Screens" />

    <TextBlock Classes="h2" Text="MODE" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ToggleButton Classes="mini" Content="PREP (pre-programming)" IsChecked="{Binding IsPrepMode, Mode=TwoWay}"
                    ToolTip.Tip="Build the rig at the desk with no hardware — the outputs stay held until you switch to SHOW" />
      <TextBlock Classes="label" Text="{Binding PrepSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock Classes="hint tip"
               Text="PREP is for the day before: add the screens the venue will have, arrange and label them, give each its pattern, type in the NDI and capture names the rig will use, and build every look — all without a display, a camera or a wall attached. Outputs are held closed so nothing can go live by accident. At the venue, switch to SHOW and adopt each planned screen onto the display it turned out to be; everything programmed against it comes with it." />

    <TextBlock Classes="h2" Text="PLANNED SCREENS" IsVisible="{Binding PlannedScreenCount, Converter={StaticResource Positive}}" />
    <ItemsControl ItemsSource="{Binding State.Output.Placements}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:ScreenPlacement">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="9,7" Margin="0,3"
                  IsVisible="{Binding IsPlannedDisplay}">
            <StackPanel Spacing="5">
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Grid.Column="0" Watermark="Name (e.g. Main wall)" Text="{Binding CustomLabel}" />
                <Button Grid.Column="2" Classes="mini" Content="✕" ToolTip.Tip="Remove this planned screen"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemovePlannedScreenCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
              <Grid ColumnDefinitions="46,86,4,86,*">
                <TextBlock Classes="label" Text="Size" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="160" Maximum="16384" Increment="16" FormatString="0"
                               ShowButtonSpinner="False"
                               Value="{Binding PlannedWidth, Mode=TwoWay, Converter={StaticResource Num}}" />
                <NumericUpDown Grid.Column="3" Minimum="160" Maximum="16384" Increment="16" FormatString="0"
                               ShowButtonSpinner="False"
                               Value="{Binding PlannedHeight, Mode=TwoWay, Converter={StaticResource Num}}" />
              </Grid>
              <Grid ColumnDefinitions="*,8,Auto">
                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AdoptTargets}"
                          SelectedValue="{Binding AdoptTargetId, Mode=TwoWay}"
                          SelectedValueBinding="{Binding ScreenId, x:DataType=vm:EditTarget}"
                          PlaceholderText="At the venue: which display is this?" />
                <Button Grid.Column="2" Classes="chip" Content="Adopt"
                        ToolTip.Tip="Bind this planned screen to the chosen display — position, label, pattern, trims and looks all follow"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AdoptPlannedScreenCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
      <Button Classes="chip" Content="+ Plan a screen" Command="{Binding AddPlannedScreenCommand}" />
      <Button Classes="chip" Content="Refresh displays" Command="{Binding RefreshAdoptTargetsCommand}" />
    </StackPanel>

    <TextBlock Classes="h2" Text="FEED SCREENS (NDI SENDS, THE STREAM)" IsVisible="{Binding VirtualScreenCount, Converter={StaticResource Positive}}" />
    <Panel IsVisible="{Binding VirtualScreenCount, Converter={StaticResource Positive}}">
    <TextBlock Classes="hint tip"
               Text="Every NDI send owns a screen of its own, and the stream does while it is set to its own screen. They are screens like any other — arrange them, OWN them on the wall, give them a look of their own, put them in a multiview or a cue — but never a window, never adopted onto a display, never joined to one by touching. A send that mirrors another target still owns one; what the send shows is chosen on the NDI page, the stream's source on the Stream page. The size follows the feed." />
    </Panel>
    <ItemsControl ItemsSource="{Binding State.Output.Placements}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:ScreenPlacement">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="9,7" Margin="0,3"
                  IsVisible="{Binding IsVirtual}">
            <Grid ColumnDefinitions="Auto,10,*,10,Auto">
              <Border Grid.Column="0" Background="#20242E" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                <TextBlock Text="{Binding VirtualKind}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
              </Border>
              <TextBox Grid.Column="2" Watermark="Name" Text="{Binding CustomLabel}" ToolTip.Tip="What the wall and the pickers call this screen" />
              <TextBlock Grid.Column="4" Classes="label" VerticalAlignment="Center">
                <Run Text="{Binding PlannedWidth}" /><Run Text="×" /><Run Text="{Binding PlannedHeight}" /><Run Text=" · follows the feed" />
              </TextBlock>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Background="#0B0C10" CornerRadius="10" BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1" Height="320" ClipToBounds="True">
      <c:ScreenArrangeControl />
    </Border>
    <TextBlock Classes="hint tip"
               Text="Tiles show the live content of each screen. Drag a screen flush against another to join them into one big canvas (it glows green when it will connect); drag it away to split. Click a tile to select it." />
    <TextBlock Classes="label" Text="{Binding GroupSummary}" Margin="0,2,0,0" />

    <TextBlock Classes="h2" Text="FRAME RATE" />
    <Grid ColumnDefinitions="130,*">
      <TextBlock Classes="label" Text="Master rate" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding MasterFpsOptions}"
                SelectedValue="{Binding MasterFps, Mode=TwoWay}"
                SelectedValueBinding="{Binding Value, x:DataType=vm:FpsOption}" />
    </Grid>
    <TextBlock Classes="hint tip"
               Text="The show's frame rate. Every output presents at it — a 30 fps show on 60 Hz displays draws every other refresh, evenly, on one clock — an NDI sender set to 'master' sends at it, and the stream can follow it. Unlimited leaves every display at its own refresh. A screen below can override it." />

    <TextBlock Classes="h2" Text="SELECTED SCREEN" />
    <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" IsVisible="{Binding HasSelection}">
      <StackPanel>
        <TextBlock Text="{Binding SelectedScreenTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="86,*" Margin="0,6,0,0">
          <TextBlock Classes="label" Text="Label" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Watermark="e.g. Stage left LED (shown everywhere)"
                   Text="{Binding SelectedScreenLabel, Mode=TwoWay}" />
        </Grid>
        <Grid ColumnDefinitions="86,*" Margin="0,4,0,0" IsVisible="{Binding SelectedIsInCanvas}">
          <TextBlock Classes="label" Text="Canvas name" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Watermark="e.g. Main wall (names the joined canvas)"
                   Text="{Binding SelectedCanvasName, Mode=TwoWay}" />
        </Grid>

        <CheckBox Margin="0,6,0,0" Content="Output enabled"
                  IsChecked="{Binding SelectedEnabled, Mode=TwoWay}" />
        <CheckBox Content="Custom pattern for this screen"
                  IsChecked="{Binding SelectedUseCustom, Mode=TwoWay}"
                  IsEnabled="{Binding !SelectedIsGrouped}" />
        <Panel IsVisible="{Binding SelectedIsGrouped}">
          <TextBlock Classes="hint tip"
                     Text="This screen is part of a joined canvas — the canvas shows the program pattern. Drag it away to give it its own pattern." />
        </Panel>

        <!-- What the screen is for: the role, whether it follows cues, what it repeats -->
        <Grid ColumnDefinitions="86,*" Margin="0,8,0,0">
          <TextBlock Classes="label" Text="Role" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ScreenRoleItems}"
                    SelectedValue="{Binding SelectedRole, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}"
                    ToolTip.Tip="Main follows the show; Confidence and Info screens are locked as you pick them; a Repeater copies another target (choose it under Mirror of)" />
        </Grid>
        <CheckBox Content="Follows looks, cues and TAKE" IsChecked="{Binding SelectedFollowsCues, Mode=TwoWay}"
                  ToolTip.Tip="Off = locked: this screen keeps its picture through every look, cue, clicker step, TAKE ALL and stinger — a confidence monitor or an info screen. SEND to its tile, or OWN and edit, when it should change. The tile's LOCK is the same switch" />
        <Grid ColumnDefinitions="86,*" Margin="0,4,0,0">
          <TextBlock Classes="label" Text="Mirror of" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding MirrorSources}"
                    SelectedValue="{Binding SelectedMirrorOf, Mode=TwoWay}"
                    SelectedValueBinding="{Binding ScreenId, x:DataType=vm:EditTarget}"
                    ToolTip.Tip="A repeater draws this target's picture wherever that picture goes — a duplicate of a main screen or a joined canvas" />
        </Grid>
        <TextBlock Classes="hint tip"
                   Text="Role names what the screen is for and picks whether it follows cues: CONF and INFO screens are locked as you choose them, so a cue progression changes the main screens and leaves them alone (SEND on the tile, a cue's Screen unlock, or the remote's LOCK n OFF changes that). Mirror of makes the screen a repeater of another screen or canvas. The wall shows the badge and LOCK on every tile." />
        <CheckBox Margin="0,4,0,0" Content="Direct output — bypass the desktop compositor"
                  IsChecked="{Binding SelectedDirectOutput, Mode=TwoWay}" IsVisible="{Binding SelectedIsDisplay}"
                  ToolTip.Tip="Windows hands this window straight to its display through the flip path — no composition frame, no compositor jitter. The swap chain behind it is chosen when Patterns starts." />
        <TextBlock Classes="hint" Text="{Binding DirectOutputStatus}" TextWrapping="Wrap" IsVisible="{Binding SelectedIsDisplay}" />
        <Panel IsVisible="{Binding SelectedIsDisplay}">
          <TextBlock Classes="hint tip"
                     Text="With it, a hardware card renders and Windows flips this window straight to its display while it covers the display alone — the compositor's frame of latency and its jitter go. The swap chain behind it is process-wide and chosen at start: tick, save, restart Patterns. A start that fails to reach the desk with it is held off next time and the line above says so; untick and tick to try again." />
        </Panel>

        <TextBlock Classes="label" Text="Orientation" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding Rotations}"
                  SelectedValue="{Binding SelectedRotation, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
        <TextBlock Classes="hint tip"
                   Text="For displays mounted in portrait or upside down: content is rendered upright and rotated at output. The overview above shows the rotated shape." />

        <TextBlock Classes="label" Text="Frame rate" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding ScreenFpsOptions}"
                  SelectedValue="{Binding SelectedFpsOverride, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:FpsOption}" />

        <TextBlock Classes="label" Text="Display mode (Windows)" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="*,8,Auto,8,Auto,8,Auto">
          <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding DisplayModeOptions}"
                    SelectedItem="{Binding SelectedDisplayModeLabel, Mode=TwoWay}" PlaceholderText="Modes this display offers…" />
          <Button Grid.Column="2" Classes="chip" Content="Apply" Command="{Binding ApplyDisplayModeCommand}"
                  ToolTip.Tip="Switch the display to this size and refresh rate — the same change as Windows' Display settings" />
          <Button Grid.Column="4" Classes="chip" Content="KEEP" Command="{Binding KeepDisplayModeCommand}" IsVisible="{Binding DisplayModePending}" />
          <Button Grid.Column="6" Classes="chip" Content="REVERT" Command="{Binding RevertDisplayModeCommand}" IsVisible="{Binding DisplayModePending}" />
        </Grid>
        <TextBlock Classes="hint" Text="{Binding DisplayModeStatus}" TextWrapping="Wrap" />
        <TextBlock Classes="hint tip"
                   Text="Lists the modes the display's own EDID offers and applies one through Windows, so a 1080p50 wall or a 4K projector gets the signal it expects. A change waits for KEEP and reverts by itself in 15 s if the picture is lost; everything programmed for the screen — placement, pattern, canvases, senders, looks — follows it across the change. Close the outputs first." />

        <TextBlock Classes="label" Text="Output trims" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="86,*,44" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="label" Text="Brightness" VerticalAlignment="Center" />
          <Slider Grid.Row="0" Grid.Column="1" Minimum="10" Maximum="150" TickFrequency="5"
                  Value="{Binding SelectedBrightness, Mode=TwoWay}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedBrightness, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="1" Classes="label" Text="Gamma" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="0.4" Maximum="2.5" TickFrequency="0.05"
                  Value="{Binding SelectedGamma, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedGamma, StringFormat={}{0:0.00}}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Red" VerticalAlignment="Center" />
          <Slider Grid.Row="2" Grid.Column="1" Minimum="25" Maximum="175" TickFrequency="5"
                  Value="{Binding SelectedTrimR, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedTrimR, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Green" VerticalAlignment="Center" />
          <Slider Grid.Row="3" Grid.Column="1" Minimum="25" Maximum="175" TickFrequency="5"
                  Value="{Binding SelectedTrimG, Mode=TwoWay}" />
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedTrimG, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="4" Classes="label" Text="Blue" VerticalAlignment="Center" />
          <Slider Grid.Row="4" Grid.Column="1" Minimum="25" Maximum="175" TickFrequency="5"
                  Value="{Binding SelectedTrimB, Mode=TwoWay}" />
          <TextBlock Grid.Row="4" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedTrimB, StringFormat={}{0:0}%}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Content="Reset trims" Command="{Binding ResetTrimsCommand}" />
        </StackPanel>
        <TextBlock Classes="hint tip"
                   Text="Per-screen brightness / gamma / RGB balance for matching mismatched house displays. Applies to this output only — NDI and other screens are untouched." />

        <TextBlock Classes="label" Text="Corner warp (keystone) — px offsets" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="76,*,6,*,12,76,*,6,*" RowDefinitions="Auto,4,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Top-left" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpTlx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpTly, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
          <TextBlock Grid.Row="0" Grid.Column="5" Classes="label" Text="Top-right" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="6" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpTrx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="0" Grid.Column="8" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpTry, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Bottom-left" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpBlx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpBly, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
          <TextBlock Grid.Row="2" Grid.Column="5" Classes="label" Text="Bottom-right" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="6" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpBrx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="2" Grid.Column="8" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedPlacement.WarpBry, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Content="Reset warp" Command="{Binding ResetWarpCommand}" />
        </StackPanel>
        <TextBlock Classes="hint tip"
                   Text="Pulls each corner of this output by the given pixels — a light keystone for casually placed projectors, not a full warp engine. Positive X moves right, positive Y moves down." />

        <TextBlock Classes="label" Text="Edge blend (projectors)" Margin="0,8,0,0" />
        <CheckBox Content="Automatic — fade the edges this screen overlaps with a neighbour"
                  IsChecked="{Binding SelectedBlendAuto, Mode=TwoWay}" />
        <TextBlock Classes="hint" Text="{Binding BlendReadback}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="76,*,12,76,*" RowDefinitions="Auto,4,Auto" IsEnabled="{Binding !SelectedBlendAuto}">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Left px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="4096" Increment="8" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedBlendLeft, Mode=TwoWay, Converter={StaticResource Num}}" />
          <TextBlock Grid.Row="0" Grid.Column="3" Classes="label" Text="Right px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="4" Minimum="0" Maximum="4096" Increment="8" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedBlendRight, Mode=TwoWay, Converter={StaticResource Num}}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Top px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="4096" Increment="8" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedBlendTop, Mode=TwoWay, Converter={StaticResource Num}}" />
          <TextBlock Grid.Row="2" Grid.Column="3" Classes="label" Text="Bottom px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="4" Minimum="0" Maximum="4096" Increment="8" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedBlendBottom, Mode=TwoWay, Converter={StaticResource Num}}" />
        </Grid>
        <Grid ColumnDefinitions="86,*,44" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
          <TextBlock Grid.Row="0" Classes="label" Text="Curve" VerticalAlignment="Center" />
          <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding BlendCurves}"
                    SelectedValue="{Binding SelectedBlendCurve, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
          <TextBlock Grid.Row="1" Classes="label" Text="Blend gamma" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="3" TickFrequency="0.05"
                  Value="{Binding SelectedBlendGamma, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding SelectedBlendGamma, StringFormat={}{0:0.00}}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Content="Reset blend" Command="{Binding ResetBlendCommand}" />
        </StackPanel>
        <TextBlock Classes="hint tip"
                   Text="Projectors that overlap on the wall — two, a row of three or four, a stack, a 2×2 grid: tick Automatic on every one, drag each over its neighbour by the overlap, and the overlaps become one joined canvas they all draw, each fading every shared edge to black so the light adds up to one picture; a middle projector fades both sides, a grid's projector a side and a top or bottom, and where two zones meet in a corner the fades multiply, which is what four projectors sharing a corner need. The lines above audit each join of the selected screen — the neighbour must fade the facing edge by the same width with the same curve — so a rig is checked join by join before doors. Put the Projection blend pattern's grey check on the canvas and turn the gamma until the overlaps read as flat as the rest. Only this output fades; NDI, monitors and the preview never do." />

        <TextBlock Classes="label" Text="Wall gaps — bezels, the air between LED pillars" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="86,*,12,86,*" IsVisible="{Binding SelectedIsInCanvas}" Margin="0,2,0,4">
          <TextBlock Grid.Column="0" Classes="label" Text="Bezel H px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="4096" Increment="2" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedSeamGapX, Mode=TwoWay, Converter={StaticResource Num}}"
                         ToolTip.Tip="Bezel compensation for this joined canvas: the dead width between two of its displays side by side — both bezels and any air — in pixels" />
          <TextBlock Grid.Column="3" Classes="label" Text="Bezel V px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="4" Minimum="0" Maximum="4096" Increment="2" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding SelectedSeamGapY, Mode=TwoWay, Converter={StaticResource Num}}"
                         ToolTip.Tip="The dead height between two displays of this canvas one above the other, in pixels" />
        </Grid>
        <ItemsControl ItemsSource="{Binding SelectedGaps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:WallGap">
              <Grid ColumnDefinitions="*,6,Auto,6,Auto,6,Auto" Margin="0,2">
                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).GapAxes}"
                          SelectedValue="{Binding Axis, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
                <NumericUpDown Grid.Column="2" Width="96" Minimum="1" Maximum="16384" Increment="8" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding At, Mode=TwoWay, Converter={StaticResource Num}}"
                               ToolTip.Tip="The first raster pixel after the gap: a vertical gap's x, a horizontal gap's y" />
                <NumericUpDown Grid.Column="4" Width="96" Minimum="1" Maximum="16384" Increment="8" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding Size, Mode=TwoWay, Converter={StaticResource Num}}"
                               ToolTip.Tip="How wide the gap is, in the wall's own pixels (the physical gap measured in pixel pitches)" />
                <Button Grid.Column="6" Classes="mini" Content="✕" ToolTip.Tip="Remove this gap"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveGapCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
          <Button Classes="chip" Content="+ Gap" Command="{Binding AddGapCommand}" ToolTip.Tip="A vertical gap in the middle of the raster, to move and size" />
          <TextBlock Classes="label" Text="Grid" VerticalAlignment="Center" Margin="6,0,0,0" />
          <NumericUpDown Width="72" Minimum="1" Maximum="64" Increment="1" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding GapGridColumns, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="Columns of panels packed in this raster" />
          <TextBlock Classes="label" Text="×" VerticalAlignment="Center" />
          <NumericUpDown Width="72" Minimum="1" Maximum="64" Increment="1" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding GapGridRows, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="Rows of panels packed in this raster" />
          <NumericUpDown Width="84" Minimum="1" Maximum="4096" Increment="2" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding GapGridPx, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="The gap between them, in the wall's pixels" />
          <Button Classes="chip" Content="Set from grid" Command="{Binding SetGapsFromGridCommand}"
                  ToolTip.Tip="Replace the list with the seams of an even grid of panels packed in this screen's raster" />
          <Button Classes="chip" Content="Clear" Command="{Binding ClearGapsCommand}" ToolTip.Tip="No gaps: the picture is the raster again" />
        </StackPanel>
        <TextBlock Classes="hint" Text="{Binding GapSummary}" TextWrapping="Wrap" />
        <TextBlock Classes="hint tip"
                   Text="Where the wall has no pixels. For a wall of displays joined into one canvas, Bezel H / V is the dead width between neighbours (both bezels plus any air, in pixels): content is laid out as if the strips were there and each display shows its own real pixels, so a line across the wall is straight in the room. For one output whose raster packs panels that stand apart — three LED pillars side by side in a 1152-wide raster, a wall controller's four displays in one 4K — add a gap where each strip stands (before which raster pixel, and how wide, in the wall's own pixel pitch), or Set from grid for an even wall. Every pattern, video, web page, layer, overlay and lower third spans the gaps; the LED wall and video wall patterns put their tiles on the real panels when their raster matches this screen's, and draw the gaps black with GAP n px in them; the PREVIEW and PROGRAM panes, the multiview tiles and the phone's thumbnail shade the strips so you see where they are; NDI senders of this target carry the whole surface for a processor that maps the gaps itself. Processors that map the gaps in the raster themselves need no gaps here — describe the wall in the LED wall pattern's Irregular map instead." />
      </StackPanel>
    </Border>
    <TextBlock Classes="hint" IsVisible="{Binding !HasSelection}" Text="Click a screen tile to select it." />

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
      <Button Classes="chip" Content="Identify screens" Command="{Binding IdentifyCommand}" />
      <Button Classes="chip" Content="Reset layout" Command="{Binding ResetLayoutCommand}" />
    </StackPanel>
    <TextBlock Classes="hint tip"
               Text="Your main (primary) screen stays off by default when other screens are present, so OUTPUTS ON never covers the controls — tick 'Output enabled' to include it anyway." />

    <TextBlock Classes="h2" Text="TRANSITIONS" />
    <CheckBox Content="Crossfade content changes" IsChecked="{Binding State.Transition.Enabled}" />
    <Grid ColumnDefinitions="130,*,52" IsEnabled="{Binding State.Transition.Enabled}">
      <TextBlock Classes="label" Text="Fade time (ms)" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="100" Maximum="3000" TickFrequency="50"
              Value="{Binding State.Transition.DurationMs, Mode=TwoWay}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.Transition.DurationMs, StringFormat={}{0:0}}" />
    </Grid>
    <TextBlock Classes="hint tip"
               Text="Look recalls, cues, playlist advances, source changes and blackout crossfade on every screen and NDI output — synchronised across spans. A cue's look can carry its own cut or fade. Setting tweaks stay instant." />

    <TextBlock Classes="h2" Text="EDIT SAFE" />
    <CheckBox Content="Previews are sandboxed by default (EDIT SAFE on at start, re-armed after every send)"
              IsChecked="{Binding State.Switcher.EditSafeByDefault}" />
    <TextBlock Classes="hint tip"
               Text="On (recommended): the preview opens detached, so touching any editor — screens, outputs, inputs, patterns — never reaches the audience until you CUT or TAKE, and EDIT SAFE re-arms itself after each send. Things you fire still go straight to air: F-key looks, cues, stingers, the SHOW CONTROLS drawer and remote commands. Off: the preview mirrors the program and every edit is live." />

    <TextBlock Classes="h2" Text="WINDOW BEHAVIOUR" />
    <CheckBox Content="Always on top" IsChecked="{Binding State.Output.Topmost}" />
    <CheckBox Content="Hide mouse cursor on outputs" IsChecked="{Binding State.Output.HideCursor}" />

    <TextBlock Classes="h2" Text="LIVE" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="go" Content="OUTPUTS ON" Command="{Binding GoCommand}" Focusable="False" />
      <Button Classes="stop" Content="OUTPUTS OFF" Command="{Binding StopCommand}" Focusable="False" />
    </StackPanel>
    <TextBlock Classes="hint tip"
               Text="On an output window: Esc twice within a second closes outputs · Space/B blackout · I identify. Layout changes apply live while outputs run." />
  </StackPanel>
</UserControl>
