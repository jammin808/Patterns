<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:c="using:Patterns.App.Views.Controls"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.OverlaysSection"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-time" Text="Overlays" />

    <TextBlock Classes="h2" Text="TIME &amp; DATE" />
    <CheckBox Content="Show clock" IsChecked="{Binding State.Overlays.Clock.Enabled}" />
    <StackPanel IsEnabled="{Binding State.Overlays.Clock.Enabled}">
      <CheckBox Content="24-hour" IsChecked="{Binding State.Overlays.Clock.TwentyFourHour}" />
      <CheckBox Content="Seconds" IsChecked="{Binding State.Overlays.Clock.ShowSeconds}" />
      <CheckBox Content="Date" IsChecked="{Binding State.Overlays.Clock.ShowDate}" />
      <CheckBox Content="Pill background" IsChecked="{Binding State.Overlays.Clock.Pill}" />
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Text colour" />
        <c:ColorField Grid.Column="1" Value="{Binding State.Overlays.Clock.TextColor, Mode=TwoWay}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Position" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Anchors}"
                  SelectedValue="{Binding State.Overlays.Clock.Anchor, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Size (% height)" />
        <Slider Grid.Column="1" Minimum="2" Maximum="40" Value="{Binding State.Overlays.Clock.SizePct, Mode=TwoWay}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Opacity" />
        <Slider Grid.Column="1" Minimum="0.05" Maximum="1" Value="{Binding State.Overlays.Clock.Opacity, Mode=TwoWay}" />
      </Grid>
    </StackPanel>

    <TextBlock Classes="h2" Text="LOGO WATERMARK" />
    <CheckBox Content="Show logo (set the file in Branding)" IsChecked="{Binding State.Overlays.Logo.Enabled}" />
    <StackPanel IsEnabled="{Binding State.Overlays.Logo.Enabled}">
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Position" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Anchors}"
                  SelectedValue="{Binding State.Overlays.Logo.Anchor, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Height (%)" />
        <Slider Grid.Column="1" Minimum="2" Maximum="100" Value="{Binding State.Overlays.Logo.HeightPct, Mode=TwoWay}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Opacity" />
        <Slider Grid.Column="1" Minimum="0.05" Maximum="1" Value="{Binding State.Overlays.Logo.Opacity, Mode=TwoWay}" />
      </Grid>
    </StackPanel>

    <TextBlock Classes="h2" Text="MESSAGE" />
    <CheckBox Content="Show message" IsChecked="{Binding State.Overlays.Message.Enabled}" />
    <StackPanel IsEnabled="{Binding State.Overlays.Message.Enabled}">
      <TextBox Watermark="WELCOME" Text="{Binding State.Overlays.Message.Text}" />
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Text colour" />
        <c:ColorField Grid.Column="1" Value="{Binding State.Overlays.Message.TextColor, Mode=TwoWay}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Position" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Anchors}"
                  SelectedValue="{Binding State.Overlays.Message.Anchor, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Size (% height)" />
        <Slider Grid.Column="1" Minimum="2" Maximum="30" Value="{Binding State.Overlays.Message.SizePct, Mode=TwoWay}" />
      </Grid>
      <CheckBox Content="Scroll (ticker)" IsChecked="{Binding State.Overlays.Message.Scroll}" />
      <Grid ColumnDefinitions="130,*" IsEnabled="{Binding State.Overlays.Message.Scroll}">
        <TextBlock Classes="label" Text="Speed (px/s)" />
        <NumericUpDown Grid.Column="1" Minimum="10" Maximum="4000" Increment="10" FormatString="0"
                       Value="{Binding State.Overlays.Message.ScrollPxPerSec, Mode=TwoWay, Converter={StaticResource Num}}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Background" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding MessageBackgrounds}"
                  SelectedValue="{Binding State.Overlays.Message.Background, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Backdrop strength" />
        <Slider Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding State.Overlays.Message.BackgroundStrength, Mode=TwoWay}" />
      </Grid>
      <TextBlock Classes="hint tip"
                 Text="Fade is a soft band that is darkest at the edge the message sits on — the classic lower third under a ticker. A ticker loops seamlessly at any speed and text length, and every screen, span half and NDI sender shows the same train." />

      <CheckBox Content="Feed the text from a data source (RSS / CSV / calendar)"
                IsChecked="{Binding State.Overlays.Message.UseFeed}" Margin="0,6,0,0" />
      <StackPanel IsVisible="{Binding State.Overlays.Message.UseFeed}">
        <TextBox Watermark="https://…/feed.xml — or a local .csv / .ics / .txt file"
                 Text="{Binding State.Overlays.Message.FeedSource}" />
        <Grid ColumnDefinitions="130,*">
          <TextBlock Classes="label" Text="Format" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding FeedKinds}"
                    SelectedValue="{Binding State.Overlays.Message.FeedKind, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
        </Grid>
        <Grid ColumnDefinitions="130,*">
          <TextBlock Classes="label" Text="Refresh (min)" />
          <NumericUpDown Grid.Column="1" Minimum="1" Maximum="720" Increment="1" FormatString="0"
                         Value="{Binding State.Overlays.Message.FeedRefreshMinutes, Mode=TwoWay, Converter={StaticResource Num}}" />
        </Grid>
        <Grid ColumnDefinitions="130,*">
          <TextBlock Classes="label" Text="Max items" />
          <NumericUpDown Grid.Column="1" Minimum="1" Maximum="100" Increment="1" FormatString="0"
                         Value="{Binding State.Overlays.Message.FeedMaxItems, Mode=TwoWay, Converter={StaticResource Num}}" />
        </Grid>
        <Grid ColumnDefinitions="130,*">
          <TextBlock Classes="label" Text="Separator" />
          <TextBox Grid.Column="1" Text="{Binding State.Overlays.Message.FeedSeparator}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Content="Refresh now" Command="{Binding RefreshFeedCommand}" />
        </StackPanel>
        <TextBlock Classes="label" Text="{Binding FeedStatus}" TextWrapping="Wrap" />
        <TextBlock Classes="hint tip"
                   Text="RSS/Atom shows headlines; CSV/plain text shows one entry per line; an ICS calendar shows the next 24 h as 'HH:mm  Event'. Turn on Scroll for a ticker. The message text above is ignored while the feed is on." />
      </StackPanel>
    </StackPanel>

    <TextBlock Classes="h2" Text="PICTURE-IN-PICTURE (LIVE INSET)" />
    <CheckBox Content="Show a live inset over the content" IsChecked="{Binding State.Overlays.Pip.Enabled}" />
    <StackPanel IsEnabled="{Binding State.Overlays.Pip.Enabled}">
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Source" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding PipSources}"
                  SelectedValue="{Binding State.Overlays.Pip.Source, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
      </Grid>
      <Grid ColumnDefinitions="130,*,8,Auto"
            IsVisible="{Binding State.Overlays.Pip.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:PipSource.NdiFeed}}">
        <TextBlock Classes="label" Text="NDI source" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding NdiSourceOptions}"
                  SelectedItem="{Binding State.Overlays.Pip.NdiSourceName, Mode=TwoWay}"
                  PlaceholderText="NDI sources…" />
        <Button Grid.Column="3" Classes="mini" Content="Refresh" Command="{Binding RefreshNdiSourcesCommand}" />
      </Grid>
      <Grid ColumnDefinitions="130,*,8,Auto"
            IsVisible="{Binding State.Overlays.Pip.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:PipSource.Capture}}">
        <TextBlock Classes="label" Text="Device" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding CaptureDeviceOptions}"
                  SelectedItem="{Binding State.Overlays.Pip.CaptureDevice, Mode=TwoWay}"
                  PlaceholderText="Capture devices…" />
        <Button Grid.Column="3" Classes="mini" Content="Refresh" Command="{Binding RefreshCaptureDevicesCommand}" />
      </Grid>
      <Grid ColumnDefinitions="130,*"
            IsVisible="{Binding State.Overlays.Pip.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:PipSource.Capture}}">
        <TextBlock Classes="label" Text="Format" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding PipCaptureFormat.Options}"
                  SelectedItem="{Binding PipCaptureFormat.Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Position" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Anchors}"
                  SelectedValue="{Binding State.Overlays.Pip.Anchor, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Width (%)" />
        <Slider Grid.Column="1" Minimum="10" Maximum="50" Value="{Binding State.Overlays.Pip.WidthPct, Mode=TwoWay}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Opacity" />
        <Slider Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding State.Overlays.Pip.Opacity, Mode=TwoWay}" />
      </Grid>
      <CheckBox Content="Accent border" IsChecked="{Binding State.Overlays.Pip.ShowBorder}" />
      <TextBlock Classes="label" Text="Crop the feed (% cut away on each side)" Margin="0,6,0,0" />
      <Grid ColumnDefinitions="130,*,40" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Classes="label" Text="Left" VerticalAlignment="Center" />
        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding State.Overlays.Pip.CropLeftPct, Mode=TwoWay}" />
        <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding State.Overlays.Pip.CropLeftPct, StringFormat={}{0:0}%}" />
        <TextBlock Grid.Row="1" Classes="label" Text="Right" VerticalAlignment="Center" />
        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding State.Overlays.Pip.CropRightPct, Mode=TwoWay}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding State.Overlays.Pip.CropRightPct, StringFormat={}{0:0}%}" />
        <TextBlock Grid.Row="2" Classes="label" Text="Top" VerticalAlignment="Center" />
        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding State.Overlays.Pip.CropTopPct, Mode=TwoWay}" />
        <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding State.Overlays.Pip.CropTopPct, StringFormat={}{0:0}%}" />
        <TextBlock Grid.Row="3" Classes="label" Text="Bottom" VerticalAlignment="Center" />
        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding State.Overlays.Pip.CropBottomPct, Mode=TwoWay}" />
        <TextBlock Grid.Row="3" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding State.Overlays.Pip.CropBottomPct, StringFormat={}{0:0}%}" />
      </Grid>
      <TextBlock Classes="hint tip"
                 Text="A second live input (camera, remote feed) in the corner of whatever is showing — its own receiver/decoder, independent of the Media source, on every screen and NDI output. Crop away a slate, a border or a black bar from any side; the inset takes the cropped shape, never squashes. Inset audio is not played." />
    </StackPanel>

    <TextBlock Classes="h2" Text="TECH INFO CHIP" />
    <CheckBox Content="Show sink name, pattern and FPS" IsChecked="{Binding State.Overlays.Info.Enabled}" />
    <StackPanel IsEnabled="{Binding State.Overlays.Info.Enabled}">
      <CheckBox Content="Include FPS" IsChecked="{Binding State.Overlays.Info.ShowFps}" />
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Position" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Anchors}"
                  SelectedValue="{Binding State.Overlays.Info.Anchor, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
