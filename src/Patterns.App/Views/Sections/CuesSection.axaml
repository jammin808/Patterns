<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.CuesSection"
             Classes="hue-cues"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-looks" Text="Cues" />
    <TextBlock Classes="hint tip"
               Text="Two lists of the same kind. The CUE STACK is what the show caller runs, in order; the CLICKER LIST is what a speaker steps through with Page Down / Page Up (and the remote's NEXT / PREV). A cue is one or more typed actions run in order — apply a look, play audio, fire a VOG or stinger, switch a playlist part, start a countdown… Every reference is checked as you build: a cue that cannot run is marked broken with the reason, and the rest of the list still runs." />

    <Grid ColumnDefinitions="*,8,Auto,6,Auto">
      <ComboBox Grid.Column="0" ItemsSource="{Binding Cues.Stacks}" SelectedItem="{Binding Cues.SelectedStack, Mode=TwoWay}"
                DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" ToolTip.Tip="Which list to edit" />
      <Button Grid.Column="2" Classes="chip" Content="+ Cue" Command="{Binding Cues.AddCueCommand}"
              ToolTip.Tip="Add a cue after the selected one" />
      <Button Grid.Column="4" Classes="mini" Content="Renumber" Command="{Binding Cues.RenumberCommand}"
              ToolTip.Tip="01.010, 01.020, … in list order (the order never changes)" />
    </Grid>
    <TextBlock Classes="label" Text="{Binding Cues.ValidationSummary}" />

    <!-- The caller's home: a running order in and out -->
    <WrapPanel Margin="0,2,0,0">
      <Button Classes="chip" Content="IMPORT SHEET…" Command="{Binding ImportCueSheetCommand}" Margin="0,0,6,4"
              ToolTip.Tip="A CSV or Excel running order replaces this list — the columns are read by their header names (see the template)" />
      <Button Classes="mini" Content="Append sheet…" Command="{Binding ImportCueSheetAppendCommand}" Margin="0,0,6,4"
              ToolTip.Tip="The sheet's rows go after the last cue, numbering continued" />
      <Button Classes="mini" Content="Export CSV" Command="{Binding ExportCueSheetCommand}" Margin="0,0,6,4"
              ToolTip.Tip="This list as a sheet — for Excel, a printout, or a round trip" />
      <Button Classes="mini" Content="Template CSV" Command="{Binding SaveCueTemplateCommand}" Margin="0,0,6,4"
              ToolTip.Tip="The columns with example rows to copy from: Number, Name, Track, Start, Duration, Follow, Mark, Confirm, Look, Action, Target, Value, Notes" />
    </WrapPanel>
    <TextBlock Classes="label" Text="{Binding Cues.LastImportReport}" TextWrapping="Wrap"
               IsVisible="{Binding Cues.LastImportReport, Converter={StaticResource NotEmpty}}" />
    <TextBlock Classes="hint tip"
               Text="A running order from Excel or a CSV becomes the list in one go: Number, Name, Track, Start (HH:mm), Duration (mm:ss, 5 min), Follow (blank, 0 or a delay), Mark (break, lunch, end), Confirm, a Look by name, an Action with its Target and Value, and Notes — any of them, in any order, by header. Looks and targets are matched by name; an unknown one is kept and reads as broken until it exists. Export writes the same columns back." />

    <ItemsControl ItemsSource="{Binding Cues.Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CueRow">
          <Border Classes="cueRow" Classes.cueSelected="{Binding IsSelected}" Classes.cueBroken="{Binding IsBroken}"
                  Classes.cueOff="{Binding !Enabled}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                       Classes="cueDot" Classes.current="{Binding IsCurrent}" Classes.broken="{Binding IsBroken}" Classes.ready="{Binding Ready}"
                       ToolTip.Tip="Green = last run from this list · red = broken · blue = marked ready" />
              <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0,2" Cursor="Hand"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Cues.SelectCueCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Spacing="1">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Number}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Background="#20242E" CornerRadius="6" Padding="5,1" IsVisible="{Binding HasTrack}">
                      <TextBlock Text="{Binding Track}" FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="hint" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  <TextBlock Classes="hint" Foreground="{StaticResource TallyPgmBrush}" Text="{Binding Problem}" IsVisible="{Binding IsBroken}" />
                  <TextBlock Classes="hint" Foreground="{StaticResource TallyHoldBrush}" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                <ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" Margin="0,-4"
                              ToolTip.Tip="Enabled — a disabled cue is skipped" />
                <Button Classes="mini" Content="FIRE" FontWeight="Bold" Focusable="False"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Cues.FireCueCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="Run this cue's actions now (goes to air)" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint" Foreground="{StaticResource TallyHoldBrush}" Text="{Binding Cues.StackNotesText}" IsVisible="{Binding Cues.HasStackNotes}" />

    <StackPanel IsVisible="{Binding Cues.IsClickerSelected}" Spacing="4">
      <TextBlock Classes="h2" Text="CLICKER" />
      <Grid ColumnDefinitions="Auto,12,Auto,*,Auto">
        <CheckBox Grid.Column="0" Content="Clicker armed" IsChecked="{Binding ClickerArmed, Mode=TwoWay}"
                  ToolTip.Tip="While armed, Page Down / Page Up (and the arrow keys outside a text box) step this list. Always off when the app opens." />
        <CheckBox Grid.Column="2" Content="Loop at the end" IsChecked="{Binding Cues.LoopAtEnd, Mode=TwoWay}" />
        <Button Grid.Column="4" Classes="mini" Content="Reset to start" Command="{Binding PresenterResetCommand}" />
      </Grid>
      <TextBlock Classes="label" Text="{Binding PresenterStepText}" />
    </StackPanel>

    <!-- The selected cue's settings live in the pop-out column beside this page (round 19): the list keeps its room. -->
    <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding Cues.HasSelection}" Margin="0,4,0,0">
      <TextBlock Classes="hint" Text="{Binding PopOutHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="mini" Content="SETTINGS ▸" Command="{Binding OpenPopOutCommand}" IsVisible="{Binding !PopOut.IsOpen}"
              ToolTip.Tip="Open the selected cue's settings in the column beside this page" />
    </Grid>
  </StackPanel>
</UserControl>
