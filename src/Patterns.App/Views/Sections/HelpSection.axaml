<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             x:Class="Patterns.App.Views.Sections.HelpSection"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="Border.step">
      <Setter Property="Background" Value="{StaticResource PanelBg2Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="Border.step.current">
      <Setter Property="BorderBrush" Value="#2EE68A" />
    </Style>
    <Style Selector="Border.step.done">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="TextBlock.helpTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.helpBody">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.helpWire">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1" Text="Help" />
    <TextBlock Classes="hint tip"
               Text="The whole guide, in the order a show happens: START HERE, RUNNING THE SHOW, CONTENT, THE RIG, CONTROL, THE MACHINE. Search for a word, a key or a verb from the wire; pick a section; open a card for how it works, where it sits in the workflow, what to do in order, the words on the wire and the pages it lives on (GO opens one). WALKTHROUGHS are the same guide as checklists by role. ? TIPS on any page's strip lists the topics that page belongs to." />

    <Grid ColumnDefinitions="*,6,Auto,6,Auto">
      <TextBox Text="{Binding HelpQuery, Mode=TwoWay}"
               Watermark="Search help — a word, a key or a verb on the wire: stinger · F5 · SCREEN LOOK · spotify · blend · arduino…" />
      <Button Grid.Column="2" Classes="mini" Content="CLEAR" Command="{Binding ClearHelpCommand}" IsVisible="{Binding IsHelpSearching}"
              ToolTip.Tip="Back to the section" />
      <ToggleButton Grid.Column="4" Classes="mini" Content="READ ALL" IsChecked="{Binding HelpReadAll, Mode=TwoWay}"
                    ToolTip.Tip="Every card open, to read the guide through" />
    </Grid>
    <ItemsControl ItemsSource="{Binding HelpGroups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:HelpGroupChip">
          <ToggleButton Classes="mini" Margin="0,0,6,6" Content="{Binding Label}" ToolTip.Tip="{Binding Blurb}"
                        IsChecked="{Binding IsCurrent, Mode=OneWay}" Command="{Binding PickCommand}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint" Text="{Binding HelpResultText}" TextWrapping="Wrap" />
    <CheckBox Content="Show hints on the pages" IsChecked="{Binding ShowHints, Mode=TwoWay}"
              ToolTip.Tip="The explanations that sit behind ? TIPS on the page strip, inline on every page again. Remembered in the show." />

    <StackPanel IsVisible="{Binding !IsHelpSearching}">
      <TextBlock Classes="h2" Text="WALKTHROUGHS — STEP BY STEP, BY ROLE" />
      <ItemsControl ItemsSource="{Binding WalkRoles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WalkRoleChip">
            <ToggleButton Classes="mini" Margin="0,0,6,6" Content="{Binding Label}" ToolTip.Tip="{Binding Blurb}"
                          IsChecked="{Binding IsCurrent, Mode=OneWay}" Command="{Binding PickCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="hint" Text="{Binding WalkRoleBlurb}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding WalkChoices}" Margin="0,4,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WalkChoice">
            <ToggleButton Classes="mini" Margin="0,0,6,6" Content="{Binding Title}" ToolTip.Tip="{Binding Goal}"
                          IsChecked="{Binding IsCurrent, Mode=OneWay}" Command="{Binding StartCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" IsVisible="{Binding HasWalk}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding WalkTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="hint" Text="{Binding WalkGoal}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{Binding WalkWords}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Classes="chip" Content="◀ Back" Command="{Binding WalkBackCommand}" ToolTip.Tip="The step before" />
              <Button Classes="chip" Content="Done, next ▶" Command="{Binding WalkNextCommand}" ToolTip.Tip="Tick this step and move to the next" />
              <Button Classes="chip" Content="Restart" Command="{Binding WalkRestartCommand}" ToolTip.Tip="From the first step; what the show already has stays ticked" />
            </StackPanel>
          </Grid>
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding WalkFraction}" Height="6" />
          <ItemsControl ItemsSource="{Binding WalkSteps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WalkStepRow">
                <Border Classes="step" Classes.current="{Binding IsCurrent}" Classes.done="{Binding IsDone}">
                  <Grid ColumnDefinitions="26,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="label" Text="{Binding Number}" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="hint" Text="{Binding Detail}" TextWrapping="Wrap" />
                      <TextBlock Classes="label" Text="{Binding PageWords}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="chip" Content="GO" Margin="6,0,0,0" VerticalAlignment="Top"
                            Command="{Binding GoCommand}" ToolTip.Tip="Open the page this step happens on" />
                    <Button Grid.Column="3" Classes="chip" Content="{Binding TickText}" Margin="6,0,0,0" VerticalAlignment="Top"
                            Command="{Binding DoneCommand}" ToolTip.Tip="{Binding TickTip}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <TextBlock Classes="hint tip"
                 Text="Pick who you are and what you are about to do: each scenario is the steps in order, each on the page it happens on — GO opens that page, the tick button marks the step done by hand, Done, next ticks and moves on. A step the show already has (screens adopted, outputs on, looks saved, the stack armed, remote control on…) ticks itself as you do the work, so the list is a live checklist, not a leaflet. Restart clears the hand ticks; what the show has stays ticked. Nothing here changes the show." />
    </StackPanel>

    <TextBlock Classes="h2" Text="TOPICS" />
    <ItemsControl ItemsSource="{Binding HelpRows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:HelpRow">
          <!-- One topic: closed, the title and its place in the workflow; open, how it works, what to do, the wire, the pages. -->
          <Border Classes="runRow">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                <Button Classes="mini" Content="{Binding OpenText}" Command="{Binding ToggleCommand}" VerticalAlignment="Top" Width="34"
                        ToolTip.Tip="Open or close this topic" />
                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Classes="helpTitle" Text="{Binding Title}" />
                  <TextBlock Classes="hint" Text="{Binding Where}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="4" Classes="runTag" Text="{Binding GroupLabel}" VerticalAlignment="Top" />
              </Grid>
              <TextBlock Classes="hint" Foreground="{StaticResource AccentBrush}" Text="{Binding Snippet}" IsVisible="{Binding HasSnippet}" TextWrapping="Wrap" />
              <StackPanel Spacing="4" IsVisible="{Binding IsOpen}">
                <TextBlock Classes="tipHead" Text="HOW IT WORKS" />
                <TextBlock Classes="helpBody" Text="{Binding Body}" />
                <TextBlock Classes="tipHead" Text="DO THIS" IsVisible="{Binding HasSteps}" />
                <TextBlock Classes="helpBody" Text="{Binding StepsText}" IsVisible="{Binding HasSteps}" />
                <TextBlock Classes="tipHead" Text="ON THE WIRE" IsVisible="{Binding HasWire}" />
                <TextBlock Classes="helpWire" Text="{Binding Wire}" IsVisible="{Binding HasWire}" />
                <TextBlock Classes="tipHead" Text="PAGES" IsVisible="{Binding HasPages}" />
                <ItemsControl ItemsSource="{Binding Pages}" IsVisible="{Binding HasPages}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HelpPageLink">
                      <Button Classes="chip" Margin="0,0,6,6" Content="{Binding Header, StringFormat='GO · {0}'}" Command="{Binding GoCommand}"
                              ToolTip.Tip="Open this page" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
