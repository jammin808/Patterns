<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             x:Class="Patterns.App.Views.Sections.HelpSection"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="Border.step">
      <Setter Property="Background" Value="{StaticResource PanelBg2Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="Border.step.current">
      <Setter Property="BorderBrush" Value="#2EE68A" />
    </Style>
    <Style Selector="Border.step.done">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
  </UserControl.Styles>

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1" Text="Help" />
    <CheckBox Content="Show hints on the pages" IsChecked="{Binding ShowHints, Mode=TwoWay}"
              ToolTip.Tip="The explanations that sit behind ? TIPS on the page strip, inline on every page again. Remembered in the show." />

    <TextBlock Classes="h2" Text="WALKTHROUGHS — STEP BY STEP, BY ROLE" />
    <ItemsControl ItemsSource="{Binding WalkRoles}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:WalkRoleChip">
          <ToggleButton Classes="mini" Margin="0,0,6,6" Content="{Binding Label}" ToolTip.Tip="{Binding Blurb}"
                        IsChecked="{Binding IsCurrent, Mode=OneWay}" Command="{Binding PickCommand}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint" Text="{Binding WalkRoleBlurb}" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding WalkChoices}" Margin="0,4,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:WalkChoice">
          <ToggleButton Classes="mini" Margin="0,0,6,6" Content="{Binding Title}" ToolTip.Tip="{Binding Goal}"
                        IsChecked="{Binding IsCurrent, Mode=OneWay}" Command="{Binding StartCommand}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" IsVisible="{Binding HasWalk}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding WalkTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="hint" Text="{Binding WalkGoal}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" Text="{Binding WalkWords}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Classes="chip" Content="◀ Back" Command="{Binding WalkBackCommand}" ToolTip.Tip="The step before" />
            <Button Classes="chip" Content="Done, next ▶" Command="{Binding WalkNextCommand}" ToolTip.Tip="Tick this step and move to the next" />
            <Button Classes="chip" Content="Restart" Command="{Binding WalkRestartCommand}" ToolTip.Tip="From the first step; what the show already has stays ticked" />
          </StackPanel>
        </Grid>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding WalkFraction}" Height="6" />
        <ItemsControl ItemsSource="{Binding WalkSteps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WalkStepRow">
              <Border Classes="step" Classes.current="{Binding IsCurrent}" Classes.done="{Binding IsDone}">
                <Grid ColumnDefinitions="26,*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="label" Text="{Binding Number}" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="hint" Text="{Binding Detail}" TextWrapping="Wrap" />
                    <TextBlock Classes="label" Text="{Binding PageWords}" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="chip" Content="GO" Margin="6,0,0,0" VerticalAlignment="Top"
                          Command="{Binding GoCommand}" ToolTip.Tip="Open the page this step happens on" />
                  <Button Grid.Column="3" Classes="chip" Content="{Binding TickText}" Margin="6,0,0,0" VerticalAlignment="Top"
                          Command="{Binding DoneCommand}" ToolTip.Tip="{Binding TickTip}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <TextBlock Classes="hint tip"
               Text="Pick who you are and what you are about to do: each scenario is the steps in order, each on the page it happens on — GO opens that page, the tick button marks the step done by hand, Done, next ticks and moves on. A step the show already has (screens adopted, outputs on, looks saved, the stack armed, remote control on…) ticks itself as you do the work, so the list is a live checklist, not a leaflet. Restart clears the hand ticks; what the show has stays ticked. Nothing here changes the show." />

    <TextBlock Classes="h2" Text="THE SHELL" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Five groups on the rail, in the order a show happens: SHOW (the panel beside the switcher, and the Run surface) · PLAN (cues, looks and every wall-clock automation) · BUILD (pattern, media, overlays, lower thirds, countdown, particles, branding, the library) · SETUP (screens, audio, NDI, stream, remote) · ADMIN (the machine, this help). The strip across the top lists the current group's pages; each group remembers the page you were on. ? TIPS on the strip opens this page's explanations under their headings — every page keeps its own — with a tick to show them inline again (the tick above does the same; the show remembers it). The desk resizes: drag the divider between the page and the screens, drag the handle between PROGRAM and PREVIEW, or press ◧ WIDE on the strip to reduce the screens to a strip on the right — the layout travels with the show. SHOW CONTROLS under the wall: message, clock, countdown and the audio track's volume, each behind SEND — straight to air, sandbox open or not, journaled, and replaced by the next look recall." />

    <TextBlock Classes="h2" Text="PREP · SHOW · RUN" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Two different things in the header. MODE — PREP or SHOW — is about what may leave the machine, and it is saved in the show file. PREP is pre-programming: every editor, the switcher, looks, cues and the clicker work exactly as in SHOW, but the output windows are refused (and closed as you enter), every NDI send stops and the stream is held — the audience sees nothing, on a cable or on the network; planned screens stand in for the rig and are adopted onto the real displays at the venue. SHOW is the venue: OUTPUTS ON opens the windows, the sends run, the stream starts when it is armed. Sound is never held by the mode — the audio track, VOGs, stingers and break music play in both, so a rehearsal at the desk can be heard. LAYOUT — RUN — is the caller's surface over either mode: the LIVE strip, the wall, the cue stack and GO take the window (POP OUT for a second monitor, /run on a tablet); Enter is GO, ↑ ↓ move standby, Esc twice is STOP ALL. It changes nothing about what goes out; leaving it is refused while the stack is armed, and switching PREP · SHOW leaves it first." />

    <TextBlock Classes="h2" Text="KEYS" />
    <TextBlock TextWrapping="Wrap" LineHeight="22" xml:space="preserve">F1–F12   apply saved looks (Looks page)
⇧F5   OUTPUTS ON — open the output windows
⇧F6   OUTPUTS OFF — close them (on an output window: Esc twice within a second)
⇧F7   IDENTIFY — flash screen numbers
⇧F8 / Space   BLACKOUT toggle
Page Down / Page Up   clicker list next / back (armed on the Cues page or the Show panel)
Enter (RUN, armed)    GO on the cue stack · ↑ ↓ move standby · Esc cancels a confirm, Esc twice = STOP ALL
On outputs:  Esc ×2 close · Space/B blackout · I identify · F1–F12 looks · PgDn/PgUp presenter
Every key acts once per press — holding a key down never repeats it.</TextBlock>

    <TextBlock Classes="h2" Text="BEFORE THE SHOW (PREP MODE)" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="PREP in the header (or on the Screens page): build the whole rig at your desk with nothing plugged in. 'Plan a screen' adds a screen at the size the venue will have — arrange it, name it, give it its own pattern, put it in a canvas, use it in the multiview — and outputs stay held closed so nothing can go live by accident. Live inputs can be typed in by name (Media page) before the camera or NDI sender exists. At the venue, switch to SHOW, pick which detected display each planned screen turned out to be and press Adopt: position, label, rotation, trims, warp, per-screen pattern, canvas name, multiview tiles and the stream source all follow onto the real display, so the desk work is never redone." />

    <TextBlock Classes="h2" Text="MANY INPUTS AT ONCE" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Every live source runs on its own: give screen 1 a camera, screen 2 an NDI feed from the graphics PC and screen 3 a walk-in video, all at the same time. Pick the screen in the strip, then choose its source in the Media page. The same feed used in several places (two screens, the PiP inset and a multiview tile) costs one decode, not four. Multiview tiles can name their own NDI source or capture device, so a monitor wall can show four different inputs. The Media page lists what is mounted right now, and warns if the rig asks for more simultaneous sources than the limit (4 decoders, 6 NDI receivers)." />

    <TextBlock Classes="h2" Text="WORKFLOW" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="1) SETUP › Screens — drag tiles together to span them into one canvas, click a tile to enable/disable it, rotate it for portrait mounting, trim its brightness/colour, nudge its corners (warp) for a keystoned projector, or give it its own pattern.  2) BUILD — choose and tune a pattern, or grab one from the Library (sections for patterns, your images, videos and audio, particles, presets and brand kits, and a search box); the Particles page files its scenes in packs — Classic, Awards, Modern, Nature, Moods, Starcloth, Night sky, Feel-good — with your own saved scenes under Custom; the Fractal pattern (Pattern page) is a living picture from maths that can breathe with this computer's sound or an input.  3) OUTPUTS ON.  4) PLAN › Looks — save the state as a look and put it on an F-key or the daily schedule; PLAN › Cues — build the cue stack and the clicker list.  5) SHOW — run the evening from the panel, or RUN for the caller's surface.  Everything updates live while outputs run — including LED wall geometry, blend overlap, countdowns and branding." />

    <TextBlock Classes="h2" Text="FRAME RATE, DISPLAY MODES &amp; CAPTURE FORMATS" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Screens page: the master frame rate paces every output on one clock — a 30 fps show on 60 Hz displays draws every other refresh, evenly, so spans and NDI stay in step — with a per-screen override for a display that must run at its own rate; an NDI sender set to 'master' sends at it, the stream can follow it, and the Machine page judges dropped frames against it. Unlimited (the default) draws at each display's refresh. Display mode (selected screen): the sizes and refresh rates the display's EDID offers; Apply switches it through Windows while outputs are off, KEEP within 15 seconds makes it stick or it reverts by itself, and everything programmed for that screen follows it across the change. Direct output (selected screen): bypasses the desktop compositor — Windows flips the window straight to its display while a hardware card renders and the window covers the display alone, so the compositor's frame of latency and its jitter go; the swap chain behind it is chosen at start, so tick, save and restart, and the line under the tick says what is in force. A start that fails with it is held off next time; untick and tick to try again. Format (Media and PiP capture blocks): the sizes and rates the capture card's driver advertises — pick the one the source sends so the card opens in that mode; 'Device default' leaves it to the driver." />

    <TextBlock Classes="h2" Text="REMOTE CONTROL" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Switch it on on the Remote page (SETUP), then open the shown address on any phone or tablet on this network for the web remote — one page with a menu across SHOW, CUES, LOOKS, SCREENS, AUDIO, LOWER THIRDS and SETUP, a header that names what is on air with its chips and a connection dot, thumb-sized buttons, and a page that changes the moment the show does; the tab you were on is remembered. Stream Decks: load the Bitfocus Companion module from integrations/companion-module-patterns (presets for transport, looks, screens, groups, presenter, stingers and audio, with live feedback) — or use Companion's Generic TCP with the one-line commands in docs/REMOTE.md. There is no password: anyone on the network can drive the show while remote control is on." />

    <TextBlock Classes="h2" Text="THE SWITCHER (PROGRAM / PREVIEW)" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="The right side works like a vision mixer. PROGRAM (top) is always what the audience sees. PREVIEW (bottom) is where you build — and it is sandboxed from the moment the app opens, so touching any editor never reaches the screens. The wall between them has a tile for every content target — PGM, every joined canvas and every stand-alone screen — with a PGM and a PVW miniature (true pictures at the target's own shape) and a tally dot: red = the audience sees it, amber = held through the next send, grey = not on air. Click a tile and the big panes take its shape and show it (and the editors work on it when it has its own pattern). OWN gives the target its own pattern instead of the program — a joined canvas can hold content of its own; MON draws the miniatures (off saves GPU on a big rig); ARM means the next CUT / TAKE changes it — un-armed, it keeps the picture the audience is seeing, and ARM ALL brings everything back; the switch turns that output on/off live. Build the next look with any editor, then CUT (instant) or TAKE (crossfade) to every armed target, or SEND TO TICKED tiles as their own pattern; EDIT SAFE re-arms itself after each send, so you are always building in safety. What you FIRE still goes straight to air: F-key looks, the ON AIR button on a look, scheduled cues, presenter steps, stingers and every remote command — only what you are editing is held back. Use → PVW on a look to load it into the preview instead. Blackout and OUTPUTS ON/OFF stay live through the freeze. Turn the default off in Admin → Switcher if you'd rather the preview mirrored the program." />

    <TextBlock Classes="h2" Text="PERMANENT INSTALLS: THE CLOCK RUNS THE SITE" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where it sits in the workflow: a shop window, a hotel lobby, a museum wall, a reception screen — a machine nobody sits at that must show the right thing at the right time for months, take an advert or an announcement in its stride, be looked after from somewhere else and take a new build without a visit. PLAN → Install is its home. Build the looks first (Looks page), then the rota: + PROGRAMME is a look from a start to an end on its days (blank = every day; Mon–Fri, weekends, Sat Sun) between its dates (a seasonal row beats the daily one; a window past midnight is allowed); + ADVERT is a look for some seconds at its start and every so many minutes until its end — on every screen, or only the screens it names, the others keeping their picture; + ANNOUNCEMENT is words on the message overlay, a VOG from the Audio page, a look of its own, for some seconds — by the clock or by hand. TODAY shows the day as the clock will run it and says in words what a row cannot do. Tick Schedule on: the programme's look lands at once and every change goes through the same action layer as the desk, so the journal reads ApplyLook from schedule; outside every programme the idle look or black. Announcements beat adverts; a firing while the caller's stack is armed or a stinger holds the screens is skipped and said. By hand from anywhere: PLAY NOW on a row, ANNOUNCE Closing time or ANNOUNCE some words and ADVERT Offer on the wire (ANNOUNCE OFF / ADVERT OFF end them), a cue's Announcement on / Advert — play now, /patterns/announce over OSC, Companion 2.2.0's announce and advert keys, the phone's ADMIN page. Remote administration: type an admin passcode and the web remote gains an ADMIN page (health, the schedule, every announcement and advert as a key, RESTART, the staged update, a support bundle to download, the log, a console) — the same passcode rides RESTART and UPDATE APPLY on the wire; SUPPORT BUNDLE writes a zip with the logs, the journal, the settings with every secret blanked and the last super-check to send with a question. A management server: type its check-in URL (https, or http on the LAN) and a token, and the site posts its name, build, health and STATE every few minutes, running the reply's commands and staging the update it offers. Updates: drop patterns-update-&lt;version&gt;.zip (Patterns.exe and patterns.update.json at its root) into the updates folder beside the settings, press APPLY (or let the update window do it at a quiet hour): the watchdog swaps the files between two starts with the old ones kept in a backup folder, brings the show back live, and rolls back by itself if the new build does not stay up for two minutes. docs/INSTALLS.md carries every rule and the check-in contract." />

    <TextBlock Classes="h2" Text="THE INTERACTIVE AREA: ARDUINO, RASPBERRY PI AND DEVICES OVER IP" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where it sits in the workflow: a physical GO button for the caller, a lamp on the lectern that says the deck is live, a relay that fires with a look, a sensor that changes the message — the room wired to the show. SETUP → Interactive is the page: switch the area on (off by default; a port opens only when you say so), + ARDUINO (SERIAL) or + DEVICE OVER IP, a name, the port (the page lists this machine's serial ports) or the address, the baud or the IP port, the line ending the device expects. The device speaks short text lines and Patterns turns each one into a show command through the same action layer as the desk, the cues, the phone and Companion: a trigger row maps the device's line (BTN1, whole and case-blind; SENSOR * as a prefix) to a protocol line (CUE GO, NEXT, LOOK Walk-in, BLACKOUT ON, MESSAGE Room at * with the sensor's value carried through), and a line with no row runs as the protocol it already is when you allow it. Every command is fenced like any other — a GO from a button is refused while the stack is not armed — and the answer, OK or ERR and the reason, goes back to the device; the journal reads 'from device Arduino'. Patterns speaks back too: KEY VALUE lines only when a value changes — BLACKOUT 1, LIVE 1, LOOK Walk-in, PROGRAM …, CUE 01.020, ARMED 1, HOLD 0, DECK 3 12, STEP 2 5 — everything once when a device connects and again with RESEND ALL, so a sketch follows the show in a few lines. Sending a line of your own: the SEND box on the card (a handshake to try the wiring), a cue's Device — send a line (target the device, value the text — the checks refuse an unknown device and warn while the area is off), DEVICE Arduino RELAY 1 on the wire, /patterns/device/Arduino over OSC, Companion 2.1.0's device_send. The wires look after themselves: a serial port that vanishes reopens when it is back, a TCP link reconnects every two seconds, UDP needs no connection; the card reads open, reconnecting or closed and why, with the last line in and out, so a wiring fault shows before doors. docs/ARDUINO.md carries the sketch (two buttons, two LEDs), a Raspberry Pi script and the whole vocabulary both ways." />

    <TextBlock Classes="h2" Text="COMPANION 2.0 AND OSC: KEYS THAT FILL THEMSELVES FROM THE SHOW" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where it sits in the workflow: the Stream Deck at front of house should be ready the moment the show is — and stay right as looks are added, renamed and reordered in the last hour. Companion cannot place keys on a page by itself, so Patterns and its module (2.0.0, integrations/companion-module-patterns) do the next best thing: banks. Drag a row of Look bank keys once and each key reads its name from a variable Patterns keeps fresh in every STATE push ($(patterns:look_3) is the third look on the Looks page), fires the look at that place (LOOK #3 on the wire — the third look whatever its name or F-key), turns green while that look is on air and amber while it is loaded in the preview, and dims while nothing sits behind it; save a look and the next dim key lights with its name, delete one and its key dims. The same banks exist for the F-keys, lower thirds, people, VOGs and stingers, break music, playlist parts, screens (with a lock key each, green while enabled, amber while locked) and the cue stack — the Cue bank's first key is the standby cue and the six after it the cues that follow, each relabelling on every GO, a press putting that cue on standby (or standby and GO). The module also builds a preset per item — Looks — this show, People — this show, Upcoming cues — this show and the rest — rebuilt the moment the show's lists change, so a key with a fixed name is one drag away. What comes back: every key's light comes from the STATE Patterns pushes (airLook, previewLook, pattern, the looks by place with their F-key, on-air and in-preview flags, the screens with armed and own, the deck's page, the web page's service) — the feedbacks look_on_air, look_bank_on_air, look_f_on_air, look_preview, screen_armed, screen_own and slot_empty, the variables air_look, preview_look, pattern and the banks. OSC gets the same facts as messages to the feedback host — /patterns/state/looks/3 &quot;Walk-in&quot; and /looks/3/air 1, /lowerthirds/n, /people/n, /stingers/n, /sections/n, /music/items/n, /screen/n/name, /cue/next/k, /deck/page, /deck/count, /deck/ended, /web/page, /web/service, /look/air, /look/preview, /pattern — and /patterns/look/index/3 applies a look by place, so a TouchOSC page or a lighting desk labels itself the same way (Remote page → OSC). Everything a key does still goes through the one action layer: the same checks, the same journal line with the key's name, the same ERR sentence back." />

    <TextBlock Classes="h2" Text="EDGE BLEND BEYOND TWO PROJECTORS: ROWS, GRIDS, CORNERS, THE AUDIT" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where it sits in the workflow: a wide stage gets three or four projectors in a row, a tall one a stack, a big surface a 2×2 grid, and the question is always whether the blends stay independent and still add up. They do. Every output fades its own edges from its own overlaps on the Screens page: a middle projector fades both sides, a grid's projector a side and a top or bottom, each by exactly the overlap it shares with that neighbour (unequal overlaps stay on their own joins), with its own curve, its own gamma (projectors differ) and, when Automatic is off, its own typed widths. Where two zones cross in a corner the fades multiply — which is what four projectors sharing a corner need, since (left + right) × (top + bottom) is one — so the corner reads as flat as the rest. Setting it up: tick Automatic on every projector, drag each over its neighbour by the overlap (the overlaps join them into one canvas that all of them draw), select each projector in turn and read the lines under Edge blend: ✓ Left join with P1: 320 px, both fade, SCurve is a join that is right; ⚠ names what is wrong and what to do — an overlap nobody fades (twice as bright), a join fading on one side only (tick Automatic on the other), widths that differ (use the overlap on both), curves that differ (use the same curve), or zones too wide to leave a picture between them. Then put the Projection blend pattern on the canvas — Projectors along, Rows across for a grid, the real overlaps both ways — and its P1…Pn frames, hatched zones with OVERLAP n px and opposing ramps land on the wall; the 50% grey check shows every join and every corner, and each projector's Blend gamma is turned until its joins read flat. Only the outputs fade: the PREVIEW pane, the multiview, NDI sends and the stream show the canvas whole. Limits, honestly: the blend is a soft edge, not a full warp engine (the corner nudges handle a light keystone), and black levels in the overlaps depend on the projectors' native black — a projector with lifted blacks shows the zones on a black picture, which no software can remove." />

    <TextBlock Classes="h2" Text="POWERPOINT DECKS THROUGH LIBREOFFICE IMPRESS" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where it sits in the workflow: a speaker hands over a .pptx an hour before doors and nobody wants to open PowerPoint on the show machine. Choose the file as the Deck (Media page → Deck → Browse…; .pptx, .ppt, .ppsx, .pptm, a Keynote .key or an Impress .odp) and Patterns converts it to a PDF with LibreOffice Impress in the background — headless, with a profile of its own, so a LibreOffice or PowerPoint window open on the machine is neither used nor disturbed — and keeps the PDF under decks/ beside the show, named for the file's size and last write: an unchanged deck never converts twice (a look recalls it at once, even after a restart) and an edited one converts again by itself; RELOAD forces it. While it converts the card reads Converting… (the readout under the file box, the phone's deck line and STATE's converting flag say the same; the click-through steps the clicker list meanwhile) and the moment the pages arrive the deck is a PDF deck like any other: full frame at the slides' shape, sharp on every output, the click-through, the cue stack resuming at the end. Where LibreOffice comes from: install it free from libreoffice.org (the default folder is found), put a LibreOfficePortable folder beside Patterns on the show drive, or type the path to soffice.exe (or its folder) in the box that appears when it is nowhere — kept in Admin, found without a restart. Without it the card says so and what to do, and exporting the deck as PDF from PowerPoint is always the fallback. Known limits, honestly: a slide becomes a page, so animations, builds and transitions inside the PowerPoint are not kept (a build that reveals bullets becomes its final state; split it into slides if the reveal matters), embedded video does not play (put the clip on a layer or a stinger), and a font the machine lacks is substituted — check the pages on the PREVIEW pane once before the show. A 300-page deck with pictures converts in well under a minute; a conversion that takes over three minutes is stopped and the card says so." />

    <TextBlock Classes="h2" Text="PDF DECKS: FULL FRAME, THE CLICK-THROUGH, THE CUE STACK RESUMES" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where it sits in the workflow: most presentations arrive as a PDF — exported from PowerPoint, Keynote or Slides — and a show wants them on screen exactly as designed, driven by the presenter's clicker, and handed back to the cue stack when they end. A deck is a Media pattern (Media page → Deck): choose the PDF, and the page on show is a picture like any other — full frame at its own shape (a 4:3 deck gets bars on a 16:9 screen, never a stretch; Fill or the area of interest change that when you want), rendered as sharp as the largest screen needs on every output, NDI send and the stream, and carried by looks and cues. The pages either side are rendered ahead, so a turn is instant. The click-through: once the deck is on air — through a cue, a look, or by hand — the presenter's clicker (Page Down / Page Up, the arrows outside a text box), NEXT / BACK on the phone, Companion's presenter keys and NEXT on the wire turn its pages first, before they step a clicker list, and a list need not be armed at all. At the last page the next click GOes the caller's standby cue — the cue stack resumes, so the caller programmes 'deck on' as one cue and 'what comes after' as the next, arms the stack with the second on standby and lets the presenter click to the end; the PREVIEW header and the phone say when that click is coming, and Companion's DECK key turns amber. Untick 'At the last page, the next click GOes…' for a deck that should hold its last page instead. Start at page sets where a look or a cue lands. Turning pages from the desk: the DECK block's First / Previous / NEXT PAGE / Last, a cue (Deck — next page, previous page, go to page: a number, first or last), DECK NEXT / PREV / FIRST / LAST / PAGE n on the wire, /patterns/deck/… over OSC, and Companion 1.11.0's deck keys; STATE carries deck{file,page,count,ended}. The same deck on two screens is one deck on one page, and the preview shows the page on air. PDFs join the Library as decks, so a tile puts one on the pattern; a PowerPoint file itself goes through LibreOffice Impress — the section above." />

    <TextBlock Classes="h2" Text="WEB PAGES: YOUTUBE, GOOGLE SLIDES, POWERPOINT, KEYS, CLICKS AND CUES" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where it sits in the workflow: a web page is a picture like any other — the pattern (Media → Web page, or SHOW THIS PAGE ON THE PATTERN on the Remote &amp; web page) or a layer over one (LAYERS → Web page) — so it fits the canvas, joins spans and trims, reaches NDI and the stream, crossfades, sits under the overlays and the lower third and travels with looks and cues; nothing ever opens outside Patterns, and a link that wants a new window opens in the same page. The page renders through WebView2, the browser engine Windows 10 and 11 ship, in a window of its own that no screen shows, and every click, drag, wheel step and key the desk sends reaches it the way a browser automation session sends them — as real, trusted events, whichever window has the focus — so links, players, sliders and frames from other sites all answer. Driving it: click, drag and scroll on the PREVIEW pane (Alt-press drags a web layer's box instead); PAGE CONTROLS on the Media page type into the field you last clicked and carry the page's own buttons — on YouTube PLAY / PAUSE, MUTE, RESTART, +10 s and −10 s through the player itself; on Google Slides and PowerPoint for the web NEXT, PREVIOUS, FIRST, LAST, PRESENT, BLACK, WHITE and EXIT; on any page the arrows, the page keys, Enter and Escape. KEYS → PAGE (the chip on the PREVIEW pane's header and under PAGE CONTROLS, or Ctrl+Alt+K) hands the page the whole keyboard — F5 starts a PowerPoint, the arrows move a deck, a search box takes typing, a sign-in takes a password — and the desk's own shortcuts wait until the chip or Ctrl+Alt+K gives them back. The services: paste a YouTube, Vimeo or Google Slides link and the Media page names the service and offers FULL FRAME, which rewrites the address so the show sees the player or the deck alone — YouTube with autoplay and no controls or related videos, a published Slides deck as its embed with the control bar hidden, your own deck in present mode — and SHOW THIS PAGE ON THE PATTERN does that by itself; a video whose owner blocks embedding keeps its watch link and the area of interest cuts the furniture. PowerPoint for the web and a Slides deck of your own need a sign-in once — KEYS → PAGE, type, and the account stays signed in on this machine. Cues: 'Web page — key or action' with the page left blank reaches the page on air with next, prev, first, last, present, exit, play, pause, mute, restart, black, white or a key chord (ArrowRight, Space, k, Ctrl+Shift+F5), so a caller's sheet reads 'page: present' on the cue that starts the deck and 'page: next' on every slide; a page named by its nickname or a word of its address reaches that page instead; 'Web page — click' clicks a spot in percent, 'type' types, 'reload' reloads, and the checks refuse a key nobody knows or a page that will not be on air. The same on the wire (WEB NEXT, WEB KEY ArrowRight, WEB CLICK 50 50, WEB TYPE …, WEB RELOAD, WEB OPEN address, PAGE as an alias), over OSC (/patterns/web/next …), on the phone's SHOW tab (PAGE ON AIR with the service's buttons) and in Companion 1.10.0 (a Web page category, a page-on-air feedback, the page's name, title and service as variables). Set the page size (the viewport it lays itself out for) and the zoom on the Media page; 'Show the pointer' draws the desk's pointer and a click ripple on the page wherever it is shown, so the room sees what you point at — off for a page nobody drives. The same address on several targets costs one browser; four pages run at once." />

    <TextBlock Classes="h2" Text="THE AREA OF INTEREST: CROP, MIRROR AND TURN ANY INPUT" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where it sits in the workflow: a live input rarely arrives clean — a Teams caller comes with the gallery strip and the toolbar, a Google Slides window with its tab bar, a shared screen with a taskbar, a camera on a capture card the wrong way up — and the audience should see the picture, not the furniture around it. The area of interest is the part of an input the show uses: it is cut from the source before the picture is fitted to the target, so what is left fills the screen at its own shape on every output, every NDI send and the stream, and it is saved with the pattern, so a look or a cue that recalls the input recalls the crop. Media page → AREA OF INTEREST: press PICK ON PREVIEW and drag a box on the PREVIEW pane around what should be seen; the box is the picture the moment you let go, and the summary line says what is kept (Keeps 50% × 50% of the picture, from 25% in, 25% down). Pick again to refine: a second box is a box within the picture as it shows now, so you can close in twice. The presets take what usually needs taking — Top bar off (8%), Side panel off (25% from the right: a participants or chat panel), Bottom strip off (12%: a toolbar or notes), Centre 80% — and the four sliders cut up to 90% from any side while never keeping less than a twentieth; Clear brings the whole picture back. Mirror and Upside down flip the picture, Turn stands it at 90°, 180° or 270° for a portrait feed or a camera mounted on its side; the flips happen first, the turn after. It works on every source — a still, a video, an NDI feed, a capture card, a web page and each playlist item — through the source's own crop where it has one, so a 4K feed cropped to a quarter costs no more than the quarter. A web page keeps its clicks through the crop while it is upright (the desk maps a click on the PREVIEW pane back to the page through the box); a turned or mirrored page shows no pointer and takes no clicks — crop it, do not turn it, when you need to drive it. The PiP inset has its own four crop sliders on the PiP block for the same reason." />

    <TextBlock Classes="h2" Text="THE MULTIVIEW'S TALLY: PROGRAM, THE NEXT TAKE, AND WHICH SCREEN" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where it sits in the workflow: the multiview is the monitor wall the show caller and the director watch — a screen of its own (the Pattern page's Multiview pattern on any display), an NDI send of it, or /multiview in a browser — and a monitor wall has to say more than what a picture looks like: it has to say what state each screen is in. So every tile wears badges along its top edge. PGM with a red border while the target is live to the audience (the outputs open, the screen switched on, no blackout); OFF when the screen is switched off, OUTPUTS OFF when the outputs are closed, BLACK during a blackout, FROZEN in cyan while FREEZE holds the outputs. With EDIT SAFE open — when there is a preview and a TAKE to come — NEXT in green means the next TAKE changes this target and HELD in amber means the wall un-armed it, so the caller can see at a glance where the next picture lands before pressing TAKE. LOCKED means the screen keeps its picture through looks, cues and TAKE ALL; OWN means it shows a picture of its own rather than the program; REP n means it repeats screen n. The Preview tile is green-bordered PVW (NO PREVIEW while EDIT SAFE is off). Under each tile a two-part bar: the name on the left and what it is on the right — SCREEN 2 · 1920×1080, CANVAS A · 3840×1080 · 2 SCREENS, NDI SEND 4 · 1920×1080, STREAM, PLANNED SCREEN, with CONF / INFO / REP for a screen with a role — so a tile is never a mystery picture; the PROGRAM tile's bar lists the screens the program is on (ON 1 · 2 · A) and the PREVIEW tile's the screens the next TAKE reaches (NEXT TAKE → A). The tally checkbox on the Pattern page switches the borders and badges off together; the captions stay. The same facts reach the remotes: STATE carries editSafe and each screen's armed and own, OSC feedback sends /patterns/state/editsafe and /armed/n, and the phone's SCREENS tab reads NEXT / HELD / OWN beside each screen." />

    <TextBlock Classes="h2" Text="LOWER THIRDS: PREVIEW, SIGN-OFF, AIR, UPDATE, THE SHOW'S DEFAULT" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where it sits in the workflow: a lower third rides over whatever picture is on — a look, a cue, a clip — on every screen, NDI send and the stream at once, so it is programmed beside the picture, not inside it. The flow on the Lower thirds page: build a design (or pick the show's style once and ★ it as the default), put a person in from the LIBRARY, press PVW — the design shows on the PREVIEW pane, on the multiview's Preview tile and, with REVIEW on, full-frame on the multiview, where a show caller or director reads the spelling and signs it off while the audience sees nothing new — then TAKE TO AIR: it arrives the way it was designed to and the preview clears for the next name. AIR skips the sign-off and puts the design on straight away, as it is at that moment. HIDE takes it off the way it was designed to. The preview needs EDIT SAFE (with it off, the preview is the air, and PVW says so). What EDIT SAFE means for a design on air: the audience sees a copy, and the desk edits the show's own — so a change made while a design is on air lights EDITED on the page, the Show panel, the phone and a Stream Deck key, and UPDATE ON AIR carries it across in place, the words too, without the design leaving and arriving again (AIR again restarts it instead). A picture TAKE keeps whatever lower third is on air exactly where it is in its life and takes one that is in the preview to air with it; switching EDIT SAFE off keeps it too. The ★ default: once a style is chosen it usually serves the whole show, so PERSON n, the PEOPLE chips, the phone's PEOPLE buttons and a cue that names a person but no design put the next name into the design on air — or, with none on air, the ★ one. The first design of a show is the default until another is starred; a deleted default moves to the first design left. Cues: Lower third on / to preview / take / off — a caller's sheet can read 'lt preview: Jane' a minute before and 'lt take' on the cue. The wire and OSC: LT n, LT n WITH person, LT PREVIEW n [WITH person], LT PREVIEW WITH person, LT TAKE, LT UPDATE, LT PREVIEW OFF, LT OFF, PERSON n; STATE carries lowerThird, lowerThirdPreview, lowerThirdDefault and lowerThirdEdited, and Companion 1.9.0 has the keys (LT PVW n, PVW PERSON n, LT TAKE lit amber while something is in the preview, LT UPDATE lit while the air copy is behind). The phone's LOWER THIRDS tab has PVW FIRST, so its chips go to the preview instead of air, a TAKE TO AIR button while something is in the preview, and UPDATE ON AIR while the air copy is behind." />

    <TextBlock Classes="h2" Text="FREEZE, THE TIMED FADE, THE PREVIOUS LOOK, EARLIER VERSIONS" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Show panel → FREEZE · FADE · LOOK BACK. FREEZE holds the frame every output shows — the windows, the NDI sends, the stream — until you press again, while the desk, the preview and the monitors keep moving: a wall processor's freeze on the whole rig, for the moment something behind the picture has to change. A blackout still takes a frozen output, and the fade that runs when the freeze lifts starts from the frame the room was seeing. FADE TO BLACK and FADE UP are a blackout with a fade of the seconds you type beside them, whatever the transition setting says. LOOK BACK puts the look that was on air before the current one back on air; pressing it again swaps the two. On the wire: FREEZE ON / OFF / TOGGLE, FADE 2, FADE UP 2 (or FADEUP 2), LOOKBACK; /patterns/freeze, /patterns/fade 2, /patterns/fade/up 2, /patterns/lookback over OSC; the phone remote's SHOW and LOOKS tabs and Companion's FREEZE, FADE and PREVIOUS LOOK keys. None of it is saved in the show. Machine page → Earlier versions of the show: every save keeps the previous file, and the first save that changes something after five quiet minutes keeps the file as it was, twenty deep; RESTORE puts a version back exactly as Load show would. docs/PRO-FEATURES.md is the study behind these: what the big rigs do, what Patterns already does, what was worth building now and what would cost the stability." />

    <TextBlock Classes="h2" Text="BEZELS AND GAPS: THE WALL THE CONTENT SPANS" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Where a wall has no pixels — the bezels between the displays of a video wall, the air between LED pillars — the content should be laid out as if the pixels were there, so a line across the wall is straight in the room and a thing that moves across a gap goes behind it. Screens page → select the screen → Wall gaps: for a canvas of joined displays, Bezel H / V is the dead width between neighbours in pixels (measure the bezel and the air in millimetres, divide by the pixel pitch); for one output whose raster packs panels that stand apart (three LED pillars in one 1152-wide raster, a wall controller's four displays in one 4K), add a gap where each strip stands — before which raster pixel, how wide — or Set from grid for an even wall. Every pattern, video, web page, layer, overlay and lower third spans the gaps and the output leaves them out; the LED wall and video wall patterns put their tiles on the real panels when their raster matches the screen's and draw the gaps black with GAP n px in them (the video wall adds a ring and two diagonals across the wall: round and straight when the compensation is right, stepped when not); the PGM and PVW panes, the multiview tiles and the phone's thumbnail shade the strips; NDI senders of the target carry the whole surface for a processor that maps the gaps itself. A processor that maps the gaps in its own raster needs none of this — describe that wall with the LED wall pattern's Irregular map." />

    <TextBlock Classes="h2" Text="REVIEW ON THE MULTIVIEW" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="A multiview tile can show the Preview — what the desk is building in EDIT SAFE, beside the program (Pattern page → Multiview tiles; a slate while EDIT SAFE is off). REVIEW (the Show panel, the Pattern page's multiview block, the phone remote's SHOW tab, REVIEW ON / OFF / TOGGLE on the wire, /patterns/review over OSC, Companion's REVIEW key) puts the preview over every multiview full-frame with a REVIEW · PREVIEW chip — a screen's own multiview pattern, an NDI send of it, /multiview on the web remote — until you switch it off, so the next look is checked on the monitor wall before the TAKE. The audience's screens never change with it, and it is never saved with the show." />

    <TextBlock Classes="h2" Text="THE WATCHDOG, AND A BEACON FOR A SECOND MACHINE" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="What the watchdog sees: a crash, and a desk that stops answering for 30 seconds — it restarts the app with the show put back, backs off, and gives up on a crash loop. What it cannot see, the Machine page's advice now says: outputs open but drawing nothing for 30 s while moving content is up (the render path stuck while the desk still answers — OUTPUTS OFF and ON, then RESTART APP), and a stream that switched itself off after an encoder error. A supervisor that gives up leaves a note the next start puts on the health line, so a silent log is never the only record. The beacon (Machine page): tick Send on the main machine and it sends one small UDP datagram a second — who it is, what is on air, the cue on standby, the health line — to the backup's address or the whole network; tick Listen on the backup and its health line and super-check say Main machine seen 1 s ago: live · …, MAIN MACHINE SILENT for 6 s — take over? when the main goes quiet, or its watchdog gave up when the supervisor sent its last word. Taking over — OUTPUTS ON on the backup, the switcher to it — stays your call: two machines each deciding to be the main is the one failure worse than one being down. The beacon carries no control and nothing else leaves the machine." />

    <TextBlock Classes="h2" Text="OSC IN AND OUT" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Remote page, OSC: tick OSC in and Patterns listens on UDP port 9698 while remote control is on — QLab's network cues, TouchOSC, a lighting desk with OSC out, Companion's OSC. Every address starts /patterns/ and means exactly the TCP line it maps to (/patterns/look 3, /patterns/blackout 1, /patterns/screen/2 0, /patterns/cue/go, /patterns/lowerthird Neon &quot;Jane Doe&quot;, /patterns/person 2 …): a number or a name rides as the next address segment or as the first argument, a switch is 1/0, a float above 0.5, a bool or on/off/toggle, a fader's 0.0–1.0 float is a music level, and the journal reads the sender's address. A refused command answers /patterns/error to the sender with the same sentence the TCP port writes; /patterns/ping answers /patterns/pong. Feedback to names a host: every change sends one bundle of /patterns/state/… messages there — live, blackout, the program, the cue on standby and the next, the lower third and its person, each screen's switch and lock, the music — so a fader page or a tally reads the show. The full list is in docs/REMOTE.md and under the OSC block on the Remote page." />

    <TextBlock Classes="h2" Text="THE LOWER-THIRDS LIBRARY: PEOPLE READY TO GO" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Lower thirds page, LIBRARY: every person (or line of information) the show will name — a name, a role, a company (empty = the brand kit's), a photo and a note for you — kept apart from the designs, so one design serves the whole speaker list. IMPORT LIST reads a CSV or the first sheet of an Excel file by header (Name, or First name and Last name; Role; Company; Photo; Note — Template CSV shows the columns); Append updates a name that is already there instead of doubling it; Export CSV writes the library back. USE puts a person into the selected design — the Name, Role and Company elements read the fields, the photo lands in the picture element named Photo (else the first picture) — and SHOW does that and puts it on air. From a cue: Lower third on, pick the design and the person (blank = as designed); the checks refuse a person who is not in the library, so a wrong name never reaches the screen. The Show panel's PEOPLE chips, the phone remote's PEOPLE buttons, PERSON n and LT design WITH person on the wire and the Companion module's PERSON keys put the person into the design on air (else the last shown, else the first) and show it again — the next speaker in one press." />

    <TextBlock Classes="h2" Text="THE CALLER'S HOME: A RUNNING ORDER, THE CLOCK, AUTO-FOLLOW" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Cues page: IMPORT SHEET reads a CSV or the first sheet of an Excel file into the list in one go — Number, Name, Track, Start (HH:mm), Duration (mm:ss, 5 min), Follow, Mark (break, lunch, end), Confirm, a Look by name, an Action with its Target and Value, Notes — any of them, by header name, in any order; Template CSV gives you the columns with rows to copy, Export CSV writes the list back the same way. Each cue carries a planned start and length, a mark and a follow (Running order row), and gets its look in one pick and an action in one press (Quick row). Run surface: the LIVE strip says ON TIME, 3 MIN LATE or 2 MIN EARLY from the last GO against its planned start; the line above the list says when the next break, lunch and the end are expected (≥ when a cue has overrun or has no length); every row shows its planned and expected start; −1 MIN / +1 MIN move every planned start from the standby cue on, RESUME NOW plans the standby cue for now and moves the rest with it, CATCH UP squeezes the planned lengths before the next mark in proportion (never under 30 s) until the lateness is made up. A cue with a Follow fires the next one by itself when the delay is up — through the same GO gate, so HOLD, moving standby or disarming stops it, and STOP FOLLOW on the standby card does too." />

    <TextBlock Classes="h2" Text="LAYERS &amp; DRAGGING" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Every target's pattern carries two layers (Media page, LAYERS): a still, a clip, an NDI feed, a capture device or another screen's picture, each in a box you place as a share of the canvas, with a fit (Fill crops to cover, Fit letterboxes), a crop from all four sides, rounded corners, a border and an opacity. They draw over the pattern and under the overlays and the lower third, on every span, NDI send and the stream, and they belong to the pattern — so a look, a cue and a TAKE carry them. Anything you see on the PREVIEW pane that can move, you can drag: a layer, the logo, the clock, the countdown, the message and the PiP inset all follow the pointer (the one on top wins where they overlap; a ticker moves up and down only); an empty layer shows a dashed box so it can be placed before its picture exists, and dragging never starts a crossfade — a new picture does. With EDIT SAFE on the drag lands in the preview until you CUT or TAKE; off, it goes straight to air. The Nudge X / Y sliders beside each overlay's Position read the same numbers. On the Lower thirds page, click an element on the stage to select it and drag it to move it." />

    <TextBlock Classes="h2" Text="SCREEN ROLES, LOCKS &amp; REPEATERS" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Not every screen is for the audience. On the Screens page give a screen a role — Main, Confidence (a stage monitor), Info (a foyer screen) or Repeater — and it says what the screen is for: CONF and INFO screens are locked as you choose them, so a look, a cue, a clicker step, TAKE ALL or a stinger changes the main screens and leaves them alone; a locked screen keeps exactly the picture it had, as its own pattern, until you SEND the preview to its tile, OWN and edit it, or unlock it. LOCK on every wall tile is the same switch (the tile reads amber, held, while a send is being built), and a cue (Screen lock / unlock), the remote (LOCK n ON / OFF) and Companion can flip it mid-show — 'from cue 12 the comfort monitor stops following'. Mirror of makes a screen a repeater of another screen or a joined canvas: it draws that target's picture wherever the picture goes, has none of its own, and the tile says what it repeats. SEND on a tile puts the preview on that one target alone — every other target stays as it was — beside the tick and SEND TO TICKED for several at once." />

    <TextBlock Classes="h2" Text="SHOW PARTS, MULTIVIEW &amp; STREAMING" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Playlist parts (Media page; their daily start times also sit on the Looks page): split the playlist into named parts of the show; click ▶ to put one on air, give parts daily start times, or switch with SECTION n from the remote. Multiview (Pattern page → type Multiview): a monitor wall of program/screens/inputs/clock with labels and red on-air tally — each tile at its target's real shape and with the wall's own name for it, so a joined canvas is one wide tile and a screen inside one shows its own half — assign it to any screen or NDI sender, and watch it remotely at the web-remote address + /multiview. Stream page: send one screen to up to two RTMP/SRT/UDP destinations with a single encode (full build, Windows); it never auto-starts, and stream keys live in your settings file, so treat saved shows as sensitive." />

    <TextBlock Classes="h2" Text="BREAK MUSIC (SPOTIFY)" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Break music (Audio page): your Spotify playlists, albums and songs as one-press buttons for the room between the show's own content — walk-in, the interval, the wrap. Patterns drives Spotify rather than decoding it (Spotify's DRM does not allow that): the sound comes out of the Spotify app on the desk machine or any Spotify Connect device, and Patterns tells it what to play, how loud and when to stop, reading back what is on. Needs Spotify Premium and your own free Client ID from the Spotify developer dashboard, with the three 127.0.0.1 redirect addresses the Audio page lists registered on that app; CONNECT signs in through your browser and the sign-in is kept in patterns.spotify.json beside the settings — never inside a show file. It ducks under a sound stinger like the music track, STOP ALL pauses it, and it is a cue action (play, pause, skip, level), a MUSIC remote verb and a Companion key. BROWSE SONGS lists what is inside one of your playlists or a pasted playlist, album or artist link, and Search Spotify finds songs, albums, playlists and artists — add any of them as a button. A look can start one of those buttons, or pause the music, as it goes on air (the Music picker on the Looks page); loading a look into the preview leaves the music alone. Browsing and searching work on any account; starting playback is Premium-only, by Spotify's rule. Switching the feature off is not a stop — pause first — and closing Patterns leaves the music playing on purpose." />

    <TextBlock Classes="h2" Text="LOWER THIRDS" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Lower thirds page (BUILD): a design is a box of elements — text that says a name, a role, a company, the date, the time or your own words; bars; a picture; the brand logo; a clip or still; particles; a fractal — each with a fill or gradient, corners, a border, a shadow, a glow and a chaser, and each with its own way in and out (pick a motion chip, or edit the keys: offset, opacity, scale, rotation, a wipe, with an ease). Start from one of ten presets, fill in the fields, scrub or play the preview, and SHOW: it goes on air over whatever is showing, on every screen, NDI send and the stream at once, on the same frame of the master clock, and reacts to effect stings like the full-screen studio. HIDE (or its own hold) takes it off the way it was designed to. Fire from the Show panel, a cue (Lower third on / off), the phone remote and Companion (LT n, LT OFF); a look saved while one is on carries it. Designs live in the show file; Save as a file writes one to the lowerthirds folder to carry to another show." />

    <TextBlock Classes="h2" Text="VOG, STINGERS &amp; STAYING UP" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="VOG and stingers (Audio page): one-press sounds and clips. A VOG (voice of God) plays over everything — the music ducks, a stinger that is playing ducks too and carries on, the content carries on, and a clip hands the screens back when it ends. A STINGER is a transition hit — the music fades out fast, the picture dissolves into the clip, and when it lands the show does what you chose: back to what was on, hold for your take, GO the next cue through the caller's gate, or a look or cue you picked; anything that cannot run puts the show back. STOP ALL always puts a held stinger back and never runs its ending. An effect sting (+ Add effect pulse on the Audio page) is a stinger with no file: a shape that runs through the particles and fractals on screen for the length you set and settles back by itself — the four pulses (an explosion, a rush, a flash, a bloom: a rise and a settle) or a scored sting that changes the picture's settings in phases (a shockwave, a vortex, a strobe, a supernova, a freeze, a gust, a rainbow, a quake). It owns nothing and changes no music, so it fires alone, over a clip, or in a cue beside a look. The tally: whatever is playing lights its row on the Audio page and its chip on the Show panel — the seconds on air, HOLDING for a held frame, a bar running down a sting — and the look in use lights on the Looks page and the Show panel: red PROGRAM for the picture on air (PROGRAM · EDITED once it has been changed since), green PREVIEW for the look loaded into the sandboxed preview. A stopped sound or clip fades out over the stop fade (Audio page) rather than cutting, and can never be heard again under the next one. One clock: the pictures, every fade and duck, and every audio output run on the show's master clock — each output device is measured against it and pulled into line (MASTER CLOCK &amp; SYNC on the Audio page shows each output's clock, the correction and the lag; untick the lock and they free-run, measured), so two outputs never drift apart over a long set. Lip-sync: a device row's delay holds that output back (IMAG, a far speaker), Video sound delay moves every clip's soundtrack against its picture, the Stream page's audio delay rides inside the encode. SYNC CHECK flashes every screen, NDI picture and the stream white every two seconds and clicks the computer output at the same instant — count the gap at the far end and set the delay. Live DUCK (D, the SHOW CONTROLS drawer, the phone, Companion, a cue): everything but a VOG drops to the Audio page's live-duck level so someone can speak from the room, and stays down until you lift it — STOP ALL leaves it. Fire either from the Show panel, a cue, the phone remote (VOG / STING keys refuse the other kind) or a Stream Deck. Watchdog (Machine page): the app runs supervised — after a crash or a 30-second UI freeze it restarts itself with the same settings and puts live outputs (and the audio track) back. A clean close never auto-restores. The health line on the Show panel counts uptime, watchdog restarts and contained render faults." />

    <TextBlock Classes="h2" Text="MACHINE (PERFORMANCE &amp; GPU)" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="The Machine page (ADMIN) watches the machine while you watch the show. RUN SUPER-CHECK checks everything at once — the computer, the graphics cards and which one renders, every display with its mode, the outputs and their frame rate, NDI, the stream, audio, the remote, video playback and the advice, each with a green, amber or red light — says what level of show the hardware is good for, and saves the report beside the exe (Copy report pastes it into an email); the Machine and Help pages widen the desk while they are open. Below it: live CPU/memory/GPU/frame-rate with three-minute history charts, plain-language suggestions when something needs attention (on battery, memory climbing, frames dropping, disk filling), a computer overview with one-click support info, and a Restart app button that brings the show straight back. A rolling patterns.metrics.csv (30-second samples) records the night for after-show reading. Graphics card: Patterns detects and uses the best GPU by default and registers the choice with Windows (so video decode follows); pick Power saving, a specific adapter, or Let Windows decide — changes apply after a restart." />

    <TextBlock Classes="h2" Text="PORTABLE FILES" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Settings, presets, brand kits and the log live beside Patterns.exe — copy the folder and everything travels with it. Show files (.patshow.json) capture the whole setup for a gig." />

    <TextBlock Classes="h2" Text="EXTRAS" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="NDI: install the free NDI runtime (ndi.video) or drop Processing.NDI.Lib.x64.dll beside the exe — then send as many outputs as you need (8-bit BGRX or 10-bit P216) and receive any NDI feed as a media source. Every send owns a screen of its own on the rig (Screens page: FEED SCREENS; the wall): the send shows the program, a mirror of any screen or joined canvas at that target's shape, or its own screen with a look of its own. The stream (Stream page) gets the same — a display is captured off the desktop, its own screen or a canvas is rendered by the engine into the same encode. Video/audio and HDMI/SDI capture devices: the 'full' download bundles libVLC; the lean exe uses an installed 64-bit VLC or a 'libvlc' folder beside it. Web pages open on any screen via installed Edge or Chrome. All optional — the app runs without them." />
  </StackPanel>
</UserControl>
