<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             x:Class="Patterns.App.Views.Sections.LibrarySection"
             x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="Auto,*" Margin="4,8,4,4">
    <StackPanel Grid.Row="0">
      <TextBlock Classes="h1" Text="Library" />
      <TextBlock Classes="hint" Margin="0,0,0,8"
                 Text="Everything you can put on a screen with one click: factory patterns, your images, videos and audio, saved presets, particle scenes and brand kits — applied to the current editing target. Pick a section, or type to search." />
      <Grid ColumnDefinitions="*,12,260" Margin="0,0,0,6">
        <ListBox Grid.Column="0" Name="LibrarySections" ItemsSource="{Binding LibrarySections}"
                 SelectedItem="{Binding SelectedLibrarySection, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Padding="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" FontWeight="SemiBold" Padding="4,0" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBox Grid.Column="2" Name="LibrarySearch" Text="{Binding LibrarySearch, Mode=TwoWay}"
                 Watermark="Search — a name, a kind, a section" VerticalAlignment="Top" />
      </Grid>
      <TextBlock Classes="label" Text="{Binding LibrarySummary}" Margin="0,0,0,6" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Library}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PresetItem">
            <Button Margin="0,0,8,8" Padding="0" CornerRadius="8" Background="{StaticResource PanelBg2Brush}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ApplyPresetCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
              <StackPanel Width="128">
                <Border CornerRadius="8,8,0,0" ClipToBounds="True" Height="72" Background="#0A0A0E">
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Margin="8,6,8,8">
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Category}" Classes="hint" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="mini" Content="✕" Padding="4,0" IsVisible="{Binding CanRemove}"
                            ToolTip.Tip="Take this file out of the library (the file itself stays)"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveLibraryItemCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
