<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:svc="using:Patterns.Core.Services"
             xmlns:app="using:Patterns.App.Services"
             x:Class="Patterns.App.Views.Sections.NodesSection"
             Classes="hue-nodes"
             x:DataType="vm:INodesPage">
  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-nodes" Text="Nodes" />
    <TextBlock Classes="hint tip"
               Text="Every other Patterns on this network, as the beacon tells it: a desk, a caller node (a show caller's own Patterns — the Show pages alone, cues planned at home, in step with the desk at the venue), an arcade, a stage timer. A node is the same build run as a separate process — Patterns.exe --node caller — with its own folder, window and crash domain; it never opens an output." />

    <TextBlock Classes="h2" Text="THIS PROCESS" />
    <TextBlock Classes="label" Text="{Binding NodesIdentity}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="{Binding NodesLinkWords}" TextWrapping="Wrap" />
    <CheckBox Content="Accept caller nodes (sends and hears the beacon, listens for callers on the twin's port with this desk's key)"
              IsChecked="{Binding State.Twin.AcceptCallers}" IsVisible="{Binding IsDesk}"
              ToolTip.Tip="A caller joins with this desk's twin key (Machine page, TWIN — a desk with no key is given one), follows the show and calls it, sends its cues back, and never holds an output. Off: no caller can link, and the beacon stays as the Machine page sets it" />
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCallerNode}">
      <Button Classes="mini" Content="OFFER PLAN" Command="{Binding OfferPlanCommand}" ToolTip.Tip="The cues as they stand here, to the desk's Nodes page — APPLY there lands them" />
      <Button Classes="mini" Content="UNLINK" Command="{Binding UnlinkNodeCommand}" ToolTip.Tip="Leave the desk: plan on, with the show as it stands here" />
      <TextBlock Classes="label" Text="{Binding PlanWords}" VerticalAlignment="Center" />
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Plans}" IsVisible="{Binding IsDesk}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="app:TwinService+PlanOffer">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" BorderBrush="#35E0D0" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding Caller, StringFormat='A plan from the caller {0}'}" />
                <TextBlock Classes="label" Text="{Binding Count}" />
                <TextBlock Classes="label" Text="{Binding Words}" TextWrapping="Wrap" />
                <TextBlock Classes="label" Foreground="#FFD070" Text="WAITS — the stack is armed; it lands on DISARM" IsVisible="{Binding Queued}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="chip" Content="Apply" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !Queued}"
                      Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).ApplyPlanCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="The plan's stacks onto this show — the show as it was is kept under EARLIER VERSIONS first. While the stack is armed it waits, and lands on DISARM" />
              <Button Grid.Column="2" Classes="mini" Content="✕" Margin="8,0,0,0" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).DismissPlanCommand}" CommandParameter="{Binding}" ToolTip.Tip="Set the plan aside" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="h2" Text="ON THE NETWORK" />
    <TextBlock Classes="hint" Text="{Binding NodesLine}" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Nodes}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="svc:NodeCard">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" BorderBrush="{Binding Hue}" BorderThickness="1"
                  ToolTip.Tip="The card wears its kind's colour — the same one its key wears on a Stream Deck — and goes dark red once the node stops being heard">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding KindLabel}" Foreground="{Binding Hue}" />
                <TextBlock Classes="label" Text="{Binding Line}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="chip" Content="Link" Margin="8,0,0,0" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).LinkNodeCommand}" CommandParameter="{Binding}"
                      IsVisible="{Binding $parent[UserControl].((vm:INodesPage)DataContext).IsCallerNode}"
                      ToolTip.Tip="This caller follows that desk: its show lands here, every edit as it lands, and GO from here goes there" />
              <Button Grid.Column="2" Classes="chip" Content="Open pages" Margin="8,0,0,0" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).OpenNodePagesCommand}" CommandParameter="{Binding}"
                      IsVisible="{Binding PagesUrl, Converter={StaticResource NotEmpty}}"
                      ToolTip.Tip="Its phone remote, caller's page, stage timer — in the browser" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- Round 87: the show network (Show Bus 1.1) — the other show apps, and the link to a Stagewatch. -->
    <TextBlock Classes="h2" Text="THE SHOW NETWORK" />
    <TextBlock Classes="hint" Text="{Binding ShowBusLine}" TextWrapping="Wrap" />
    <!-- Round 89: the pairing token crossed the network unencrypted from another machine — said in words, amber, until NEW TOKEN. -->
    <TextBlock Text="{Binding TokenClearWords, StringFormat='△ {0}'}" Foreground="#FFB020" TextWrapping="Wrap" Margin="0,2,0,0"
               IsVisible="{Binding TokenClearWords, Converter={StaticResource NotEmpty}}"
               ToolTip.Tip="A remote on that machine sent this desk's pairing token unencrypted — the web remote over plain http://, an older Companion module (before 3.18.0, or 3.18.0 when the desk's NONCE came late), or another app's plain header. Anyone on that network may hold it now. NEW TOKEN on the Remote page (TRUST) rotates it; pair those remotes again over https:// or by proof" />
    <ItemsControl ItemsSource="{Binding ShowApps}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="svc:ShowAppCard">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" BorderBrush="{Binding Hue}" BorderThickness="1"
                  ToolTip.Tip="Another show app heard on UDP 9928 — teal Stagewatch, violet AGMessage, sky a Slides agent; amber once quiet, while its show is stuck or this desk's key is not taken, or while two machines say its id (both named on the card, and no new link to it until they stop taking turns for a minute); dark red once gone">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Foreground="{Binding Hue}">
                <Run Text="{Binding KindLabel}" />
                <Run Text=" " />
                <Run Text="{Binding Name}" />
              </TextBlock>
              <TextBlock Classes="label" Text="{Binding Line}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <CheckBox Content="Link to a Stagewatch — its timer on the stage pages, its things on the Eye, its context in the assistant's brief"
              IsChecked="{Binding State.Control.Stagewatch.Enabled}"
              ToolTip.Tip="Off by default. With no address the desk follows the first Stagewatch it hears on the show network. One room, one timer: the stage pages show the Stagewatch's time while it answers" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0" IsVisible="{Binding State.Control.Stagewatch.Enabled}">
      <TextBlock Classes="label" Text="Address" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding State.Control.Stagewatch.Host}" Watermark="host:port — empty finds one on the show network"
               ToolTip.Tip="A Stagewatch's address and web port (9924 when left out). Empty: the first Stagewatch heard on UDP 9928" />
      <TextBlock Grid.Row="1" Classes="label" Text="Key" VerticalAlignment="Center" Margin="0,6,8,0" />
      <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding State.Control.Stagewatch.ApiKey}" PasswordChar="•" Watermark="swk_… — a node key made on the Stagewatch (a read key follows the timer only; the approval queue needs node)"
               ToolTip.Tip="Made in Stagewatch: Settings → Remote → API keys. Sent in the Authorization header, never in a URL; masked in every bundle, never mirrored to a twin" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPendingCertificate}" Margin="0,4,0,0">
      <TextBlock Text="CERTIFICATE CHANGED — the Stagewatch now shows another certificate; the link refuses it until you accept" Foreground="#FFB020" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
      <Button Content="ACCEPT" Command="{Binding AcceptCertificateCommand}"
              ToolTip.Tip="Round 88: only when you know why it changed (the Stagewatch was reinstalled, its certificate renewed). Compare the fingerprint on its Settings → Remote first" />
    </StackPanel>
    <CheckBox Content="The stage timer follows the Stagewatch (one room, one timer)" IsChecked="{Binding State.Control.Stagewatch.FollowStage}"
              IsVisible="{Binding State.Control.Stagewatch.Enabled}"
              ToolTip.Tip="The stage and timer pages show the Stagewatch's time and colours while it answers; quiet, the time is held back; gone, this desk's own countdown runs. Pause and add-time are the Stagewatch's then" />

    <TextBlock Classes="hint tip"
               Text="How the pieces find each other: every Patterns sends a beacon once a second (UDP, port 9700 by default) and hears the others'; a node always does, a desk does while it accepts callers. A caller node presses LINK on the desk it follows and joins with that desk's twin key; the desk's Nodes page counts it under LINKED and its Machine page's TWIN line names it. NODES on the wire lists every card as JSON. The other show apps (Stagewatch, AGMessage, Slides agents) say hello on UDP 9928 every two seconds — who they are and where their doors are, never what the show is (docs/SHOWBUS.md)." />
  </StackPanel>
</UserControl>
