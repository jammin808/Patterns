<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:svc="using:Patterns.Core.Services"
             xmlns:app="using:Patterns.App.Services"
             xmlns:ctl="using:Patterns.App.Views.Controls"
             x:Class="Patterns.App.Views.Sections.NodesSection"
             Classes="hue-nodes"
             x:DataType="vm:INodesPage">
  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-nodes" Text="Nodes" />
    <TextBlock Classes="hint tip"
               Text="Every other Patterns on this network, as the beacon tells it: a desk, a caller node (a show caller's own Patterns — the Show pages alone, cues planned at home, in step with the desk at the venue), an arcade, a stage timer. A node is the same build run as a separate process — Patterns.exe --node caller — with its own folder, window and crash domain; it never opens an output." />

    <TextBlock Classes="h2" Text="THIS PROCESS" />
    <TextBlock Classes="label" Text="{Binding NodesIdentity}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="{Binding NodesLinkWords}" TextWrapping="Wrap" />
    <CheckBox Content="Accept caller nodes (sends and hears the beacon, listens for callers on the twin's port with this desk's key)"
              IsChecked="{Binding State.Twin.AcceptCallers}" IsVisible="{Binding IsDesk}"
              ToolTip.Tip="A caller joins with this desk's twin key (Machine page, TWIN — a desk with no key is given one), follows the show and calls it, sends its cues back, and never holds an output. Off: no caller can link, and the beacon stays as the Machine page sets it" />
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCallerNode}">
      <Button Classes="mini" Content="OFFER PLAN" Command="{Binding OfferPlanCommand}" ToolTip.Tip="The cues as they stand here, to the desk's Nodes page — APPLY there lands them" />
      <Button Classes="mini" Content="UNLINK" Command="{Binding UnlinkNodeCommand}" ToolTip.Tip="Leave the desk: plan on, with the show as it stands here" />
      <TextBlock Classes="label" Text="{Binding PlanWords}" VerticalAlignment="Center" />
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Plans}" IsVisible="{Binding IsDesk}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="app:TwinService+PlanOffer">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" BorderBrush="#35E0D0" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding Caller, StringFormat='A plan from the caller {0}'}" />
                <TextBlock Classes="label" Text="{Binding Count}" />
                <TextBlock Classes="label" Text="{Binding Words}" TextWrapping="Wrap" />
                <TextBlock Classes="label" Foreground="#FFD070" Text="WAITS — the stack is armed; it lands on DISARM" IsVisible="{Binding Queued}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="chip" Content="Apply" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !Queued}"
                      Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).ApplyPlanCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="The plan's stacks onto this show — the show as it was is kept under EARLIER VERSIONS first. While the stack is armed it waits, and lands on DISARM" />
              <Button Grid.Column="2" Classes="mini" Content="✕" Margin="8,0,0,0" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).DismissPlanCommand}" CommandParameter="{Binding}" ToolTip.Tip="Set the plan aside" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="h2" Text="ON THE NETWORK" />
    <TextBlock Classes="hint" Text="{Binding NodesLine}" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Nodes}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="svc:NodeCard">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" BorderBrush="{Binding Hue}" BorderThickness="1"
                  ToolTip.Tip="The card wears its kind's colour — the same one its key wears on a Stream Deck — and goes dark red once the node stops being heard">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding KindLabel}" Foreground="{Binding Hue}" />
                <TextBlock Classes="label" Text="{Binding Line}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="chip" Content="Link" Margin="8,0,0,0" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).LinkNodeCommand}" CommandParameter="{Binding}"
                      IsVisible="{Binding $parent[UserControl].((vm:INodesPage)DataContext).IsCallerNode}"
                      ToolTip.Tip="This caller follows that desk: its show lands here, every edit as it lands, and GO from here goes there" />
              <Button Grid.Column="2" Classes="chip" Content="Open pages" Margin="8,0,0,0" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).OpenNodePagesCommand}" CommandParameter="{Binding}"
                      IsVisible="{Binding PagesUrl, Converter={StaticResource NotEmpty}}"
                      ToolTip.Tip="Its phone remote, caller's page, stage timer — in the browser" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- Round 87: the show network (Show Bus 1.1) — the other show apps, and the link to a Stagewatch. -->
    <TextBlock Classes="h2" Text="THE SHOW NETWORK" />
    <TextBlock Classes="hint" Text="{Binding ShowBusLine}" TextWrapping="Wrap" />
    <!-- Round 96 (Show Bus 1.3 §12): the windows Stagewatch grants this desk — where each is shown, as the air says, and whether it is ready. -->
    <TextBlock Classes="hint" Text="{Binding StagewatchWindowsWords}" TextWrapping="Wrap" Margin="0,2,0,0"
               IsVisible="{Binding StagewatchWindowsWords, Converter={StaticResource NotEmpty}}"
               ToolTip.Tip="A window a Stagewatch operator granted this desk (window grant on Stagewatch). Stage it on a screen's PVW (PVW WINDOW name), then TAKE once its page is ready; SCREEN n WINDOW name puts a ready one up live. NODES ASK WINDOW name asks Stagewatch's desk for one." />
    <!-- Round 96 (Show Bus 1.3 §12.4): ask the linked Stagewatch's desk for a window, for this desk — the Stagewatch card's menu entry opens here. -->
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDesk}" Margin="0,4,0,0">
      <TextBox Text="{Binding AskWindowName}" Watermark="a window's name on Stagewatch" MinWidth="220"
               ToolTip.Tip="Show Bus 1.3 §12.4: the name (or id) of a window on the linked Stagewatch. The ask goes to that Stagewatch's own desk, where a person decides; a grant comes back on the link and is listed above" />
      <Button Content="ASK FOR WINDOW" Command="{Binding AskWindowCommand}"
              ToolTip.Tip="NODES ASK WINDOW name — a request, never done here: the window is Stagewatch's to grant. The Stagewatch card's right-click menu opens this box" />
    </StackPanel>
    <!-- Round 89: the pairing token crossed the network unencrypted from another machine — said in words, amber, until NEW TOKEN. -->
    <TextBlock Text="{Binding TokenClearWords, StringFormat='△ {0}'}" Foreground="#FFB020" TextWrapping="Wrap" Margin="0,2,0,0"
               IsVisible="{Binding TokenClearWords, Converter={StaticResource NotEmpty}}"
               ToolTip.Tip="A remote on that machine sent this desk's pairing token unencrypted — the web remote over plain http://, an older Companion module (before 3.18.0, or 3.18.0 when the desk's NONCE came late), or another app's plain header. Anyone on that network may hold it now. NEW TOKEN on the Remote page (TRUST) rotates it; pair those remotes again over https:// or by proof" />
    <!-- Show Bus 1.3 §13.5: the app keys a connector proves itself with on this desk's wire — KEY MAKE, KEY BIND, KEY REVOKE, the desk's alone. -->
    <StackPanel Spacing="4" Margin="0,8,0,4" IsVisible="{Binding IsDesk}">
      <TextBlock Classes="h2" Text="APP KEYS" />
      <TextBlock Classes="hint" TextWrapping="Wrap"
                 Text="A key for one other app's link to this desk (Show Bus 1.3 §13.5): it proves LINK on the wire's port, speaks for that app alone and runs only what its scope reaches — follow and post read, drive adds VIDEO, CUE GO and STANDBY, SECTION and STAGE MESSAGE, operate runs everything. A Stagewatch that proves the pairing token over TLS enrols a key of its own here, at follow. Revoking a key ends its link at once." />
      <TextBlock Classes="hint" Text="{Binding AppKeys.Protection}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding AppKeys.Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AppKeyRow">
            <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="8" BorderBrush="{Binding Hue}" BorderThickness="1" ctl:Menus.Kind="appkey"
                    ToolTip.Tip="✓ a key in force; △ amber once it arrived in clear from another machine — revoke it and make a new one. Right-click: revoke, its scope, or another connector — the same presses as the buttons, the operator's alone">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Foreground="{Binding Hue}" TextWrapping="Wrap" VerticalAlignment="Center">
                  <Run Text="{Binding Mark}" />
                  <Run Text=" " />
                  <Run Text="{Binding Words}" />
                </TextBlock>
                <Button Grid.Column="1" Classes="mini" Content="BIND…" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).AppKeys.PickBindCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="KEY BIND: let this key speak for another connector, or at another scope — typed below" />
                <Button Grid.Column="2" Classes="mini" Content="REVOKE" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).AppKeys.RevokeCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="KEY REVOKE: the key stops at once — a link that uses it now is refused and closed (Show Bus 1.3 §13.5.5)" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding AppKeys.MakeFor}" Watermark="kind:id — main:3f9c2a1b7d0e for a Stagewatch, as its hello names it" MinWidth="300"
                 ToolTip.Tip="The one connector the key speaks for: its kind and its show network id (the card above names both). The key is refused for any other" />
        <ComboBox ItemsSource="{Binding AppKeys.Scopes}" SelectedItem="{Binding AppKeys.MakeScope}" MinWidth="110"
                  ToolTip.Tip="follow and post: reads; drive: and the playout desk's verbs; operate: everything, as the operator — no OUTPUTS, TAKE or CUT, SCREEN or setting below it" />
        <Button Content="MAKE KEY" Command="{Binding AppKeys.MakeCommand}"
                ToolTip.Tip="KEY MAKE: a new ptk_ key, 160 random bits, shown here once and kept nowhere but as its hash — never on the wire, a deck or the assistant" />
      </StackPanel>
      <StackPanel Spacing="4" IsVisible="{Binding AppKeys.HasShown}">
        <TextBox IsReadOnly="True" Text="{Binding AppKeys.Shown}" FontFamily="Consolas,Menlo,monospace" MinWidth="360" HorizontalAlignment="Left"
                 ToolTip.Tip="Select and copy it into that app now. HIDE forgets it: it is never shown again" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding AppKeys.ShownWords, StringFormat='△ {0}'}" Foreground="#FFB020" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" />
          <Button Content="HIDE" Command="{Binding AppKeys.HideShownCommand}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AppKeys.BindKid, Converter={StaticResource NotEmpty}}">
        <TextBlock Classes="label" Text="{Binding AppKeys.BindKid, StringFormat='Key {0} speaks for'}" VerticalAlignment="Center" />
        <TextBox Text="{Binding AppKeys.BindFor}" Watermark="kind:id" MinWidth="220" />
        <ComboBox ItemsSource="{Binding AppKeys.Scopes}" SelectedItem="{Binding AppKeys.BindScope}" MinWidth="110" />
        <Button Content="BIND" Command="{Binding AppKeys.BindCommand}"
                ToolTip.Tip="KEY BIND: the key speaks for that connector at that scope from now on; moved, or lowered, its live link ends at once" />
      </StackPanel>
    </StackPanel>
    <!-- Show Bus 1.3 §13.16.5: the acceptor's list — every link this wire accepted that LINK verified, never a deck; CLOSE and REVOKE KEY the operator's. -->
    <StackPanel Spacing="4" Margin="0,8,0,4" IsVisible="{Binding AppLinks.HasRows}">
      <TextBlock Classes="h2" Text="APP LINKS" />
      <TextBlock Classes="hint" TextWrapping="Wrap"
                 Text="The other apps linked to this desk's wire by LINK (Show Bus 1.3 §13.16.5) — each proved the pairing token or an app key, both ends checked. A deck that paired the older way is on the Remote page's COMPANION strip, never here. ✓ green: proved; △ amber: proved but plain from another machine, or its key was seen in clear; ○ grey: ended, kept a minute." />
      <ItemsControl ItemsSource="{Binding AppLinks.Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AppLinkTableRow">
            <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="8" BorderBrush="{Binding Hue}" BorderThickness="1" ctl:Menus.Kind="applink"
                    ToolTip.Tip="✓ a link LINK proved; △ amber while it is plain from another machine or its key was seen in clear; ○ ended. Right-click: close it, or revoke the key it stands on — the same presses as the buttons, the operator's alone">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Foreground="{Binding Hue}" TextWrapping="Wrap" VerticalAlignment="Center">
                  <Run Text="{Binding Mark}" />
                  <Run Text=" " />
                  <Run Text="{Binding Words}" />
                </TextBlock>
                <Button Grid.Column="1" Classes="mini" Content="CLOSE" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding CanClose}"
                        Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).AppLinks.CloseCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Close this link: it hears that this desk's operator closed it, runs nothing more and ends; its key stays in force, so it may link again. A Stagewatch shows its key refused and waits a minute before it links again — Show Bus 1.3's line has no word for an operator's close" />
                <Button Grid.Column="2" Classes="mini" Content="REVOKE KEY" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding CanRevoke}"
                        Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).AppLinks.RevokeKeyCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="KEY REVOKE for the key this link stands on: this link and every other that uses it are refused at once (Show Bus 1.3 §13.5.5)" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <TextBlock Text="{Binding AppLinks.RefusalWords}" Foreground="#FFB020" TextWrapping="Wrap" Margin="0,2,0,4" IsVisible="{Binding AppLinks.HasRefusals}"
               ToolTip.Tip="LINK refusals on this desk's wire in the last minute, each with its count — the connector named is what it claimed; a refusal proved nothing" />
    <ItemsControl ItemsSource="{Binding ShowApps}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="svc:ShowAppCard">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" BorderBrush="{Binding Hue}" BorderThickness="1" ctl:Menus.Kind="showapp"
                  ToolTip.Tip="Another show app heard on UDP 9928 — teal Stagewatch, violet AGMessage, sky a Slides agent; amber once quiet, while its show is stuck or this desk's key is not taken, while two machines say its id (both named on the card, and no new link to it until they stop taking turns for a minute), or while its own context or its link says amber; dark red once gone or while its context or link says red. The mark before its name is that light's shape: ✓ green, △ amber, ✕ red, ○ nothing known yet">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Foreground="{Binding Hue}">
                <Run Text="{Binding Mark}" />
                <Run Text=" " />
                <Run Text="{Binding KindLabel}" />
                <Run Text=" " />
                <Run Text="{Binding Name}" />
              </TextBlock>
              <TextBlock Classes="label" Text="{Binding Line}" TextWrapping="Wrap" />
              <Button Content="ADD AS DEVICE" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding AddAsDevice}"
                      Command="{Binding $parent[UserControl].((vm:INodesPage)DataContext).AddAsDeviceCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="A Show Bus node device on the Interactive page, its address and wire port from this hello — type the node's pairing token in its Secret box (PlayMap: its Network drawer). It pairs by proof before anything is taken from it; its verbs go as DEVICE lines, each with its own receipt. The card's right-click entry is the same press" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <CheckBox Content="Link to a Stagewatch — its timer on the stage pages, its things on the Eye, its context in the assistant's brief"
              IsChecked="{Binding LinkBoxes.On}"
              ToolTip.Tip="Off by default. With no address the desk follows the first Stagewatch it hears on the show network. One room, one timer: the stage pages show the Stagewatch's time while it answers. The same verb as STAGEWATCH LINK ON|OFF on a deck or the wire, one journal row" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0" IsVisible="{Binding State.Control.Stagewatch.Enabled}">
      <TextBlock Classes="label" Text="Address" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding LinkBoxes.Address, UpdateSourceTrigger=LostFocus}" Watermark="host:port, or id:&lt;a heard Stagewatch's id&gt; — empty finds one on the show network"
               ToolTip.Tip="A Stagewatch's address and web port (9924 when left out), or id: and the show network id of one heard (it is dialled wherever it is heard). Empty: the first Stagewatch heard on UDP 9928. Taken when you leave the box, as STAGEWATCH LINK from a deck or the wire is, one journal row" />
      <TextBlock Grid.Row="1" Classes="label" Text="Key" VerticalAlignment="Center" Margin="0,6,8,0" />
      <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding LinkBoxes.Key, UpdateSourceTrigger=LostFocus}" PasswordChar="•" Watermark="swk_… — a node key made on the Stagewatch (a read key follows the timer only; the approval queue needs node)"
               ToolTip.Tip="Made in Stagewatch: Settings → Remote → API keys. Sent in the Authorization header, never in a URL; masked in every bundle, never mirrored to a twin. Typed here and nowhere else: a new key goes to the Stagewatch this page names and binds to the first one that takes it — never to one a deck or the wire chose" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTrust}" Margin="0,4,0,0">
      <TextBlock Text="{Binding TrustWords, StringFormat='△ {0}'}" Foreground="#FFB020" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
      <Button Content="TRUST" Command="{Binding TrustCertificateCommand}"
              ToolTip.Tip="Show Bus 1.3 §13.6.8: an older Stagewatch cannot prove itself, so its key goes only to a certificate a person has trusted. Compare this fingerprint with the one on the Stagewatch's Settings → Remote, then press TRUST. The card's right-click menu holds the same press" />
    </StackPanel>
    <StackPanel Spacing="4" IsVisible="{Binding HasPendingCertificate}" Margin="0,4,0,0">
      <TextBlock Text="{Binding AcceptWords, StringFormat='✕ {0}'}" Foreground="#FF5C7A" TextWrapping="Wrap" MaxWidth="560" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding AcceptHex}" Watermark="at least 8 hex of the new certificate" MinWidth="220"
                 ToolTip.Tip="Show Bus 1.3 §13.8.3: type the first hex of the fingerprint the Stagewatch shows on its own Settings → Remote — never copied here for you. A certificate that has changed again since is refused" />
        <Button Content="ACCEPT" Command="{Binding AcceptCertificateCommand}"
                ToolTip.Tip="Only when you know why it changed (the Stagewatch was reinstalled, its certificate renewed). A person's choice on this desk — never on the wire, a deck or the assistant; the card's right-click entry opens this box" />
      </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasKeyBind}" Margin="0,4,0,0">
      <TextBlock Text="{Binding KeyBindWords}" Foreground="#FFB020" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
      <Button Content="BIND KEY" Command="{Binding BindKeyCommand}"
              ToolTip.Tip="G34: the key goes only to the Stagewatch it is bound to — typed here, or bound by the first Stagewatch that took it. A person's choice on this desk; the wire's STAGEWATCH KEY is refused, so a key never rides a line" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding State.Control.Stagewatch.Enabled}" Margin="0,4,0,0">
      <Button Content="LINK AGAIN" Command="{Binding LinkAgainCommand}"
              ToolTip.Tip="Show Bus 1.3 §13.16.6: a refused key's hold and the redial's wait end, and the next dial is due now — refused, with the reason, while nothing is held and no redial waits. The card's right-click entry, a deck's key and the wire's STAGEWATCH LINK AGAIN are the same press" />
      <Button Content="LOWER FLOOR" Command="{Binding LinkBoxes.LowerFloorCommand}" IsVisible="{Binding LinkBoxes.HasFloor}"
              ToolTip.Tip="Show Bus 1.3 §13.9.3: the Stagewatch proved itself before and now offers less — take the lesser link, said amber. The card's right-click entry, a deck's key and the wire's STAGEWATCH FLOOR LOWER are the same press" />
      <Button Content="RELEASE" Command="{Binding LinkBoxes.ReleaseCommand}" IsEnabled="False" ToolTip.ShowOnDisabled="True"
              ToolTip.Tip="{Binding LinkBoxes.ReleaseWords}" />
    </StackPanel>
    <CheckBox Content="The stage timer follows the Stagewatch (one room, one timer)" IsChecked="{Binding LinkBoxes.Follow}"
              IsVisible="{Binding State.Control.Stagewatch.Enabled}"
              ToolTip.Tip="The stage and timer pages show the Stagewatch's time and colours while it answers; quiet, the time is held back; gone, this desk's own countdown runs. Pause and add-time are the Stagewatch's then. The same verb as STAGEWATCH FOLLOW ON|OFF on a deck or the wire, one journal row; the link's light is red only while the stage follows it" />

    <TextBlock Classes="hint tip"
               Text="How the pieces find each other: every Patterns sends a beacon once a second (UDP, port 9700 by default) and hears the others'; a node always does, a desk does while it accepts callers. A caller node presses LINK on the desk it follows and joins with that desk's twin key; the desk's Nodes page counts it under LINKED and its Machine page's TWIN line names it. NODES on the wire lists every card as JSON. The other show apps (Stagewatch, PlayMap, AGMessage, Slides agents) say hello on UDP 9928 every two seconds — who they are and where their doors are, never what the show is (Show Bus 1.3, docs/SHOWBUS.md)." />
  </StackPanel>
</UserControl>
