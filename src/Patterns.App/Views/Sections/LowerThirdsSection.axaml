<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:c="using:Patterns.App.Views.Controls"
             xmlns:lt="using:Patterns.Core.LowerThirds"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.LowerThirdsSection"
             Classes="hue-lower-thirds"
             x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="Auto,*" Margin="4,8,12,16">
    <!-- Pinned: the title and the design preview stay in view while the page below scrolls. -->
    <StackPanel Grid.Row="0" Classes="form" Name="PinnedPreview">
      <TextBlock Classes="h1 neon-lower" Text="Lower thirds" />
      <Grid ColumnDefinitions="Auto,10,*">
        <TextBlock Classes="h2" Text="PREVIEW" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="label" Text="{Binding LowerThirdPreviewTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
      <Border Background="#0B0C10" CornerRadius="8" ClipToBounds="True">
        <Panel>
          <c:LowerThirdPreview Name="DesignPreview" Design="{Binding SelectedLowerThird}" State="{Binding State}" TimeMs="{Binding PreviewTimeMs}" Height="250"
                               SelectedElement="{Binding SelectedElement, Mode=TwoWay}"
                               ToolTip.Tip="Click an element to select it; drag it to move it" />
          <TextBlock Classes="hint" Text="No design selected — pick one under DESIGNS, or + New." HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !HasLowerThird}" />
        </Panel>
      </Border>
      <Grid ColumnDefinitions="Auto,6,Auto,8,*,8,60" Margin="0,4,0,0" IsVisible="{Binding HasLowerThird}">
        <ToggleButton Classes="chip" Content="▶ PLAY" IsChecked="{Binding PreviewPlaying, Mode=TwoWay}" ToolTip.Tip="Run the way in, the hold and the way out, round and round" />
        <Button Grid.Column="2" Classes="mini" Content="⟲" Command="{Binding PreviewRestartCommand}" ToolTip.Tip="Back to the start" />
        <Slider Grid.Column="4" Minimum="0" Maximum="{Binding PreviewLengthMs}" Value="{Binding PreviewTimeMs, Mode=TwoWay}" />
        <TextBlock Grid.Column="6" Classes="label" Text="{Binding PreviewTimeMs, StringFormat={}{0:0} ms}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Name="PageScroll">
    <StackPanel Classes="form" Margin="0,8,0,0">
    <TextBlock Classes="hint tip"
               Text="A name, a role, a date, a logo, a headshot — animated on and off over whatever is showing, on every screen, NDI send and the stream at once. Start from a preset, fill in the fields, PVW it for a sign-off and TAKE TO AIR — or AIR straight away. Every element is a box you can move, size and style (fill, gradient, corners, border, shadow, glow, a chaser round its edge), and every element has its own way in and out: pick a motion, or edit the keys. Designs live in the show file; save one as a file of its own to carry it to another show." />

    <TextBlock Classes="h2" Text="DESIGNS" />
    <Grid ColumnDefinitions="*,8,Auto">
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LowerThirdPresetNames}"
                SelectedItem="{Binding NewLowerThirdPreset, Mode=TwoWay}" ToolTip.Tip="The preset a new design starts from" />
      <Button Grid.Column="2" Classes="chip" Content="+ New" Command="{Binding NewLowerThirdCommand}"
              ToolTip.Tip="A new design from the chosen preset" />
    </Grid>
    <ListBox ItemsSource="{Binding State.LowerThirds.Designs}" SelectedItem="{Binding SelectedLowerThird, Mode=TwoWay}" MaxHeight="230">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="lt:LowerThirdDesign">
          <Grid ColumnDefinitions="Auto,6,*,8,Auto,6,Auto,8,Auto,4,Auto,6,Auto,Auto">
            <ToggleButton Classes="mini" Content="★" IsChecked="{Binding IsDefault, Mode=OneWay}" VerticalAlignment="Center"
                          ToolTip.Tip="The show's default design: once a style is chosen it usually serves the whole show, so PERSON n, the PEOPLE chips, the phone and a cue that names a person but no design put the next name into this one when none is on air"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SetDefaultLowerThirdCommand}" CommandParameter="{Binding}" />
            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
            <Border Grid.Column="4" Classes="tallyChip pvw" IsVisible="{Binding IsInPreview}" VerticalAlignment="Center">
              <TextBlock Text="{Binding PreviewText}" />
            </Border>
            <Border Grid.Column="6" Classes="tallyChip air" IsVisible="{Binding IsOnAir}" VerticalAlignment="Center">
              <TextBlock Text="{Binding OnAirText}" />
            </Border>
            <Button Grid.Column="8" Classes="mini" Content="PVW" ToolTip.Tip="Into the preview for a sign-off: the PREVIEW pane, the multiview's Preview tile and REVIEW show it while the audience sees nothing new; TAKE TO AIR when it is right (needs EDIT SAFE)"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PreviewLowerThirdCommand}" CommandParameter="{Binding}" />
            <Button Grid.Column="10" Classes="mini go" Content="AIR" ToolTip.Tip="On air now, as the design is at this moment — every screen, NDI send and the stream (again restarts its way in)"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowLowerThirdCommand}" CommandParameter="{Binding}" />
            <Button Grid.Column="12" Classes="mini" Content="⧉" ToolTip.Tip="Duplicate"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DuplicateLowerThirdCommand}" CommandParameter="{Binding}" />
            <Button Grid.Column="13" Classes="mini" Content="✕" ToolTip.Tip="Delete (off the air and the preview if it is on)"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteLowerThirdCommand}" CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,8,Auto,6,Auto">
          <TextBlock Classes="label" Text="{Binding LowerThirdStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="2" Classes="mini" Content="UPDATE ON AIR" IsVisible="{Binding LowerThirdAirEdited}" Command="{Binding UpdateLowerThirdCommand}"
                  ToolTip.Tip="The design on air has been edited since it went there: push the edit — everything, the words too — without it leaving and arriving again" />
          <Button Grid.Column="4" Classes="stop" Content="HIDE" Command="{Binding HideLowerThirdCommand}" ToolTip.Tip="The lower third on air leaves the way it was designed to" />
        </Grid>
        <Grid ColumnDefinitions="*,8,Auto,6,Auto">
          <TextBlock Classes="label" Text="{Binding LowerThirdPreviewText}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="2" Classes="go" Content="TAKE TO AIR" IsVisible="{Binding HasLowerThirdInPreview}" Command="{Binding TakeLowerThirdCommand}"
                  ToolTip.Tip="The signed-off lower third to air — it arrives the way it was designed to — and the preview clears for the next name" />
          <Button Grid.Column="4" Classes="mini" Content="CLEAR PREVIEW" IsVisible="{Binding HasLowerThirdInPreview}" Command="{Binding ClearLowerThirdPreviewCommand}"
                  ToolTip.Tip="The preview's lower third leaves; nothing changes on air" />
        </Grid>
      </StackPanel>
    </Border>
    <TextBlock Classes="hint tip"
               Text="The flow: build a design, PVW it — it shows on the PREVIEW pane, on the multiview's Preview tile and, with REVIEW, full-frame on the multiview, where a show caller or director checks the spelling and signs it off — then TAKE TO AIR. AIR skips the sign-off and puts the design on straight away, as it is at that moment; HIDE takes it off the way it was designed to. With EDIT SAFE open the audience sees a copy of the design: an edit made while it is on air lights EDITED here, and UPDATE ON AIR carries the edit across in place (the words too), or AIR again to restart it. ★ marks the show's default design — once a style is chosen it usually serves the whole show — so PERSON n, the PEOPLE chips, the phone and a cue that names a person but no design put the next name into it when none is on air. A picture TAKE keeps whatever lower third is on air where it is in its life and takes one that is in the preview to air with it. Cues: Lower third on / to preview / take / off; the wire: LT n, LT PREVIEW n, LT TAKE, LT UPDATE, LT OFF. Everything here is journaled." />

    <TextBlock Classes="h2" Text="LIBRARY: PEOPLE &amp; LINES" />
    <WrapPanel>
      <Button Classes="chip" Content="+ Person" Margin="0,0,6,6" Command="{Binding NewEntryCommand}" ToolTip.Tip="A new entry: a name, a role, a company, a photo, a note for you" />
      <Button Classes="chip" Content="IMPORT LIST" Margin="0,0,6,6" Command="{Binding ImportPeopleCommand}"
              ToolTip.Tip="A speaker list from a CSV or the first sheet of an Excel file replaces the library — Name (or First name and Last name), Role, Company, Photo, Note, read by their header names" />
      <Button Classes="mini" Content="Append" Margin="0,0,6,6" Command="{Binding ImportPeopleAppendCommand}" ToolTip.Tip="Add a list to the library; a name already there is updated, never doubled" />
      <Button Classes="mini" Content="Export CSV" Margin="0,0,6,6" Command="{Binding ExportPeopleCommand}" ToolTip.Tip="The library as a CSV — for Excel, a printout or another show" />
      <Button Classes="mini" Content="Template CSV" Margin="0,0,6,6" Command="{Binding SavePeopleTemplateCommand}" ToolTip.Tip="The columns with rows to copy" />
    </WrapPanel>
    <ListBox ItemsSource="{Binding State.LowerThirds.Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" MaxHeight="230">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="lt:LowerThirdEntry">
          <Grid ColumnDefinitions="*,8,Auto,Auto,Auto,Auto">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="label" Text="{Binding Role}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Role, Converter={StaticResource NotEmpty}}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="mini" Content="USE" ToolTip.Tip="Into the selected design — its fields and its photo — without going anywhere"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).UseEntryCommand}" CommandParameter="{Binding}" />
            <Button Grid.Column="3" Classes="mini" Content="PVW" ToolTip.Tip="Into the selected design (else the one in the preview, on air, or the show's default) and the preview, for a sign-off"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PreviewEntryCommand}" CommandParameter="{Binding}" />
            <Button Grid.Column="4" Classes="mini go" Content="AIR" ToolTip.Tip="Into the selected design, and on air now"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowEntryCommand}" CommandParameter="{Binding}" />
            <Button Grid.Column="5" Classes="mini" Content="✕" ToolTip.Tip="Remove from the library"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteEntryCommand}" CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ContentControl Content="{Binding SelectedEntry}" IsVisible="{Binding HasEntry}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="lt:LowerThirdEntry">
          <StackPanel Classes="form">
            <Grid ColumnDefinitions="110,*" Margin="0,4,0,0">
              <TextBlock Classes="label" Text="Name" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" Watermark="Jane Doe — or a line: Doors open 19:00" />
            </Grid>
            <Grid ColumnDefinitions="110,*" Margin="0,4,0,0">
              <TextBlock Classes="label" Text="Role" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding Role, Mode=TwoWay}" Watermark="Chief Executive" />
            </Grid>
            <Expander Name="EntryMore" Header="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).EntryMoreHeader}"
                      IsExpanded="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).EntryMoreExpanded, Mode=TwoWay}" Margin="0,4,0,0"
                      ToolTip.Tip="The company, the photo and your note — folded away so the list keeps its room; the name and the role are what the screen shows">
              <StackPanel Classes="form">
                <Grid ColumnDefinitions="110,*" Margin="0,4,0,0">
                  <TextBlock Classes="label" Text="Company" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Company, Mode=TwoWay}" Watermark="Empty = the brand kit's company" />
                </Grid>
                <Grid ColumnDefinitions="110,*,8,Auto" Margin="0,4,0,0">
                  <TextBlock Classes="label" Text="Photo" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Photo, Mode=TwoWay}" Watermark="Empty = the design's picture stays" />
                  <Button Grid.Column="3" Classes="mini" Content="Browse…" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).BrowseEntryPhotoCommand}" />
                </Grid>
                <Grid ColumnDefinitions="110,*" Margin="0,4,0,0">
                  <TextBlock Classes="label" Text="Note" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Note, Mode=TwoWay}" Watermark="For you — pronunciation, the session — never drawn" />
                </Grid>
              </StackPanel>
            </Expander>
          </StackPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <TextBlock Classes="hint tip"
               Text="The library is every person (or line) the show will name, kept apart from the designs so one design serves the whole speaker list. USE puts an entry into the selected design — the Name, Role and Company elements read its fields, the photo lands in the picture element named Photo (else the first picture); PVW does that and puts the design in the preview for a sign-off; AIR does it and puts the design on air. A cue (Lower third on / to preview) names the design and the person; a person who is not in the library is refused before the show, so a wrong name never reaches the screen. The Show panel's PEOPLE chips, the phone's PEOPLE buttons, PERSON n / LT design WITH person on the wire and Companion put the next speaker into the design on air — or, with none on air, the show's ★ default design. Append updates a name that is already there; Photo paths are kept as written." />

    <StackPanel IsVisible="{Binding HasLowerThird}">
      <TextBlock Classes="hint tip" Text="The preview stays at the top of this page while you work below it. Its timeline: the way in, then the hold (a design that waits to be hidden holds 1.5 s there), then the way out. Drag the slider to any instant." />

      <TextBlock Classes="h2" Text="DESIGN" />
      <ContentControl Content="{Binding SelectedLowerThird}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="lt:LowerThirdDesign">
            <StackPanel Classes="form">
              <Grid ColumnDefinitions="110,*">
                <TextBlock Classes="label" Text="Name" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" Watermark="e.g. Keynote speaker" />
              </Grid>
              <Grid ColumnDefinitions="110,*" Margin="0,4,0,0">
                <TextBlock Classes="label" Text="Name shown" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding PersonName, Mode=TwoWay}" Watermark="Jane Doe" />
              </Grid>
              <Grid ColumnDefinitions="110,*" Margin="0,4,0,0">
                <TextBlock Classes="label" Text="Role" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding PersonRole, Mode=TwoWay}" Watermark="Head of Something" />
              </Grid>
              <Grid ColumnDefinitions="110,*" Margin="0,4,0,0">
                <TextBlock Classes="label" Text="Company" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Company, Mode=TwoWay}" Watermark="Empty = the brand kit's company" />
              </Grid>
              <Grid ColumnDefinitions="110,*,8,*" Margin="0,4,0,0">
                <TextBlock Classes="label" Text="Date · time" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding DateText, Mode=TwoWay}" Watermark="Empty = today" />
                <TextBox Grid.Column="3" Text="{Binding TimeText, Mode=TwoWay}" Watermark="Empty = the time now" />
              </Grid>
              <Grid ColumnDefinitions="110,86,8,86,8,*" Margin="0,8,0,0">
                <TextBlock Classes="label" Text="Box (px)" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="40" Maximum="8192" Increment="10" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding Width, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="The design box's width at 1080 lines" />
                <NumericUpDown Grid.Column="3" Minimum="20" Maximum="4320" Increment="10" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding Height, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="The design box's height at 1080 lines" />
                <ComboBox Grid.Column="5" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:Lists.Anchors}"
                          SelectedValue="{Binding Anchor, Mode=TwoWay}" SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}"
                          ToolTip.Tip="Where the box sits on the screen" />
              </Grid>
              <Grid ColumnDefinitions="110,86,8,86,8,86,*" Margin="0,4,0,0">
                <TextBlock Classes="label" Text="Margins · scale" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="-2048" Maximum="4096" Increment="10" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding MarginX, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="From the left or right edge" />
                <NumericUpDown Grid.Column="3" Minimum="-2048" Maximum="4096" Increment="10" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding MarginY, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="From the top or bottom edge" />
                <NumericUpDown Grid.Column="5" Minimum="10" Maximum="400" Increment="5" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding ScalePct, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="Scale, percent (100 = the design's own size at 1080 lines)" />
              </Grid>
              <Grid ColumnDefinitions="110,86,8,86,8,86,*" Margin="0,4,0,0">
                <TextBlock Classes="label" Text="In · hold · out" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="20000" Increment="50" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding InMs, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="The way in, ms" />
                <NumericUpDown Grid.Column="3" Minimum="0" Maximum="600000" Increment="500" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding HoldMs, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="Stays this long, ms; 0 = until hidden" />
                <NumericUpDown Grid.Column="5" Minimum="0" Maximum="20000" Increment="50" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding OutMs, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="The way out, ms" />
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <TextBlock Classes="h2" Text="ELEMENTS" />
      <WrapPanel>
        <Button Classes="chip" Content="+ Text" Margin="0,0,6,6" Command="{Binding AddElementCommand}" CommandParameter="Text" />
        <Button Classes="chip" Content="+ Bar" Margin="0,0,6,6" Command="{Binding AddElementCommand}" CommandParameter="Bar" />
        <Button Classes="chip" Content="+ Picture" Margin="0,0,6,6" Command="{Binding AddElementCommand}" CommandParameter="Image" />
        <Button Classes="chip" Content="+ Logo" Margin="0,0,6,6" Command="{Binding AddElementCommand}" CommandParameter="Logo" />
        <Button Classes="chip" Content="+ Clip" Margin="0,0,6,6" Command="{Binding AddElementCommand}" CommandParameter="Media" />
        <Button Classes="chip" Content="+ Particles" Margin="0,0,6,6" Command="{Binding AddElementCommand}" CommandParameter="Particles" />
        <Button Classes="chip" Content="+ Fractal" Margin="0,0,6,6" Command="{Binding AddElementCommand}" CommandParameter="Fractal" />
      </WrapPanel>
      <ListBox ItemsSource="{Binding SelectedLowerThird.Elements}" SelectedItem="{Binding SelectedElement, Mode=TwoWay}" MaxHeight="210">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="lt:LowerThirdElement">
            <Grid ColumnDefinitions="Auto,8,*,8,Auto,Auto,Auto">
              <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" ToolTip.Tip="Drawn" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="hint" Text="{Binding Kind}" />
              </StackPanel>
              <Button Grid.Column="4" Classes="mini" Content="▲" ToolTip.Tip="Draw earlier (further back)"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveElementUpCommand}" CommandParameter="{Binding}" />
              <Button Grid.Column="5" Classes="mini" Content="▼" ToolTip.Tip="Draw later (further in front)"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveElementDownCommand}" CommandParameter="{Binding}" />
              <Button Grid.Column="6" Classes="mini" Content="✕" ToolTip.Tip="Remove"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveElementCommand}" CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Classes="hint tip" Text="Elements draw in list order: the first is furthest back. Put the bar first, the words last." />

      <!-- The selected element's settings live in the pop-out column beside this page (round 19): the designer keeps its room. -->
      <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding HasElement}" Margin="0,4,0,0">
        <TextBlock Classes="hint" Text="{Binding PopOutHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="mini" Content="SETTINGS ▸" Command="{Binding OpenPopOutCommand}" IsVisible="{Binding !PopOut.IsOpen}"
                ToolTip.Tip="Open the selected element's settings in the column beside this page" />
      </Grid>

      <TextBlock Classes="h2" Text="SAVED FILES" />
      <Button Classes="chip" Content="Save this design as a file" HorizontalAlignment="Left" Command="{Binding SaveLowerThirdFileCommand}"
              ToolTip.Tip="A JSON file in the lowerthirds folder beside the exe, named after the design — copy it to another machine and load it there" />
      <ItemsControl ItemsSource="{Binding LowerThirdFiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PickItem">
            <Grid ColumnDefinitions="*,8,Auto" Margin="0,3">
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="mini" Content="Load into the show"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LoadLowerThirdFileCommand}" CommandParameter="{Binding Id}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="hint tip" Text="Loading a file adds a new design (the file stays as it is). The designs in the show are saved with the show." />
    </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
