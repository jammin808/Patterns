<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:c="using:Patterns.App.Views.Controls"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.MediaSection"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!-- One layer's editor: the source, its box, how it sits, its edges -->
    <DataTemplate x:Key="LayerEditor" x:DataType="m:LayerConfig">
      <StackPanel Spacing="4">
        <CheckBox Content="On" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <Grid ColumnDefinitions="86,*">
          <TextBlock Classes="label" Text="Source" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LayerSources}"
                    SelectedValue="{Binding Source, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
        </Grid>
        <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Image}}">
          <TextBox Watermark="PNG, JPEG, BMP, WebP…" Text="{Binding ImagePath, Mode=TwoWay}" />
          <Button Grid.Column="2" Classes="chip" Content="Browse…"
                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).BrowseLayerImageCommand}" CommandParameter="{Binding}" />
        </Grid>
        <StackPanel Spacing="4" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Video}}">
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Watermark="MP4, MOV, MKV…" Text="{Binding VideoPath, Mode=TwoWay}" />
            <Button Grid.Column="2" Classes="chip" Content="Browse…"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).BrowseLayerVideoCommand}" CommandParameter="{Binding}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox Content="Loop" IsChecked="{Binding Loop, Mode=TwoWay}" />
            <CheckBox Content="Mute" IsChecked="{Binding Mute, Mode=TwoWay}" />
          </StackPanel>
          <Grid ColumnDefinitions="86,*,44">
            <TextBlock Classes="label" Text="Volume" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="0" Maximum="125" TickFrequency="5" Value="{Binding VolumePct, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding VolumePct, StringFormat={}{0:0}%}" />
          </Grid>
        </StackPanel>
        <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.NdiFeed}}">
          <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).NdiSourceOptions}"
                    SelectedItem="{Binding NdiSourceName, Mode=TwoWay}" PlaceholderText="NDI sources on the network…" />
          <Button Grid.Column="2" Classes="chip" Content="Refresh"
                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RefreshNdiSourcesCommand}" />
        </Grid>
        <TextBox IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.NdiFeed}}"
                 Watermark="…or type the exact source name" Text="{Binding NdiSourceName, Mode=TwoWay}" />
        <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Capture}}">
          <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CaptureDeviceOptions}"
                    SelectedItem="{Binding CaptureDevice, Mode=TwoWay}" PlaceholderText="Capture devices…" />
          <Button Grid.Column="2" Classes="chip" Content="Refresh"
                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RefreshCaptureDevicesCommand}" />
        </Grid>
        <ComboBox IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Screen}}"
                  ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MultiviewTargets}"
                  SelectedValue="{Binding TargetId, Mode=TwoWay}"
                  SelectedValueBinding="{Binding ScreenId, x:DataType=vm:EditTarget}"
                  PlaceholderText="Which screen or canvas…" />
        <StackPanel Spacing="4" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Web}}">
          <TextBox Watermark="https://example.com/live — or a local HTML file" Text="{Binding WebUrl, Mode=TwoWay}" />
          <Grid ColumnDefinitions="86,*,8,Auto,*">
            <TextBlock Classes="label" Text="Page (px)" VerticalAlignment="Center" ToolTip.Tip="The page's own viewport — what it lays itself out for; the picture is then fitted into the box" />
            <NumericUpDown Grid.Column="1" Minimum="320" Maximum="7680" Increment="10" FormatString="0" Value="{Binding WebWidth, Mode=TwoWay, Converter={StaticResource Num}}" />
            <TextBlock Grid.Column="3" Classes="label" Text="×" VerticalAlignment="Center" Margin="4,0" />
            <NumericUpDown Grid.Column="4" Minimum="240" Maximum="4320" Increment="10" FormatString="0" Value="{Binding WebHeight, Mode=TwoWay, Converter={StaticResource Num}}" />
          </Grid>
          <Grid ColumnDefinitions="86,*,44">
            <TextBlock Classes="label" Text="Zoom" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="25" Maximum="400" TickFrequency="25" Value="{Binding WebZoomPct, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding WebZoomPct, StringFormat={}{0:0}%}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox Content="Show the pointer" IsChecked="{Binding WebShowPointer, Mode=TwoWay}" ToolTip.Tip="Draw the desk's pointer and its clicks on the page wherever this layer is shown" />
            <CheckBox Content="Mute" IsChecked="{Binding Mute, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>

        <TextBlock Classes="label" Text="Box (% of the canvas — or drag it on the PREVIEW pane)" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="86,*,44" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="label" Text="Left" VerticalAlignment="Center" />
          <Slider Grid.Row="0" Grid.Column="1" Minimum="-50" Maximum="100" Value="{Binding XPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding XPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="1" Classes="label" Text="Top" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="-50" Maximum="100" Value="{Binding YPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding YPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Width" VerticalAlignment="Center" />
          <Slider Grid.Row="2" Grid.Column="1" Minimum="2" Maximum="150" Value="{Binding WPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding WPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Height" VerticalAlignment="Center" />
          <Slider Grid.Row="3" Grid.Column="1" Minimum="2" Maximum="150" Value="{Binding HPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding HPct, StringFormat={}{0:0}%}" />
        </Grid>
        <Grid ColumnDefinitions="86,*">
          <TextBlock Classes="label" Text="Fit" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FitModes}"
                    SelectedValue="{Binding Fit, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
        </Grid>
        <Grid ColumnDefinitions="86,*,44">
          <TextBlock Classes="label" Text="Opacity" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" />
          <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Opacity, StringFormat={}{0:0.00}}" />
        </Grid>
        <Grid ColumnDefinitions="86,*,8,86,*">
          <TextBlock Classes="label" Text="Corners (px)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="500" Increment="2" FormatString="0" Value="{Binding CornerPx, Mode=TwoWay, Converter={StaticResource Num}}" />
          <TextBlock Grid.Column="3" Classes="label" Text="Border (px)" VerticalAlignment="Center" Margin="8,0,0,0" />
          <NumericUpDown Grid.Column="4" Minimum="0" Maximum="200" Increment="1" FormatString="0" Value="{Binding BorderPx, Mode=TwoWay, Converter={StaticResource Num}}" />
        </Grid>
        <Grid ColumnDefinitions="86,*">
          <TextBlock Classes="label" Text="Border colour" VerticalAlignment="Center" />
          <c:ColorField Grid.Column="1" Value="{Binding BorderColor, Mode=TwoWay}" />
        </Grid>
        <TextBlock Classes="label" Text="Crop (% cut away on each side)" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="86,*,44" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="label" Text="Left" VerticalAlignment="Center" />
          <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding CropLeftPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding CropLeftPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="1" Classes="label" Text="Right" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding CropRightPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding CropRightPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Top" VerticalAlignment="Center" />
          <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding CropTopPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding CropTopPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Bottom" VerticalAlignment="Center" />
          <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding CropBottomPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding CropBottomPct, StringFormat={}{0:0}%}" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-media" Text="Media" />
    <TextBlock Classes="hint tip" Text="Shown when the pattern type is 'Media'. Media composites through the engine, so it reaches spans and NDI outputs too. Every input runs separately: give each screen its own source (pick the screen in the strip, then choose here) and the same feed can sit on several screens, the PiP and the multiview at once — one decode per source." />

    <TextBlock Classes="label" Text="{Binding ActiveInputsText}" TextWrapping="Wrap" />

    <TextBlock Classes="h2" Text="SOURCE" />
    <ComboBox ItemsSource="{Binding MediaSources}"
              SelectedValue="{Binding ActivePattern.Media.Source, Mode=TwoWay}"
              SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />

    <!-- Single image -->
    <StackPanel IsVisible="{Binding ActivePattern.Media.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:MediaSource.Image}}">
      <TextBlock Classes="h2" Text="IMAGE" />
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox Grid.Column="0" Watermark="PNG, JPEG, BMP, WebP…" Text="{Binding ActivePattern.Media.ImagePath}" />
        <Button Grid.Column="2" Classes="chip" Content="Browse…" Command="{Binding BrowseImageCommand}" />
      </Grid>
    </StackPanel>

    <!-- Single video / audio file -->
    <StackPanel IsVisible="{Binding ActivePattern.Media.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:MediaSource.Video}}">
      <TextBlock Classes="h2" Text="VIDEO / AUDIO FILE" />
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox Grid.Column="0" Watermark="MP4, MOV, MKV… or MP3, WAV, FLAC…" Text="{Binding ActivePattern.Media.VideoPath}" />
        <Button Grid.Column="2" Classes="chip" Content="Browse…" Command="{Binding BrowseVideoCommand}" />
      </Grid>
      <CheckBox Content="Loop" IsChecked="{Binding ActivePattern.Media.Loop}" />
    </StackPanel>

    <!-- NDI feed -->
    <StackPanel IsVisible="{Binding ActivePattern.Media.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:MediaSource.NdiFeed}}">
      <TextBlock Classes="h2" Text="NDI FEED" />
      <Grid ColumnDefinitions="*,8,Auto">
        <ComboBox Grid.Column="0" ItemsSource="{Binding NdiSourceOptions}"
                  SelectedItem="{Binding ActivePattern.Media.NdiSourceName, Mode=TwoWay}"
                  PlaceholderText="NDI sources on the network…" />
        <Button Grid.Column="2" Classes="chip" Content="Refresh" Command="{Binding RefreshNdiSourcesCommand}" />
      </Grid>
      <TextBox Margin="0,4,0,0" Watermark="…or type the exact source name (pre-show, before the feed exists)"
               Text="{Binding ActivePattern.Media.NdiSourceName, Mode=TwoWay}" />
      <Grid ColumnDefinitions="86,*" Margin="0,4,0,0">
        <TextBlock Classes="label" Text="Nickname" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Watermark="e.g. Camera 1 (shown in the multiview and status)"
                 Text="{Binding InputNickname, Mode=TwoWay}" />
      </Grid>
      <TextBlock Classes="hint tip"
                 Text="Receives a live NDI® video feed and composites it like any pattern — it reaches spans, trims and NDI outputs. The list refreshes itself while this panel is active; senders appear a few seconds after they start. Needs the NDI runtime (see the NDI page). Video only — feed audio is not passed through." />
    </StackPanel>

    <!-- Capture device -->
    <StackPanel IsVisible="{Binding ActivePattern.Media.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:MediaSource.Capture}}">
      <TextBlock Classes="h2" Text="CAPTURE DEVICE" />
      <Grid ColumnDefinitions="*,8,Auto">
        <ComboBox Grid.Column="0" ItemsSource="{Binding CaptureDeviceOptions}"
                  SelectedItem="{Binding ActivePattern.Media.CaptureDevice, Mode=TwoWay}"
                  PlaceholderText="Video capture devices…" />
        <Button Grid.Column="2" Classes="chip" Content="Refresh" Command="{Binding RefreshCaptureDevicesCommand}" />
      </Grid>
      <TextBox Margin="0,4,0,0" Watermark="…or type the exact device name (pre-show, before the card is plugged in)"
               Text="{Binding ActivePattern.Media.CaptureDevice, Mode=TwoWay}" />
      <Grid ColumnDefinitions="86,*" Margin="0,4,0,0">
        <TextBlock Classes="label" Text="Format" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding CaptureFormat.Options}"
                  SelectedItem="{Binding CaptureFormat.Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" />
      </Grid>
      <Grid ColumnDefinitions="86,*" Margin="0,4,0,0">
        <TextBlock Classes="label" Text="Nickname" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Watermark="e.g. Podium cam (shown in the multiview and status)"
                 Text="{Binding InputNickname, Mode=TwoWay}" />
      </Grid>
      <TextBlock Classes="hint tip"
                 Text="HDMI/SDI capture cards (Elgato, Magewell, Blackmagic WDM, AVerMedia…) and webcams — anything with a DirectShow driver. Low-latency confidence video through libVLC; device audio is not passed through. Format lists the sizes and rates the card's driver offers (its EDID to the source decides what arrives): pick the one the source sends, or leave the device's default." />
    </StackPanel>

    <!-- A deck: a PDF presentation, a page at a time; the click-through turns it -->
    <StackPanel IsVisible="{Binding ActivePattern.Media.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:MediaSource.Deck}}">
      <TextBlock Classes="h2" Text="DECK — A PDF PRESENTATION" />
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox Grid.Column="0" Watermark="A PDF — export the deck from PowerPoint, Keynote or Slides as PDF" Text="{Binding ActivePattern.Media.DeckPath, Mode=TwoWay}" />
        <Button Grid.Column="2" Classes="chip" Content="Browse…" Command="{Binding BrowseDeckCommand}" />
      </Grid>
      <Grid ColumnDefinitions="130,90,16,*" Margin="0,4,0,0">
        <TextBlock Classes="label" Text="Start at page" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" Minimum="1" Maximum="9999" Increment="1" FormatString="0" ShowButtonSpinner="False"
                       Value="{Binding ActivePattern.Media.DeckStartPage, Mode=TwoWay, Converter={StaticResource Num}}"
                       ToolTip.Tip="The page the deck opens at when a look or a cue brings it on" />
        <CheckBox Grid.Column="3" Content="At the last page, the next click GOes the standby cue (the cue stack resumes)"
                  IsChecked="{Binding ActivePattern.Media.DeckEndsWithGo, Mode=TwoWay}" VerticalAlignment="Center"
                  ToolTip.Tip="Off: the deck holds its last page and the caller GOes by hand" />
      </Grid>
      <TextBlock Classes="label" Text="{Binding DeckPageText}" TextWrapping="Wrap" Margin="0,6,0,0" />
      <WrapPanel Margin="0,4,0,0">
        <Button Classes="mini" Content="⏮ First" Command="{Binding DeckFirstCommand}" Margin="0,0,4,4" />
        <Button Classes="mini" Content="◀ Previous" Command="{Binding DeckPrevCommand}" Margin="0,0,4,4" />
        <Button Classes="chip" Content="NEXT PAGE ▶" Command="{Binding DeckNextCommand}" Margin="0,0,4,4" />
        <Button Classes="mini" Content="Last ⏭" Command="{Binding DeckLastCommand}" Margin="0,0,12,4" />
      </WrapPanel>
      <TextBlock Classes="hint tip"
                 Text="The page shows full frame at its own shape — a 4:3 deck gets bars on a 16:9 screen, never a stretch — rendered as sharp as the largest screen needs, on every output, NDI send and the stream. Once the deck is on air (through a cue, a look, or by hand) it is the click-through: the clicker's keys, NEXT / BACK on the phone, Companion's presenter keys and NEXT on the wire turn its pages, and at the last page the next click GOes the standby cue, so the cue stack resumes. A cue can turn pages too (Deck — next page / go to page), and DECK NEXT / PREV / PAGE n on the wire, OSC and Companion. The area of interest, the flips and the turn apply to a page like any picture." />
    </StackPanel>

    <!-- Web page inside the engine -->
    <StackPanel IsVisible="{Binding ActivePattern.Media.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:MediaSource.Web}}">
      <TextBlock Classes="h2" Text="WEB PAGE" />
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox Grid.Column="0" Watermark="https://example.com/schedule — or a local HTML file"
                 Text="{Binding ActivePattern.Media.WebUrl, Mode=TwoWay}" />
        <Button Grid.Column="2" Classes="chip" Content="Remember" Command="{Binding RememberWebUrlCommand}"
                ToolTip.Tip="Keep this address in the saved pages (shared with the Remote &amp; web page)" />
      </Grid>
      <!-- A YouTube, Vimeo, Slides or PowerPoint link: the service named, and FULL FRAME for the player or the deck alone -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="{Binding WebPresetNote, Converter={StaticResource NotEmpty}}">
        <Button Classes="chip" Content="FULL FRAME" Command="{Binding WebFullFrameCommand}" IsVisible="{Binding WebCanFullFrame}" VerticalAlignment="Top"
                ToolTip.Tip="Rewrite the address for the show: the player or the deck alone, no page furniture" />
        <TextBlock Classes="label" Text="{Binding WebPresetNote}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560" />
      </StackPanel>
      <Grid ColumnDefinitions="130,*" Margin="0,4,0,0">
        <TextBlock Classes="label" Text="Saved pages" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding State.Web.SavedUrls}" SelectedItem="{Binding SavedWebPick, Mode=TwoWay}"
                  PlaceholderText="Pick a remembered address…" HorizontalAlignment="Stretch" />
      </Grid>
      <Grid ColumnDefinitions="130,*,8,Auto,*" Margin="0,4,0,0">
        <TextBlock Classes="label" Text="Page size (px)" VerticalAlignment="Center"
                   ToolTip.Tip="The page's own viewport — what it lays itself out for; the picture is then fitted like any other" />
        <NumericUpDown Grid.Column="1" Minimum="320" Maximum="7680" Increment="10" FormatString="0"
                       Value="{Binding ActivePattern.Media.WebWidth, Mode=TwoWay, Converter={StaticResource Num}}" />
        <TextBlock Grid.Column="3" Classes="label" Text="×" VerticalAlignment="Center" Margin="4,0" />
        <NumericUpDown Grid.Column="4" Minimum="240" Maximum="4320" Increment="10" FormatString="0"
                       Value="{Binding ActivePattern.Media.WebHeight, Mode=TwoWay, Converter={StaticResource Num}}" />
      </Grid>
      <Grid ColumnDefinitions="130,*,44" Margin="0,4,0,0">
        <TextBlock Classes="label" Text="Zoom" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="25" Maximum="400" TickFrequency="25" Value="{Binding ActivePattern.Media.WebZoomPct, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding ActivePattern.Media.WebZoomPct, StringFormat={}{0:0}%}" />
      </Grid>
      <CheckBox Content="Show the pointer and clicks on the page (every output)" IsChecked="{Binding ActivePattern.Media.WebShowPointer, Mode=TwoWay}"
                ToolTip.Tip="Off for a page nobody drives — a kiosk schedule, a dashboard" />
      <Grid ColumnDefinitions="130,*" Margin="0,4,0,0">
        <TextBlock Classes="label" Text="Nickname" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Watermark="e.g. Schedule (shown in the multiview and status)"
                 Text="{Binding InputNickname, Mode=TwoWay}" />
      </Grid>
      <TextBlock Classes="hint tip"
                 Text="The page renders inside the engine through WebView2 (the browser engine Windows 10 and 11 ship), so it joins spans and trims, reaches NDI and the stream, and travels with looks and cues like any pattern; nothing opens outside Patterns. Drive it on the PREVIEW pane: clicks, drags and the wheel land on the page as real events; type and press keys with the PAGE CONTROLS below, or hand it the whole keyboard with KEYS → PAGE. Paste a YouTube, Vimeo, Google Slides or PowerPoint link and the line above names the service: FULL FRAME shows the player or the deck alone, and the service's own actions (NEXT, PRESENT, PLAY…) come to the PAGE CONTROLS, the phone, cues and Companion. Its sound follows Mute (SOUND, below). The same address on several targets costs one browser; up to four pages run at once." />
    </StackPanel>

    <!-- Playlist -->
    <StackPanel IsVisible="{Binding ActivePattern.Media.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:MediaSource.Playlist}}">
      <TextBlock Classes="h2" Text="SHOW PARTS" />
      <TextBlock Classes="hint tip"
                 Text="Split the playlist into parts of the show — Walk-in, Main, Break… One part plays at a time: click ▶ to put it on air (also from the remote/Companion: SECTION 2), or give it a daily start time. Files and folders below belong to the highlighted part." />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ItemsControl ItemsSource="{Binding ActivePattern.Media.Playlist.Sections}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:PlaylistSectionConfig">
                <Border Classes="tile" Classes.tileActive="{Binding IsOnAir}">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Background="Transparent" BorderThickness="0" Padding="2,3" Cursor="Hand"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SetPlaylistSectionCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="Put this part on air (and edit it below)">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="▶" FontSize="10" Foreground="#2EE68A" VerticalAlignment="Center"
                                   IsVisible="{Binding IsOnAir}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StartTime}" FontSize="10" Foreground="#8A93A3" VerticalAlignment="Center"
                                   IsVisible="{Binding StartTime, Converter={StaticResource NotEmpty}}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="mini" Content="✕" ToolTip.Tip="Delete this part (its files stay on disk)"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemovePlaylistSectionCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="chip" Content="+ Part" Command="{Binding AddPlaylistSectionCommand}"
                  VerticalAlignment="Center" />
        </StackPanel>
      </ScrollViewer>
      <Grid ColumnDefinitions="86,*" Margin="0,4,0,0">
        <TextBlock Classes="label" Text="Part name" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding ActivePlaylistSection.Name, Mode=TwoWay}" />
      </Grid>
      <Grid ColumnDefinitions="86,90,8,*" Margin="0,4,0,0">
        <TextBlock Classes="label" Text="Starts daily" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Watermark="HH:mm" Text="{Binding ActivePlaylistSection.StartTime, Mode=TwoWay}" />
        <TextBlock Grid.Column="3" Classes="hint tip" VerticalAlignment="Center"
                   Text="optional — takes over at this time (24 h)" />
      </Grid>

      <TextBlock Classes="h2" Text="FILES IN THIS PART" />
      <Grid ColumnDefinitions="Auto,8,Auto,*">
        <Button Grid.Column="0" Classes="chip" Content="+ Add files…" Command="{Binding AddPlaylistFilesCommand}" />
        <Button Grid.Column="2" Classes="chip" Content="+ Add folder…" Command="{Binding AddPlaylistFolderCommand}" />
      </Grid>
      <TextBlock Classes="label" Text="{Binding PlaylistStatus}" Margin="0,4,0,2" TextWrapping="Wrap" />

      <ItemsControl x:Name="PlaylistList" ItemsSource="{Binding ActivePlaylistSection.Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:PlaylistItemConfig">
            <Border Classes="plrow" Background="{StaticResource PanelBg2Brush}" CornerRadius="8"
                    Padding="7,6" Margin="0,2">
              <Grid ColumnDefinitions="Auto,8,Auto,8,*,6,Auto,6,Auto,6,Auto">
                <Border Grid.Column="0" Classes="plhandle" Background="#262B36" CornerRadius="5"
                        Padding="4,2" VerticalAlignment="Center" Cursor="SizeNorthSouth"
                        ToolTip.Tip="Drag to re-order">
                  <TextBlock Text="≡" FontSize="14" Foreground="#8A93A3" />
                </Border>
                <Border Grid.Column="2" Background="#20242E" CornerRadius="5" Padding="5,2" VerticalAlignment="Center">
                  <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#8A93A3"
                             Text="{Binding Path, Converter={StaticResource MediaKind}}" />
                </Border>
                <TextBlock Grid.Column="4" Text="{Binding Path, Converter={StaticResource FileName}}"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                <Border Grid.Column="6" Background="#123A26" CornerRadius="7" Padding="6,2" VerticalAlignment="Center"
                        IsVisible="{Binding IsNowPlaying}">
                  <TextBlock Text="▶ NOW" FontSize="10" FontWeight="SemiBold" Foreground="#2EE68A" />
                </Border>
                <Border Grid.Column="8" Background="#20242E" CornerRadius="7" Padding="6,2" VerticalAlignment="Center"
                        IsVisible="{Binding ScheduledTime, Converter={StaticResource NotEmpty}}"
                        ToolTip.Tip="Plays daily at this time">
                  <TextBlock FontSize="10" Foreground="#C8D0DC" Text="{Binding ScheduledTime, StringFormat='⏱ {0}'}" />
                </Border>
                <Button Grid.Column="10" Classes="mini" Content="✕" ToolTip.Tip="Remove from playlist"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemovePlaylistItemCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="hint tip"
                 Text="Drag the ≡ handle to re-order — items play top to bottom (or shuffled). Click a row to edit its timing below." />

      <!-- Selected item timing -->
      <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10,8"
              IsVisible="{Binding HasPlaylistItemSelection}" Margin="0,4,0,0">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     Text="{Binding SelectedPlaylistItem.Path, Converter={StaticResource FileName}, FallbackValue=''}" />
          <Grid ColumnDefinitions="Auto,6,58,12,Auto,6,58,6,Auto,6,*" Margin="0,6,0,0">
            <TextBlock Grid.Column="0" Classes="label" Text="Hold s" VerticalAlignment="Center"
                       ToolTip.Tip="Seconds on screen; 0 = default (image dwell / full video or audio length)" />
            <NumericUpDown Grid.Column="2" Minimum="0" Maximum="86400" Increment="5" FormatString="0" ShowButtonSpinner="False"
                           Value="{Binding SelectedPlaylistItem.DurationSeconds, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" />
            <TextBlock Grid.Column="4" Classes="label" Text="At" VerticalAlignment="Center"
                       ToolTip.Tip="Daily play time (24 h HH:mm) — interrupts the cycle; blank = plays in turn" />
            <TextBox Grid.Column="6" Watermark="HH:mm" Text="{Binding SelectedPlaylistItem.ScheduledTime, FallbackValue=''}" />
            <TextBlock Grid.Column="8" Classes="label" Text="for s" VerticalAlignment="Center"
                       ToolTip.Tip="How long the timed interruption holds before the cycle resumes" />
            <NumericUpDown Grid.Column="10" Minimum="1" Maximum="86400" Increment="10" FormatString="0" ShowButtonSpinner="False"
                           Value="{Binding SelectedPlaylistItem.ScheduledDurationSeconds, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=60}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="h2" Text="PLAYLIST — FOLDERS" />
      <ItemsControl ItemsSource="{Binding ActivePlaylistSection.Folders}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Grid ColumnDefinitions="*,6,Auto" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
              <Button Grid.Column="2" Classes="mini" Content="✕"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemovePlaylistFolderCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="hint tip"
                 Text="Folder media (scanned with subfolders) plays after the items above, sorted by name. New files are picked up automatically." />

      <TextBlock Classes="h2" Text="PLAYLIST — PLAYBACK" />
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Image dwell (s)" />
        <NumericUpDown Grid.Column="1" Minimum="1" Maximum="3600" Increment="1" FormatString="0"
                       Value="{Binding ActivePattern.Media.Playlist.ImageDwellSeconds, Mode=TwoWay, Converter={StaticResource Num}}" />
      </Grid>
      <CheckBox Content="Play videos to their end" IsChecked="{Binding ActivePattern.Media.Playlist.VideoFullLength}" />
      <CheckBox Content="Shuffle (seeded — same order until reshuffled)" IsChecked="{Binding ActivePattern.Media.Playlist.Shuffle}" />
      <Grid ColumnDefinitions="130,*" IsVisible="{Binding ActivePattern.Media.Playlist.Shuffle}">
        <TextBlock Classes="label" Text="Shuffle seed" />
        <NumericUpDown Grid.Column="1" Minimum="1" Maximum="99999" Increment="1" FormatString="0"
                       Value="{Binding ActivePattern.Media.Playlist.ShuffleSeed, Mode=TwoWay, Converter={StaticResource Num}}" />
      </Grid>
      <CheckBox Content="Include images" IsChecked="{Binding ActivePattern.Media.Playlist.IncludeImages}" />
      <CheckBox Content="Include videos &amp; audio" IsChecked="{Binding ActivePattern.Media.Playlist.IncludeVideos}" />
      <TextBlock Classes="hint tip"
                 Text="The playlist loops continuously while this pattern is live. '⏱ HH:mm' items interrupt daily at that time, then the cycle resumes." />
    </StackPanel>

    <!-- The area of interest: crop, flip, turn — any source -->
    <TextBlock Classes="h2" Text="AREA OF INTEREST — CROP, FLIP, TURN" />
    <Grid ColumnDefinitions="Auto,8,Auto,8,*">
      <ToggleButton Classes="chip" Content="PICK ON PREVIEW" IsChecked="{Binding CropPickActive, Mode=TwoWay}"
                    ToolTip.Tip="Then drag a box on the PREVIEW pane around the part of the picture to keep — the slide, the shared screen, the caller — and the rest is cut away; a second pick refines the first" />
      <Button Grid.Column="2" Classes="mini" Content="Clear" Command="{Binding ClearCropCommand}" ToolTip.Tip="The whole picture again" />
      <TextBlock Grid.Column="4" Classes="label" Text="{Binding CropSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Grid>
    <WrapPanel Margin="0,4,0,0">
      <TextBlock Classes="hint" Text="Start from: " VerticalAlignment="Center" Margin="0,0,6,6" />
      <Button Classes="mini" Content="Top bar off" Margin="0,0,4,6" Command="{Binding CropPresetCommand}" CommandParameter="top:8" ToolTip.Tip="Cut 8% from the top — a title bar, a tab strip" />
      <Button Classes="mini" Content="Side panel off" Margin="0,0,4,6" Command="{Binding CropPresetCommand}" CommandParameter="right:25" ToolTip.Tip="Cut 25% from the right — a participants strip, a chat panel" />
      <Button Classes="mini" Content="Bottom strip off" Margin="0,0,4,6" Command="{Binding CropPresetCommand}" CommandParameter="bottom:12" ToolTip.Tip="Cut 12% from the bottom — a toolbar, presenter notes" />
      <Button Classes="mini" Content="Centre 80%" Margin="0,0,4,6" Command="{Binding CropPresetCommand}" CommandParameter="centre:80" ToolTip.Tip="Keep the middle 80% — a light zoom that loses every edge" />
    </WrapPanel>
    <Grid ColumnDefinitions="130,*,44" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
      <TextBlock Grid.Row="0" Classes="label" Text="Cut left" VerticalAlignment="Center" />
      <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding ActivePattern.Media.CropLeftPct, Mode=TwoWay}" />
      <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ActivePattern.Media.CropLeftPct, StringFormat={}{0:0}%}" />
      <TextBlock Grid.Row="1" Classes="label" Text="Cut right" VerticalAlignment="Center" />
      <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding ActivePattern.Media.CropRightPct, Mode=TwoWay}" />
      <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ActivePattern.Media.CropRightPct, StringFormat={}{0:0}%}" />
      <TextBlock Grid.Row="2" Classes="label" Text="Cut top" VerticalAlignment="Center" />
      <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding ActivePattern.Media.CropTopPct, Mode=TwoWay}" />
      <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ActivePattern.Media.CropTopPct, StringFormat={}{0:0}%}" />
      <TextBlock Grid.Row="3" Classes="label" Text="Cut bottom" VerticalAlignment="Center" />
      <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding ActivePattern.Media.CropBottomPct, Mode=TwoWay}" />
      <TextBlock Grid.Row="3" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ActivePattern.Media.CropBottomPct, StringFormat={}{0:0}%}" />
    </Grid>
    <Grid ColumnDefinitions="130,*,8,Auto,8,Auto" Margin="0,4,0,0">
      <TextBlock Classes="label" Text="Turn" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding ActivePattern.Media.RotateQuarters, Mode=TwoWay}"
                ToolTip.Tip="A portrait feed on a landscape screen, a camera on its side">
        <ComboBoxItem Content="Upright" />
        <ComboBoxItem Content="90° clockwise" />
        <ComboBoxItem Content="180°" />
        <ComboBoxItem Content="90° anticlockwise" />
      </ComboBox>
      <CheckBox Grid.Column="3" Content="Mirror" IsChecked="{Binding ActivePattern.Media.FlipHorizontal, Mode=TwoWay}"
                ToolTip.Tip="Left and right swapped — a confidence monitor read in a mirror, a camera that flips" />
      <CheckBox Grid.Column="5" Content="Upside down" IsChecked="{Binding ActivePattern.Media.FlipVertical, Mode=TwoWay}"
                ToolTip.Tip="Top and bottom swapped — a camera mounted the wrong way up" />
    </Grid>
    <TextBlock Classes="hint tip"
               Text="An input rarely arrives clean: a Teams call keeps its participants strip beside the shared screen, Google Slides in a browser keeps its filmstrip and notes, a presenter view keeps its toolbar. The area of interest cuts all of that away before the picture is fitted, so the room sees the slide alone, edge to edge — on every screen, NDI send and the stream, and in every look and cue that carries this pattern. PICK ON PREVIEW is the quick way: drag a box on the PREVIEW pane around the part to keep; a second pick refines it, and the sliders fine-tune to the percent (each side up to 90%; a twentieth of the picture always survives). Turn and the flips put a sideways or mirrored feed the right way up. The same crop sits on the PiP inset and on a layer in their own settings; a web page keeps its clicks through the crop while it is upright." />

    <!-- Sound (video, audio, playlist) -->
    <StackPanel IsVisible="{Binding ActivePattern.Media.Source, Converter={StaticResource NotEq}, ConverterParameter={x:Static m:MediaSource.Image}}">
      <TextBlock Classes="h2" Text="SOUND" />
      <CheckBox Content="Mute" IsChecked="{Binding ActivePattern.Media.Mute}" />
      <Grid ColumnDefinitions="130,*,44">
        <TextBlock Classes="label" Text="Volume" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="0" Maximum="125" TickFrequency="5"
                Value="{Binding ActivePattern.Media.VolumePct, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding ActivePattern.Media.VolumePct, StringFormat={}{0:0}%}" />
      </Grid>
      <TextBlock Classes="hint tip"
                 Text="Plays on the default Windows audio device. 100% = source level; above 100 uses libVLC's software gain. Mute and volume apply live — the media never restarts." />
    </StackPanel>

    <TextBlock Classes="hint tip"
               Text="Video decoding uses libVLC when available: the 'full' build ships it; otherwise install 64-bit VLC or put a 'libvlc' folder beside Patterns.exe. Images always work." />

    <TextBlock Classes="h2" Text="FIT" />
    <ComboBox ItemsSource="{Binding FitModes}"
              SelectedValue="{Binding ActivePattern.Media.Fit, Mode=TwoWay}"
              SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
    <Grid ColumnDefinitions="130,*">
      <TextBlock Classes="label" Text="Background" />
      <c:ColorField Grid.Column="1" Value="{Binding ActivePattern.Media.BackgroundColor, Mode=TwoWay}" />
    </Grid>

    <!-- Layers: two pictures over this target's pattern, whatever its kind -->
    <TextBlock Classes="h2" Text="LAYERS" />
    <TextBlock Classes="hint tip"
               Text="Two pictures over this target's pattern, whatever it is — a still, a clip, an NDI feed, a capture device, or another screen's picture — each in a box you drag on the PREVIEW pane (or set below), with a fit, a crop, corners, a border and an opacity. They belong to the pattern, so they travel with looks and cues and reach spans, NDI and the stream; they draw under the overlays and the lower third. Dragging never starts a crossfade; a new picture fades in." />
    <Border Classes="panel" Padding="10" Margin="0,4,0,0">
      <StackPanel>
        <TextBlock Classes="label" Text="LAYER 1" FontWeight="Bold" Margin="0,0,0,4" />
        <ContentControl Content="{Binding ActivePattern.Layer1}" ContentTemplate="{StaticResource LayerEditor}" />
      </StackPanel>
    </Border>
    <Border Classes="panel" Padding="10" Margin="0,6,0,0">
      <StackPanel>
        <TextBlock Classes="label" Text="LAYER 2" FontWeight="Bold" Margin="0,0,0,4" />
        <ContentControl Content="{Binding ActivePattern.Layer2}" ContentTemplate="{StaticResource LayerEditor}" />
      </StackPanel>
    </Border>

    <!-- Page controls: the keyboard for a web page shown by the pattern or a layer -->
    <StackPanel IsVisible="{Binding HasWebPage}">
      <TextBlock Classes="h2" Text="PAGE CONTROLS" />
      <TextBlock Classes="label" Text="{Binding WebControlsTarget}" TextWrapping="Wrap" />
      <WrapPanel Margin="0,4,0,0">
        <ToggleButton Classes="chip" Content="⌨ KEYS → PAGE" Margin="0,0,8,4" IsChecked="{Binding KeysToPage, Mode=TwoWay}"
                      ToolTip.Tip="The keyboard belongs to the page — F5 starts a PowerPoint, the arrows move a deck, k plays a YouTube video, a search box or a sign-in takes typing. Press again or Ctrl+Alt+K to get the desk's keys back" />
        <!-- The page's own actions, from its service: YouTube's player, a deck's slides, a plain page's keys -->
        <ItemsControl ItemsSource="{Binding WebPageActions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WebActionChip">
              <Button Classes="mini" Content="{Binding Label}" Margin="0,0,4,4" ToolTip.Tip="{Binding Hint}"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).WebActionCommand}" CommandParameter="{Binding Id}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </WrapPanel>
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox Grid.Column="0" Watermark="Type into the page — the field you last clicked on the PREVIEW pane…"
                 Text="{Binding WebTypedText, Mode=TwoWay}" />
        <Button Grid.Column="2" Classes="chip" Content="SEND" Command="{Binding SendWebTextCommand}" />
      </Grid>
      <WrapPanel Margin="0,4,0,0">
        <Button Classes="mini" Content="Enter" Command="{Binding WebKeyCommand}" CommandParameter="Enter" Margin="0,0,4,4" />
        <Button Classes="mini" Content="Tab" Command="{Binding WebKeyCommand}" CommandParameter="Tab" Margin="0,0,4,4" />
        <Button Classes="mini" Content="Esc" Command="{Binding WebKeyCommand}" CommandParameter="Escape" Margin="0,0,4,4" />
        <Button Classes="mini" Content="⌫" Command="{Binding WebKeyCommand}" CommandParameter="Backspace" Margin="0,0,4,4" />
        <Button Classes="mini" Content="Space" Command="{Binding WebKeyCommand}" CommandParameter="Space" Margin="0,0,4,4" />
        <Button Classes="mini" Content="↑" Command="{Binding WebKeyCommand}" CommandParameter="ArrowUp" Margin="0,0,4,4" />
        <Button Classes="mini" Content="↓" Command="{Binding WebKeyCommand}" CommandParameter="ArrowDown" Margin="0,0,4,4" />
        <Button Classes="mini" Content="←" Command="{Binding WebKeyCommand}" CommandParameter="ArrowLeft" Margin="0,0,4,4" />
        <Button Classes="mini" Content="→" Command="{Binding WebKeyCommand}" CommandParameter="ArrowRight" Margin="0,0,4,4" />
        <Button Classes="mini" Content="PgUp" Command="{Binding WebKeyCommand}" CommandParameter="PageUp" Margin="0,0,4,4" />
        <Button Classes="mini" Content="PgDn" Command="{Binding WebKeyCommand}" CommandParameter="PageDown" Margin="0,0,4,4" />
        <Button Classes="mini" Content="Home" Command="{Binding WebKeyCommand}" CommandParameter="Home" Margin="0,0,4,4" />
        <Button Classes="mini" Content="End" Command="{Binding WebKeyCommand}" CommandParameter="End" Margin="0,0,12,4" />
        <Button Classes="mini" Content="◀ Back" Command="{Binding WebBackCommand}" Margin="0,0,4,4" />
        <Button Classes="mini" Content="Forward ▶" Command="{Binding WebForwardCommand}" Margin="0,0,4,4" />
        <Button Classes="mini" Content="Reload" Command="{Binding WebReloadCommand}" Margin="0,0,4,4" />
      </WrapPanel>
      <TextBlock Classes="label" Text="{Binding WebPageStatus}" TextWrapping="Wrap" />
      <TextBlock Classes="hint tip"
                 Text="The controls drive the page you last clicked on the PREVIEW pane (else the pattern's page, else its first web layer). Typing goes to the field that has the page's focus — click it first. The action chips are the page's own: on YouTube they drive the player itself, on Google Slides and PowerPoint for the web they are the slide keys, on any other page the arrows and page keys. KEYS → PAGE hands the page the whole keyboard until you press it again or Ctrl+Alt+K. Hold Alt while pressing on a web layer to drag its box instead of clicking into the page. The same actions run from a cue (Web page — key or action), the wire (WEB NEXT, WEB KEY …), OSC, the phone's SHOW tab and Companion." />
    </StackPanel>
  </StackPanel>
</UserControl>
