<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             x:Class="Patterns.App.Views.Sections.AssistantSection"
             Classes="hue-assistant"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <!-- The conversation reads newest first and has room: a turn is a card with air around its
         words, the type a size up from a label, the answer's proposals as cards inside it. -->
    <Style Selector="Border.turn">
      <Setter Property="Background" Value="{StaticResource PanelBg2Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,5" />
    </Style>
    <Style Selector="Border.turn.mine">
      <Setter Property="BorderBrush" Value="#3EC1F3" />
      <Setter Property="Background" Value="#14232E" />
    </Style>
    <Style Selector="Border.turn.declined">
      <Setter Property="BorderBrush" Value="#FF9E58" />
    </Style>
    <Style Selector="Border.turn.latest">
      <Setter Property="BorderBrush" Value="#7CF5C8" />
    </Style>
    <Style Selector="Border.proposal">
      <Setter Property="Background" Value="#0F1A1A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#3A7CF5C8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Border.proposal.applied">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="TextBlock.who">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.turnText">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="23" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.proposalTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.ask">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
  </UserControl.Styles>

  <StackPanel Classes="form" Margin="4,8,12,16" Spacing="6">
    <TextBlock Classes="h1 neon-assistant" Text="Assistant" />
    <TextBlock Classes="hint tip"
               Text="An assistant for building the show: say how many screens you have, what the day looks like, which overlays you want, and it drafts planned screens, looks, cues, lower thirds and a brand as proposals — APPLY the ones you want; nothing changes until you do. A proposal that draws lands in the PREVIEW (EDIT SAFE opens if it was off) with the editing target on Program: what is on air stays exactly as it is until you press TAKE or CUT. It talks about Patterns and live-event AV only, never about how Patterns works inside. It needs the internet and your own Anthropic API key; the key lives beside the settings file on this machine, never in a show file. What it sees of your show: names and counts — screens, looks, cues, designs, overlays, the brand's colours — never a file, an address, a passcode or a key." />

    <TextBlock Classes="h2" Text="KEY" />
    <TextBlock Classes="hint" Text="{Binding AssistantKeyText}" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,6,Auto,6,Auto">
      <TextBox Text="{Binding AssistantKeyDraft, Mode=TwoWay}" PasswordChar="•" Watermark="Paste an Anthropic API key (sk-ant-…) — from your own account at console.anthropic.com" />
      <Button Grid.Column="2" Classes="mini" Content="SAVE KEY" Command="{Binding SaveAssistantKeyCommand}" ToolTip.Tip="Kept beside the settings file on this machine; nothing is sent until a question is asked" />
      <Button Grid.Column="4" Classes="mini" Content="FORGET" Command="{Binding ForgetAssistantKeyCommand}" IsVisible="{Binding HasAssistantKey}" ToolTip.Tip="The key leaves this machine; the assistant is off" />
    </Grid>

    <TextBlock Classes="h2" Text="ASK" />
    <Grid ColumnDefinitions="*,8,Auto">
      <TextBox Classes="ask" Text="{Binding AssistantInput, Mode=TwoWay}" IsEnabled="{Binding CanAskAssistant}" TextWrapping="Wrap"
               Watermark="Two screens, a walk-in look, a keynote at ten and a break at eleven — plan it for me…">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding AskAssistantCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="2" Content="ASK" Command="{Binding AskAssistantCommand}" IsEnabled="{Binding CanAskAssistant}" VerticalAlignment="Stretch" Padding="18,8" FontWeight="Bold" ToolTip.Tip="Enter asks too" />
    </Grid>
    <ItemsControl ItemsSource="{Binding AssistantStarters}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Button Classes="mini" Margin="0,0,6,6" Content="{Binding}"
                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AssistantStarterCommand}"
                  CommandParameter="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="label" Text="{Binding AssistantStatus}" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAssistantRows}" Margin="0,6,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Classes="h2" Text="CONVERSATION" Margin="0" />
        <TextBlock Classes="hint" Text="newest first" VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="1" Classes="mini" Content="CLEAR" Command="{Binding ClearAssistantCommand}" ToolTip.Tip="Start afresh — the assistant forgets this session's turns" />
    </Grid>
    <ItemsControl ItemsSource="{Binding AssistantRows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AssistantRow">
          <Border Classes="turn" Classes.mine="{Binding IsMine}" Classes.declined="{Binding IsDeclined}" Classes.latest="{Binding IsLatest}">
            <StackPanel Spacing="6">
              <TextBlock Classes="who" Text="{Binding Who}" />
              <TextBlock Classes="turnText" Text="{Binding Text}" />
              <TextBlock Classes="turnText" Text="{Binding QuestionsText}" IsVisible="{Binding HasQuestions}" Foreground="#FFC24D" />
              <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssistantChip">
                    <Border Classes="proposal" Classes.applied="{Binding IsApplied}">
                      <Grid ColumnDefinitions="*,12,Auto">
                        <StackPanel Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="who" Text="{Binding Kind}" Foreground="#7CF5C8" VerticalAlignment="Center" />
                            <TextBlock Classes="proposalTitle" Text="{Binding Title}" />
                          </StackPanel>
                          <TextBlock Classes="turnText" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" />
                          <TextBlock Classes="hint" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                          <TextBlock Classes="turnText" Text="{Binding StepsText}" IsVisible="{Binding HasSteps}" />
                          <TextBlock Classes="hint" Text="{Binding AppliedText}" IsVisible="{Binding IsApplied}" Foreground="#2EE68A" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="APPLY" Command="{Binding ApplyCommand}" IsVisible="{Binding CanApply}" VerticalAlignment="Top" Padding="14,6" FontWeight="Bold"
                                ToolTip.Tip="Into the show now: a picture lands in the PREVIEW (EDIT SAFE opens if it was off) and TAKE or CUT puts it on air; planned screens, the brand, looks saved, designs added and cues appended go straight to their lists" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="h2" Text="WHAT IT WILL AND WILL NOT DO" />
    <TextBlock Classes="hint" TextWrapping="Wrap"
               Text="Will: plan screens by size and role (one planned screen per physical screen — a wall fed by several outputs is one screen of the wall's size), propose looks with their overlays, write a cue stack for the day with planned times, draft lower thirds from the presets, set the brand's colours, explain the workflow on Patterns' pages, and answer questions about live-event AV. Will not: touch the show without APPLY, put anything on air (a picture it proposes builds in the preview; TAKE or CUT is yours), pick files or addresses (those are yours, by hand), talk about anything outside Patterns and the show, or say how Patterns works inside. Every answer is checked on this side too: a question about its own instructions or Patterns' internals never leaves the machine." />
  </StackPanel>
</UserControl>
