<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:c="using:Patterns.App.Views.Controls"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.LayersSection"
             Classes="hue-layers"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!-- One layer's editor: the source, its box, how it sits, its edges -->
    <DataTemplate x:Key="LayerEditor" x:DataType="m:LayerConfig">
      <StackPanel Spacing="4">
        <CheckBox Content="On" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <Grid ColumnDefinitions="86,*">
          <TextBlock Classes="label" Text="Source" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LayerSources}"
                    SelectedValue="{Binding Source, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
        </Grid>
        <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Image}}">
          <TextBox Watermark="PNG, JPEG, BMP, WebP…" Text="{Binding ImagePath, Mode=TwoWay}" />
          <Button Grid.Column="2" Classes="chip" Content="Browse…"
                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).BrowseLayerImageCommand}" CommandParameter="{Binding}" />
        </Grid>
        <StackPanel Spacing="4" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Video}}">
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Watermark="MP4, MOV, MKV…" Text="{Binding VideoPath, Mode=TwoWay}" />
            <Button Grid.Column="2" Classes="chip" Content="Browse…"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).BrowseLayerVideoCommand}" CommandParameter="{Binding}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox Content="Loop" IsChecked="{Binding Loop, Mode=TwoWay}" />
            <CheckBox Content="Mute" IsChecked="{Binding Mute, Mode=TwoWay}" />
          </StackPanel>
          <Grid ColumnDefinitions="86,*,44">
            <TextBlock Classes="label" Text="Volume" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="0" Maximum="125" TickFrequency="5" Value="{Binding VolumePct, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding VolumePct, StringFormat={}{0:0}%}" />
          </Grid>
        </StackPanel>
        <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.NdiFeed}}">
          <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Media.NdiSourceOptions}"
                    SelectedItem="{Binding NdiSourceName, Mode=TwoWay}" PlaceholderText="NDI sources on the network…" />
          <Button Grid.Column="2" Classes="chip" Content="Refresh"
                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Media.RefreshNdiSourcesCommand}" />
        </Grid>
        <TextBox IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.NdiFeed}}"
                 Watermark="…or type the exact source name" Text="{Binding NdiSourceName, Mode=TwoWay}" />
        <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Capture}}">
          <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Media.CaptureDeviceOptions}"
                    SelectedItem="{Binding CaptureDevice, Mode=TwoWay}" PlaceholderText="Capture devices…" />
          <Button Grid.Column="2" Classes="chip" Content="Refresh"
                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Media.RefreshCaptureDevicesCommand}" />
        </Grid>
        <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Arcade}}"
                   Text="This machine's game in the box, straight from the game loop — the Arcade page runs it, ARCADE SIZE shapes it." />
        <Button Classes="mini" Content="OPEN ARCADE" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Arcade}}"
                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenPageCommand}" CommandParameter="Arcade" />
        <ComboBox IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Screen}}"
                  ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MultiviewTargets}"
                  SelectedValue="{Binding TargetId, Mode=TwoWay}"
                  SelectedValueBinding="{Binding ScreenId, x:DataType=vm:EditTarget}"
                  PlaceholderText="Which screen or canvas…" />
        <StackPanel Spacing="4" IsVisible="{Binding Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:LayerSource.Web}}">
          <TextBox Watermark="https://example.com/live — or a local HTML file" Text="{Binding WebUrl, Mode=TwoWay}" />
          <Grid ColumnDefinitions="86,*,8,Auto,*">
            <TextBlock Classes="label" Text="Page (px)" VerticalAlignment="Center" ToolTip.Tip="The page's own viewport — what it lays itself out for; the picture is then fitted into the box" />
            <NumericUpDown Grid.Column="1" Minimum="320" Maximum="7680" Increment="10" FormatString="0" Value="{Binding WebWidth, Mode=TwoWay, Converter={StaticResource Num}}" />
            <TextBlock Grid.Column="3" Classes="label" Text="×" VerticalAlignment="Center" Margin="4,0" />
            <NumericUpDown Grid.Column="4" Minimum="240" Maximum="4320" Increment="10" FormatString="0" Value="{Binding WebHeight, Mode=TwoWay, Converter={StaticResource Num}}" />
          </Grid>
          <Grid ColumnDefinitions="86,*,44">
            <TextBlock Classes="label" Text="Zoom" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="25" Maximum="400" TickFrequency="25" Value="{Binding WebZoomPct, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding WebZoomPct, StringFormat={}{0:0}%}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox Content="Show the pointer" IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).State.Web.ShowPointer, Mode=TwoWay}"
                      ToolTip.Tip="The desk's own switch, the same as the Media page's: the pointer and its clicks on every web page, off by default, kept with the show" />
            <CheckBox Content="Mute" IsChecked="{Binding Mute, Mode=TwoWay}" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,8,90,8,Auto">
            <CheckBox Content="Play the video from" IsChecked="{Binding WebAutoPlay, Mode=TwoWay}" VerticalAlignment="Center"
                      ToolTip.Tip="The armed web VT carried by the look: when this layer goes to air its video plays from the point beside (seconds; 0 = the top), and a cue ahead opens the page early, held there" />
            <NumericUpDown Grid.Column="2" Minimum="0" Maximum="86400" Increment="1" FormatString="0" IsEnabled="{Binding WebAutoPlay}"
                           Value="{Binding WebStartSeconds, Mode=TwoWay, Converter={StaticResource Num}}" />
            <TextBlock Grid.Column="4" Classes="label" Text="s when it goes to air" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="Auto,8,*">
            <TextBlock Classes="label" Text="Frames" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:Lists.WebSmoothings}" HorizontalAlignment="Stretch"
                      SelectedValue="{Binding WebSmoothing, Mode=TwoWay}" SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}"
                      ToolTip.Tip="How this layer's page reaches the glass: Auto smooths a video and shows a live page at once; Smooth and Low latency choose outright (round 68)" />
          </Grid>
        </StackPanel>

        <TextBlock Classes="label" Text="Box (% of the canvas — or drag it on the PREVIEW pane)" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="86,*,44" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="label" Text="Left" VerticalAlignment="Center" />
          <Slider Grid.Row="0" Grid.Column="1" Minimum="-50" Maximum="100" Value="{Binding XPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding XPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="1" Classes="label" Text="Top" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="-50" Maximum="100" Value="{Binding YPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding YPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Width" VerticalAlignment="Center" />
          <Slider Grid.Row="2" Grid.Column="1" Minimum="2" Maximum="150" Value="{Binding WPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding WPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Height" VerticalAlignment="Center" />
          <Slider Grid.Row="3" Grid.Column="1" Minimum="2" Maximum="150" Value="{Binding HPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding HPct, StringFormat={}{0:0}%}" />
        </Grid>
        <Grid ColumnDefinitions="86,*">
          <TextBlock Classes="label" Text="Fit" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FitModes}"
                    SelectedValue="{Binding Fit, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
        </Grid>
        <Grid ColumnDefinitions="86,*,44">
          <TextBlock Classes="label" Text="Opacity" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" />
          <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Opacity, StringFormat={}{0:0.00}}" />
        </Grid>
        <!-- Round 63: how the layer arrives and leaves — switched on or off, or showing a new picture -->
        <Grid ColumnDefinitions="86,*,8,Auto,96">
          <TextBlock Classes="label" Text="Appears" VerticalAlignment="Center"
                     ToolTip.Tip="How this layer arrives and leaves when it is switched on or off, or shows a new picture: a fade, a cut, or a slide in from the nearest edge. 0 ms is the show's transition time" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AppearKinds}"
                    SelectedValue="{Binding Appear.Kind, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
          <TextBlock Grid.Column="3" Classes="label" Text="ms" VerticalAlignment="Center" Margin="8,0,4,0" />
          <NumericUpDown Grid.Column="4" Minimum="0" Maximum="3000" Increment="50" FormatString="0"
                         Value="{Binding Appear.DurationMs, Mode=TwoWay, Converter={StaticResource Num}}" />
        </Grid>
        <Grid ColumnDefinitions="86,*,8,86,*">
          <TextBlock Classes="label" Text="Corners (px)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="500" Increment="2" FormatString="0" Value="{Binding CornerPx, Mode=TwoWay, Converter={StaticResource Num}}" />
          <TextBlock Grid.Column="3" Classes="label" Text="Border (px)" VerticalAlignment="Center" Margin="8,0,0,0" />
          <NumericUpDown Grid.Column="4" Minimum="0" Maximum="200" Increment="1" FormatString="0" Value="{Binding BorderPx, Mode=TwoWay, Converter={StaticResource Num}}" />
        </Grid>
        <Grid ColumnDefinitions="86,*">
          <TextBlock Classes="label" Text="Border colour" VerticalAlignment="Center" />
          <c:ColorField Grid.Column="1" Value="{Binding BorderColor, Mode=TwoWay}" />
        </Grid>
        <TextBlock Classes="label" Text="Crop (% cut away on each side)" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="86,*,44" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="label" Text="Left" VerticalAlignment="Center" />
          <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding CropLeftPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding CropLeftPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="1" Classes="label" Text="Right" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding CropRightPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding CropRightPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Top" VerticalAlignment="Center" />
          <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding CropTopPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding CropTopPct, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Bottom" VerticalAlignment="Center" />
          <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="45" Value="{Binding CropBottomPct, Mode=TwoWay}" />
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding CropBottomPct, StringFormat={}{0:0}%}" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The layers' own page on the BUILD rail, before the library and the assistant: the two pictures over
       the editing target's pattern, whatever its kind -->
  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-layers" Text="Layers" />
    <TextBlock Classes="hint tip"
               Text="Two pictures over the target's pattern, whatever it is — a still, a clip, an NDI feed, a capture device, a web page or another screen's picture — each in a box you drag on the PREVIEW pane (or set below), with a fit, a crop, corners, a border and an opacity. They belong to the pattern, so they travel with looks and cues and reach spans, NDI and the stream; they draw under the overlays and the lower third. Dragging never starts a crossfade; a new picture fades in." />

    <StackPanel IsVisible="{Binding ShowEditTargets}">
      <TextBlock Classes="h2" Text="EDITING TARGET" />
      <ComboBox ItemsSource="{Binding EditTargets}" SelectedItem="{Binding EditTarget, Mode=TwoWay}" />
      <TextBlock Classes="hint tip" Text="Whose layers these are — the program's, or a screen with its own pattern. The preview follows." />
    </StackPanel>
    <TextBlock Classes="label" Text="{Binding EditTargetBanner}" TextWrapping="Wrap" />

    <TextBlock Classes="h2" Text="LAYER 1" />
    <Border Classes="panel" Padding="10" c:Menus.Kind="layer" c:Menus.Subject="layer1">
      <ContentControl Content="{Binding ActivePattern.Layer1}" ContentTemplate="{StaticResource LayerEditor}" />
    </Border>
    <TextBlock Classes="h2" Text="LAYER 2" />
    <Border Classes="panel" Padding="10" c:Menus.Kind="layer" c:Menus.Subject="layer2">
      <ContentControl Content="{Binding ActivePattern.Layer2}" ContentTemplate="{StaticResource LayerEditor}" />
    </Border>

    <!-- A web layer's keys and actions, here as on the Media page -->
    <c:WebPageControls />
  </StackPanel>
</UserControl>
