<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.InteractiveSection"
             Classes="hue-interactive"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-interactive" Text="Interactive" />
    <TextBlock Classes="hint tip"
               Text="Buttons, sensors and lights in the room: an Arduino on a USB cable, a Raspberry Pi or an ESP32 on the network, a show controller with a TCP port. A device sends short text lines — BTN1, SENSOR 42 — and each one fires a show command through the same action layer as the desk, the cues and Companion; the show sends lines back — BLACKOUT 1, LOOK Walk-in, CUE 01.020 — whenever something changes, so a lamp on the lectern can follow the cue stack. A cue can send a line of its own (Device — send a line), and so can the wire (DEVICE Arduino RELAY 1), OSC and Companion. The sketch and the wiring are in docs/ARDUINO.md." />

    <TextBlock Classes="h2" Text="DEVICES" />
    <CheckBox Content="Interactive area on — open the devices' ports" IsChecked="{Binding State.Interactive.Enabled}"
              ToolTip.Tip="Off by default: opening a serial port or a network connection is a deliberate act. Off, every device stays closed and a cue's line goes nowhere." />
    <TextBlock Classes="label" Text="{Binding InteractiveStatus}" />
    <TextBlock Classes="label" Text="{Binding SerialPortsText}" IsVisible="{Binding SerialPortsText, Converter={StaticResource NotEmpty}}" />
    <WrapPanel Margin="0,4,0,4">
      <Button Classes="chip" Content="+ ARDUINO (SERIAL)" Command="{Binding AddSerialDeviceCommand}" Margin="0,0,8,6"
              ToolTip.Tip="A board on a USB cable: type its port (COM3 on Windows, /dev/ttyUSB0 or /dev/ttyACM0 elsewhere) and the speed the sketch opens" />
      <Button Classes="chip" Content="+ DEVICE OVER IP" Command="{Binding AddIpDeviceCommand}" Margin="0,0,8,6"
              ToolTip.Tip="A Raspberry Pi, an ESP32, a show controller: type its address and port; TCP connects and reconnects by itself, UDP sends datagrams" />
      <Button Classes="chip" Content="+ MIDI CONTROL SURFACE" Command="{Binding AddMidiDeviceCommand}" Margin="0,0,8,6"
              ToolTip.Tip="An APC40, a Launchpad, a nanoKONTROL, an X-Touch: pick its port, press LEARN and press a control. Windows only" />
    </WrapPanel>
    <TextBlock Classes="label" Text="THE ROOM'S OTHER BOXES — media servers, projectors, anything with a port" Margin="0,4,0,0" />
    <WrapPanel Margin="0,4,0,4">
      <Button Classes="chip" Content="+ PROJECTOR (PJLINK)" Command="{Binding AddEndpointCommand}" CommandParameter="PjLink" Margin="0,0,8,6"
              ToolTip.Tip="Any venue projector on the network (PJLink, TCP 4352): POWER ON / OFF, INPUT HDMI 1, SHUTTER ON, and its state read every ten seconds — power, lamp hours, errors. Type its password if it asks for one" />
      <Button Classes="chip" Content="+ DISGUISE D3" Command="{Binding AddEndpointCommand}" CommandParameter="Disguise" Margin="0,0,8,6"
              ToolTip.Tip="Disguise's show control over its OSC device: PLAY, STOP, NEXT, PREV, CUE 1.2, TRACK name, VOLUME 80, BRIGHTNESS 50 — the address of the d3 machine and the port its OSC device receives on (7401 as shipped)" />
      <Button Classes="chip" Content="+ PIXERA" Command="{Binding AddEndpointCommand}" CommandParameter="Pixera" Margin="0,0,8,6"
              ToolTip.Tip="Pixera's JSON-RPC API (TCP 1400): TIMELINE name PLAY / PAUSE / STOP, CUE timeline cue, API any.method {params}, RAW {json-rpc}" />
      <Button Classes="chip" Content="+ OSC DEVICE" Command="{Binding AddEndpointCommand}" CommandParameter="Osc" Margin="0,0,8,6"
              ToolTip.Tip="Any box that speaks OSC over UDP — QLab, Resolume, TouchDesigner, a lighting desk: the words are the address and its arguments, /cue/1/start" />
      <Button Classes="chip" Content="+ COMPANION" Command="{Binding AddEndpointCommand}" CommandParameter="Companion" Margin="0,0,8,6"
              ToolTip.Tip="Bitfocus Companion's own TCP API (port 16759): PAGE 3 turns the Stream Deck to a page, PRESS 2/0/1 fires a button, VAR name value fills a custom variable — from a cue, the wire or the assistant, so the deck follows the show. A Companion heard on the network fills in its address" />
      <Button Classes="chip" Content="+ HTTP ENDPOINT" Command="{Binding AddEndpointCommand}" CommandParameter="Lines" Margin="0,0,8,6"
              ToolTip.Tip="A box with a web API — Companion's own, a Q-SYS core, a Crestron or Extron processor, an encoder: each line is a request (GET /api/play, POST /cue {&quot;n&quot;:3}); the answer's status comes back as a line" />
    </WrapPanel>

    <ItemsControl ItemsSource="{Binding State.Interactive.Devices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:DeviceConfig">
          <Border Classes="card" Margin="0,0,0,10" Padding="10">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="Auto,8,*,8,Auto,8,Auto">
                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" ToolTip.Tip="Off keeps this device closed while the others run" />
                <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" Watermark="Name — what cues and the wire call it (DEVICE Arduino …)" />
                <Button Grid.Column="4" Classes="mini" Content="RESEND ALL" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ResendDeviceCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Send every fact of the show to this device now — after it was reset, or to see what it hears" />
                <Button Grid.Column="6" Classes="mini" Content="REMOVE" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveDeviceCommand}" CommandParameter="{Binding}" />
              </Grid>
              <Grid ColumnDefinitions="130,*,8,Auto,8,90" Margin="0,2,0,0">
                <TextBlock Classes="label" Text="Link" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:Lists.DeviceLinks}"
                          SelectedValue="{Binding Link, Mode=TwoWay}" SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
                <TextBlock Grid.Column="3" Classes="label" Text="Line ending" VerticalAlignment="Center" />
                <ComboBox Grid.Column="5" ItemsSource="{x:Static vm:Lists.LineEndings}"
                          SelectedValue="{Binding LineEnding, Mode=TwoWay}" SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}"
                          ToolTip.Tip="What ends every line Patterns writes; an Arduino's Serial.println expects LF" />
              </Grid>
              <Grid ColumnDefinitions="130,*,8,Auto,8,*" Margin="0,2,0,0"
                    IsVisible="{Binding Link, Converter={StaticResource NotEq}, ConverterParameter={x:Static m:DeviceLink.Midi}}">
                <TextBlock Classes="label" Text="Speaks" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:Lists.DeviceProfiles}"
                          SelectedValue="{Binding Profile, Mode=TwoWay}" SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}"
                          ToolTip.Tip="The box's own vocabulary: what a cue's words are turned into on the wire — plain lines for a board or a web API, PJLink for a projector, Disguise's OSC, Pixera's JSON-RPC, plain OSC" />
                <TextBlock Grid.Column="3" Classes="label" Text="Password" VerticalAlignment="Center"
                           IsVisible="{Binding Profile, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:DeviceProfile.PjLink}}" />
                <TextBox Grid.Column="5" Text="{Binding Secret, Mode=TwoWay}" PasswordChar="•" Watermark="only if the projector asks (PJLink authentication)"
                         IsVisible="{Binding Profile, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:DeviceProfile.PjLink}}" />
                <TextBlock Grid.Column="3" Classes="label" Text="Surface" VerticalAlignment="Center"
                           IsVisible="{Binding Profile, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:DeviceProfile.Companion}}" />
                <TextBox Grid.Column="5" Text="{Binding Surface, Mode=TwoWay}" Watermark="Companion's id for the Stream Deck (its Surfaces page) — what a bare PAGE turns"
                         IsVisible="{Binding Profile, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:DeviceProfile.Companion}}" />
              </Grid>
              <TextBlock Classes="hint tip" Text="{Binding Words}" TextWrapping="Wrap"
                         IsVisible="{Binding Link, Converter={StaticResource NotEq}, ConverterParameter={x:Static m:DeviceLink.Midi}}" />
              <TextBlock Classes="hint" Text="{Binding HistoryText}" TextWrapping="Wrap"
                         IsVisible="{Binding Link, Converter={StaticResource NotEq}, ConverterParameter={x:Static m:DeviceLink.Midi}}"
                         ToolTip.Tip="What this box did lately: the last line sent to it and when, its last reply and the confirmation it reached, the last state it was observed in, and the last failure — FAILED while that failure is its last word. The ages move with the desk's tick; nothing here is saved with the show" />
              <Grid ColumnDefinitions="130,*,8,Auto,8,*,8,Auto,8,*" Margin="0,2,0,0"
                    IsVisible="{Binding Link, Converter={StaticResource NotEq}, ConverterParameter={x:Static m:DeviceLink.Midi}}">
                <TextBlock Classes="label" Text="Confirm" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:Lists.ConfirmLevels}"
                          SelectedValue="{Binding Confirm, Mode=TwoWay}" SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}"
                          ToolTip.Tip="How sure the show wants to be that this box did what it was told. A cue's step goes at once; the receipt follows in the journal and on this card. Capped at what the link can give: UDP and MIDI are sent only. The twin's wall switch waits for this level." />
                <TextBlock Grid.Column="3" Classes="label" Text="Ask after" VerticalAlignment="Center" />
                <TextBox Grid.Column="5" Text="{Binding ObserveQuery, Mode=TwoWay}" Watermark="INPUT ? · GET /api/route"
                         ToolTip.Tip="For Observed: the words sent once the box accepted, asking what it did" />
                <TextBlock Grid.Column="7" Classes="label" Text="Expect" VerticalAlignment="Center" />
                <TextBox Grid.Column="9" Text="{Binding ObserveExpect, Mode=TwoWay}" Watermark="31 · &quot;input&quot;:&quot;hdmi1&quot;"
                         ToolTip.Tip="For Observed: what the answer must contain" />
              </Grid>
              <!-- Round 65.11: the input-status adapter — which screen this box's input carries, the words that ask what it receives, the pattern that reads the answer. -->
              <Grid ColumnDefinitions="130,*,8,Auto,8,*,8,Auto,8,*,8,Auto,8,60" Margin="0,2,0,0"
                    IsVisible="{Binding Link, Converter={StaticResource NotEq}, ConverterParameter={x:Static m:DeviceLink.Midi}}">
                <TextBlock Classes="label" Text="Input carries" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding InputScreen, Mode=TwoWay}" Watermark="screen 2 · LED wall"
                         ToolTip.Tip="The screen this box's input carries — its number in the overview or its label. Set, the box is asked what it receives and the answer is held against that screen's signal contract as the third witness (RECEIVED on the Screens page); empty, the box is not asked" />
                <TextBlock Grid.Column="3" Classes="label" Text="Ask" VerticalAlignment="Center" />
                <TextBox Grid.Column="5" Text="{Binding InputQuery, Mode=TwoWay}" Watermark="profile's own · %2IRES ? · GET /api/input"
                         ToolTip.Tip="The words that ask the box what its input receives. Empty: the profile's own where the protocol is published (a PJLink class 2 projector's IRES ?); a dash for none. A box with an HTTP API: GET and its path" />
                <TextBlock Grid.Column="7" Classes="label" Text="Reads" VerticalAlignment="Center" />
                <TextBox Grid.Column="9" Text="{Binding InputPattern, Mode=TwoWay}" Watermark="(?&lt;w&gt;\d+)x(?&lt;h&gt;\d+)@(?&lt;hz&gt;[\d.]+)"
                         ToolTip.Tip="A regular expression that reads the answer: the groups w and h are the raster, hz the rate (50, 59.94, 60000/1001), enc the encoding (RGB, 444, 422, 420), bits the depth. Empty: the profile's own. What the pattern does not read stays unsaid — never guessed" />
                <TextBlock Grid.Column="11" Classes="label" Text="Every" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="13" Value="{Binding InputEverySeconds, Mode=TwoWay}" Minimum="0" Maximum="600" Increment="5" FormatString="0" ShowButtonSpinner="False"
                               ToolTip.Tip="Seconds between asks while the link is open; 0 is the profile's thirty" />
              </Grid>
              <!-- A control surface: its port from the machine's own list, and which starter rows the button puts in. -->
              <Grid ColumnDefinitions="130,*,8,Auto,8,*" Margin="0,2,0,0"
                    IsVisible="{Binding Link, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:DeviceLink.Midi}}">
                <TextBlock Classes="label" Text="Surface port" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MidiInputs}"
                          SelectedItem="{Binding Port, Mode=TwoWay}"
                          PlaceholderText="Whatever is plugged in" />
                <TextBlock Grid.Column="3" Classes="label" Text="Starter rows" VerticalAlignment="Center" />
                <ComboBox Grid.Column="5" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MidiSurfaceNames}"
                          SelectedValue="{Binding StarterSet, Mode=TwoWay}" SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}"
                          PlaceholderText="Which controller this is" />
              </Grid>

              <Grid ColumnDefinitions="130,*,8,Auto,8,100,8,Auto,8,90"
                    IsVisible="{Binding Link, Converter={StaticResource NotEq}, ConverterParameter={x:Static m:DeviceLink.Midi}}">
                <TextBlock Classes="label" Text="Port / address" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Port, Mode=TwoWay}" Watermark="COM3 · /dev/ttyUSB0 · 192.168.1.50 · pi.local:7000 · http://10.0.0.9:8080" />
                <TextBlock Grid.Column="3" Classes="label" Text="Baud" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="5" Minimum="300" Maximum="4000000" Increment="9600" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding Baud, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="Serial only: the speed the sketch opens (Serial.begin(115200))" />
                <TextBlock Grid.Column="7" Classes="label" Text="IP port" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="9" Minimum="1" Maximum="65535" Increment="1" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding NetPort, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="TCP / UDP only: the port, when the address carries none of its own" />
              </Grid>
              <WrapPanel>
                <CheckBox Content="Its lines may be show commands as they are (GO, LOOK 3, BLACKOUT ON…)" IsChecked="{Binding SpeaksProtocol, Mode=TwoWay}" Margin="0,0,12,0"
                          ToolTip.Tip="A line with no trigger row below is taken as a protocol command when it is one; off, only the triggers fire" />
                <CheckBox Content="Hears the show (BLACKOUT 1, LOOK …, CUE …)" IsChecked="{Binding HearsShow, Mode=TwoWay}" Margin="0,0,12,0"
                          ToolTip.Tip="The show's facts go to the device as KEY VALUE lines whenever one changes" />
                <CheckBox Content="Answers go back (OK / ERR …)" IsChecked="{Binding EchoReplies, Mode=TwoWay}"
                          ToolTip.Tip="The answer to a device's command is written back to it — OK, or ERR and why" />
              </WrapPanel>
              <TextBlock Classes="label" Text="{Binding Status}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="130,*,8,Auto">
                <TextBlock Classes="label" Text="Send a line" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding TestText, Mode=TwoWay}" Watermark="PING · RELAY 1 · POWER ON · PLAY · /cue/1/start · GET /api/play" />
                <Button Grid.Column="3" Classes="chip" Content="SEND" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).TestDeviceCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Write this line to the device now — the same as DEVICE name text on the wire or a cue's Device — send a line" />
              </Grid>
              <TextBlock Classes="label" Text="TRIGGERS — what the device's lines mean" Margin="0,4,0,0" />
              <ItemsControl ItemsSource="{Binding Triggers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:DeviceTriggerConfig">
                    <Grid ColumnDefinitions="*,8,Auto,8,2*,8,Auto" Margin="0,2">
                      <TextBox Grid.Column="0" Text="{Binding Match, Mode=TwoWay}" Watermark="The device says… BTN1, SENSOR *" ToolTip.Tip="The whole line, case-blind; ending in * it matches the start, and the rest rides into a command ending in *" />
                      <TextBlock Grid.Column="2" Classes="label" Text="→" VerticalAlignment="Center" />
                      <TextBox Grid.Column="4" Text="{Binding Command, Mode=TwoWay}" Watermark="…and Patterns does: CUE GO · NEXT · LOOK Walk-in · BLACKOUT ON · MESSAGE *" ToolTip.Tip="Any line of the wire protocol (docs/REMOTE.md)" />
                      <Button Grid.Column="6" Classes="mini" Content="✕" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveTriggerCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel>
                <Button Classes="mini" Content="+ TRIGGER" Margin="0,0,6,0" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddTriggerCommand}" CommandParameter="{Binding}" />
                <Button Classes="chip" Content="LEARN — press a control" Margin="0,0,6,0"
                        IsVisible="{Binding Link, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:DeviceLink.Midi}}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LearnMidiCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="The next thing this surface sends becomes a row. Nobody can state a controller's note numbers without the hardware in front of them, so the desk asks you to press it" />
                <Button Classes="mini" Content="+ STARTER ROWS"
                        IsVisible="{Binding Link, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:DeviceLink.Midi}}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SeedMidiCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="The chosen surface's published numbers, put into this table where you can read and edit them — a starting point, never run against the hardware here" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="label" Foreground="{StaticResource TallyHoldBrush}" TextWrapping="Wrap"
               Text="{Binding MidiLearnText}" IsVisible="{Binding MidiLearnText, Converter={StaticResource NotEmpty}}" />

    <TextBlock Classes="h2" Text="A MIDI CONTROL SURFACE" />
    <TextBlock Classes="hint tip"
               Text="An APC40, a Launchpad, a nanoKONTROL, an X-Touch — a control surface is a device like any other here, because its messages arrive as the same text lines an Arduino sends: NOTE 1 53 127 when a pad goes down, NOTEOFF 1 53 when it comes up, CC 1 7 50 as a fader passes halfway. So the trigger table above is the map, and the action layer, the journal and the arm fence are the ones the desk already had. A release is its own word so a pad fires once, not again on the way up; a fader reads 0 to 100 rather than 0 to 127 because the desk's level verbs refuse anything higher, and a control that silently dies in the top of its travel is worse than one that never worked. Rows read both ways in the one table: NOTE 1 53 * → LOOK 3 is the pad firing the look, and LOOK Walk-in → LAMP 1 53 21 is the look lighting the pad (21 is a colour in that surface's own palette; % on the right takes the show's own 0–100 reading and stretches it onto an LED ring). LEARN is the fastest way to any of it: press it, press the control, and the row writes itself — nobody can state a controller's note numbers with confidence without the hardware in front of them, so the desk asks instead of guessing. + STARTER ROWS puts a known surface's published numbers into your table where you can read and change them; every set says on the button that it has not been run against hardware here." />
    <TextBlock Classes="hint tip"
               Text="Honest limits. MIDI is Windows only on this build, and Windows' MIDI ports are single-client: if Ableton or the vendor's own utility is holding the surface, Patterns cannot open it and says so rather than sitting silent. A fader's moves reach the show fifty times a second rather than on every message — a hand cannot tell, and it is what keeps a sweep from becoming hundreds of journal lines on the thread that draws the desk; a press is never delayed or merged. Only two things in the whole show take a level (the audio playlist and break music), so the other faders on a surface can fire and step but cannot mix — there is no master fader here to give them. Endless encoders send a nudge rather than a position and are not supported. SysEx is not sent or received, so a Launchpad needs putting into programmer mode by its own tool, and there is still no MIDI Show Control or timecode chase. A Korg nanoKONTROL2 lights nothing until its own editor is used to hand its lamps over — the desk will say so rather than looking connected and doing nothing. Answers do not go back to a surface; there is nowhere on a pad to put a sentence, so watch this card's status line." />

    <TextBlock Classes="h2" Text="WHAT A DEVICE HEARS" />
    <TextBlock Classes="hint tip"
               Text="One KEY VALUE line per fact, only when it changes: BLACKOUT 1|0 · LIVE 1|0 · DUCK 1|0 · FROZEN 1|0 · REVIEW 1|0 · LOOK name · PROGRAM what is on air · STINGER name · LOWERTHIRD name · ARMED 1|0 · HOLD 1|0 · CUE the standby number · DECK page count · STEP index count. A device that has just connected hears everything once; RESEND ALL sends it again. A command the device sent is answered OK or ERR and the reason — the same answers the wire gives — unless the answers are switched off above. Lines a device sends are fired through the action layer with the device's name as their origin, so the journal reads 'CUE GO from device Arduino'." />
  </StackPanel>
</UserControl>
