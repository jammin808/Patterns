<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.AudioSection"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-audio" Text="Audio" />

    <TextBlock Classes="h2" Text="AUDIO TRACK" />
    <TextBlock Classes="hint"
               Text="An independent music/announcement track — plays whatever is on screen, to the default output or any set of devices (each HDMI screen is an audio device, so a track can follow all screens, one, or a group)." />
    <Grid ColumnDefinitions="*,8,Auto">
      <TextBox Grid.Column="0" Watermark="MP3, WAV, FLAC…" Text="{Binding State.AudioPlayer.Path}" />
      <Button Grid.Column="2" Classes="chip" Content="Browse…" Command="{Binding BrowseAudioTrackCommand}" />
    </Grid>
    <Grid ColumnDefinitions="Auto,8,Auto,16,Auto,*">
      <Button Grid.Column="0" Classes="go" Content="▶ PLAY" Command="{Binding PlayAudioCommand}" />
      <Button Grid.Column="2" Classes="stop" Content="■ STOP" Command="{Binding StopAudioCommand}" />
      <CheckBox Grid.Column="4" Content="Loop" IsChecked="{Binding State.AudioPlayer.Loop}" />
    </Grid>
    <Grid ColumnDefinitions="130,*,44">
      <TextBlock Classes="label" Text="Volume" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="125" TickFrequency="5"
              Value="{Binding State.AudioPlayer.VolumePct, Mode=TwoWay}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.AudioPlayer.VolumePct, StringFormat={}{0:0}%}" />
    </Grid>
    <TextBlock Classes="label" Text="{Binding AudioPlayerStatus}" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="*,8,Auto">
      <TextBlock Classes="label" Text="Play on these outputs (none ticked = computer output)" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="mini" Content="Refresh devices" Command="{Binding RefreshAudioDevicesCommand}" />
    </Grid>
    <ItemsControl ItemsSource="{Binding AudioDevices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AudioDeviceChoice">
          <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,1" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint"
               Text="The computer audio output is the default Windows device — usually the jack or interface feeding the venue sound system — and it combines with HDMI screens (tick both to play everywhere at once). Multi-device playback starts the outputs together; over very long tracks separate devices can drift a little. Device changes apply on the next play." />

    <TextBlock Classes="h2" Text="STINGERS" />
    <TextBlock Classes="hint"
               Text="One-press sounds and clips — 'Take your seats, the show is about to begin' — fired from here, the Show page, a phone or a Stream Deck, no audio engineer needed. Sounds play over everything (the music track ducks underneath); a video clip takes over every screen, and when it ends the previous content comes straight back." />
    <WrapPanel>
      <Button Classes="chip" Content="+ Add sounds / clips…" Command="{Binding AddStingerFilesCommand}" Margin="0,0,8,6" />
      <Button Classes="stop" Content="■ STOP STINGER" Command="{Binding StopStingerCommand}" Margin="0,0,0,6" />
    </WrapPanel>
    <ItemsControl ItemsSource="{Binding State.Stingers.Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:StingerItemConfig">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="8,6" Margin="0,2">
            <Grid ColumnDefinitions="Auto,8,Auto,8,*,6,Auto" RowDefinitions="Auto,4,Auto">
              <Button Grid.Column="0" Classes="go" Content="▶ FIRE" Padding="10,6"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FireStingerCommand}"
                      CommandParameter="{Binding}" />
              <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center"
                         Text="{Binding Path, Converter={StaticResource MediaKind}}" />
              <TextBox Grid.Column="4" Text="{Binding Name}" MinWidth="60"
                       Watermark="{Binding Path, Converter={StaticResource FileName}}"
                       ToolTip.Tip="{Binding Path}" />
              <Button Grid.Column="6" Classes="mini" Content="✕"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveStingerCommand}"
                      CommandParameter="{Binding}" />
              <Grid Grid.Row="2" Grid.ColumnSpan="7" ColumnDefinitions="Auto,8,*,8,40">
                <TextBlock Classes="label" Text="Vol" VerticalAlignment="Center" />
                <Slider Grid.Column="2" Minimum="0" Maximum="125" TickFrequency="5"
                        Value="{Binding VolumePct, Mode=TwoWay}" />
                <TextBlock Grid.Column="4" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding VolumePct, StringFormat={}{0:0}%}" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid ColumnDefinitions="130,*,44">
      <TextBlock Classes="label" Text="Music duck" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
              Value="{Binding State.Stingers.DuckPct, Mode=TwoWay}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.Stingers.DuckPct, StringFormat={}{0:0}%}" />
    </Grid>
    <TextBlock Classes="hint"
               Text="How loud the music track stays while a sound stinger plays (0% = fully silent, then it comes back by itself). Sounds use the track's device selection above; clip sound plays like any video." />
    <TextBlock Classes="label" Text="{Binding StingerStatus}" TextWrapping="Wrap" />

    <TextBlock Classes="hint"
               Text="Soundcheck signal for the audio engineer: a reference tone, or a channel ident — one pip LEFT, two pips RIGHT — with a matching on-screen indicator on every output, so what you see is what they hear." />

    <TextBlock Classes="h2" Text="TONE GENERATOR" />
    <ToggleButton Classes="blackout" Content="TONE ON / OFF" IsChecked="{Binding State.Tone.Enabled}"
                  HorizontalAlignment="Left" Padding="16,8" />
    <TextBlock Classes="label" Text="{Binding ToneStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="hint" Text="The tone never auto-starts with the app — it always comes up off." />

    <StackPanel IsEnabled="{Binding State.Tone.Enabled}">
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Mode" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding ToneModes}"
                  SelectedValue="{Binding State.Tone.Mode, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Channels" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding ToneChannelsList}"
                  SelectedValue="{Binding State.Tone.Channels, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Frequency (Hz)" />
        <NumericUpDown Grid.Column="1" Minimum="20" Maximum="20000" Increment="10" FormatString="0"
                       Value="{Binding State.Tone.FrequencyHz, Mode=TwoWay, Converter={StaticResource Num}}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Classes="mini" Content="100" Command="{Binding ToneFrequencyCommand}" CommandParameter="100" />
        <Button Classes="mini" Content="440" Command="{Binding ToneFrequencyCommand}" CommandParameter="440" />
        <Button Classes="mini" Content="1 k" Command="{Binding ToneFrequencyCommand}" CommandParameter="1000" />
        <Button Classes="mini" Content="10 k" Command="{Binding ToneFrequencyCommand}" CommandParameter="10000" />
      </StackPanel>
      <Grid ColumnDefinitions="130,*,52">
        <TextBlock Classes="label" Text="Level (dBFS)" />
        <Slider Grid.Column="1" Minimum="-60" Maximum="0" TickFrequency="1"
                Value="{Binding State.Tone.LevelDb, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding State.Tone.LevelDb, StringFormat={}{0:0} dB}" />
      </Grid>
      <TextBlock Classes="hint"
                 Text="-18 dBFS is a common line-up level. The tone plays on the default Windows audio device; channel ident shows LEFT / RIGHT on screen in time with the pips." />
    </StackPanel>
  </StackPanel>
</UserControl>
