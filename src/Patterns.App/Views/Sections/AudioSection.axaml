<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.AudioSection"
             Classes="hue-audio"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-audio" Text="Audio" />

    <!-- Round 73: the master clock and sync and the tone generator live in the pop-out column beside this page, so the page is the lists and the routing. -->
    <Grid ColumnDefinitions="*,8,Auto" Margin="0,4,0,0">
      <TextBlock Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"
                 Text="The master clock and sync check, and the tone generator, are in the column beside this page. ◀ CLOSE hides the column; SETTINGS ▸ brings it back." />
      <Button Grid.Column="2" Classes="mini" Content="SETTINGS ▸" Command="{Binding OpenPopOutCommand}" IsVisible="{Binding !PopOut.IsOpen}"
              ToolTip.Tip="Open the clock, sync and tone settings in the column beside this page" />
    </Grid>

    <TextBlock Classes="h2" Text="WHAT THE DESK IS LISTENING TO" />
    <TextBlock Classes="hint tip"
               Text="A show can have a clip on the programme, another on a confidence screen's own picture and a third loaded into the preview, and every one of them has a soundtrack. Played together they are a mix nobody chose, over the top of whatever you are trying to hear. So the desk monitors one at a time, and unless you say otherwise it is the programme — the sound the room is hearing is the sound you are checking against. This changes nothing on any screen, any NDI send or the stream: what the audience hears comes off the picture that is on air, never off the desk's own speakers. It is the clips, the capture boxes and the web pages that are monitored; the audio playlist, VOGs and stingers are the show's own sound and always play." />
    <Grid ColumnDefinitions="130,*">
      <TextBlock Classes="label" Text="Listening to" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" Name="MonitorSource" ItemsSource="{Binding MonitorSources}" HorizontalAlignment="Stretch"
                SelectedValue="{Binding State.Monitor.Source, Mode=TwoWay}"
                SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
    </Grid>
    <Grid ColumnDefinitions="130,*" IsVisible="{Binding MonitorIsOutput}" Margin="0,4,0,0">
      <TextBlock Classes="label" Text="Which output" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" Name="MonitorOutput" ItemsSource="{Binding MonitorOutputs}" HorizontalAlignment="Stretch"
                SelectedValue="{Binding State.Monitor.OutputId, Mode=TwoWay}"
                SelectedValueBinding="{Binding ScreenId, x:DataType=vm:EditTarget}"
                PlaceholderText="Which screen or canvas…"
                ToolTip.Tip="A screen that is simply following the show has the programme's sound, and that is what you will hear" />
    </Grid>
    <TextBlock Classes="h2" Text="AUDIO PLAYLIST" />
    <TextBlock Classes="hint tip"
               Text="An independent bed of music or announcements — plays whatever is on screen, to the default output or any set of devices (each HDMI screen is an audio device, so it can follow all screens, one, or a group). Add tracks one at a time or whole folders: a folder's audio files play after the rows, in name order, and a file dropped in live is seen within half a minute. Shuffle deals the order by a seed the show keeps (RESHUFFLE deals again); Loop the list starts it over at its end, off it stops there. A VOG ducks it, a stinger fades it out and back, STOP ALL stops it. On the wire: AUDIO PLAY [n or name], AUDIO NEXT, AUDIO PREV, AUDIO STOP, AUDIO VOL." />
    <WrapPanel>
      <Button Classes="chip" Content="+ Add tracks…" Command="{Binding Audio.AddFilesCommand}" Margin="0,0,8,6" />
      <Button Classes="chip" Content="+ Add folder…" Command="{Binding Audio.AddFolderCommand}" Margin="0,0,8,6" />
      <CheckBox Content="Shuffle" IsChecked="{Binding State.AudioPlayer.Shuffle}" Margin="0,0,8,6" VerticalAlignment="Center" />
      <Button Classes="mini" Content="RESHUFFLE" Command="{Binding Audio.ReshuffleCommand}" Margin="0,0,8,6" VerticalAlignment="Center"
              ToolTip.Tip="Deal a new order — the same shuffle plays at the rehearsal and the show until you do" />
      <CheckBox Content="Loop the list" IsChecked="{Binding State.AudioPlayer.Loop}" Margin="0,0,0,6" VerticalAlignment="Center" />
    </WrapPanel>
    <ItemsControl ItemsSource="{Binding State.AudioPlayer.Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:AudioTrackConfig">
          <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="7,6" Margin="0,2">
            <Grid ColumnDefinitions="Auto,8,Auto,8,*,6,Auto,6,Auto,6,Auto">
              <Button Grid.Column="0" Classes="mini" Content="▶" ToolTip.Tip="Play this track now"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.PlayItemCommand}"
                      CommandParameter="{Binding}" />
              <Border Grid.Column="2" Background="#123A26" CornerRadius="7" Padding="6,2" VerticalAlignment="Center"
                      IsVisible="{Binding IsNowPlaying}">
                <TextBlock Text="▶ NOW" FontSize="10" FontWeight="SemiBold" Foreground="#2EE68A" />
              </Border>
              <TextBox Grid.Column="4" Text="{Binding Name}" MinWidth="60"
                       Watermark="{Binding Path, Converter={StaticResource FileName}}" ToolTip.Tip="{Binding Path}" />
              <Button Grid.Column="6" Classes="mini" Content="▲" ToolTip.Tip="Earlier in the list"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.MoveItemUpCommand}"
                      CommandParameter="{Binding}" />
              <Button Grid.Column="8" Classes="mini" Content="▼" ToolTip.Tip="Later in the list"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.MoveItemDownCommand}"
                      CommandParameter="{Binding}" />
              <Button Grid.Column="10" Classes="mini" Content="✕" ToolTip.Tip="Remove from the list"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.RemoveItemCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding State.AudioPlayer.Folders}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Grid ColumnDefinitions="Auto,8,*,6,Auto" Margin="0,2">
            <TextBlock Classes="label" Text="FOLDER" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
            <Button Grid.Column="4" Classes="mini" Content="✕" ToolTip.Tip="Remove the folder from the list"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.RemoveFolderCommand}"
                    CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid ColumnDefinitions="Auto,8,Auto,8,Auto,8,Auto,*">
      <Button Grid.Column="0" Classes="chip" Content="⏮ PREV" Command="{Binding Audio.PrevCommand}" ToolTip.Tip="The previous track (the list wraps)" />
      <Button Grid.Column="2" Classes="go" Content="▶ PLAY" Command="{Binding Audio.PlayCommand}" ToolTip.Tip="The list from where it stopped, or its first track" />
      <Button Grid.Column="4" Classes="stop" Content="■ STOP" Command="{Binding Audio.StopCommand}" />
      <Button Grid.Column="6" Classes="chip" Content="⏭ NEXT" Command="{Binding Audio.NextCommand}" ToolTip.Tip="The next track (the list wraps)" />
    </Grid>
    <Grid ColumnDefinitions="130,*,44">
      <TextBlock Classes="label" Text="Volume" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="125" TickFrequency="5"
              Value="{Binding State.AudioPlayer.VolumePct, Mode=TwoWay}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.AudioPlayer.VolumePct, StringFormat={}{0:0}%}" />
    </Grid>
    <TextBlock Classes="label" Text="{Binding Audio.PlayerStatus}" TextWrapping="Wrap" />

    <TextBlock Classes="h2" Text="PROGRAMME OUT — WHAT THE ROOM HEARS" />
    <Grid ColumnDefinitions="*,8,Auto">
      <TextBlock Classes="label" Text="Play on these outputs (none ticked = computer output)" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="mini" Content="Refresh devices" Command="{Binding Audio.RefreshDevicesCommand}" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Audio.Devices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AudioDeviceChoice">
          <Grid ColumnDefinitions="*,12,160,8,58" Margin="0,1">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
            <Slider Grid.Column="2" Minimum="0" Maximum="2000" TickFrequency="10" VerticalAlignment="Center"
                    Value="{Binding DelayMs, Mode=TwoWay, Converter={StaticResource Num}}"
                    ToolTip.Tip="Audio delay offset for this output: its sound leaves this much later, so a picture that arrives late (a projector, an LED processor, an IMAG chain) and the room's sound line up" />
            <TextBlock Grid.Column="4" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="{Binding DelayMs, StringFormat={}{0} ms}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint tip"
               Text="These are the programme's outputs: the USB or dedicated interface feeding the venue sound system, the HDMI screens, or the computer's own output (the default Windows device) — tick several to play everywhere at once. Each has its own delay offset for lip sync. Device changes apply on the next play. A named interface that is not plugged in does not stop the show: the sound falls back to the computer's own output and the line below says so, because an operator who is not told finds out from the room." />
    <TextBlock Classes="label" Foreground="{StaticResource TallyHoldBrush}" TextWrapping="Wrap"
               Text="{Binding AudioDeviceTrouble}" IsVisible="{Binding AudioDeviceTrouble, Converter={StaticResource NotEmpty}}" />

    <TextBlock Classes="h2" Text="MONITOR — WHAT THE OPERATOR HEARS" />
    <TextBlock Classes="hint tip"
               Text="The desk's own output, kept off the programme's on purpose: headphones, the machine's own speakers, a spare card. It is where a picture the room is NOT watching plays — the preview, or one screen doing its own thing — so you can hear the next clip before it lands without touching the PA. The programme's sound is never taken away to make room for it: with no monitor output named there is nowhere to audition that is not the room, so nothing else plays and the line says so. Clips, capture boxes and web pages are what this routes; the audio playlist, VOGs, stingers and the tone are the show's own sound and always go to the programme's outputs." />
    <Grid ColumnDefinitions="130,*">
      <TextBlock Classes="label" Text="Monitor output" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" Name="MonitorDevice" ItemsSource="{Binding MonitorDevices}" HorizontalAlignment="Stretch"
                SelectedItem="{Binding State.Monitor.Device, Mode=TwoWay}"
                PlaceholderText="None — only the programme is heard" />
    </Grid>
    <Grid ColumnDefinitions="130,*,58" Margin="0,4,0,0">
      <TextBlock Classes="label" Text="Monitor level" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="125" TickFrequency="5" Value="{Binding State.Monitor.VolumePct, Mode=TwoWay}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.Monitor.VolumePct, StringFormat={}{0:0}%}" />
    </Grid>
    <TextBlock Classes="hint" Text="{Binding MonitorWords}" TextWrapping="Wrap" Margin="0,4,0,0" />
    <TextBlock Classes="hint tip"
               Text="Honest limits: there is no mix bus anywhere in the build — every sound opens its own stream and Windows sums them — so there is no programme fader, no meters and nothing above stereo. One clip is one decoder and one decoder plays to one device, so the same clip cannot be on the PA and in the cans at once (the room's claim wins). A web page's sound cannot be routed from here at all — WebView2 offers a mute and nothing else — and a capture card's embedded audio is not opened by this build." />

    <!-- ROUTING — which soundtrack goes where: sources × destinations, a VOG mode, a trim and a delay per destination. -->
    <Expander Margin="0,8,0,0" IsExpanded="{Binding Audio.RoutingOn}">
      <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="h2" Text="ROUTING — WHICH SOUNDTRACK GOES WHERE" Margin="0" />
          <Border Classes="tallyChip air" IsVisible="{Binding Audio.RoutingOn}" VerticalAlignment="Center"><TextBlock Text="ON" /></Border>
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="4">
        <TextBlock Classes="hint tip"
                   Text="A video or a page on an info screen with its own soundtrack over that screen's HDMI while the room hears the desk through the sound card; the same programme embedded on an NDI send; a VOG that ducks the room but leaves the stream clean. Off — as every show before it — the programme's outputs carry the show's sound and the monitor the operator's. On, this matrix is in charge: each row is a destination (an output as Windows names it, or an NDI send) and the ticks are the sources it carries, at a level in dB; a VOG ducks the rest on that destination, replaces them, or never reaches it. Switched on empty it seeds audio-follows-video. Switching it reopens the clips on air — do it in setup. AUDIO ROUTE music TO Info HDMI AT -6, AUDIO VOG NDI Stream LEAVE and the rest on the wire, in cues and over OSC." />
        <WrapPanel>
          <Button Classes="chip" Content="{Binding Audio.RoutingOnLabel}" Command="{Binding Audio.RoutingOnCommand}" Margin="0,0,8,6" />
          <Button Classes="mini" Content="SEED — audio follows video" Command="{Binding Audio.RoutingSeedCommand}" Margin="0,0,8,6"
                  ToolTip.Tip="Only when the matrix is empty: the programme, the music, VOGs, stingers and the tone on every programme output, the programme with the music and VOGs on every NDI send" />
          <Button Classes="mini" Content="CLEAR" Command="{Binding Audio.RoutingClearCommand}" Margin="0,0,8,6" ToolTip.Tip="Every destination and route gone — nothing plays anywhere while the matrix is on until something is routed" />
          <CheckBox Content="Sound follows the picture" IsChecked="{Binding Audio.RoutingFollow, Mode=TwoWay}" Margin="0,0,8,6" VerticalAlignment="Center"
                    ToolTip.Tip="Round 69: every screen that names a sound output (Screens page → Sound out) gets the route its picture makes — the programme's sound while it shows the programme, its own picture's soundtrack while it shows one of its own, the repeated screen's while it repeats — and the route moves with every take. Your own rows win where both name the same crosspoint. Off, the rows alone rule. AUDIO FOLLOW ON / OFF on the wire" />
        </WrapPanel>
        <Grid ColumnDefinitions="130,*,8,Auto">
          <TextBlock Classes="label" Text="Add a destination" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Audio.RoutingDestinationChoices}" SelectedItem="{Binding Audio.RoutingDestinationPick, Mode=TwoWay}"
                    PlaceholderText="An output this machine has, or an NDI send of the show…" HorizontalAlignment="Stretch" />
          <Button Grid.Column="3" Classes="chip" Content="ADD" Command="{Binding Audio.RoutingAddDestinationCommand}" />
        </Grid>
        <TextBlock Classes="hint" Text="{Binding Audio.RoutingWords}" TextWrapping="Wrap" />
        <TextBlock Classes="hint" Text="{Binding Audio.RoutingFollowWords}" TextWrapping="Wrap" />
        <TextBlock Classes="hint" Text="{Binding Audio.RoutingPagesWords}" TextWrapping="Wrap" IsVisible="{Binding Audio.RoutingPagesWords, Converter={StaticResource NotEmpty}}" />
        <ItemsControl ItemsSource="{Binding Audio.RoutingRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RoutingRowVm">
              <Border Classes="stingerRow" CornerRadius="8" Padding="8,6" Margin="0,3">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="Auto,8,*,8,Auto,8,Auto,8,Auto">
                    <TextBlock Classes="label" Text="{Binding KindWord}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding Row.Label, Mode=TwoWay}" Watermark="{Binding Label}" MinWidth="120"
                             ToolTip.Tip="{Binding Row.Key}" />
                    <TextBlock Grid.Column="4" Classes="label" Text="{Binding Meter}" MinWidth="52" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="{StaticResource TallyPgmBrush}" ToolTip.Tip="The lane's meter — the clips mixed here; the show's own players are not metered" />
                    <TextBlock Grid.Column="6" Classes="label" Text="not plugged in" Foreground="{StaticResource TallyHoldBrush}" VerticalAlignment="Center" IsVisible="{Binding !Present}" />
                    <Button Grid.Column="8" Classes="mini" Content="✕" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.RoutingRemoveDestinationCommand}" CommandParameter="{Binding}" />
                  </Grid>
                  <!-- The cells: one chip per source; ticked = on this destination, with its level beside it and the live gain under a VOG. -->
                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RoutingCellVm">
                        <Border Classes="routeCell" Classes.on="{Binding IsOn}" Classes.followed="{Binding Followed}" CornerRadius="6" Padding="6,3" Margin="0,0,6,4">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center" Padding="4,0,0,0" />
                            <TextBlock Classes="label" Text="follows the picture" VerticalAlignment="Center" IsVisible="{Binding Followed}" Foreground="{StaticResource AccentBrush}"
                                       ToolTip.Tip="The picture makes this route: a screen that names this output shows this source now, at 0 dB plus the row's trim, moving with every take. Tick it to make it a row of your own — a level, a mute — and the row wins" />
                            <TextBox Width="54" Text="{Binding LevelText, Mode=TwoWay}" Watermark="0 dB" IsVisible="{Binding IsOn}" VerticalAlignment="Center"
                                     ToolTip.Tip="The level in dB: 0 is unity, −60 is off, +12 the ceiling" />
                            <TextBlock Classes="label" Text="{Binding LiveText}" VerticalAlignment="Center" IsVisible="{Binding LiveText, Converter={StaticResource NotEmpty}}"
                                       ToolTip.Tip="The gain the lane runs at now — ducked under a VOG" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="Auto,8,180,8,Auto,8,110,8,Auto,8,110,8,Auto">
                    <TextBlock Classes="label" Text="VOG" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.VogModes}" HorizontalAlignment="Stretch"
                              SelectedValue="{Binding Row.VogMode, Mode=TwoWay}" SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
                    <TextBlock Grid.Column="4" Classes="label" Text="Trim dB" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="6" Minimum="-60" Maximum="12" Increment="1" FormatString="0.#" Value="{Binding Row.TrimDb, Mode=TwoWay, Converter={StaticResource Num}}" />
                    <TextBlock Grid.Column="8" Classes="label" Text="Delay ms" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="10" Minimum="0" Maximum="2000" Increment="10" FormatString="0" Value="{Binding Row.DelayMs, Mode=TwoWay, Converter={StaticResource Num}}" />
                    <CheckBox Grid.Column="12" Content="Mute" IsChecked="{Binding Row.Mute, Mode=TwoWay}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Classes="label" Text="{Binding LiveWords}" TextWrapping="Wrap" />
                  <TextBlock Classes="label" Text="{Binding Error}" Foreground="{StaticResource TallyHoldBrush}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="hint tip"
                   Text="What the matrix can and cannot do on this build. The playlist, VOGs, stingers and the tone open on the destinations routed for them, at the level and behind the delay each row says, and follow a VOG per destination. A clip's soundtrack (a file on the pattern, a layer or a screen's own picture) comes to the desk's mixer while the matrix is on and reaches every destination it is routed to — a sound card, an HDMI screen, an NDI send with the sound embedded — through a lane per destination, the metered number above. A web page's sound is steered through the page's own output picker: it can go to one output, and only where the browser lets the page see the outputs — the line above says what the page did. A capture card's embedded audio is not opened by this build. Levels add along the path (the crosspoint, then the row's trim); the floor is −60 dB (off), the ceiling +12." />
      </StackPanel>
    </Expander>

    <TextBlock Classes="h2" Text="BREAK MUSIC (SPOTIFY)" />
    <TextBlock Classes="hint tip"
               Text="Plays your Spotify playlists in the room during breaks and while people arrive. The sound comes out of the Spotify app on this machine (or any Spotify Connect device) — Patterns tells it what to play, how loud and when to stop, and reads back what is on. It ducks under a VOG sound and fades under a stinger, like the music track does, and STOP ALL pauses it. Needs Spotify Premium and your own free Client ID from the Spotify developer dashboard." />
    <CheckBox Content="Use Spotify for break music" IsChecked="{Binding State.Spotify.Enabled}" />
    <StackPanel IsEnabled="{Binding State.Spotify.Enabled}">
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Client ID" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Music.ClientId, UpdateSourceTrigger=LostFocus}" Watermark="Client ID from your Spotify app" />
      </Grid>
      <TextBlock Classes="hint tip" Text="Add all three of these as Redirect URIs in your Spotify app settings:" />
      <TextBox Text="{Binding Music.RedirectUris, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
               FontFamily="Consolas,Menlo,monospace" />
      <TextBlock Classes="hint tip"
                 Text="Spotify has not accepted 'localhost' since April 2025 — these loopback addresses are the supported form for a desktop app. Three, so a busy port never blocks sign-in." />
      <WrapPanel>
        <Button Classes="go" Content="CONNECT" Command="{Binding Music.ConnectCommand}" Margin="0,0,8,6" />
        <Button Classes="mini" Content="DISCONNECT" Command="{Binding Music.DisconnectCommand}" Margin="0,0,10,6" VerticalAlignment="Center" />
        <TextBlock Classes="label" Text="{Binding Music.AccountText}" VerticalAlignment="Center" Margin="0,0,0,6" />
      </WrapPanel>
      <Grid ColumnDefinitions="130,*,8,Auto">
        <TextBlock Classes="label" Text="Play on" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Music.Devices}" SelectedItem="{Binding Music.SelectedDevice}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SpotifyDeviceChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="3" Classes="mini" Content="Refresh devices" Command="{Binding Music.RefreshDevicesCommand}" />
      </Grid>
      <TextBlock Classes="hint tip"
                 Text="Leave the device blank to play on whatever Spotify is currently using. If the chosen device is not on Spotify when a cue fires, the music plays on the active device and says so rather than refusing. Which sound output Spotify itself uses is set in Spotify." />
      <Grid ColumnDefinitions="130,*,44">
        <TextBlock Classes="label" Text="Level" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                Value="{Binding State.Spotify.LevelPct, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding State.Spotify.LevelPct, StringFormat={}{0:0}%}" />
      </Grid>
      <TextBlock Classes="hint tip"
                 Text="The Spotify device's own volume. It drops to the Music duck level below while a VOG sound plays and fades out under a stinger, like the music track." />
      <Grid ColumnDefinitions="130,*,8,Auto,8,Auto">
        <TextBlock Classes="label" Text="Spotify link" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Music.LinkDraft}" Watermark="https://open.spotify.com/playlist/…" />
        <Button Grid.Column="3" Classes="chip" Content="ADD" Command="{Binding Music.AddLinkCommand}" />
        <Button Grid.Column="5" Classes="mini" Content="BROWSE SONGS" Command="{Binding Music.BrowseLinkCommand}"
                ToolTip.Tip="List the songs inside a playlist, album or artist link, to add them one at a time" />
      </Grid>
      <TextBlock Classes="hint tip" Text="In Spotify: right-click a playlist, album or song → Share → Copy link, then paste it here. ADD keeps the whole thing as one button; BROWSE SONGS lists what is inside so single songs can be added." />
      <Grid ColumnDefinitions="130,*,8,Auto,8,Auto,8,Auto">
        <TextBlock Classes="label" Text="My playlists" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Music.Playlists}" SelectedItem="{Binding Music.SelectedPlaylist}"
                  HorizontalAlignment="Stretch" PlaceholderText="Refresh after CONNECT" />
        <Button Grid.Column="3" Classes="chip" Content="ADD" Command="{Binding Music.AddPlaylistCommand}" />
        <Button Grid.Column="5" Classes="mini" Content="BROWSE SONGS" Command="{Binding Music.BrowsePlaylistCommand}" />
        <Button Grid.Column="7" Classes="mini" Content="Refresh my playlists" Command="{Binding Music.RefreshPlaylistsCommand}" />
      </Grid>
      <Grid ColumnDefinitions="130,*,8,Auto">
        <TextBlock Classes="label" Text="Search Spotify" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Music.SearchDraft}" Watermark="A song, album, playlist or artist">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding Music.SearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="3" Classes="chip" Content="SEARCH" Command="{Binding Music.SearchCommand}" />
      </Grid>
      <TextBlock Classes="label" Text="{Binding Music.BrowseStatus}" TextWrapping="Wrap"
                 IsVisible="{Binding Music.BrowseStatus, Converter={StaticResource NotEmpty}}" />
      <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding Music.Tracks.Count, Converter={StaticResource Positive}}">
        <ListBox Grid.Column="0" ItemsSource="{Binding Music.Tracks}" SelectedItem="{Binding Music.SelectedTrack}" MaxHeight="220"
                 ToolTip.Tip="The songs inside what you browsed — pick one and ADD SONG" />
        <Button Grid.Column="2" Classes="chip" Content="ADD SONG" VerticalAlignment="Top" Command="{Binding Music.AddTrackCommand}" />
      </Grid>
      <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding Music.SearchHits.Count, Converter={StaticResource Positive}}">
        <ListBox Grid.Column="0" ItemsSource="{Binding Music.SearchHits}" SelectedItem="{Binding Music.SelectedSearchHit}" MaxHeight="220"
                 ToolTip.Tip="Search results — pick one and ADD" />
        <Button Grid.Column="2" Classes="chip" Content="ADD" VerticalAlignment="Top" Command="{Binding Music.AddSearchHitCommand}" />
      </Grid>
      <TextBlock Classes="hint tip" Text="Browsing and searching work on any Spotify account. Starting the music needs Premium — Spotify lets no app control a free account's playback. A look can start (or pause) an entry from here when it goes on air: the Music picker on the Looks page." />
      <Button Classes="stop" Content="❚❚ PAUSE BREAK MUSIC" Command="{Binding Music.PauseCommand}" HorizontalAlignment="Left" />
      <ItemsControl ItemsSource="{Binding State.Spotify.Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:SpotifyItemConfig">
            <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="8,6" Margin="0,2">
              <Grid ColumnDefinitions="Auto,8,Auto,8,*,8,Auto,6,Auto">
                <Button Grid.Column="0" Classes="go" Content="▶ PLAY" Padding="10,6"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Music.PlayCommand}"
                        CommandParameter="{Binding}" />
                <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" Text="{Binding KindLabel}" />
                <TextBox Grid.Column="4" Text="{Binding Name}" MinWidth="60"
                         Watermark="{Binding DisplayName}" ToolTip.Tip="{Binding Uri}" />
                <CheckBox Grid.Column="6" Content="Shuffle" IsChecked="{Binding Shuffle}" VerticalAlignment="Center" />
                <Button Grid.Column="8" Classes="mini" Content="✕"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Music.RemoveCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="label" Text="{Binding Music.Status}" TextWrapping="Wrap" />
      <TextBlock Classes="hint tip"
                 Text="Patterns controls Spotify; it does not play the audio itself — Spotify's DRM does not allow that. A development-mode Client ID from the Spotify dashboard allows up to five listed Premium accounts; a business gets more. Your sign-in is kept in patterns.spotify.json beside the settings file and never travels inside a show file. Switching break music off leaves whatever is playing on Spotify — use PAUSE or STOP ALL first. Closing Patterns leaves the music playing too." />
    </StackPanel>

    <TextBlock Classes="h2" Text="VOG &amp; STINGERS" />
    <TextBlock Classes="hint tip"
               Text="One-press sounds and clips, fired from here, the Show panel, a cue, a phone or a Stream Deck — no audio engineer needed. A VOG (voice of God) plays over the show — 'Take your seats, the show is about to begin' — the music ducks underneath, and a clip hands the screens back when it ends. A STINGER is a transition hit: the music fades out, a clip dissolves in, and when it lands the show goes where you say — back to what was on, held for your take, on to the next cue, or to a look or cue you name. New files start as VOGs; switch a row to Stinger to give it an ending. An EFFECT PULSE is a stinger with no file: a surge through the particles and fractals on screen — an explosion, a rush, a flash, a bloom — that settles back by itself, owns nothing and changes no music; fire it alone, over a clip, or in a cue beside a look." />
    <WrapPanel>
      <Button Classes="chip" Content="+ Add sounds / clips…" Command="{Binding Audio.AddStingerFilesCommand}" Margin="0,0,8,6" />
      <Button Classes="chip" Content="+ Add effect pulse" Command="{Binding Audio.AddEffectPulseCommand}" Margin="0,0,8,6"
              ToolTip.Tip="A stinger with no file: a shape that runs through the particles and fractals on screen for the length you set and settles back by itself — a pulse (explosion, rush, flash, bloom) or a scored sting that changes the picture in phases (shockwave, vortex, strobe, supernova, freeze, gust, rainbow, quake)" />
      <Button Classes="stop" Content="■ STOP" Command="{Binding Audio.StopStingerCommand}" Margin="0,0,0,6"
              ToolTip.Tip="Stops whatever is on air: a clip or a held frame reverts, and a stinger's ending is cancelled, never run" />
    </WrapPanel>
    <ItemsControl ItemsSource="{Binding State.Stingers.Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:StingerItemConfig">
          <!-- The row lights red while its item plays: the chip says how long, a surge shows its bar. -->
          <Border Classes="stingerRow" Classes.air="{Binding IsOnAir}" CornerRadius="8" Padding="8,6" Margin="0,2">
            <Grid ColumnDefinitions="Auto,8,Auto,8,*,6,Auto" RowDefinitions="Auto,4,Auto,4,Auto,4,Auto,Auto">
              <Button Grid.Column="0" Classes="go" Content="▶ FIRE" Padding="10,6"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.FireStingerCommand}"
                      CommandParameter="{Binding}" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{Binding KindLabel}" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Classes="label" Text="{Binding Path, Converter={StaticResource MediaKind}}" IsVisible="{Binding IsFile}" />
                <Border Classes="tallyChip air" IsVisible="{Binding IsOnAir}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding OnAirText}" />
                </Border>
              </StackPanel>
              <ProgressBar Grid.Row="7" Grid.ColumnSpan="7" Height="3" Minimum="0" Maximum="1" Margin="0,4,0,0"
                           Value="{Binding OnAirProgress}" IsVisible="{Binding ShowsProgress}"
                           Foreground="{StaticResource TallyPgmBrush}" Background="#30000000" />
              <TextBox Grid.Column="4" Text="{Binding Name}" MinWidth="60"
                       Watermark="{Binding DisplayName}"
                       ToolTip.Tip="{Binding Path}" />
              <Button Grid.Column="6" Classes="mini" Content="✕"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.RemoveStingerCommand}"
                      CommandParameter="{Binding}" />
              <Grid Grid.Row="2" Grid.ColumnSpan="7" ColumnDefinitions="Auto,8,260,8,*,8,60" IsVisible="{Binding IsPulse}">
                <TextBlock Classes="label" Text="Pulse" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.PulsePresets}"
                          SelectedValue="{Binding PulsePreset, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
                <Slider Grid.Column="4" Minimum="100" Maximum="5000" TickFrequency="100"
                        Value="{Binding PulseMs, Mode=TwoWay, Converter={StaticResource Num}}"
                        ToolTip.Tip="How long the surge runs before the picture settles" />
                <TextBlock Grid.Column="6" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding PulseMs, StringFormat={}{0} ms}" />
              </Grid>
              <Grid Grid.Row="2" Grid.ColumnSpan="7" ColumnDefinitions="Auto,8,*,8,40" IsVisible="{Binding IsFile}">
                <TextBlock Classes="label" Text="Vol" VerticalAlignment="Center" />
                <Slider Grid.Column="2" Minimum="0" Maximum="125" TickFrequency="5"
                        Value="{Binding VolumePct, Mode=TwoWay}" />
                <TextBlock Grid.Column="4" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding VolumePct, StringFormat={}{0:0}%}" />
              </Grid>
              <Grid Grid.Row="4" Grid.ColumnSpan="7" ColumnDefinitions="Auto,8,260,8,*" IsVisible="{Binding IsFile}">
                <TextBlock Classes="label" Text="Kind" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.StingerKinds}"
                          SelectedValue="{Binding Kind, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
                <TextBlock Grid.Column="4" Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{Binding AfterKey, Converter={StaticResource StingerAfterText}}" />
              </Grid>
              <StackPanel Grid.Row="6" Grid.ColumnSpan="7" IsVisible="{Binding IsSting}" Spacing="4">
                <Grid ColumnDefinitions="Auto,8,260,8,*">
                  <TextBlock Classes="label" Text="When it lands" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.StingerAfters}"
                            SelectedValue="{Binding After, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
                  <CheckBox Grid.Column="4" Content="Music comes back" IsChecked="{Binding MusicReturns, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </Grid>
                <ComboBox HorizontalAlignment="Stretch"
                          IsVisible="{Binding After, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:StingerAfter.Next}}"
                          ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.AfterListChoices}"
                          SelectedValue="{Binding AfterTarget, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Id, x:DataType=vm:PickItem}" />
                <ComboBox HorizontalAlignment="Stretch"
                          IsVisible="{Binding After, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:StingerAfter.Custom}}"
                          ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Audio.AfterLookOrCueChoices}"
                          SelectedValue="{Binding AfterTarget, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Id, x:DataType=vm:PickItem}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid ColumnDefinitions="130,*,52">
      <TextBlock Classes="label" Text="Music duck (VOG)" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
              Value="{Binding State.Stingers.DuckPct, Mode=TwoWay}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.Stingers.DuckPct, StringFormat={}{0:0}%}" />
    </Grid>
    <Grid ColumnDefinitions="130,*,52">
      <TextBlock Classes="label" Text="Live duck level" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
              Value="{Binding State.Stingers.DuckToPct, Mode=TwoWay}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.Stingers.DuckToPct, StringFormat={}{0:0}%}" />
    </Grid>
    <Grid ColumnDefinitions="130,*,52">
      <TextBlock Classes="label" Text="Live duck fade" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="2000" TickFrequency="50"
              Value="{Binding State.Stingers.DuckFadeMs, Mode=TwoWay, Converter={StaticResource Num}}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.Stingers.DuckFadeMs, StringFormat={}{0} ms}" />
    </Grid>
    <Grid ColumnDefinitions="130,*,52">
      <TextBlock Classes="label" Text="Sting fade" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="2000" TickFrequency="50"
              Value="{Binding State.Stingers.FadeMs, Mode=TwoWay, Converter={StaticResource Num}}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.Stingers.FadeMs, StringFormat={}{0} ms}" />
    </Grid>
    <Grid ColumnDefinitions="130,*,52">
      <TextBlock Classes="label" Text="Stop fade" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="50" Maximum="1000" TickFrequency="50"
              Value="{Binding State.Stingers.StopFadeMs, Mode=TwoWay, Converter={StaticResource Num}}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.Stingers.StopFadeMs, StringFormat={}{0} ms}" />
    </Grid>
    <Grid ColumnDefinitions="130,*,52">
      <TextBlock Classes="label" Text="Hold limit" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="600" TickFrequency="5"
              Value="{Binding State.Stingers.HoldSeconds, Mode=TwoWay, Converter={StaticResource Num}}" />
      <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Text="{Binding State.Stingers.HoldSeconds, StringFormat={}{0} s}" />
    </Grid>
    <TextBlock Classes="hint tip"
               Text="Music duck: how loud the music track stays while a VOG sound plays (0% = silent, then it comes back by itself). Live duck: what the music, a playing stinger and a clip's sound hold at while someone speaks from the room — press D, the DUCK key in the SHOW CONTROLS drawer, a Companion key or DUCK on the phone; it stays until you lift it, and STOP ALL leaves it. Sting fade: how quickly the music fades out under a stinger, how quickly the picture dissolves into a clip, and how quickly the music comes back (0 = a hard cut). Stop fade: how a sound or clip that is stopped — by STOP, by the next press, by a cue moving on — leaves the air: a fade to silence, never a cut, and a stopped sound is silenced for good, so it can never be heard again under the next one. Hold limit: a stinger set to hold gives the show back by itself after this long — 0 means it holds until you take it, so cut stings with a hold frame. Sounds use the track's device selection above; a clip's sound plays like any video." />
    <TextBlock Classes="label" Text="{Binding Audio.StingerStatus}" TextWrapping="Wrap" />

    <TextBlock Classes="hint tip"
               Text="Soundcheck signal for the audio engineer: a reference tone, or a channel ident — one pip LEFT, two pips RIGHT — with a matching on-screen indicator on every output, so what you see is what they hear." />

  </StackPanel>
</UserControl>
