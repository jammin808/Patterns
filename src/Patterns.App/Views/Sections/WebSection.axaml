<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             x:Class="Patterns.App.Views.Sections.WebSection"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-remote" Text="Remote &amp; web" />

    <TextBlock Classes="h2" Text="REMOTE CONTROL" />
    <CheckBox Content="Remote control on (web remote + Companion)" IsChecked="{Binding State.Control.Enabled}" />
    <CheckBox Content="Remotes may ARM the cue stack (CUE ARM ON / OFF, the Companion ARM key)" IsChecked="{Binding State.Control.RemotesMayArm}"
              ToolTip.Tip="Off by default: arming is a deliberate act at the desk. GO, standby and HOLD from a remote need the stack armed either way." />
    <StackPanel IsEnabled="{Binding State.Control.Enabled}">
      <Grid ColumnDefinitions="130,*,16,Auto,8,90">
        <TextBlock Classes="label" Text="Web remote port" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" Minimum="1024" Maximum="65535" Increment="1" FormatString="0"
                       Value="{Binding State.Control.HttpPort, Mode=TwoWay, Converter={StaticResource Num}}" />
        <TextBlock Grid.Column="3" Classes="label" Text="Companion (TCP)" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="5" Minimum="1024" Maximum="65535" Increment="1" FormatString="0"
                       Value="{Binding State.Control.TcpPort, Mode=TwoWay, Converter={StaticResource Num}}" />
      </Grid>
      <TextBlock Classes="label" Text="Open on a phone or tablet on this network:" Margin="0,4,0,0" />
      <TextBox Text="{Binding RemoteUrlsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
               FontFamily="Consolas,monospace" />
      <TextBlock Classes="hint tip"
                 Text="The web remote drives presenter next/back, looks, transport, blackout, screens and the audio track — big buttons, made for a phone at the tech table or in a pocket. Bitfocus Companion: add a 'Patterns' connection with the companion module (integrations folder in the repo), or use Generic TCP with the commands in docs/REMOTE.md — looks, screens and canvas groups map straight onto Stream Deck keys with live feedback. No password: anyone on this network can control the show while enabled." />

      <TextBlock Classes="h2" Text="OSC" />
      <CheckBox Content="OSC in (UDP) — QLab, TouchOSC, a lighting desk, Companion's OSC" IsChecked="{Binding State.Control.OscEnabled}"
                ToolTip.Tip="Off by default: another open port is a deliberate act. Every address starts /patterns/ and means exactly the TCP line it maps to" />
      <Grid ColumnDefinitions="130,90,16,Auto,8,*,8,90" IsEnabled="{Binding State.Control.OscEnabled}">
        <TextBlock Classes="label" Text="OSC port" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" ShowButtonSpinner="False"
                       Value="{Binding State.Control.OscPort, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="The UDP port Patterns listens on" />
        <TextBlock Grid.Column="3" Classes="label" Text="Feedback to" VerticalAlignment="Center" />
        <TextBox Grid.Column="5" Text="{Binding State.Control.OscFeedbackHost, Mode=TwoWay}" Watermark="host or address — empty = no feedback"
                 ToolTip.Tip="Every change sends one bundle of /patterns/state/… messages here (the tablet running TouchOSC, the desk running Companion); replies to a command go to whoever sent it either way" />
        <NumericUpDown Grid.Column="7" Minimum="1" Maximum="65535" Increment="1" FormatString="0" ShowButtonSpinner="False"
                       Value="{Binding State.Control.OscFeedbackPort, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="The port the feedback host listens on" />
      </Grid>
      <TextBlock Classes="label" Text="{Binding OscStatus}" TextWrapping="Wrap" />
      <TextBlock Classes="hint tip"
                 Text="Addresses: /patterns/outputs 1|0 · /patterns/blackout [1|0] · /patterns/identify · /patterns/look n|name · /patterns/next, /prev · /patterns/screen/n [1|0] · /patterns/lock/n [1|0] · /patterns/group/A 1|0 · /patterns/audio/play, /stop · /patterns/music/play [n|name], /pause, /next, /volume level · /patterns/tone 1|0 · /patterns/duck [1|0] · /patterns/stinger n|name, /stinger/stop, /vog, /sting · /patterns/lowerthird n|name [person], /lowerthird/off · /patterns/person n|name · /patterns/section n|name · /patterns/stream 1|0 · /patterns/cue/go [id], /cue/standby/next, /prev, /cue/standby number|name, /cue/hold 1|0, /cue/arm 1|0 · /patterns/stopall · /patterns/ping. A number or a name rides as the next address segment or as the first argument; a switch is 1/0, a float above 0.5, a bool, or on/off/toggle; a fader's 0.0–1.0 float is a music level. A refused command answers /patterns/error to the sender, ping answers /patterns/pong. The feedback bundle carries /patterns/state/live, /blackout, /program, /duck, /tone, /audio, /music, /music/now, /music/level, /stinger, /stinger/hold, /lowerthird, /lowerthird/person, /stream, /playlist, /health, /rev, /screen/n, /lock/n, /cue/armed, /cue/hold, /cue/confirm, /cue/standby (number, name), /cue/previous, /cue/next, /cue/last (number, outcome), /cue/offset, /cue/follow. The full list with the meanings is in docs/REMOTE.md." />
    </StackPanel>

    <TextBlock Classes="hint tip"
               Text="Watchdog, performance monitoring, GPU choice and machine health live on the Machine page (ADMIN)." />

    <TextBlock Classes="hint tip"
               Text="Put a web page on any screen — session schedules, dashboards, wayfinding, streams. Two ways: inside the engine (SHOW THIS PAGE ON THE PATTERN, or Media → Web page), where it joins spans and trims, reaches NDI and the stream, rides with looks and cues and takes clicks from the PREVIEW pane; or as a managed browser window on top of a screen (OPEN FULL SCREEN), for a page that must keep its own keyboard and mouse." />

    <TextBlock Classes="h2" Text="PAGE" />
    <TextBox Watermark="https://example.com/schedule — or a local HTML file" Text="{Binding State.Web.Url}" />
    <Grid ColumnDefinitions="130,*">
      <TextBlock Classes="label" Text="On screen" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding WebScreens}"
                SelectedValue="{Binding State.Web.TargetScreenId, Mode=TwoWay}"
                SelectedValueBinding="{Binding ScreenId, x:DataType=vm:EditTarget}" />
    </Grid>
    <WrapPanel Margin="0,4,0,0">
      <Button Classes="go" Content="OPEN FULL SCREEN" Command="{Binding OpenWebFullscreenCommand}"
              Margin="0,0,8,6" ToolTip.Tip="Kiosk mode — no browser chrome, fills the chosen screen" />
      <Button Classes="chip" Content="Windowed" Command="{Binding OpenWebWindowedCommand}"
              Margin="0,0,8,6" VerticalAlignment="Center"
              ToolTip.Tip="A movable window on the chosen screen (drag it, or close and reopen full screen)" />
      <Button Classes="stop" Content="CLOSE" Command="{Binding CloseWebCommand}"
              Margin="0,0,0,6" ToolTip.Tip="Close every web window Patterns opened" />
    </WrapPanel>
    <TextBlock Classes="label" Text="{Binding WebStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="hint tip"
               Text="Full screen = kiosk (in), windowed = out; Esc inside a kiosk window also exits its full screen. Opened pages are remembered below." />

    <TextBlock Classes="h2" Text="IN THE ENGINE" />
    <WrapPanel>
      <Button Classes="go" Content="SHOW THIS PAGE ON THE PATTERN" Command="{Binding PutWebPageOnPatternCommand}" Margin="0,0,8,6"
              ToolTip.Tip="The selected target's pattern becomes a Media pattern showing this page inside the engine — spans, NDI, the stream, looks and cues all carry it; drive it on the PREVIEW pane" />
    </WrapPanel>
    <TextBlock Classes="hint tip"
               Text="Inside the engine the page is a picture like any other: it fits the canvas, crossfades, sits under the overlays and the lower third, and can be a layer over another pattern too (Media page → LAYERS → Web page). Click, drag and scroll it on the PREVIEW pane; the pointer is drawn for the room or hidden per page; PAGE CONTROLS on the Media page type into it. Needs the WebView2 runtime, which Windows 10 and 11 keep current." />

    <TextBlock Classes="h2" Text="SAVED PAGES" />
    <ItemsControl ItemsSource="{Binding State.Web.SavedUrls}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Grid ColumnDefinitions="*,6,Auto,Auto" Margin="0,2">
            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
            <Button Grid.Column="2" Classes="mini" Content="Use"
                    ToolTip.Tip="Put this address in the page box"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LoadWebUrlCommand}"
                    CommandParameter="{Binding}" />
            <Button Grid.Column="3" Classes="mini" Content="✕"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveWebUrlCommand}"
                    CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="h2" Text="GOOD TO KNOW" />
    <TextBlock Classes="hint tip"
               Text="A browser window (OPEN FULL SCREEN) sits on top of the operating system, not inside the pattern engine — it doesn't join spans, take trims, or reach NDI outputs, but it keeps a real keyboard and mouse for someone at that screen. A page inside the engine does all of those and is driven from the desk; a page with sound plays it on the default device unless muted." />
  </StackPanel>
</UserControl>
