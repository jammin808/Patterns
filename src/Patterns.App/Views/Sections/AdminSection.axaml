<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             x:Class="Patterns.App.Views.Sections.AdminSection"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-admin" Text="Machine" />
    <TextBlock Classes="hint tip"
               Text="The machine room: live and historical performance, plain-language suggestions when something needs attention, the graphics card choice, and the tools for keeping a show machine healthy." />

    <TextBlock Classes="h2" Text="SUPER-CHECK" />
    <TextBlock Classes="hint tip" TextWrapping="Wrap"
               Text="One button: the machine, the graphics card, every display and its mode, the outputs and their frame rate, NDI, the stream, audio, the remote, video playback and the advice — each with a light — and the level of show this hardware is good for. The report is saved beside the exe and can be copied into an email." />
    <WrapPanel>
      <Button Classes="go" Content="RUN SUPER-CHECK" Padding="14,8" Margin="0,0,8,6" Command="{Binding RunSuperCheckCommand}"
              ToolTip.Tip="Checks everything now and writes patterns.supercheck.txt beside the exe" />
      <Button Classes="chip" Content="Copy report" Click="CopySuperCheck" Margin="0,0,8,6" IsVisible="{Binding HasSuperCheck}"
              ToolTip.Tip="The whole report as text — paste it into an email or ticket" />
    </WrapPanel>
    <Border Classes="panel" Padding="12" IsVisible="{Binding HasSuperCheck}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="12" Height="12" Fill="{Binding SuperCheckDot}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SuperCheckHeadline}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="label" Text="{Binding SuperCheckLevelText}" TextWrapping="Wrap" />
        <TextBlock Classes="hint" Text="{Binding SuperCheckSavedText}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding SuperCheckRows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CheckRowView">
              <Border Width="330" Background="{StaticResource PanelBg2Brush}" CornerRadius="6" Padding="8,6" Margin="0,0,6,6">
                <Grid ColumnDefinitions="Auto,8,*">
                  <Ellipse Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,4,0,0" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Classes="hint" Text="{Binding Section}" />
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                      <Run Text="{Binding Item}" /><Run Text=" — " /><Run Text="{Binding Value}" />
                    </TextBlock>
                    <TextBlock Classes="hint" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock Classes="h2" Text="LIVE PERFORMANCE (LAST 3 MINUTES)" />
    <Grid ColumnDefinitions="86,*" Margin="0,2">
      <TextBlock Classes="label" Text="CPU" VerticalAlignment="Top" Margin="0,2,0,0" />
      <StackPanel Grid.Column="1" Spacing="3">
        <TextBlock Classes="label" Text="{Binding AdminCpuText}" TextWrapping="Wrap" />
        <Border Width="200" Height="44" HorizontalAlignment="Left" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="3">
          <Polyline Points="{Binding AdminCpuSpark}" Stroke="#3EC1F3" StrokeThickness="1.5" Margin="1" />
        </Border>
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="86,*" Margin="0,4">
      <TextBlock Classes="label" Text="Memory" VerticalAlignment="Top" Margin="0,2,0,0" />
      <StackPanel Grid.Column="1" Spacing="3">
        <TextBlock Classes="label" Text="{Binding AdminMemText}" TextWrapping="Wrap" />
        <Border Width="200" Height="44" HorizontalAlignment="Left" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="3">
          <Polyline Points="{Binding AdminRamSpark}" Stroke="#B18CFF" StrokeThickness="1.5" Margin="1" />
        </Border>
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="86,*" Margin="0,4">
      <TextBlock Classes="label" Text="Rendering" VerticalAlignment="Top" Margin="0,2,0,0" />
      <StackPanel Grid.Column="1" Spacing="3">
        <TextBlock Classes="label" Text="{Binding AdminRenderText}" TextWrapping="Wrap" />
        <Border Width="200" Height="44" HorizontalAlignment="Left" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="3">
          <Polyline Points="{Binding AdminFpsSpark}" Stroke="#2EE68A" StrokeThickness="1.5" Margin="1" />
        </Border>
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="86,*" Margin="0,2">
      <TextBlock Classes="label" Text="GPU" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="label" Text="{Binding AdminGpuText}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Grid>
    <TextBlock Classes="hint" Text="{Binding AdminExtrasText}" />
    <TextBlock Classes="hint tip"
               Text="A 30-second summary is appended to patterns.metrics.csv beside the exe (rotated at 1 MB) — after a bad night, the record shows what CPU, memory and frame rate were doing." />
    <CheckBox Content="Keep the on-disk performance record (patterns.metrics.csv)"
              IsChecked="{Binding State.Admin.MetricsCsv}" />

    <TextBlock Classes="h2" Text="SUGGESTIONS" />
    <ItemsControl ItemsSource="{Binding AdminSuggestions}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SuggestionRow">
          <Grid ColumnDefinitions="Auto,8,*" Margin="0,3">
            <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,5,0,0" />
            <StackPanel Grid.Column="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="hint" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,1,0,0" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="h2" Text="GRAPHICS CARD" />
    <ItemsControl ItemsSource="{Binding GpuRows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:GpuRow">
          <StackPanel Margin="0,2">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{Binding Detail}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid ColumnDefinitions="60,*" Margin="0,4,0,0">
      <TextBlock Classes="label" Text="Use" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" MinWidth="240" HorizontalAlignment="Stretch"
                ItemsSource="{x:Static vm:Lists.GpuPreferences}"
                SelectedValue="{Binding State.Admin.Graphics.Preference, Mode=TwoWay}"
                SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
    </Grid>
    <Grid ColumnDefinitions="60,*" Margin="0,4,0,0" IsVisible="{Binding GpuSpecificVisible}">
      <TextBlock Classes="label" Text="Adapter" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding GpuAdapterNames}"
                SelectedItem="{Binding State.Admin.Graphics.AdapterName, Mode=TwoWay}" />
    </Grid>
    <Grid ColumnDefinitions="60,*" Margin="0,4,0,0">
      <TextBlock Classes="label" Text="Direct" VerticalAlignment="Top" Margin="0,2,0,0"
                 ToolTip.Tip="Direct output: outputs that bypass the desktop compositor (Screens page, the selected screen)" />
      <TextBlock Grid.Column="1" Classes="hint" Text="{Binding DirectOutputSummary}" TextWrapping="Wrap" />
    </Grid>
    <TextBlock Classes="label" Text="{Binding GpuActiveText}" />
    <TextBlock Classes="label" Text="{Binding GraphicsApplyStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="hint tip"
               Text="By default Patterns detects the best card (most video memory, discrete first) and registers it with Windows so video decoding uses the same card — on laptops this is what stops the show rendering on the battery-saver GPU. Changing it needs an app restart." />

    <TextBlock Classes="h2" Text="THIS COMPUTER" />
    <TextBlock Classes="label" Text="{Binding MachineOverview}" TextWrapping="Wrap" LineHeight="20" />
    <WrapPanel Margin="0,6,0,0">
      <Button Classes="chip" Content="Copy support info" Click="CopySupportInfo" Margin="0,0,8,6"
              ToolTip.Tip="Machine, GPUs, screens, current numbers and advice — paste into an email or ticket" />
      <Button Classes="chip" Content="Open app folder" Command="{Binding OpenAppFolderCommand}" Margin="0,0,8,6"
              ToolTip.Tip="Settings, logs, presets and the metrics record live beside Patterns.exe" />
    </WrapPanel>

    <TextBlock Classes="h2" Text="STABILITY (WATCHDOG)" />
    <CheckBox Content="Watchdog: auto-restart after a crash or hang"
              IsChecked="{Binding State.Watchdog.Enabled}"
              ToolTip.Tip="Takes effect on the next start of Patterns" />
    <CheckBox Content="After a restart, put the show back (open outputs, resume the audio track)"
              IsChecked="{Binding State.Watchdog.AutoRestore}"
              IsEnabled="{Binding State.Watchdog.Enabled}" />
    <TextBlock Classes="label" Text="{Binding HealthText}" TextWrapping="Wrap" />
    <Button Classes="stop" Content="RESTART APP (SHOW COMES BACK)" Padding="14,8" Margin="0,6,0,0"
            Command="{Binding RestartAppCommand}"
            ToolTip.Tip="Exits and relaunches through the watchdog — outputs and the audio track are restored in seconds. Use it to apply a GPU change or clear a suspected leak at a break." />
    <TextBlock Classes="hint tip"
               Text="A tiny supervisor runs the app as its child (two Patterns.exe in Task Manager — that's this). If the app crashes, or its interface stops responding for 30 seconds, it is restarted within seconds with the same settings and the outputs re-opened. Restarts back off and stop if something crashes over and over (see patterns.watchdog.log) — and when they stop, the next start says so on the health line above. What the heartbeat cannot see — outputs open but drawing nothing while the desk still answers, a stream that switched itself off — the advice list above now says." />

    <TextBlock Classes="h2" Text="BEACON (A SECOND MACHINE)" />
    <CheckBox Content="Send a heartbeat beacon every second — this is the main machine"
              IsChecked="{Binding State.Watchdog.BeaconEnabled}"
              ToolTip.Tip="One small UDP datagram a second: who this machine is, what is on air, the cue on standby, the health line. A backup machine listening for it knows within five seconds when this one goes silent — and the watchdog sends one last beacon when it gives up" />
    <Grid ColumnDefinitions="110,*,8,90,16,Auto,8,*" IsEnabled="{Binding State.Watchdog.BeaconEnabled}">
      <TextBlock Classes="label" Text="Send to" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding State.Watchdog.BeaconHost, Mode=TwoWay}" Watermark="255.255.255.255 = everyone on this network"
               ToolTip.Tip="The backup machine's address or name, or the broadcast address" />
      <NumericUpDown Grid.Column="3" Minimum="1" Maximum="65535" Increment="1" FormatString="0" ShowButtonSpinner="False"
                     Value="{Binding State.Watchdog.BeaconPort, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="The port the backup listens on" />
      <TextBlock Grid.Column="5" Classes="label" Text="As" VerticalAlignment="Center" />
      <TextBox Grid.Column="7" Text="{Binding State.Watchdog.BeaconName, Mode=TwoWay}" Watermark="this computer's name" ToolTip.Tip="How this machine names itself in its beacon" />
    </Grid>
    <CheckBox Content="Listen for the main machine's beacon — this is the backup"
              IsChecked="{Binding State.Watchdog.BeaconListen}"
              ToolTip.Tip="The health line and the super-check then say whether the main machine is alive, silent, or its watchdog stood down" />
    <Grid ColumnDefinitions="110,90" IsEnabled="{Binding State.Watchdog.BeaconListen}">
      <TextBlock Classes="label" Text="Listen on port" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" ShowButtonSpinner="False"
                     Value="{Binding State.Watchdog.BeaconListenPort, Mode=TwoWay, Converter={StaticResource Num}}" />
    </Grid>
    <TextBlock Classes="label" Text="{Binding BeaconStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="hint tip"
               Text="The backup-machine path: two machines on the same network, the same show file on both (a USB stick, or Export the show), the same displays cabled to a switcher or the same NDI names, the main one sending its beacon and the backup listening. The backup's health line reads 'Main machine seen 1 s ago: live · Walk-in · standby 01.020' while all is well, 'MAIN MACHINE SILENT for 6 s — take over?' when the main goes quiet, and 'its watchdog gave up' when the main's supervisor stood down; the super-check shows the same as a red row. Taking over is still your call — OUTPUTS ON here, the switcher to this machine — and that is deliberate: two machines both deciding to be the main is the one failure worse than one being down. Nothing but this datagram leaves the machine; the beacon carries no control." />
  </StackPanel>
</UserControl>
