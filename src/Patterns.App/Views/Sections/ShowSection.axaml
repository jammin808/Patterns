<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:m="using:Patterns.Core.Model"
             xmlns:lt="using:Patterns.Core.LowerThirds"
             x:Class="Patterns.App.Views.Sections.ShowSection"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-show" Text="Show panel" />
    <TextBlock Classes="hint tip" Text="Show-time buttons beside the switcher: looks, VOGs and stingers, the clicker list, break music and the audio track. The outputs transport is in the header; the cue stack runs from the Run page (RUN)." />

    <TextBlock Classes="h2" Text="LOOKS" />
    <ItemsControl ItemsSource="{Binding State.LooksAndCues.Looks}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:LookConfig">
          <!-- Lit red while it is the picture on air, green while it is loaded in the preview. -->
          <Button Classes="chip" Classes.pvw="{Binding IsInPreview}" Classes.air="{Binding IsOnAir}"
                  Margin="0,0,6,6" Height="52" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  ToolTip.Tip="{Binding TallyText}"
                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ApplyLookCommand}"
                  CommandParameter="{Binding}">
            <StackPanel>
              <TextBlock Text="{Binding Hotkey, Converter={StaticResource HotkeyLabel}}" FontSize="10"
                         Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                         IsVisible="{Binding Hotkey, Converter={StaticResource Positive}}" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint tip" Text="Save looks on the Looks page (PLAN) — F1–F12 recall them from anywhere." />

    <TextBlock Classes="h2" Text="CLICKER LIST" />
    <Grid ColumnDefinitions="*,8,*">
      <Button Grid.Column="0" Classes="chip" Content="⟨  Back" Height="46" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Command="{Binding PresenterPrevCommand}" />
      <Button Grid.Column="2" Classes="go" Content="Next  ⟩" Height="46" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Command="{Binding PresenterNextCommand}" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="label" Text="{Binding PresenterStepText}" VerticalAlignment="Center" />
      <CheckBox Grid.Column="1" Content="Clicker armed" IsChecked="{Binding ClickerArmed, Mode=TwoWay}"
                ToolTip.Tip="Page Down / Page Up (USB clickers) step the clicker list — build it on the Cues page" />
    </Grid>

    <StackPanel IsVisible="{Binding VogChips.Count, Converter={StaticResource Positive}}">
      <TextBlock Classes="h2" Text="VOG" />
      <ItemsControl ItemsSource="{Binding VogChips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:StingerItemConfig">
            <Button Classes="chip" Classes.air="{Binding IsOnAir}" Margin="0,0,6,6" Height="46" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" ToolTip.Tip="{Binding OnAirText}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FireVogCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Path, Converter={StaticResource MediaKind}}" FontSize="10"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel IsVisible="{Binding StingChips.Count, Converter={StaticResource Positive}}">
      <TextBlock Classes="h2" Text="STINGERS" />
      <ItemsControl ItemsSource="{Binding StingChips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:StingerItemConfig">
            <Button Classes="chip" Classes.air="{Binding IsOnAir}" Margin="0,0,6,6" Height="56" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" ToolTip.Tip="{Binding OnAirText}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FireStingCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Path, Converter={StaticResource MediaKind}}" FontSize="10"
                             Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="hint" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding AfterKey, Converter={StaticResource StingerAfterText}, ConverterParameter=summary}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel IsVisible="{Binding State.LowerThirds.Designs.Count, Converter={StaticResource Positive}}">
      <TextBlock Classes="h2" Text="LOWER THIRDS" />
      <ItemsControl ItemsSource="{Binding State.LowerThirds.Designs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="lt:LowerThirdDesign">
            <Button Classes="chip" Classes.air="{Binding IsOnAir}" Margin="0,0,6,6" Height="46" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" ToolTip.Tip="{Binding OnAirText}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowLowerThirdCommand}"
                    CommandParameter="{Binding}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBlock Classes="label" Text="{Binding LowerThirdStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="2" Classes="mini" Content="■ Hide" Command="{Binding HideLowerThirdCommand}" />
      </Grid>
      <TextBlock Classes="hint tip" Text="A design goes on air over whatever is showing, on every screen, send and the stream, and leaves the way it was designed to. Build them on the Lower thirds page (BUILD)." />
    </StackPanel>

    <Border Classes="runBanner" IsVisible="{Binding StingerHolding}">
      <Grid ColumnDefinitions="*,8,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="runTag" Text="STING HOLD" />
          <TextBlock Classes="label" Text="{Binding StingerHoldText}" TextWrapping="Wrap" />
          <TextBlock Classes="hint tip" Text="TAKE the preview, GO the next cue — or put it back." />
        </StackPanel>
        <Button Grid.Column="2" Classes="stop" Content="PUT IT BACK" Command="{Binding StopStingerCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,8,Auto">
      <TextBlock Classes="label" Text="{Binding StingerStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="2" Classes="mini" Content="■ Stop" Command="{Binding StopStingerCommand}" />
    </Grid>
    <TextBlock Classes="hint tip"
               Text="A VOG plays over everything (the music ducks, and so does a stinger that is playing) and the content carries on. A STINGER fades the music out, and when it lands the show goes where the stinger says: back, held for your take, on to the next cue, or to a look you chose. Set them up on the Audio page (SETUP)." />

    <TextBlock Classes="h2" Text="AUDIO TRACK" />
    <Grid ColumnDefinitions="*,8,Auto,Auto">
      <TextBlock Grid.Column="0" Classes="label" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="{Binding AudioPlayerStatus}" />
      <Button Grid.Column="2" Classes="mini" Content="▶ Play" Command="{Binding PlayAudioCommand}" />
      <Button Grid.Column="3" Classes="mini" Content="■ Stop" Command="{Binding StopAudioCommand}" />
    </Grid>
    <TextBlock Classes="hint tip" Text="The message, clock, countdown and this track's volume are in the SHOW CONTROLS drawer under the wall." />

    <StackPanel x:Name="BreakMusicBlock" IsVisible="{Binding State.Spotify.Enabled}">
      <TextBlock Classes="h2" Text="BREAK MUSIC" />
      <ItemsControl ItemsSource="{Binding State.Spotify.Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:SpotifyItemConfig">
            <Button Classes="chip" Margin="0,0,6,6" Height="46" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlayMusicItemCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding KindLabel}" FontSize="10"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,8,Auto,Auto,Auto">
        <TextBlock Classes="label" Text="{Binding SpotifyStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="2" Classes="mini" Content="▶ Play" Command="{Binding ResumeMusicCommand}" />
        <Button Grid.Column="3" Classes="mini" Content="❚❚ Pause" Command="{Binding PauseMusicCommand}" />
        <Button Grid.Column="4" Classes="mini" Content="⏭ Skip" Command="{Binding SkipMusicCommand}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,8,*,8,44">
        <TextBlock Classes="label" Text="Level" VerticalAlignment="Center" />
        <Slider Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="5"
                Value="{Binding State.Spotify.LevelPct, Mode=TwoWay}" />
        <TextBlock Grid.Column="4" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding State.Spotify.LevelPct, StringFormat={}{0:0}%}" />
      </Grid>
      <TextBlock Classes="hint tip"
                 Text="Spotify plays the room during breaks. It ducks under a stinger sound and STOP ALL pauses it. Set it up on the Audio page (SETUP)." />
    </StackPanel>

    <TextBlock Classes="h2" Text="STATUS" />
    <TextBlock Classes="label" Text="{Binding OutputsStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="{Binding NextCueText}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="{Binding PlaylistStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="{Binding RemoteStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="{Binding HealthText}" TextWrapping="Wrap" />
    <TextBlock Classes="hint tip"
               Text="Phone remote: open the web address above on any device on this network (the Remote page under SETUP for settings and Companion)." />
  </StackPanel>
</UserControl>
