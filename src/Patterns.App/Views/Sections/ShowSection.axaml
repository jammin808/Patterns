<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:m="using:Patterns.Core.Model"
             xmlns:lt="using:Patterns.Core.LowerThirds"
             x:Class="Patterns.App.Views.Sections.ShowSection"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-show" Text="Show panel" />
    <TextBlock Classes="hint tip" Text="One page runs the show beside the switcher: the caller's cue strip, the looks, each screen on its own, where the show goes next, then VOGs and stingers, lower thirds, the audio track and break music. The outputs transport is in the header; the Run page (SHOW) is the same cue stack full screen for a caller reading from a metre." />

    <TextBlock Classes="h2" Text="CUES" />
    <Border Classes="runRow">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,10,*,8,Auto">
          <TextBlock Classes="runTag" Text="STANDBY" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding Run.StandbyText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="hint" Text="{Binding Run.StandbyPlanText}" IsVisible="{Binding Run.HasStandbyPlan}" />
            <TextBlock Classes="hint" Foreground="{StaticResource TallyPgmBrush}" Text="{Binding Run.StandbyProblem}" IsVisible="{Binding Run.StandbyIsBroken}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="mini" Content="▲" Command="{Binding Run.StandbyUpCommand}" ToolTip.Tip="The cue above goes on standby" />
            <Button Classes="mini" Content="▼" Command="{Binding Run.StandbyDownCommand}" ToolTip.Tip="The cue below goes on standby" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="Auto,10,*" IsVisible="{Binding Run.HasNext}">
          <TextBlock Classes="runTag" Text="NEXT" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="label" Text="{Binding Run.NextText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="*,8,Auto,8,Auto">
          <Button Classes="runGo" Content="{Binding Run.GoText}" Command="{Binding Run.GoCommand}" IsEnabled="{Binding Run.IsArmed}"
                  Height="56" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  ToolTip.Tip="The standby cue fires and the next one moves up (Space / Enter on the Run page); a cue marked confirm asks twice" />
          <Button Grid.Column="2" Classes="chip" Classes.air="{Binding Run.IsHold}" Content="HOLD" Command="{Binding Run.HoldCommand}" Height="56"
                  ToolTip.Tip="Nothing fires — GO, auto-follows, the clicker — until HOLD is pressed again" />
          <Button Grid.Column="4" Classes="chip" Classes.pvw="{Binding Run.IsArmed}" Content="{Binding Run.ArmText}" Command="{Binding Run.ArmCommand}" Height="56"
                  ToolTip.Tip="Disarmed, the stack cannot GO — the app always opens disarmed" />
        </Grid>
        <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding Run.HasFollow}">
          <TextBlock Classes="label" Text="{Binding Run.FollowText}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="2" Classes="mini" Content="CANCEL" Command="{Binding Run.CancelFollowCommand}"
                  ToolTip.Tip="The auto-follow counting down is cancelled; the cue stays on standby for a GO" />
        </Grid>
        <TextBlock Classes="hint" Text="{Binding Run.ValidationSummary}" IsVisible="{Binding Run.HasValidationSummary}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <TextBlock Classes="hint tip" Text="The caller's stack in a strip: STANDBY is the cue GO fires, NEXT the one after it; ▲ ▼ move the standby, HOLD stops everything firing, ARM is the safety. Build the stack on the Cues page (PLAN)." />

    <TextBlock Classes="h2" Text="LOOKS" />
    <ItemsControl ItemsSource="{Binding State.LooksAndCues.Looks}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:LookConfig">
          <!-- Lit red while it is the picture on air, green while it is loaded in the preview; PVW loads it into the preview for a sign-off. -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,6,6">
            <Button Classes="chip" Classes.pvw="{Binding IsInPreview}" Classes.air="{Binding IsOnAir}"
                    Height="56" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    ToolTip.Tip="{Binding TallyText}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ApplyLookCommand}"
                    CommandParameter="{Binding}">
              <StackPanel>
                <TextBlock Text="{Binding Hotkey, Converter={StaticResource HotkeyLabel}}" FontSize="10"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                           IsVisible="{Binding Hotkey, Converter={StaticResource Positive}}" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="mini" Content="PVW" Height="56" Margin="2,0,0,0" VerticalAlignment="Stretch"
                    ToolTip.Tip="Load this look into the sandboxed preview (EDIT SAFE) for a sign-off — TAKE then puts it on air"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ApplyLookToPreviewCommand}"
                    CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint tip" Text="A tile puts the look on air (with EDIT SAFE open it goes to the preview for a TAKE); PVW loads it into the preview whatever the mode. Save looks on the Looks page (PLAN) — F1–F12 recall them from anywhere." />

    <TextBlock Classes="h2" Text="SCREENS — EACH ON ITS OWN" />
    <ItemsControl ItemsSource="{Binding SwitcherTiles}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SwitcherTile">
          <!-- One row per screen and canvas (the program tile has the LOOKS grid above): a look on this screen alone, or the program back. -->
          <Border Classes="runRow" IsVisible="{Binding !IsProgramTile}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="runTag" Text="ON AIR" Foreground="{StaticResource TallyPgmBrush}" IsVisible="{Binding IsOnAir}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="runTag" Text="OWN" IsVisible="{Binding IsOwn}" Margin="6,0,0,0" VerticalAlignment="Center"
                           ToolTip.Tip="This screen shows its own picture, not the program" />
                <TextBlock Grid.Column="3" Classes="runTag" Text="LOCKED" IsVisible="{Binding IsLocked}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Classes="runTag" Text="{Binding RoleBadge}" IsVisible="{Binding HasBadge}" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{Binding BadgeTip}" />
              </Grid>
              <Grid ColumnDefinitions="*,6,Auto,6,Auto,6,Auto,6,Auto">
                <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).State.LooksAndCues.Looks}"
                          SelectedItem="{Binding PendingLook, Mode=TwoWay}" PlaceholderText="Which look…" HorizontalAlignment="Stretch"
                          DisplayMemberBinding="{Binding Name, x:DataType=m:LookConfig}"
                          ToolTip.Tip="The look whose picture → THIS SCREEN puts here alone" />
                <Button Grid.Column="2" Classes="go" Content="→ THIS SCREEN" Command="{Binding SendLookCommand}" IsEnabled="{Binding HasPendingLook}"
                        ToolTip.Tip="That look's picture for this screen lands here alone, live — every other screen stays as it is; a whole-look recall or a cue replaces it, TAKE leaves it, LOCK keeps it" />
                <Button Grid.Column="4" Classes="chip" Content="PROGRAM" Command="{Binding ProgramCommand}"
                        ToolTip.Tip="Back to the program: this screen drops its own picture" />
                <ToggleButton Grid.Column="6" Classes="mini" Content="LOCK" IsChecked="{Binding IsLocked, Mode=TwoWay}"
                              ToolTip.Tip="Keeps its picture through looks, cues, TAKE ALL and stingers (a confidence or info screen). Saved with the show" />
                <ToggleButton Grid.Column="8" Classes="mini" Content="ON" IsChecked="{Binding Enabled, Mode=TwoWay}"
                              ToolTip.Tip="The screen's output on or off, live" />
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint tip" Text="Independent screen changes without leaving the panel: pick a look in a row and → THIS SCREEN puts that look's picture (its own picture for this screen if the look carried one, else the look's program) on that screen alone — every other screen stays exactly as it was. PROGRAM puts the screen back on the program. On the wire: SCREEN 2 LOOK Sponsor, SCREEN 2 PROGRAM; a cue's Screen — its own look; /patterns/screen/2/look over OSC; Companion's screen_look key." />

    <TextBlock Classes="h2" Text="PROGRESSION" />
    <Grid ColumnDefinitions="*,8,*">
      <Button Grid.Column="0" Classes="chip" Content="⟨  Back" Height="46" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Command="{Binding PresenterPrevCommand}" />
      <Button Grid.Column="2" Classes="go" Content="Next  ⟩" Height="46" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Command="{Binding PresenterNextCommand}" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="label" Text="{Binding ProgressionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <CheckBox Grid.Column="1" Content="Clicker armed" IsChecked="{Binding ClickerArmed, Mode=TwoWay}"
                ToolTip.Tip="Page Down / Page Up (USB clickers) step the clicker list — build it on the Cues page" />
    </Grid>
    <TextBlock Classes="hint tip" Text="Where the show goes next, by itself or by a click, in one line: the clicker list's place (NEXT / BACK here, Page Down / Page Up from a USB clicker while Clicker armed is ticked), a deck's page while a PDF is on air, an auto-follow counting down in the cue stack, and the playlist's part with what is left of it." />

    <StackPanel IsVisible="{Binding VogChips.Count, Converter={StaticResource Positive}}">
      <TextBlock Classes="h2" Text="VOG" />
      <ItemsControl ItemsSource="{Binding VogChips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:StingerItemConfig">
            <Button Classes="chip" Classes.air="{Binding IsOnAir}" Margin="0,0,6,6" Height="46" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" ToolTip.Tip="{Binding OnAirText}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FireVogCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Path, Converter={StaticResource MediaKind}}" FontSize="10"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel IsVisible="{Binding StingChips.Count, Converter={StaticResource Positive}}">
      <TextBlock Classes="h2" Text="STINGERS" />
      <ItemsControl ItemsSource="{Binding StingChips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:StingerItemConfig">
            <Button Classes="chip" Classes.air="{Binding IsOnAir}" Margin="0,0,6,6" Height="56" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" ToolTip.Tip="{Binding OnAirText}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FireStingCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Path, Converter={StaticResource MediaKind}}" FontSize="10"
                             Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="hint" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding AfterKey, Converter={StaticResource StingerAfterText}, ConverterParameter=summary}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel IsVisible="{Binding State.LowerThirds.Designs.Count, Converter={StaticResource Positive}}">
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBlock Classes="h2" Text="LOWER THIRDS" VerticalAlignment="Center" />
        <ToggleButton Grid.Column="2" Classes="mini" Content="PVW FIRST" IsChecked="{Binding LowerThirdChipsToPreview, Mode=TwoWay}" VerticalAlignment="Center"
                      ToolTip.Tip="The chips go to the preview for a sign-off instead of straight to air; TAKE TO AIR then puts the signed-off one on (needs EDIT SAFE)" />
      </Grid>
      <ItemsControl ItemsSource="{Binding State.LowerThirds.Designs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="lt:LowerThirdDesign">
            <Button Classes="chip" Classes.pvw="{Binding IsInPreview}" Classes.air="{Binding IsOnAir}" Margin="0,0,6,6" Height="46" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" ToolTip.Tip="{Binding OnAirText}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ChipLowerThirdCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="★" IsVisible="{Binding IsDefault}" ToolTip.Tip="The show's default design" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,8,Auto,6,Auto">
        <TextBlock Classes="label" Text="{Binding LowerThirdStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="2" Classes="mini" Content="UPDATE ON AIR" IsVisible="{Binding LowerThirdAirEdited}" Command="{Binding UpdateLowerThirdCommand}"
                ToolTip.Tip="The design on air has been edited since it went there: push the edit across in place" />
        <Button Grid.Column="4" Classes="mini" Content="■ Hide" Command="{Binding HideLowerThirdCommand}" />
      </Grid>
      <Grid ColumnDefinitions="*,8,Auto,6,Auto" IsVisible="{Binding HasLowerThirdInPreview}">
        <TextBlock Classes="label" Text="{Binding LowerThirdPreviewText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="2" Classes="go" Content="TAKE TO AIR" Command="{Binding TakeLowerThirdCommand}" ToolTip.Tip="The signed-off lower third to air; the preview clears" />
        <Button Grid.Column="4" Classes="mini" Content="CLEAR" Command="{Binding ClearLowerThirdPreviewCommand}" ToolTip.Tip="The preview's lower third leaves; nothing changes on air" />
      </Grid>
      <TextBlock Classes="hint tip" Text="A chip puts the design on air over whatever is showing, on every screen, send and the stream; with PVW FIRST on it goes to the preview instead — the PREVIEW pane, the multiview's Preview tile and REVIEW — for a sign-off, and TAKE TO AIR puts it on. ★ is the show's default design. EDITED means the design was changed after it went on air: UPDATE ON AIR pushes the change. Build designs on the Lower thirds page (BUILD)." />
      <StackPanel IsVisible="{Binding State.LowerThirds.Entries.Count, Converter={StaticResource Positive}}">
        <TextBlock Classes="h2" Text="PEOPLE" />
        <ItemsControl ItemsSource="{Binding State.LowerThirds.Entries}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="lt:LowerThirdEntry">
              <Button Classes="chip" Margin="0,0,6,6" Height="46" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="{Binding Summary}"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ChipEntryCommand}" CommandParameter="{Binding}">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="hint tip" Text="A person goes into the design on air (else the show's ★ default) — name, role, company and photo — and it arrives again: the next speaker in one press. With PVW FIRST on, into the preview for a sign-off first." />
      </StackPanel>
    </StackPanel>

    <Border Classes="runBanner" IsVisible="{Binding StingerHolding}">
      <Grid ColumnDefinitions="*,8,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="runTag" Text="STING HOLD" />
          <TextBlock Classes="label" Text="{Binding StingerHoldText}" TextWrapping="Wrap" />
          <TextBlock Classes="hint tip" Text="TAKE the preview, GO the next cue — or put it back." />
        </StackPanel>
        <Button Grid.Column="2" Classes="stop" Content="PUT IT BACK" Command="{Binding StopStingerCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,8,Auto">
      <TextBlock Classes="label" Text="{Binding StingerStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="2" Classes="mini" Content="■ Stop" Command="{Binding StopStingerCommand}" />
    </Grid>
    <TextBlock Classes="hint tip"
               Text="A VOG plays over everything (the music ducks, and so does a stinger that is playing) and the content carries on. A STINGER fades the music out, and when it lands the show goes where the stinger says: back, held for your take, on to the next cue, or to a look you chose. Set them up on the Audio page (SETUP)." />

    <TextBlock Classes="h2" Text="AUDIO TRACK" />
    <Grid ColumnDefinitions="*,8,Auto,Auto">
      <TextBlock Grid.Column="0" Classes="label" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="{Binding AudioPlayerStatus}" />
      <Button Grid.Column="2" Classes="mini" Content="▶ Play" Command="{Binding PlayAudioCommand}" />
      <Button Grid.Column="3" Classes="mini" Content="■ Stop" Command="{Binding StopAudioCommand}" />
    </Grid>
    <TextBlock Classes="hint tip" Text="The message, clock, countdown and this track's volume are in the SHOW CONTROLS drawer under the wall." />

    <StackPanel x:Name="BreakMusicBlock" IsVisible="{Binding State.Spotify.Enabled}">
      <TextBlock Classes="h2" Text="BREAK MUSIC" />
      <ItemsControl ItemsSource="{Binding State.Spotify.Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:SpotifyItemConfig">
            <Button Classes="chip" Margin="0,0,6,6" Height="46" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlayMusicItemCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding KindLabel}" FontSize="10"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,8,Auto,Auto,Auto">
        <TextBlock Classes="label" Text="{Binding SpotifyStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="2" Classes="mini" Content="▶ Play" Command="{Binding ResumeMusicCommand}" />
        <Button Grid.Column="3" Classes="mini" Content="❚❚ Pause" Command="{Binding PauseMusicCommand}" />
        <Button Grid.Column="4" Classes="mini" Content="⏭ Skip" Command="{Binding SkipMusicCommand}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,8,*,8,44">
        <TextBlock Classes="label" Text="Level" VerticalAlignment="Center" />
        <Slider Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="5"
                Value="{Binding State.Spotify.LevelPct, Mode=TwoWay}" />
        <TextBlock Grid.Column="4" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="{Binding State.Spotify.LevelPct, StringFormat={}{0:0}%}" />
      </Grid>
      <TextBlock Classes="hint tip"
                 Text="Spotify plays the room during breaks. It ducks under a stinger sound and STOP ALL pauses it. Set it up on the Audio page (SETUP)." />
    </StackPanel>

    <TextBlock Classes="h2" Text="FREEZE · FADE · LOOK BACK" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ToggleButton Classes="chip" Content="FREEZE" IsChecked="{Binding IsFrozen, Mode=TwoWay}"
                    ToolTip.Tip="Every output — the windows, the NDI sends, the stream — holds the frame it shows until you press again; the desk keeps moving. A blackout still takes a frozen output. Never saved" />
      <Button Classes="chip" Content="FADE TO BLACK" Command="{Binding FadeToBlackCommand}"
              ToolTip.Tip="Blackout, faded over the seconds beside it (a blackout of its own time, whatever the transition setting)" />
      <NumericUpDown Width="86" Minimum="0.1" Maximum="60" Increment="0.5" FormatString="0.#" ShowButtonSpinner="False"
                     Value="{Binding FadeSeconds, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="Seconds for FADE TO BLACK and FADE UP" />
      <Button Classes="chip" Content="FADE UP" Command="{Binding FadeUpCommand}" ToolTip.Tip="The blackout lifted, faded over the same seconds" />
      <Button Classes="chip" Content="{Binding LookBackText}" Command="{Binding LookBackCommand}"
              ToolTip.Tip="The look that was on air before the current one, back on air with the show's transition — press again to swap back" />
    </StackPanel>
    <TextBlock Classes="hint tip"
               Text="FREEZE holds every output's picture while you change anything behind it (a wall processor's freeze, on the whole rig); FADE TO BLACK and FADE UP are a blackout with a fade of the seconds you type, so a two-second fade to black does not need the transition setting changed; the previous look comes back on air with LOOK BACK, and pressing it again swaps the two. On the wire: FREEZE, FADE 2, FADE UP 2, LOOKBACK; the phone remote and Companion have them; the journal writes every press." />

    <TextBlock Classes="h2" Text="REVIEW" />
    <ToggleButton Classes="chip" Content="THE PREVIEW ON EVERY MULTIVIEW" IsChecked="{Binding ReviewOnMultiview, Mode=TwoWay}" HorizontalAlignment="Left"
                  ToolTip.Tip="Every multiview draws the sandboxed preview full-frame with a REVIEW chip until you switch it off — the next look checked on the monitor wall before the TAKE. Never saved" />
    <TextBlock Classes="hint tip"
               Text="A multiview on a screen, an NDI send of it and /multiview all show the preview while this is on; the program on the audience's screens does not change. The phone remote and Companion have the same switch." />

    <TextBlock Classes="h2" Text="STATUS" />
    <TextBlock Classes="label" Text="{Binding OutputsStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="{Binding NextCueText}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="{Binding PlaylistStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="{Binding RemoteStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="{Binding HealthText}" TextWrapping="Wrap" />
    <TextBlock Classes="hint tip"
               Text="Phone remote: open the web address above on any device on this network (the Remote page under SETUP for settings and Companion)." />
  </StackPanel>
</UserControl>
