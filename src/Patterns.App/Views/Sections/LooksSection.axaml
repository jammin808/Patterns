<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Sections.LooksSection"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-looks" Text="Looks" />
    <TextBlock Classes="hint"
               Text="A look is the whole screen state — pattern, per-screen patterns, overlays, countdown, blackout — saved under a name. Recall it with F1–F12, from a cue, or from the wall-clock automation below, which all lives on this page. With break music on (Audio page), a look can also start a playlist or song, or pause the music, as it goes on air — loading it into the preview leaves the music alone." />

    <TextBlock Classes="h2" Text="SAVE THE CURRENT STATE AS A LOOK" />
    <Grid ColumnDefinitions="*,8,110,8,Auto">
      <TextBox Grid.Column="0" Watermark="Look name — e.g. Walk-in" Text="{Binding NewLookName}" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding HotkeySlots}"
                SelectedItem="{Binding NewLookHotkey, Mode=TwoWay}"
                ToolTip.Tip="Hotkey slot: F1–F12, or no key">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="x:Int32">
            <TextBlock Text="{Binding, Converter={StaticResource HotkeyLabel}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="4" Classes="chip" Content="Save look" Command="{Binding SaveLookCommand}" />
    </Grid>
    <TextBlock Classes="hint" Text="Saving with an existing name updates that look. A hotkey slot in use moves to the new look." />

    <TextBlock Classes="h2" Text="LOOKS" />
    <ItemsControl ItemsSource="{Binding State.LooksAndCues.Looks}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:LookConfig">
          <!-- The tally: a red edge and chip for the look on air, green for the one in the preview; "EDITED" once the picture moved on. -->
          <Border Classes="lookRow" Classes.pvw="{Binding IsInPreview}" Classes.air="{Binding IsOnAir}" CornerRadius="8" Padding="10,7" Margin="0,3">
            <Grid ColumnDefinitions="Auto,10,*,8,Auto,8,Auto,8,Auto,Auto,Auto,Auto">
              <Border Grid.Column="0" Background="#20242E" CornerRadius="7" Padding="8,3" MinWidth="38"
                      IsVisible="{Binding Hotkey, Converter={StaticResource Positive}}">
                <TextBlock Text="{Binding Hotkey, Converter={StaticResource HotkeyLabel}}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
              </Border>
              <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Border Grid.Column="4" Classes="tallyChip" Classes.pvw="{Binding IsInPreview}" Classes.air="{Binding IsOnAir}"
                      IsVisible="{Binding HasTally}" VerticalAlignment="Center"
                      ToolTip.Tip="PROGRAM: the picture on air is this look (EDITED: it was, and has been changed since). PREVIEW: loaded into the sandboxed preview with → PVW.">
                <TextBlock Text="{Binding TallyText}" />
              </Border>
              <!-- The value binding must be in place before the value: a value that cannot be matched to an item is written back as nothing. -->
              <ComboBox Grid.Column="6" Name="LookMusic" MinWidth="150" MaxWidth="230"
                        SelectedValueBinding="{Binding Id, x:DataType=vm:LookMusicChoice}"
                        DisplayMemberBinding="{Binding Label, x:DataType=vm:LookMusicChoice}"
                        ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LookMusicChoices}"
                        SelectedValue="{Binding MusicItemId, Mode=TwoWay}"
                        IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).State.Spotify.Enabled}"
                        ToolTip.Tip="Break music this look starts, or pauses, as it goes on air (Audio page entries)" />
              <Button Grid.Column="8" Classes="mini" Content="→ PVW"
                      ToolTip.Tip="Load into the preview to tweak, then CUT or TAKE it to air"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ApplyLookToPreviewCommand}"
                      CommandParameter="{Binding}" />
              <Button Grid.Column="9" Classes="mini" Content="ON AIR"
                      ToolTip.Tip="Put this look on the screens now (same as its F-key)"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ApplyLookCommand}"
                      CommandParameter="{Binding}" />
              <Button Grid.Column="10" Classes="mini" Content="⟳"
                      ToolTip.Tip="Overwrite this look with the current screen state"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).UpdateLookCommand}"
                      CommandParameter="{Binding}" />
              <Button Grid.Column="11" Classes="mini" Content="✕" ToolTip.Tip="Delete look"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteLookCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint" Text="The cue stack and the clicker list — what the caller and the speaker step through — are on the Cues page." />

    <TextBlock Classes="h2" Text="SCHEDULED AUTOMATION" />
    <TextBlock Classes="label" Text="{Binding NextCueText}" />
    <ItemsControl ItemsSource="{Binding State.LooksAndCues.Cues}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:CueConfig">
          <Grid ColumnDefinitions="Auto,8,74,8,*,6,Auto" Margin="0,3">
            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" ToolTip.Tip="Cue armed" />
            <TextBox Grid.Column="2" Watermark="HH:mm" Text="{Binding Time}" />
            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LookNames}"
                      SelectedItem="{Binding LookName, Mode=TwoWay}"
                      PlaceholderText="Look to fire…" />
            <Button Grid.Column="6" Classes="mini" Content="✕"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveCueCommand}"
                    CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="chip" Content="+ Add cue" Command="{Binding AddCueCommand}" />
    </StackPanel>
    <TextBlock Classes="hint"
               Text="Each armed cue applies its look daily at the set time (24 h) while the app is running — e.g. Walk-in 18:00 · Countdown 18:45 · Blackout 19:00. Times are checked every second; a cue fires once per day. While the caller's cue stack is armed, this schedule waits (the LIVE strip says AUTO HELD)." />

    <TextBlock Classes="h2" Text="PLAYLIST PARTS — DAILY START TIMES" />
    <StackPanel IsVisible="{Binding State.Pattern.Media.Source, Converter={StaticResource EnumEq}, ConverterParameter={x:Static m:MediaSource.Playlist}}">
      <ItemsControl ItemsSource="{Binding State.Pattern.Media.Playlist.Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:PlaylistSectionConfig">
            <Grid ColumnDefinitions="14,8,*,8,74,8,Auto" Margin="0,3">
              <TextBlock Grid.Column="0" Text="▶" FontSize="10" Foreground="#2EE68A" VerticalAlignment="Center"
                         IsVisible="{Binding IsOnAir}" ToolTip.Tip="On air now" />
              <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBox Grid.Column="4" Watermark="HH:mm" Text="{Binding StartTime, Mode=TwoWay}"
                       ToolTip.Tip="Optional daily start time (24 h): the part takes over at this time" />
              <Button Grid.Column="6" Classes="mini" Content="ON AIR"
                      ToolTip.Tip="Put this part on air now"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SetPlaylistSectionCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <TextBlock Classes="hint"
               Text="Shown when the program pattern is Media → Playlist. Parts and their files are built on the Media page (BUILD); their start times live here with the rest of the wall-clock automation, and a part start waits like a scheduled cue while the stack is armed." />
  </StackPanel>
</UserControl>
