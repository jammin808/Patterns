<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:ctl="using:Patterns.App.Views.Controls"
             xmlns:play="using:Patterns.Core.Play"
             x:Class="Patterns.App.Views.Sections.ArcadeSection"
             Classes="hue-arcade"
             x:DataType="vm:IArcadePage">
  <DockPanel Margin="4,8,12,8">
    <StackPanel DockPanel.Dock="Top" Classes="form">
      <TextBlock Classes="h1 neon-arcade" Text="Arcade" />
      <TextBlock Classes="hint tip"
                 Text="Old-school games for a games hub out front, or a rig day on this machine: the picture below is the game, the keyboard and any XInput pad are the players, phones join at /pad, and ARCADE verbs drive it — from a cue, a Stream Deck key or the assistant. On an arcade node (Patterns.exe --node arcade) this page is the node; on a desk the verbs go to the arcade nodes it hears, and with none heard the game runs here. The house plays between matches; START on a pad takes a seat. POP OUT gives the game a window of its own, FULLSCREEN a whole display." />

      <TextBlock Classes="h2" Text="GAME" />
      <WrapPanel>
        <Button Classes="chip" Content="PONG" Margin="0,0,8,6" Command="{Binding ArcadeGameCommand}" CommandParameter="pong" ToolTip.Tip="Two paddles, first to seven; one player faces the house" />
        <Button Classes="chip" Content="SNAKE" Margin="0,0,8,6" Command="{Binding ArcadeGameCommand}" CommandParameter="snake" ToolTip.Tip="Up to four by colour on one board" />
        <Button Classes="chip" Content="BREAKOUT" Margin="0,0,16,6" Command="{Binding ArcadeGameCommand}" CommandParameter="breakout" ToolTip.Tip="Six rows, three lives" />
        <Button Classes="mini" Content="START 1P" Margin="0,0,8,6" Command="{Binding ArcadeStartCommand}" CommandParameter="1" ToolTip.Tip="The game in hand for one person; the rest is the house" />
        <Button Classes="mini" Content="START 2P" Margin="0,0,8,6" Command="{Binding ArcadeStartCommand}" CommandParameter="2" />
        <Button Classes="mini" Content="PAUSE / RESUME" Margin="0,0,8,6" Command="{Binding ArcadePauseCommand}" />
        <Button Classes="mini" Content="STOP" Margin="0,0,8,6" Command="{Binding ArcadeStopCommand}" ToolTip.Tip="The title card" />
      </WrapPanel>
      <TextBlock Classes="label" Text="{Binding ArcadeWords}" TextWrapping="Wrap" />

      <TextBlock Classes="h2" Text="PICTURE" />
      <WrapPanel>
        <CheckBox Content="NDI out" Margin="0,0,12,0" IsChecked="{Binding ArcadeNdi}" VerticalAlignment="Center"
                  ToolTip.Tip="The game on the network as 'PATTERNS ARCADE (this machine)': the desk puts it on a screen or a canvas like any NDI source" />
        <ComboBox ItemsSource="{Binding ArcadeSizes}" SelectedItem="{Binding ArcadeSize}" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip.Tip="The picture's size — 3840x1080 for a joined canvas of two projectors" />
        <Button Classes="mini" Content="POP OUT" Margin="0,0,8,0" VerticalAlignment="Center" Command="{Binding ArcadeWindowCommand}" CommandParameter="on"
                ToolTip.Tip="The game in a window of its own — F11 fills the display, Esc brings it back, then closes it; the keys are the pads there too" />
        <Button Classes="mini" Content="FULLSCREEN" Margin="0,0,12,0" VerticalAlignment="Center" Command="{Binding ArcadeWindowCommand}" CommandParameter="full"
                ToolTip.Tip="The game filling this display — drag the window to another first, or ARCADE WINDOW FULL 2 on the wire names a display" />
        <TextBlock Classes="label" Text="{Binding ArcadeStatus}" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBlock Classes="hint" TextWrapping="Wrap"
                 Text="On the show without NDI: pick Arcade as a pattern's media, a layer's picture, the PiP's source or a wall tile — this machine's game straight from the loop's own buffers, a press on the screen the next frame; a look or a cue takes it like any picture. NDI stays for a game on another machine." />

      <TextBlock Classes="h2" Text="AUDIENCE" />
      <TextBlock Classes="hint" TextWrapping="Wrap"
                 Text="The room on this machine's remote port: phones join at /play with the code (PLAY SHOW join puts the code and its QR on the wall), the host's page is /host behind the admin passcode, and every PLAY verb works from here, a cue, a Stream Deck or the desk." />
      <WrapPanel>
        <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding PlayCode}" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Classes="label" Text="{Binding PlayJoinUrl}" Margin="0,0,10,0" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBlock Classes="label" Text="{Binding PlayWords}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding PlayQuestionLine}" Watermark="quiz Which hall is the keynote in? | Hall A | Hall B | Hall C | correct=2 time=15" />
        <Button Grid.Column="1" Classes="mini" Content="ADD" Margin="8,0,0,0" Command="{Binding PlayAddCommand}" ToolTip.Tip="choice · multi · scale (scale=1-10) · words · quiz (correct=N time=S)" />
      </Grid>
      <WrapPanel>
        <Button Classes="mini" Content="OPEN NEXT" Margin="0,0,8,6" Command="{Binding PlayVerbCommand}" CommandParameter="PLAY NEXT" />
        <Button Classes="mini" Content="CLOSE" Margin="0,0,8,6" Command="{Binding PlayVerbCommand}" CommandParameter="PLAY CLOSE" />
        <Button Classes="mini" Content="REVEAL" Margin="0,0,16,6" Command="{Binding PlayVerbCommand}" CommandParameter="PLAY REVEAL" />
        <Button Classes="chip" Content="WALL: JOIN" Margin="0,0,8,6" Command="{Binding PlayVerbCommand}" CommandParameter="PLAY SHOW join" />
        <Button Classes="chip" Content="RESULTS" Margin="0,0,8,6" Command="{Binding PlayVerbCommand}" CommandParameter="PLAY SHOW results" />
        <Button Classes="chip" Content="LEADERBOARD" Margin="0,0,8,6" Command="{Binding PlayVerbCommand}" CommandParameter="PLAY SHOW leaderboard" />
        <Button Classes="chip" Content="PATH" Margin="0,0,8,6" Command="{Binding PlayVerbCommand}" CommandParameter="PLAY SHOW path" />
        <Button Classes="chip" Content="DRAUGHTS" Margin="0,0,8,6" Command="{Binding PlayVerbCommand}" CommandParameter="PLAY SHOW draughts" />
        <Button Classes="chip" Content="WALL OFF" Margin="0,0,8,6" Command="{Binding PlayVerbCommand}" CommandParameter="PLAY HIDE" ToolTip.Tip="The arcade's picture again" />
      </WrapPanel>
      <ItemsControl ItemsSource="{Binding PlayQueue}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="play:ModerationItem">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Classes="label" TextWrapping="Wrap" VerticalAlignment="Center">
                <Run Text="{Binding Nick}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text}" /><Run Text="  " /><Run Text="{Binding Note}" Foreground="#9AA4B5" />
              </TextBlock>
              <Button Grid.Column="1" Classes="mini" Content="APPROVE" Margin="8,0,0,0" Command="{Binding $parent[UserControl].((vm:IArcadePage)DataContext).PlayApproveCommand}" CommandParameter="{Binding}" />
              <Button Grid.Column="2" Classes="mini" Content="REJECT" Margin="8,0,0,0" Command="{Binding $parent[UserControl].((vm:IArcadePage)DataContext).PlayRejectCommand}" CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="h2" Text="BEST" />
      <TextBlock Classes="label" Text="{Binding ArcadeBoard}" TextWrapping="Wrap" />
      <TextBlock Classes="hint tip"
                 Text="Keys: P1 arrows, Space, Enter is START · P2 W A S D, Left Shift, Q · P3 I J K L, U, H · P4 numpad 8 4 5 6, 0, + · 1 2 3 pick a game · XInput pads on Windows · phones at /pad on this machine's remote port · ARCADE NAME ABC on the wire signs the last score." />
    </StackPanel>
    <ctl:ArcadeSurface Margin="0,8,0,0" />
  </DockPanel>
</UserControl>
