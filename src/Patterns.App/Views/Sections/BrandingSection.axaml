<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:c="using:Patterns.App.Views.Controls"
             x:Class="Patterns.App.Views.Sections.BrandingSection"
             Classes="hue-branding"
             x:DataType="vm:MainViewModel">

  <StackPanel Classes="form" Margin="4,8,12,16">
    <TextBlock Classes="h1 neon-time" Text="Branding" />

    <TextBlock Classes="h2" Text="COMPANY" />
    <TextBox Watermark="Company / event name" Text="{Binding State.Brand.CompanyName}" />

    <TextBlock Classes="h2" Text="COLOURS" />
    <Grid ColumnDefinitions="130,*">
      <TextBlock Classes="label" Text="Primary" />
      <c:ColorField Grid.Column="1" Value="{Binding State.Brand.PrimaryColor, Mode=TwoWay}" />
    </Grid>
    <Grid ColumnDefinitions="130,*">
      <TextBlock Classes="label" Text="Secondary" />
      <c:ColorField Grid.Column="1" Value="{Binding State.Brand.SecondaryColor, Mode=TwoWay}" />
    </Grid>
    <Grid ColumnDefinitions="130,*">
      <TextBlock Classes="label" Text="Accent" />
      <c:ColorField Grid.Column="1" Value="{Binding State.Brand.AccentColor, Mode=TwoWay}" />
    </Grid>
    <Grid ColumnDefinitions="130,*">
      <TextBlock Classes="label" Text="Background" />
      <c:ColorField Grid.Column="1" Value="{Binding State.Brand.BackgroundColor, Mode=TwoWay}" />
    </Grid>
    <Grid ColumnDefinitions="130,*">
      <TextBlock Classes="label" Text="Text" />
      <c:ColorField Grid.Column="1" Value="{Binding State.Brand.TextColor, Mode=TwoWay}" />
    </Grid>
    <CheckBox Content="Apply brand colours to patterns"
              IsChecked="{Binding State.Brand.ApplyToPatterns}" />
    <TextBlock Classes="hint tip"
               Text="Accents, checkerboards, colour cycles, particles and overlay text pick up the brand kit. Measurement lines stay neutral so patterns remain accurate." />

    <TextBlock Classes="h2" Text="TYPE" />
    <ComboBox ItemsSource="{Binding FontFamilies}"
              SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}" />
    <TextBlock Classes="hint tip"
               Text="Font for clock, countdown, messages and pattern chips — any font installed on this machine. The built-in Inter always works and travels with the app." />

    <TextBlock Classes="h2" Text="LOGO" />
    <Grid ColumnDefinitions="*,8,Auto">
      <TextBox Grid.Column="0" Watermark="Logo file (PNG with alpha recommended)" Text="{Binding State.Brand.LogoPath}" />
      <Button Grid.Column="2" Classes="chip" Content="Browse…" Command="{Binding BrowseLogoCommand}" />
    </Grid>
    <TextBlock Classes="hint tip" Text="Use it as a watermark (Overlays page) or as a particle sprite (Logo shape)." />

    <!-- The Patterns badge: the app's own mark over a test pattern — Patterns' branding, not the show's -->
    <TextBlock Classes="h2" Text="PATTERNS BADGE" />
    <CheckBox Name="BadgeOn" Content="Show the Patterns badge on test patterns" IsChecked="{Binding State.Overlays.Badge.Enabled}" />
    <TextBlock Classes="hint tip"
               Text="The app's own mark — the test-card icon, PATTERNS and a line under it, in its neon colours — drawn by the engine on every output, NDI send and the stream over a test pattern, so a test card names its maker at an expo or on a rig day. It travels with looks like every overlay and drags on the PREVIEW pane; OVERLAYS OFF takes it with the rest. Off for a client's media unless you ask." />
    <StackPanel IsEnabled="{Binding State.Overlays.Badge.Enabled}">
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Position" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Anchors}"
                  SelectedValue="{Binding BadgePlace.Anchor, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
      </Grid>
      <Grid ColumnDefinitions="130,*,8,*">
        <TextBlock Classes="label" Text="Nudge X / Y (%)" ToolTip.Tip="From the anchor, as a share of the canvas — or drag the badge on the PREVIEW pane. The default lifts it off the bottom into the middle of the lower third" />
        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding State.Overlays.Badge.OffsetXPct, Mode=TwoWay}" />
        <Slider Grid.Column="3" Minimum="-100" Maximum="100" Value="{Binding State.Overlays.Badge.OffsetYPct, Mode=TwoWay}" />
      </Grid>
      <c:PlaceRow Place="{Binding BadgePlace}" />
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Height (%)" />
        <Slider Grid.Column="1" Minimum="3" Maximum="40" Value="{Binding State.Overlays.Badge.HeightPct, Mode=TwoWay}" />
      </Grid>
      <Grid ColumnDefinitions="130,*">
        <TextBlock Classes="label" Text="Opacity" />
        <Slider Grid.Column="1" Minimum="0.05" Maximum="1" Value="{Binding State.Overlays.Badge.Opacity, Mode=TwoWay}" />
      </Grid>
      <CheckBox Content="On media too (video, images, decks, web pages)" IsChecked="{Binding State.Overlays.Badge.OnMediaToo}"
                ToolTip.Tip="The badge goes on every picture Patterns draws itself — the grids and ramps, the particles, the fractals, the reactive scenes. It stays off what is not the app's to sign: someone else's media, unless you tick this, and the multiview, which is a monitoring picture" />
      <CheckBox Content="With the line under the name" IsChecked="{Binding State.Overlays.Badge.ShowLine}" />
      <TextBox Watermark="The line under PATTERNS" Text="{Binding State.Overlays.Badge.Line}" IsEnabled="{Binding State.Overlays.Badge.ShowLine}" />
    </StackPanel>

    <TextBlock Classes="h2" Text="BRAND KITS" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="chip" Content="Save kit" Command="{Binding SaveBrandKitCommand}" />
      <Button Classes="chip" Content="Load kit…" Command="{Binding LoadBrandKitCommand}" />
    </StackPanel>
    <TextBlock Classes="hint tip" Text="Kits are JSON files in the portable 'brandkits' folder — keep one per client." />
  </StackPanel>
</UserControl>
