<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Patterns.App.ViewModels"
             xmlns:c="using:Patterns.App.Views.Controls"
             xmlns:m="using:Patterns.Core.Model"
             x:Class="Patterns.App.Views.Panels.ScreenSettingsPanel"
             x:DataType="vm:MainViewModel">
  <!-- The selected item's settings, shown in the pop-out column beside the page (PopOutHost) rather than under the list. -->
  <StackPanel Classes="form" Margin="12,8,14,16">
    <Border Background="{StaticResource PanelBg2Brush}" CornerRadius="8" Padding="10" IsVisible="{Binding Screens.HasSelection}">
      <StackPanel>
        <TextBlock Text="{Binding Screens.SelectedScreenTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="86,*" Margin="0,6,0,0">
          <TextBlock Classes="label" Text="Label" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Watermark="e.g. Stage left LED (shown everywhere)"
                   Text="{Binding Screens.SelectedScreenLabel, Mode=TwoWay}" />
        </Grid>
        <Grid ColumnDefinitions="86,*" Margin="0,4,0,0" IsVisible="{Binding Screens.SelectedIsInCanvas}">
          <TextBlock Classes="label" Text="Canvas name" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Watermark="e.g. Main wall (names the joined canvas)"
                   Text="{Binding Screens.SelectedCanvasName, Mode=TwoWay}" />
        </Grid>

        <CheckBox Margin="0,6,0,0" Content="Output enabled"
                  IsChecked="{Binding Screens.SelectedEnabled, Mode=TwoWay}" />
        <CheckBox Content="Custom pattern for this screen"
                  IsChecked="{Binding Screens.SelectedUseCustom, Mode=TwoWay}"
                  IsEnabled="{Binding !Screens.SelectedIsGrouped}" />
        <Panel IsVisible="{Binding Screens.SelectedIsGrouped}">
          <TextBlock Classes="hint tip"
                     Text="This screen is part of a joined canvas — the canvas shows the program pattern. Drag it away to give it its own pattern." />
        </Panel>

        <!-- What the screen is for: the role, whether it follows cues, what it repeats -->
        <Grid ColumnDefinitions="86,*" Margin="0,8,0,0">
          <TextBlock Classes="label" Text="Role" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Screens.ScreenRoleItems}"
                    SelectedValue="{Binding Screens.SelectedRole, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}"
                    ToolTip.Tip="The group this screen is in, by what it is for: Main follows the show; Confidence and Info screens are locked as you pick them; a Repeater copies another target (choose it under Mirror of). NDI sends and the stream are feed screens, a group of their own, listed above. Every wall tile reads the group on its foot line" />
        </Grid>
        <CheckBox Content="Follows looks, cues and TAKE" IsChecked="{Binding Screens.SelectedFollowsCues, Mode=TwoWay}"
                  ToolTip.Tip="Off = locked: this screen keeps its picture through every look, cue, clicker step, TAKE ALL and stinger — a confidence monitor or an info screen. SEND to its tile, or OWN and edit, when it should change. The tile's LOCK is the same switch" />
        <Grid ColumnDefinitions="86,*" Margin="0,4,0,0">
          <TextBlock Classes="label" Text="Mirror of" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Screens.MirrorSources}"
                    SelectedValue="{Binding Screens.SelectedMirrorOf, Mode=TwoWay}"
                    SelectedValueBinding="{Binding ScreenId, x:DataType=vm:EditTarget}"
                    ToolTip.Tip="A repeater draws this target's picture wherever that picture goes — a duplicate of a main screen or a joined canvas" />
        </Grid>
        <TextBlock Classes="hint tip"
                   Text="Role is the screen's group — what it is for — and picks whether it follows cues: CONF and INFO screens are locked as you choose them, so a cue progression changes the main screens and leaves them alone (SEND on the tile, a cue's Screen unlock, or the remote's LOCK n OFF changes that). Mirror of makes the screen a repeater of another screen or canvas. The wall shows the badge and LOCK on every tile, and every tile's foot line reads the group — a click there brings you here." />
        <CheckBox Margin="0,4,0,0" Content="Direct output — bypass the desktop compositor"
                  IsChecked="{Binding Screens.SelectedDirectOutput, Mode=TwoWay}" IsVisible="{Binding Screens.SelectedIsDisplay}"
                  ToolTip.Tip="Windows hands this window straight to its display through the flip path — no composition frame, no compositor jitter. The swap chain behind it is chosen when Patterns starts." />
        <TextBlock Classes="hint" Text="{Binding Screens.DirectOutputStatus}" TextWrapping="Wrap" IsVisible="{Binding Screens.SelectedIsDisplay}" />
        <Panel IsVisible="{Binding Screens.SelectedIsDisplay}">
          <TextBlock Classes="hint tip"
                     Text="With it, a hardware card renders and Windows flips this window straight to its display while it covers the display alone — the compositor's frame of latency and its jitter go. The swap chain behind it is process-wide and chosen at start: tick, save, restart Patterns. A start that fails to reach the desk with it is held off next time and the line above says so; untick and tick to try again." />
        </Panel>

        <TextBlock Classes="label" Text="Orientation" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding Rotations}"
                  SelectedValue="{Binding Screens.SelectedRotation, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
        <TextBlock Classes="hint tip"
                   Text="For displays mounted in portrait or upside down: content is rendered upright and rotated at output. The overview above shows the rotated shape." />

        <TextBlock Classes="label" Text="Frame rate" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding Screens.ScreenFpsOptions}"
                  SelectedValue="{Binding Screens.SelectedFpsOverride, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Value, x:DataType=vm:FpsOption}" />

        <TextBlock Classes="label" Text="Display mode (Windows)" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="*,8,Auto,8,Auto,8,Auto">
          <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Screens.DisplayModeOptions}"
                    SelectedItem="{Binding Screens.SelectedDisplayModeLabel, Mode=TwoWay}" PlaceholderText="Modes this display offers…" />
          <Button Grid.Column="2" Classes="chip" Content="Apply" Command="{Binding Screens.ApplyDisplayModeCommand}"
                  ToolTip.Tip="Switch the display to this size and refresh rate — the same change as Windows' Display settings" />
          <Button Grid.Column="4" Classes="chip" Content="KEEP" Command="{Binding Screens.KeepDisplayModeCommand}" IsVisible="{Binding Screens.DisplayModePending}" />
          <Button Grid.Column="6" Classes="chip" Content="REVERT" Command="{Binding Screens.RevertDisplayModeCommand}" IsVisible="{Binding Screens.DisplayModePending}" />
        </Grid>
        <TextBlock Classes="hint" Text="{Binding Screens.DisplayModeStatus}" TextWrapping="Wrap" />
        <TextBlock Classes="hint tip"
                   Text="Lists the modes the display's own EDID offers and applies one through Windows, so a 1080p50 wall or a 4K projector gets the signal it expects. A change waits for KEEP and reverts by itself in 15 s if the picture is lost; everything programmed for the screen — placement, pattern, canvases, senders, looks — follows it across the change. Close the outputs first." />

        <TextBlock Classes="label" Text="Output trims" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="86,*,44" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="label" Text="Brightness" VerticalAlignment="Center" />
          <Slider Grid.Row="0" Grid.Column="1" Minimum="10" Maximum="150" TickFrequency="5"
                  Value="{Binding Screens.SelectedBrightness, Mode=TwoWay}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding Screens.SelectedBrightness, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="1" Classes="label" Text="Gamma" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="0.4" Maximum="2.5" TickFrequency="0.05"
                  Value="{Binding Screens.SelectedGamma, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding Screens.SelectedGamma, StringFormat={}{0:0.00}}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Red" VerticalAlignment="Center" />
          <Slider Grid.Row="2" Grid.Column="1" Minimum="25" Maximum="175" TickFrequency="5"
                  Value="{Binding Screens.SelectedTrimR, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding Screens.SelectedTrimR, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Green" VerticalAlignment="Center" />
          <Slider Grid.Row="3" Grid.Column="1" Minimum="25" Maximum="175" TickFrequency="5"
                  Value="{Binding Screens.SelectedTrimG, Mode=TwoWay}" />
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding Screens.SelectedTrimG, StringFormat={}{0:0}%}" />
          <TextBlock Grid.Row="4" Classes="label" Text="Blue" VerticalAlignment="Center" />
          <Slider Grid.Row="4" Grid.Column="1" Minimum="25" Maximum="175" TickFrequency="5"
                  Value="{Binding Screens.SelectedTrimB, Mode=TwoWay}" />
          <TextBlock Grid.Row="4" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding Screens.SelectedTrimB, StringFormat={}{0:0}%}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Content="Reset trims" Command="{Binding Screens.ResetTrimsCommand}" />
        </StackPanel>
        <TextBlock Classes="hint tip"
                   Text="Per-screen brightness / gamma / RGB balance for matching mismatched house displays. Applies to this output only — NDI and other screens are untouched." />

        <TextBlock Classes="label" Text="Corner warp (keystone) — px offsets" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="76,*,6,*,12,76,*,6,*" RowDefinitions="Auto,4,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Top-left" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpTlx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpTly, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
          <TextBlock Grid.Row="0" Grid.Column="5" Classes="label" Text="Top-right" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="6" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpTrx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="0" Grid.Column="8" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpTry, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Bottom-left" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpBlx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpBly, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
          <TextBlock Grid.Row="2" Grid.Column="5" Classes="label" Text="Bottom-right" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="6" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpBrx, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="X" />
          <NumericUpDown Grid.Row="2" Grid.Column="8" Minimum="-4096" Maximum="4096" Increment="4" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpBry, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Y" />
        </Grid>
        <TextBlock Classes="label" Text="Edge bends — px outward at the middle of each edge" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="76,*,12,76,*" RowDefinitions="Auto,4,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Top" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="-4096" Maximum="4096" Increment="2" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpTopBow, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}"
                         ToolTip.Tip="Positive bows the top edge up, negative pulls it down — a curved screen's sweep, a lens's pincushion or barrel" />
          <TextBlock Grid.Row="0" Grid.Column="3" Classes="label" Text="Bottom" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="4" Minimum="-4096" Maximum="4096" Increment="2" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpBottomBow, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Positive bows the bottom edge down" />
          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Left" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="-4096" Maximum="4096" Increment="2" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpLeftBow, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Positive bows the left edge out" />
          <TextBlock Grid.Row="2" Grid.Column="3" Classes="label" Text="Right" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="4" Minimum="-4096" Maximum="4096" Increment="2" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedPlacement.WarpRightBow, Mode=TwoWay, Converter={StaticResource Num}, FallbackValue=0}" ToolTip.Tip="Positive bows the right edge out" />
        </Grid>
        <TextBlock Classes="label" Text="Mesh — a lattice of points pulled into place" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="76,86,8,Auto,*,Auto">
          <TextBlock Classes="label" Text="Lattice" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Screens.MeshDensityOptions}" SelectedItem="{Binding Screens.SelectedMeshDensity, Mode=TwoWay}"
                    ToolTip.Tip="How many points across and down — 3 for a gentle curve, 9 or 17 for a dome or a set piece; the mesh keeps its shape when the density changes" />
          <ToggleButton Grid.Column="3" Classes="mini" Content="SHOW ON THE PROJECTOR" IsChecked="{Binding Screens.ShowLatticeOnOutput, Mode=TwoWay}"
                        ToolTip.Tip="The lattice drawn over the picture on this output, the picked point ringed — for the walk-up" />
          <Button Grid.Column="5" Classes="chip" Content="Reset mesh" Command="{Binding Screens.ResetMeshCommand}" ToolTip.Tip="Every point back to rest" />
        </Grid>
        <c:WarpMeshControl Height="230" />
        <TextBlock Classes="hint" Text="{Binding Screens.MeshDescription}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Content="Reset warp" Command="{Binding Screens.ResetWarpCommand}" ToolTip.Tip="The corners, the bends and the mesh back to rest" />
        </StackPanel>
        <TextBlock Classes="hint tip"
                   Text="The mesh: click a point in the lattice above and drag it; the projector follows when you let go. Arrows nudge the picked point a pixel, Shift for ten, Escape drops the pick. Show on the projector puts the lattice over the picture on that output with the picked point ringed, so you can see which point you are pulling from the room. A gentle curve wants 3 or 5 points; a dome or a set piece 9 or 17. Corners pull the picture into a keystone — a perspective, so straight lines stay straight inside. Bends bow each edge at its middle on top of that: a curved screen, a cyclorama, a lens's pincushion or barrel. Together they cover what a walk-up alignment needs; the finished picture, its blend zones and its black pedestal all go through the same bend, so a bowed projector's fade follows its bow. Put the Projection blend pattern up (Content ▸ Projection blend) and line the grid up with the neighbour's." />

        <TextBlock Classes="label" Text="Edge blend (projectors)" Margin="0,8,0,0" />
        <CheckBox Content="Automatic — fade the edges this screen overlaps with a neighbour"
                  IsChecked="{Binding Screens.SelectedBlendAuto, Mode=TwoWay}" />
        <TextBlock Classes="hint" Text="{Binding Screens.BlendReadback}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="76,*,12,76,*" RowDefinitions="Auto,4,Auto" IsEnabled="{Binding !Screens.SelectedBlendAuto}">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Left px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="4096" Increment="8" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedBlendLeft, Mode=TwoWay, Converter={StaticResource Num}}" />
          <TextBlock Grid.Row="0" Grid.Column="3" Classes="label" Text="Right px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="0" Grid.Column="4" Minimum="0" Maximum="4096" Increment="8" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedBlendRight, Mode=TwoWay, Converter={StaticResource Num}}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Top px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="4096" Increment="8" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedBlendTop, Mode=TwoWay, Converter={StaticResource Num}}" />
          <TextBlock Grid.Row="2" Grid.Column="3" Classes="label" Text="Bottom px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="4" Minimum="0" Maximum="4096" Increment="8" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedBlendBottom, Mode=TwoWay, Converter={StaticResource Num}}" />
        </Grid>
        <Grid ColumnDefinitions="86,*,44" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
          <TextBlock Grid.Row="0" Classes="label" Text="Curve" VerticalAlignment="Center" />
          <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding BlendCurves}"
                    SelectedValue="{Binding Screens.SelectedBlendCurve, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
          <TextBlock Grid.Row="1" Classes="label" Text="Blend gamma" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="3" TickFrequency="0.05"
                  Value="{Binding Screens.SelectedBlendGamma, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding Screens.SelectedBlendGamma, StringFormat={}{0:0.00}}" />
        </Grid>
        <Grid ColumnDefinitions="76,*,60" Margin="0,4,0,0">
          <TextBlock Classes="label" Text="Black level" VerticalAlignment="Center"
                     ToolTip.Tip="Black-level matching: the pedestal added outside the zones, as a percentage of white. Put a black picture up: the overlaps show as brighter bands and a grid's middle as a brighter square; slide until they go" />
          <Slider Grid.Column="1" Minimum="0" Maximum="25" TickFrequency="0.5" IsSnapToTickEnabled="True"
                  Value="{Binding Screens.SelectedBlendBlack, Mode=TwoWay}" />
          <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Text="{Binding Screens.SelectedBlendBlack, StringFormat={}{0:0.#}%}" />
        </Grid>
        <Grid ColumnDefinitions="76,50,Auto,50,8,Auto,70,8,Auto" Margin="0,4,0,0">
          <TextBlock Classes="label" Text="Blend grid" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Minimum="1" Maximum="8" Increment="1" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.BlendGridColumns, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="Columns" />
          <TextBlock Grid.Column="2" Classes="label" Text=" × " VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="3" Minimum="1" Maximum="8" Increment="1" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.BlendGridRows, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="Rows" />
          <TextBlock Grid.Column="5" Classes="label" Text="overlap" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="6" Minimum="0" Maximum="4096" Increment="8" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.BlendGridOverlap, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="The zone every join gets, in pixels — a tenth of a projector's width is the usual start" />
          <Button Grid.Column="8" Classes="chip" Content="Arrange as a blend grid" Command="{Binding Screens.ArrangeBlendGridCommand}"
                  ToolTip.Tip="Every screen that is on, laid out columns × rows in arrangement order, each overlapping its neighbours by the zone, all on automatic blend — the zones follow the overlaps and every join comes out equal. Planned screens take part, so the grid is built before the projectors are" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="chip" Content="Reset blend" Command="{Binding Screens.ResetBlendCommand}" />
        </StackPanel>
        <TextBlock Classes="hint tip"
                   Text="Projectors that overlap on the wall — two, a row of three or four, a stack, a 2×2 grid: tick Automatic on every one, drag each over its neighbour by the overlap, and the overlaps become one joined canvas they all draw, each fading every shared edge to black so the light adds up to one picture; a middle projector fades both sides, a grid's projector a side and a top or bottom, and where two zones meet in a corner the fades multiply, which is what four projectors sharing a corner need. The lines above audit each join of the selected screen — the neighbour must fade the facing edge by the same width with the same curve — so a rig is checked join by join before doors. Put the Projection blend pattern's grey check on the canvas and turn the gamma until the overlaps read as flat as the rest. Only this output fades; NDI, monitors and the preview never do." />

        <TextBlock Classes="label" Text="Wall gaps — bezels, the air between LED pillars" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="86,*,12,86,*" IsVisible="{Binding Screens.SelectedIsInCanvas}" Margin="0,2,0,4">
          <TextBlock Grid.Column="0" Classes="label" Text="Bezel H px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="4096" Increment="2" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedSeamGapX, Mode=TwoWay, Converter={StaticResource Num}}"
                         ToolTip.Tip="Bezel compensation for this joined canvas: the dead width between two of its displays side by side — both bezels and any air — in pixels" />
          <TextBlock Grid.Column="3" Classes="label" Text="Bezel V px" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="4" Minimum="0" Maximum="4096" Increment="2" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.SelectedSeamGapY, Mode=TwoWay, Converter={StaticResource Num}}"
                         ToolTip.Tip="The dead height between two displays of this canvas one above the other, in pixels" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Screens.SelectedGaps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:WallGap">
              <Grid ColumnDefinitions="*,6,Auto,6,Auto,6,Auto" Margin="0,2">
                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Screens.GapAxes}"
                          SelectedValue="{Binding Axis, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value, x:DataType=vm:EnumItem}" />
                <NumericUpDown Grid.Column="2" Width="96" Minimum="1" Maximum="16384" Increment="8" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding At, Mode=TwoWay, Converter={StaticResource Num}}"
                               ToolTip.Tip="The first raster pixel after the gap: a vertical gap's x, a horizontal gap's y" />
                <NumericUpDown Grid.Column="4" Width="96" Minimum="1" Maximum="16384" Increment="8" FormatString="0" ShowButtonSpinner="False"
                               Value="{Binding Size, Mode=TwoWay, Converter={StaticResource Num}}"
                               ToolTip.Tip="How wide the gap is, in the wall's own pixels (the physical gap measured in pixel pitches)" />
                <Button Grid.Column="6" Classes="mini" Content="✕" ToolTip.Tip="Remove this gap"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Screens.RemoveGapCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
          <Button Classes="chip" Content="+ Gap" Command="{Binding Screens.AddGapCommand}" ToolTip.Tip="A vertical gap in the middle of the raster, to move and size" />
          <TextBlock Classes="label" Text="Grid" VerticalAlignment="Center" Margin="6,0,0,0" />
          <NumericUpDown Width="72" Minimum="1" Maximum="64" Increment="1" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.GapGridColumns, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="Columns of panels packed in this raster" />
          <TextBlock Classes="label" Text="×" VerticalAlignment="Center" />
          <NumericUpDown Width="72" Minimum="1" Maximum="64" Increment="1" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.GapGridRows, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="Rows of panels packed in this raster" />
          <NumericUpDown Width="84" Minimum="1" Maximum="4096" Increment="2" FormatString="0" ShowButtonSpinner="False"
                         Value="{Binding Screens.GapGridPx, Mode=TwoWay, Converter={StaticResource Num}}" ToolTip.Tip="The gap between them, in the wall's pixels" />
          <Button Classes="chip" Content="Set from grid" Command="{Binding Screens.SetGapsFromGridCommand}"
                  ToolTip.Tip="Replace the list with the seams of an even grid of panels packed in this screen's raster" />
          <Button Classes="chip" Content="Clear" Command="{Binding Screens.ClearGapsCommand}" ToolTip.Tip="No gaps: the picture is the raster again" />
        </StackPanel>
        <TextBlock Classes="hint" Text="{Binding Screens.GapSummary}" TextWrapping="Wrap" />
        <TextBlock Classes="hint tip"
                   Text="Where the wall has no pixels. For a wall of displays joined into one canvas, Bezel H / V is the dead width between neighbours (both bezels plus any air, in pixels): content is laid out as if the strips were there and each display shows its own real pixels, so a line across the wall is straight in the room. For one output whose raster packs panels that stand apart — three LED pillars side by side in a 1152-wide raster, a wall controller's four displays in one 4K — add a gap where each strip stands (before which raster pixel, and how wide, in the wall's own pixel pitch), or Set from grid for an even wall. Every pattern, video, web page, layer, overlay and lower third spans the gaps; the LED wall and video wall patterns put their tiles on the real panels when their raster matches this screen's, and draw the gaps black with GAP n px in them; the PREVIEW and PROGRAM panes, the multiview tiles and the phone's thumbnail shade the strips so you see where they are; NDI senders of this target carry the whole surface for a processor that maps the gaps itself. Processors that map the gaps in the raster themselves need no gaps here — describe the wall in the LED wall pattern's Irregular map instead." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
