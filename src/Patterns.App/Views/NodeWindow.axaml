<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Patterns.App.ViewModels"
        xmlns:sec="using:Patterns.App.Views.Sections"
        xmlns:ctl="using:Patterns.App.Views.Controls"
        xmlns:pn="using:Patterns.App.Views.Panels"
        x:Class="Patterns.App.Views.NodeWindow"
        x:DataType="vm:NodeViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="820" MinWidth="720" MinHeight="480"
        Background="{StaticResource AppBgBrush}">
  <!-- A node's window: the pages its kind shows and a status line, over a NodeHost — the desk's pages, bound to
       the same interfaces the desk binds them to, with nothing of the desk behind them. A caller: Run, Cues,
       Stage, Nodes, Machine. A stage timer: Stage (the display first), Nodes, Machine. The arcade: Arcade,
       Nodes, Machine — the Machine tab is the node's own: its key, its ports, the watchdog, an update, a restart. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBgBrush}" Padding="12,6">
      <TextBlock Classes="label" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </Border>
    <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Padding="0">
      <TabItem Header="Run" IsVisible="{Binding HasRun}">
        <Border Padding="12">
          <ctl:RunView />
        </Border>
      </TabItem>
      <TabItem Header="Cues" IsVisible="{Binding HasCues}">
        <Grid ColumnDefinitions="*,Auto">
          <ScrollViewer>
            <sec:CuesSection />
          </ScrollViewer>
          <ScrollViewer Grid.Column="1" Width="440" IsVisible="{Binding Cues.HasSelection}" Background="{StaticResource PanelBgBrush}">
            <pn:CueSettingsPanel />
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Stage" IsVisible="{Binding HasStage}">
        <Grid RowDefinitions="*,Auto">
          <ctl:StageDisplay />
          <Expander Grid.Row="1" Header="THE TIMER'S CONTROLS AND MESSAGES" IsExpanded="{Binding StageControlsOpen, Mode=TwoWay}">
            <ScrollViewer MaxHeight="380">
              <sec:StageSection Margin="4,0,12,12" />
            </ScrollViewer>
          </Expander>
        </Grid>
      </TabItem>
      <!-- The arcade's section is built in code, and only on an arcade node (round 65): a section on
           a timer would bind the arcade's words and load its assembly into a process that has none. -->
      <TabItem Name="ArcadeTab" Header="Arcade" IsVisible="{Binding HasArcade}" />
      <TabItem Header="Nodes">
        <ScrollViewer>
          <sec:NodesSection />
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Machine">
        <ScrollViewer>
          <sec:NodeMachineSection />
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
