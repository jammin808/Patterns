<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Patterns.App.ViewModels"
        xmlns:sec="using:Patterns.App.Views.Sections"
        x:Class="Patterns.App.Views.NodeWindow"
        x:DataType="vm:NodeViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="820" MinWidth="720" MinHeight="480"
        Background="{StaticResource AppBgBrush}">
  <!-- A node's window: two pages and a status line, over a NodeHost — the desk's pages, bound to the
       same interfaces the desk binds them to, with nothing of the desk behind them. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBgBrush}" Padding="12,6">
      <TextBlock Classes="label" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </Border>
    <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Padding="0">
      <TabItem Header="Arcade">
        <sec:ArcadeSection />
      </TabItem>
      <TabItem Header="Nodes">
        <ScrollViewer>
          <sec:NodesSection />
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
