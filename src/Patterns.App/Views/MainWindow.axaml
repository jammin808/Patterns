<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Patterns.App.ViewModels"
        xmlns:v="using:Patterns.App.Views.Sections"
        xmlns:r="using:Patterns.App.Rendering"
        x:Class="Patterns.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Patterns — show test pattern suite"
        Icon="/Assets/patterns-256.png"
        Width="1420" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">

  <!-- Plain F1–F12 are look hotkeys (handled in code-behind); transport sits on Shift+F5–F8. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Shift+F5" Command="{Binding GoCommand}" />
    <KeyBinding Gesture="Shift+F6" Command="{Binding StopCommand}" />
    <KeyBinding Gesture="Shift+F7" Command="{Binding IdentifyCommand}" />
    <KeyBinding Gesture="Shift+F8" Command="{Binding BlackoutCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*">

    <!-- Header / transport -->
    <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="◧" FontSize="22" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="PATTERNS" FontSize="16" FontWeight="Bold" LetterSpacing="2" />
            <TextBlock Text="{Binding OutputsStatus}" Classes="hint" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding HeaderClock}" FontSize="18" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,10,0" />
          <Button Classes="go" Content="GO  (⇧F5)" Command="{Binding GoCommand}"
                  ToolTip.Tip="Open pattern outputs on the selected screens (Shift+F5)" />
          <Button Classes="stop" Content="STOP (⇧F6)" Command="{Binding StopCommand}"
                  ToolTip.Tip="Close all output windows (Shift+F6)" />
          <Button Classes="stop" Content="IDENTIFY (⇧F7)" Command="{Binding IdentifyCommand}"
                  ToolTip.Tip="Flash screen numbers on every output (Shift+F7)" />
          <ToggleButton Classes="blackout" Content="BLACKOUT (⇧F8)" IsChecked="{Binding State.Blackout}"
                        ToolTip.Tip="Instant black on all outputs and NDI (Shift+F8) — F1–F12 recall looks" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1" ColumnDefinitions="470,*" Margin="12">

      <TabControl Grid.Column="0" TabStripPlacement="Left" Padding="8,0,0,0">
        <TabItem Header="Show">
          <ScrollViewer><v:ShowSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Pattern">
          <ScrollViewer><v:PatternSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Outputs">
          <ScrollViewer><v:OutputsSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Clock">
          <ScrollViewer><v:OverlaysSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Countdown">
          <ScrollViewer><v:CountdownSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Particles">
          <ScrollViewer><v:ParticlesSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Branding">
          <ScrollViewer><v:BrandingSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Media">
          <ScrollViewer><v:MediaSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Looks">
          <ScrollViewer><v:LooksSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Audio">
          <ScrollViewer><v:AudioSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Remote">
          <ScrollViewer><v:WebSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="NDI">
          <ScrollViewer><v:NdiSection /></ScrollViewer>
        </TabItem>
        <TabItem Header="Library">
          <v:LibrarySection />
        </TabItem>
        <TabItem Header="Help">
          <ScrollViewer><v:HelpSection /></ScrollViewer>
        </TabItem>
      </TabControl>

      <!-- Preview column -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="12,0,0,0">

        <!-- Sandbox: build a look here while the outputs hold the program -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,8,*" Margin="0,0,0,8">
          <ToggleButton Grid.Column="0" Content="SANDBOX" FontWeight="SemiBold" Padding="14,7"
                        IsChecked="{Binding IsSandboxActive, Mode=TwoWay}"
                        ToolTip.Tip="Programme a look without it going live: edits show only in this preview while every screen and NDI feed holds the current program. Then send it to all screens, to ticked screens, save it as a look (Looks tab), or switch off to discard. Blackout and GO/STOP stay live; cues hold while open." />
          <Border Grid.Column="2" Background="#1C2E1F" BorderBrush="#2EE68A" BorderThickness="1"
                  CornerRadius="8" Padding="8,4" IsVisible="{Binding IsSandboxActive}">
            <Grid ColumnDefinitions="*,8,Auto,Auto">
              <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="label" Text="To:" VerticalAlignment="Center" />
                  <ItemsControl ItemsSource="{Binding SandboxScreens}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SandboxScreenChoice">
                        <ToggleButton Classes="mini" Content="{Binding Chip}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <Button Grid.Column="2" Classes="mini" Content="SEND SELECTED" Margin="0,0,6,0"
                      Command="{Binding SandboxSendSelectedCommand}"
                      ToolTip.Tip="The sandbox becomes the ticked screens' own pattern; everything else stays as it was" />
              <Button Grid.Column="3" Classes="go" Content="SEND ALL" Padding="12,5"
                      Command="{Binding SandboxSendAllCommand}"
                      ToolTip.Tip="The sandbox becomes the program on every screen (crossfades in)" />
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Row="1" Classes="panel" Padding="6" ClipToBounds="True"
                BorderBrush="#2EE68A"
                BorderThickness="{Binding IsSandboxActive, Converter={StaticResource SandboxBorder}}">
          <r:SkiaCanvasControl x:Name="PreviewCanvas" />
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="2,10,2,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <TextBlock Classes="label" Text="{Binding CanvasInfo}" />
            <TextBlock Classes="label" Text="{Binding NdiStatus, StringFormat='NDI: {0}'}" />
            <TextBlock Classes="label" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusMessage}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="chip" Content="Save show…" Command="{Binding SaveShowCommand}" />
            <Button Classes="chip" Content="Load show…" Command="{Binding LoadShowCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
