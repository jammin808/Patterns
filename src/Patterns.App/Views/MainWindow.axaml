<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Patterns.App.ViewModels"
        xmlns:v="using:Patterns.App.Views.Sections"
        xmlns:r="using:Patterns.App.Rendering"
        xmlns:ctl="using:Patterns.App.Views.Controls"
        x:Class="Patterns.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Patterns — show test pattern suite"
        Icon="/Assets/patterns-256.png"
        Width="1420" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">

  <!-- Plain F1–F12 are look hotkeys (handled in code-behind); transport sits on Shift+F5–F8. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Shift+F5" Command="{Binding GoCommand}" />
    <KeyBinding Gesture="Shift+F6" Command="{Binding StopCommand}" />
    <KeyBinding Gesture="Shift+F7" Command="{Binding IdentifyCommand}" />
    <KeyBinding Gesture="Shift+F8" Command="{Binding BlackoutCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*">

    <!-- Header / transport -->
    <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="◧" FontSize="22" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="PATTERNS" FontSize="16" FontWeight="Bold" LetterSpacing="2" />
            <TextBlock Text="{Binding OutputsStatus}" Classes="hint" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="armedChip" IsVisible="{Binding Run.IsArmed}" VerticalAlignment="Center">
            <TextBlock Text="ARMED" FontWeight="Bold" FontSize="11" />
          </Border>
          <Button Classes="chip" Content="{Binding RunLayoutButtonText}" Command="{Binding ToggleRunLayoutCommand}" Focusable="False"
                  ToolTip.Tip="RUN: the caller's surface — LIVE strip, the wall, the cue stack, GO. EXIT RUN is disabled while armed." />
          <TextBlock Text="{Binding HeaderClock}" FontSize="18" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,10,0" />
          <!-- Transport buttons never take keyboard focus: a focused button fires on Space and
               Enter, and Space is the blackout key. -->
          <Button Classes="go" Content="OUTPUTS ON (⇧F5)" Command="{Binding GoCommand}" Focusable="False"
                  ToolTip.Tip="Open the output windows on the enabled screens (Shift+F5)" />
          <Button Classes="stop" Content="OUTPUTS OFF (⇧F6)" Command="{Binding StopCommand}" Focusable="False"
                  ToolTip.Tip="Close all output windows (Shift+F6)" />
          <Button Classes="stop" Content="IDENTIFY (⇧F7)" Command="{Binding IdentifyCommand}" Focusable="False"
                  ToolTip.Tip="Flash screen numbers on every output (Shift+F7)" />
          <ToggleButton Classes="blackout" Content="BLACKOUT (⇧F8)" IsChecked="{Binding IsBlackout, Mode=TwoWay}" Focusable="False"
                        ToolTip.Tip="Instant black on all outputs and NDI (Shift+F8, or Space) — F1–F12 recall looks" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1" ColumnDefinitions="470,*" Margin="12">

      <!-- Editor column: what-am-I-editing banner + build tabs (neon dots group them) -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*" IsVisible="{Binding !IsRunLayout}">
        <Border Grid.Row="0" Background="#14232E" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="0,0,0,2" CornerRadius="8,8,0,0" Padding="12,6" Margin="0,0,0,6">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Background="#3A2E10" BorderBrush="#FFC24D" BorderThickness="1"
                    CornerRadius="5" Padding="6,1" Margin="0,0,8,0" IsVisible="{Binding IsPrepMode}">
              <TextBlock Text="PREP" FontWeight="Bold" FontSize="11" Foreground="#FFC24D" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding EditTargetBanner}" FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
        <TabControl Grid.Row="1" TabStripPlacement="Left" Padding="8,0,0,0">
        <!-- One column, always: the default strip panel wraps into a second column once the
             rail runs out of height, which squeezes the page beside it to nothing. -->
        <TabControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
        </TabControl.ItemsPanel>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#2EE68A"/><TextBlock Text="Show"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:ShowSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#3EC1F3"/><TextBlock Text="Pattern"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:PatternSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#FF6EC7"/><TextBlock Text="Media"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:MediaSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#6E9BFF"/><TextBlock Text="Looks"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:LooksSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#6E9BFF"/><TextBlock Text="Cues"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:CuesSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#B18CFF"/><TextBlock Text="Outputs"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:OutputsSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#FF9E58"/><TextBlock Text="Audio"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:AudioSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#FFC24D"/><TextBlock Text="Clock"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:OverlaysSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#FFC24D"/><TextBlock Text="Countdown"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:CountdownSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#FFC24D"/><TextBlock Text="Particles"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:ParticlesSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#FFC24D"/><TextBlock Text="Branding"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:BrandingSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#35E0D0"/><TextBlock Text="Remote"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:WebSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#8FA5FF"/><TextBlock Text="NDI"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:NdiSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#FF5C7A"/><TextBlock Text="Stream"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:StreamSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#B8E356"/><TextBlock Text="Admin"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:AdminSection /></ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#C0CBDB"/><TextBlock Text="Library"/></StackPanel></TabItem.Header>
          <v:LibrarySection />
        </TabItem>
        <TabItem>
          <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Classes="dot" Fill="#C0CBDB"/><TextBlock Text="Help"/></StackPanel></TabItem.Header>
          <ScrollViewer><v:HelpSection /></ScrollViewer>
        </TabItem>
        </TabControl>
      </Grid>

      <!-- Switcher column: PROGRAM (air) on top, strip + CUT/TAKE, PREVIEW (work) below -->
      <Grid Grid.Column="1" RowDefinitions="Auto,2*,Auto,Auto,3*,Auto" Margin="12,0,0,0" IsVisible="{Binding !IsRunLayout}">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,8,*,Auto" Margin="2,0,2,4">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Ellipse Classes="dot" Fill="#FF5C7A" />
            <TextBlock Text="PROGRAM" FontWeight="Bold" FontSize="12" LetterSpacing="1.5" Foreground="#FF9EB0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0,0,0">
            <TextBlock Classes="hint" Text="{Binding SelectedTargetLabel}" FontWeight="SemiBold" />
            <TextBlock Classes="hint" Text="{Binding SelectedTargetSizeText}" />
            <TextBlock Classes="hint" Text="· what the audience sees there" />
          </StackPanel>
          <TextBlock Grid.Column="3" Classes="label" Text="{Binding OutputsStatus}" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Classes="panel" Padding="4" ClipToBounds="True"
                BorderBrush="#59FF5C7A" BorderThickness="1">
          <!-- The pane takes the selected target's shape: a true miniature, letterboxed. -->
          <ctl:AspectBox Ratio="{Binding SelectedTargetRatio}">
            <r:SkiaCanvasControl x:Name="PgmCanvas" />
          </ctl:AspectBox>
        </Border>

        <!-- The wall (one tile per content target) with ARM ALL, CUT and TAKE — shared with the Run layout -->
        <ctl:WallView Grid.Row="2" Margin="0,6,0,6" />

        <Grid Grid.Row="3" ColumnDefinitions="Auto,8,Auto,8,*,Auto,Auto" Margin="2,0,2,4">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Ellipse Classes="dot" Fill="#2EE68A" />
            <TextBlock Text="PREVIEW" FontWeight="Bold" FontSize="12" LetterSpacing="1.5" Foreground="#8FE8B8" />
          </StackPanel>
          <ToggleButton Grid.Column="2" Classes="mini" Content="EDIT SAFE (sandbox)"
                        IsChecked="{Binding IsSandboxActive, Mode=TwoWay}"
                        ToolTip.Tip="On: edits build here without going live — outputs and NDI hold the program (blackout stays live, cues hold). Then CUT/TAKE to all screens, SEND to ticked tiles, save as a look, or switch off to discard. Off: edits go straight to air, classic test-pattern style." />
          <TextBlock Grid.Column="4" Classes="hint" VerticalAlignment="Center" Margin="8,0,0,0"
                     Text="{Binding IsSandboxActive, Converter={StaticResource BoolText}, ConverterParameter='sandboxed — edits stay off air until you CUT or TAKE|LIVE — every edit goes straight to the screens'}" />
          <Button Grid.Column="5" Classes="mini" Content="SEND TO TICKED" Margin="0,0,6,0"
                  Command="{Binding SandboxSendSelectedCommand}" IsVisible="{Binding IsSandboxActive}"
                  ToolTip.Tip="The sandbox becomes the ticked tiles' own pattern; everything else stays as it was" />
          <TextBlock Grid.Column="6" Classes="label" Text="{Binding PresenterStepText}" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="4" Classes="panel" Padding="4" ClipToBounds="True"
                BorderBrush="#2EE68A"
                BorderThickness="{Binding IsSandboxActive, Converter={StaticResource SandboxBorder}}">
          <ctl:AspectBox Ratio="{Binding SelectedTargetRatio}">
            <r:SkiaCanvasControl x:Name="PreviewCanvas" />
          </ctl:AspectBox>
        </Border>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="2,8,2,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <TextBlock Classes="label" Text="{Binding CanvasInfo}" />
            <TextBlock Classes="label" Text="{Binding NdiStatus, StringFormat='NDI: {0}'}" />
            <TextBlock Classes="label" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusMessage}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="chip" Content="Save show…" Command="{Binding SaveShowCommand}" />
            <Button Classes="chip" Content="Load show…" Command="{Binding LoadShowCommand}" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- The Run layout: one column for the caller — LIVE strip, the wall beside the list, a transport row -->
      <ctl:RunView Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsRunLayout}" />
    </Grid>
  </Grid>
</Window>
