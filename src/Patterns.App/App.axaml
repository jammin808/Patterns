<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Patterns.App.Converters"
             x:Class="Patterns.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <conv:NumberConverter x:Key="Num" />
    <conv:HexColorConverter x:Key="HexColor" />
    <conv:BoolToTextConverter x:Key="BoolText" />
    <conv:EnumEqualsConverter x:Key="EnumEq" />
    <conv:FileNameConverter x:Key="FileName" />
    <conv:HotkeyLabelConverter x:Key="HotkeyLabel" />
    <conv:PositiveConverter x:Key="Positive" />
    <conv:MediaKindConverter x:Key="MediaKind" />
    <conv:NotEmptyConverter x:Key="NotEmpty" />
    <conv:EnumNotEqualsConverter x:Key="NotEq" />
    <conv:SandboxBorderConverter x:Key="SandboxBorder" />

    <!-- Palette -->
    <Color x:Key="AppBg">#0E0F13</Color>
    <Color x:Key="PanelBg">#15171D</Color>
    <Color x:Key="PanelBg2">#1A1D24</Color>
    <Color x:Key="HairlineColor">#2A2E38</Color>
    <Color x:Key="AccentColor">#3EC1F3</Color>
    <Color x:Key="AccentDim">#1E5A70</Color>
    <Color x:Key="TextDim">#8A93A3</Color>
    <Color x:Key="DangerColor">#E0472E</Color>

    <!-- Tally: four meanings, four colours, used the same way on the wall, the panes and the rows.
         Red is on air and nothing else; blackout is black with a thin red outline and the word. -->
    <Color x:Key="TallyPgm">#E0342E</Color>
    <Color x:Key="TallyPvw">#2EE68A</Color>
    <Color x:Key="TallyHold">#FFC24D</Color>
    <Color x:Key="TallyOff">#4A505E</Color>

    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBg}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBg}" />
    <SolidColorBrush x:Key="PanelBg2Brush" Color="{StaticResource PanelBg2}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TallyPgmBrush" Color="{StaticResource TallyPgm}" />
    <SolidColorBrush x:Key="TallyPvwBrush" Color="{StaticResource TallyPvw}" />
    <SolidColorBrush x:Key="TallyHoldBrush" Color="{StaticResource TallyHold}" />
    <SolidColorBrush x:Key="TallyOffBrush" Color="{StaticResource TallyOff}" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- ColorPicker ships its control theme separately — without this include the pickers have no template at all. -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="/Styles/AppStyles.axaml" />
  </Application.Styles>

</Application>
