<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Patterns</AssemblyName>
    <RootNamespace>Patterns.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/patterns.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\patterns-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.20" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Web pages inside the engine: the WebView2 SDK (Core only — no WinForms/WPF host). Runs on
         the Evergreen runtime Windows 10/11 ship; the loader (WebView2Loader.dll) travels beside
         Patterns.exe — the publish scripts copy it. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <PackageReference Include="PDFtoImage" Version="5.0.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- Restore vehicle for the "full" build (build/publish-win-x64-full.*): the scripts
         restore with BundleVlc=true and copy the libvlc payload from this package into
         the publish folder themselves — its build-time copy items don't survive a
         single-file publish, so nothing here relies on them. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="'$(BundleVlc)' == 'true'" />
  </ItemGroup>

  <PropertyGroup Condition="'$(BundleVlc)' == 'true'">
    <!-- Ship x64 only — no point carrying x86/arm64 libvlc in the portable folder. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Patterns.Core\Patterns.Core.csproj" />
  </ItemGroup>

</Project>
