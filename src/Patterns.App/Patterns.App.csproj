<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(PatternsTfm)</TargetFramework>
    <AssemblyName>Patterns</AssemblyName>
    <RootNamespace>Patterns.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/patterns.ico</ApplicationIcon>
    <!-- Every publish (a runtime identifier set: CI, the scripts) ships the app's, Avalonia's and every
         package's code precompiled by crossgen2, so a page opened for the first time, a renderer's first
         frame or the first cue never pay the JIT on the show's own time; tiered compilation still re-jits
         the hot paths with profile data. The exe grows for it (about 88 MB against roughly 50). -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <!-- The desk speaks English: the packages' other-language resource assemblies stay out of the bundle. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\patterns-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.20" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.11" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Web pages inside the engine: the WebView2 SDK (Core only — no WinForms/WPF host). Runs on
         the Evergreen runtime Windows 10/11 ship; the loader (WebView2Loader.dll) travels beside
         Patterns.exe — the publish scripts copy it. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <PackageReference Include="PDFtoImage" Version="5.0.0" />
    <!-- Restore vehicle for the "full" build (build/publish-win-x64-full.*): the scripts
         restore with BundleVlc=true and copy the libvlc payload from this package into
         the publish folder themselves — its build-time copy items don't survive a
         single-file publish, so nothing here relies on them. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="'$(BundleVlc)' == 'true'" />
  </ItemGroup>

  <PropertyGroup Condition="'$(BundleVlc)' == 'true'">
    <!-- Ship x64 only — no point carrying x86/arm64 libvlc in the portable folder. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!-- Round 79: mini-dumps of a native crash need createdump.exe beside the exe, and the single-file publish folds
       it into the bundle. One target, after every win-x64 self-contained publish — CI, build/publish-win-x64.*,
       build/publish-win-x64-full.* — copies it from the exact runtime pack this publish resolved (ResolvedRuntimePack),
       never "the newest in the cache"; a pack without it is a loud warning, and the scripts and CI check the file. -->
  <Target Name="PlaceCreatedumpBesideTheExe" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64' And '$(SelfContained)' == 'true'">
    <ItemGroup>
      <_PatternsRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <PropertyGroup>
      <_PatternsRuntimePackDir>@(_PatternsRuntimePack->'%(PackageDirectory)')</_PatternsRuntimePackDir>
      <_PatternsCreatedump>$(_PatternsRuntimePackDir)/runtimes/win-x64/native/createdump.exe</_PatternsCreatedump>
    </PropertyGroup>
    <Copy SourceFiles="$(_PatternsCreatedump)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(_PatternsRuntimePackDir)' != '' And Exists('$(_PatternsCreatedump)')" />
    <Message Importance="high" Text="createdump.exe placed beside the exe from $(_PatternsRuntimePackDir): the watchdog keeps a mini-dump of a native crash." Condition="'$(_PatternsRuntimePackDir)' != '' And Exists('$(_PatternsCreatedump)')" />
    <Warning Text="createdump.exe was not found in the runtime pack ('$(_PatternsCreatedump)'): native crashes will leave no mini-dump (the note and the log still say what happened)." Condition="'$(_PatternsRuntimePackDir)' == '' Or !Exists('$(_PatternsCreatedump)')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Patterns.Core\Patterns.Core.csproj" />
    <ProjectReference Include="..\Patterns.Platform.Windows\Patterns.Platform.Windows.csproj" />
    <ProjectReference Include="..\Patterns.Rendering\Patterns.Rendering.csproj" />
    <ProjectReference Include="..\Patterns.Ndi\Patterns.Ndi.csproj" />
    <ProjectReference Include="..\Patterns.Arcade\Patterns.Arcade.csproj" />
    <ProjectReference Include="..\Patterns.Devices\Patterns.Devices.csproj" />
    <ProjectReference Include="..\Patterns.Audio\Patterns.Audio.csproj" />
    <ProjectReference Include="..\Patterns.Assistant\Patterns.Assistant.csproj" />
    <ProjectReference Include="..\Patterns.Audience\Patterns.Audience.csproj" />
  </ItemGroup>

</Project>
