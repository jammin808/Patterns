<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Section host panels -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="Margin" Value="0,12,0,6" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Compact controls in parameter panels -->
  <Style Selector="StackPanel.form > :is(Control)">
    <Setter Property="Margin" Value="0,3" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Navigation rail -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Theme" Value="{x:Null}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="#1E222B" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#bd">
    <Setter Property="Background" Value="#20303C" />
  </Style>
  <Style Selector="RadioButton.nav TextBlock.navlabel">
    <Setter Property="Foreground" Value="#C8D0DC" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="RadioButton.nav:checked TextBlock.navlabel">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.nav TextBlock.navicon">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Width" Value="26" />
  </Style>

  <!-- Transport -->
  <Style Selector="Button.go">
    <Setter Property="Background" Value="#137A4A" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.go:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#18935A" />
  </Style>
  <Style Selector="Button.stop">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ToggleButton.blackout">
    <Setter Property="Background" Value="#2A2E38" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ToggleButton.blackout:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="#20242E" />
  </Style>
</Styles>
