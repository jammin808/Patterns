<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Section host panels -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <!-- Type: the window sets 15 px as the base; headings, labels and chips step from it. -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <!-- Subtle neon section identity: tab dots and tinted h1 headings -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.h1.neon-show"><Setter Property="Foreground" Value="#2EE68A" /></Style>
  <Style Selector="TextBlock.h1.neon-pattern"><Setter Property="Foreground" Value="#3EC1F3" /></Style>
  <Style Selector="TextBlock.h1.neon-media"><Setter Property="Foreground" Value="#FF6EC7" /></Style>
  <Style Selector="TextBlock.h1.neon-layers"><Setter Property="Foreground" Value="#E39BFF" /></Style>
  <Style Selector="TextBlock.h1.neon-looks"><Setter Property="Foreground" Value="#6E9BFF" /></Style>
  <Style Selector="TextBlock.h1.neon-plan"><Setter Property="Foreground" Value="#9AB4FF" /></Style>
  <Style Selector="TextBlock.h1.neon-lower"><Setter Property="Foreground" Value="#FFC24D" /></Style>
  <Style Selector="TextBlock.h1.neon-outputs"><Setter Property="Foreground" Value="#B18CFF" /></Style>
  <Style Selector="TextBlock.h1.neon-audio"><Setter Property="Foreground" Value="#FF9E58" /></Style>
  <Style Selector="TextBlock.h1.neon-time"><Setter Property="Foreground" Value="#FFC24D" /></Style>
  <Style Selector="TextBlock.h1.neon-remote"><Setter Property="Foreground" Value="#35E0D0" /></Style>
  <Style Selector="TextBlock.h1.neon-ndi"><Setter Property="Foreground" Value="#8FA5FF" /></Style>
  <Style Selector="TextBlock.h1.neon-stream"><Setter Property="Foreground" Value="#FF5C7A" /></Style>
  <Style Selector="TextBlock.h1.neon-admin"><Setter Property="Foreground" Value="#B8E356" /></Style>
  <Style Selector="TextBlock.h1.neon-library"><Setter Property="Foreground" Value="#C0CBDB" /></Style>
  <Style Selector="TextBlock.h1.neon-assistant"><Setter Property="Foreground" Value="#7CF5C8" /></Style>
  <Style Selector="TextBlock.h1.neon-interactive"><Setter Property="Foreground" Value="#7CF5C8" /></Style>
  <Style Selector="TextBlock.h1.neon-help"><Setter Property="Foreground" Value="#C0CBDB" /></Style>

  <!-- The navigation rail: seventeen pages fit a 720 px window without wrapping -->
  <Style Selector="TabControl[TabStripPlacement=Left] > TabItem">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- The desk's dividers: a column splitter between the page and the screens, a handle between the panes. -->
  <Style Selector="GridSplitter.deskDivider">
    <Setter Property="Width" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Border Name="Bar" Width="2" Height="48" CornerRadius="1" Background="{StaticResource HairlineBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.deskDivider:pointerover /template/ Border#Bar">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Thumb.paneHandle">
    <Setter Property="Height" Value="8" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Name="Bar" Width="48" Height="2" CornerRadius="1" Background="{StaticResource HairlineBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Thumb.paneHandle:pointerover /template/ Border#Bar">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Switcher strip tiles -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{StaticResource PanelBg2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="Border.tile.tileActive">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="#14232E" />
  </Style>

  <!-- Tally on the wall: the dot and the title carry it (red = on air, amber = held, grey = off);
       the border stays the selection so the two never fight. -->
  <Style Selector="Ellipse.tally"><Setter Property="Fill" Value="{StaticResource TallyOffBrush}" /></Style>
  <Style Selector="Ellipse.tally.hold"><Setter Property="Fill" Value="{StaticResource TallyHoldBrush}" /></Style>
  <Style Selector="Ellipse.tally.air"><Setter Property="Fill" Value="{StaticResource TallyPgmBrush}" /></Style>
  <Style Selector="TextBlock.tileTitle"><Setter Property="Foreground" Value="#E6EAF2" /></Style>
  <Style Selector="TextBlock.tileTitle.hold"><Setter Property="Foreground" Value="{StaticResource TallyHoldBrush}" /></Style>
  <Style Selector="TextBlock.tileTitle.air"><Setter Property="Foreground" Value="#FF9EB0" /></Style>

  <!-- The Run surface, read from a metre: 32 px for the standby and the LIVE strip, 24 px for
       names and transport labels, 16 px for notes and history, nothing below 14 px. -->
  <Style Selector="Border.runLive">
    <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TallyPgmBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinHeight" Value="56" />
  </Style>
  <Style Selector="TextBlock.runLiveText">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.runTag">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="TextBlock.runClock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.runNumber">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="TextBlock.runName">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.runRow.standby TextBlock.runName">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.runStandby">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.runNotes">
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="TextBlock.runCueNotes">
    <Setter Property="Foreground" Value="{StaticResource TallyHoldBrush}" />
  </Style>
  <Style Selector="TextBlock.runRunning.over">
    <Setter Property="Foreground" Value="{StaticResource TallyHoldBrush}" />
  </Style>
  <Style Selector="TextBlock.runOutcome.failed">
    <Setter Property="Foreground" Value="{StaticResource TallyPgmBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Border.runRow">
    <Setter Property="Background" Value="{StaticResource PanelBg2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,3" />
  </Style>
  <Style Selector="Border.runRow.standby">
    <Setter Property="BorderBrush" Value="{StaticResource TallyPvwBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="#10261C" />
  </Style>
  <Style Selector="Border.runRow.last">
    <Setter Property="BorderBrush" Value="{StaticResource TallyPgmBrush}" />
  </Style>
  <Style Selector="Border.runRow.broken">
    <Setter Property="BorderBrush" Value="#80E0342E" />
  </Style>
  <Style Selector="Border.runRow.off">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Border.runTagChip">
    <Setter Property="Background" Value="#20242E" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style Selector="Border.runTagChip TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="Border.runRow.standby Border.runTagChip">
    <Setter Property="Background" Value="{StaticResource TallyPvwBrush}" />
  </Style>
  <Style Selector="Border.runRow.standby Border.runTagChip TextBlock">
    <Setter Property="Foreground" Value="#0E0F13" />
  </Style>
  <Style Selector="Border.runRow.last Border.runTagChip">
    <Setter Property="Background" Value="{StaticResource TallyPgmBrush}" />
  </Style>

  <!-- Chips: every state carries a word as well as a colour -->
  <Style Selector="Border.runChip">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.runChip TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="Border.armedChip">
    <Setter Property="Background" Value="#3A2E10" />
    <Setter Property="BorderBrush" Value="{StaticResource TallyHoldBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.armedChip TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TallyHoldBrush}" />
  </Style>
  <!-- Break music is sound, not the picture: accent blue, never a tally colour -->
  <Style Selector="Border.musicChip">
    <Setter Property="Background" Value="#10303A" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.musicChip TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Border.holdChip">
    <Setter Property="Background" Value="{StaticResource TallyHoldBrush}" />
  </Style>
  <Style Selector="Border.holdChip TextBlock">
    <Setter Property="Foreground" Value="#0E0F13" />
  </Style>
  <!-- The caller's VT clock: accent while the clip runs, red for its last ten seconds -->
  <Style Selector="Border.vtChip">
    <Setter Property="Background" Value="#10303A" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.vtChip TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Border.vtChip.out">
    <Setter Property="Background" Value="{StaticResource TallyPgmBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TallyPgmBrush}" />
  </Style>
  <Style Selector="Border.vtChip.out TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.runRow.vtRow.out">
    <Setter Property="BorderBrush" Value="{StaticResource TallyPgmBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="#2A1214" />
  </Style>
  <Style Selector="TextBlock.vtCall">
    <Setter Property="Foreground" Value="{StaticResource TallyPgmBrush}" />
  </Style>
  <Style Selector="Border.blackoutChip">
    <Setter Property="Background" Value="Black" />
    <Setter Property="BorderBrush" Value="{StaticResource TallyPgmBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.blackoutChip TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TallyPgmBrush}" />
  </Style>
  <Style Selector="Border.runBanner">
    <Setter Property="Background" Value="#3A2E10" />
    <Setter Property="BorderBrush" Value="{StaticResource TallyHoldBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>

  <!-- Transport: GO is the only green-filled button here -->
  <Style Selector="Border.runTransport">
    <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="96" />
    <Setter Property="Margin" Value="0,10,0,0" />
  </Style>
  <Style Selector="Button.runGo">
    <Setter Property="Background" Value="#1E9E5A" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="Height" Value="72" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.runGo:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#25B86A" />
  </Style>
  <Style Selector="Button.runGo.confirm">
    <Setter Property="Background" Value="{StaticResource TallyHoldBrush}" />
    <Setter Property="Foreground" Value="#0E0F13" />
  </Style>
  <Style Selector="Button.runStep">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="72" />
    <Setter Property="Margin" Value="3,0" />
    <Setter Property="Background" Value="#20242E" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.runArm, ToggleButton.runHold, ToggleButton.runBlackout, Button.runStop">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Height" Value="72" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Margin" Value="3,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="#20242E" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.runArm:checked /template/ ContentPresenter, ToggleButton.runHold:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TallyHoldBrush}" />
    <Setter Property="Foreground" Value="#0E0F13" />
  </Style>
  <Style Selector="ToggleButton.runBlackout:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Black" />
    <Setter Property="BorderBrush" Value="{StaticResource TallyPgmBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource TallyPgmBrush}" />
  </Style>
  <Style Selector="Button.runStop">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Height" Value="52" />
    <Setter Property="MinWidth" Value="100" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TallyPgmBrush}" />
  </Style>

  <!-- Cue rows on the Cues page: selection is the border, state is the dot -->
  <Style Selector="Border.cueRow">
    <Setter Property="Background" Value="{StaticResource PanelBg2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="Border.cueRow.cueSelected">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="#14232E" />
  </Style>
  <Style Selector="Border.cueRow.cueBroken">
    <Setter Property="BorderBrush" Value="#80E0342E" />
  </Style>
  <Style Selector="Border.cueRow.cueOff">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Ellipse.cueDot"><Setter Property="Fill" Value="{StaticResource TallyOffBrush}" /></Style>
  <Style Selector="Ellipse.cueDot.ready"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></Style>
  <Style Selector="Ellipse.cueDot.current"><Setter Property="Fill" Value="{StaticResource TallyPvwBrush}" /></Style>
  <Style Selector="Ellipse.cueDot.broken"><Setter Property="Fill" Value="{StaticResource TallyPgmBrush}" /></Style>

  <!-- OWN / MON / ARM / LOCK (and SEND) on a wall tile: small, lit when on; a lock reads amber, held -->
  <Style Selector="ToggleButton.wall, Button.wall">
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Margin" Value="0,0,3,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="#20242E" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="ToggleButton.wall:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.wall.lock:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TallyHoldBrush}" />
    <Setter Property="Foreground" Value="#0E0F13" />
  </Style>
  <!-- OUT on a wall tile: green while the screen's output is on, the wall's grey when it is off -->
  <Style Selector="ToggleButton.wall.output:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TallyPvwBrush}" />
    <Setter Property="Foreground" Value="#0E0F13" />
  </Style>
  <Style Selector="Border.roleBadge">
    <Setter Property="Background" Value="#14232E" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.roleBadge > TextBlock">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <!-- A wall tile collapsed to a vertical title bar (the Run area): the name on its side reads top to bottom -->
  <Style Selector="StackPanel.tileBar">
    <Setter Property="Width" Value="28" />
    <Setter Property="MinHeight" Value="112" />
  </Style>
  <Style Selector="StackPanel.tileBar TextBlock.tileTitle">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MaxWidth" Value="96" />
  </Style>
  <Style Selector="StackPanel.tileBar Border.roleBadge">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- A wall tile faded to black on its own: the badge reads in the tally's red -->
  <Style Selector="Border.roleBadge.blackBadge">
    <Setter Property="Background" Value="#2A0F10" />
    <Setter Property="BorderBrush" Value="#80E0342E" />
  </Style>
  <Style Selector="Border.roleBadge.blackBadge > TextBlock">
    <Setter Property="Foreground" Value="#E0342E" />
  </Style>

  <!-- A section heading is a band: bold caps on a subdued ground, the page's own neon for both
       (the hue styles at the end of this file), so the sections of a page read apart at a glance. -->
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="0,14,0,8" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- hint = a small dim line (a status readout, a label in a row); hint tip = an explanation.
       The window wears nohints (the show's ShowHints off, the default) and the explanations fold
       away behind ? TIPS on the page strip; the readouts stay. -->
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Window.nohints TextBlock.tip">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- The ? TIPS flyout: the page's explanations under their headings -->
  <Style Selector="Button.help">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="#14232E" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBlock.tipHead">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="Margin" Value="0,10,0,2" />
  </Style>
  <Style Selector="TextBlock.tipText">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="#D5DAE3" />
    <Setter Property="Margin" Value="0,2,0,4" />
  </Style>

  <!-- Compact controls in parameter panels -->
  <Style Selector="StackPanel.form > :is(Control)">
    <Setter Property="Margin" Value="0,3" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Navigation rail -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Theme" Value="{x:Null}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="#1E222B" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#bd">
    <Setter Property="Background" Value="#20303C" />
  </Style>
  <Style Selector="RadioButton.nav TextBlock.navlabel">
    <Setter Property="Foreground" Value="#C8D0DC" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="RadioButton.nav:checked TextBlock.navlabel">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.nav TextBlock.navicon">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Width" Value="26" />
  </Style>

  <!-- Transport -->
  <Style Selector="Button.go">
    <Setter Property="Background" Value="#137A4A" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.go:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#18935A" />
  </Style>
  <Style Selector="Button.stop">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ToggleButton.blackout">
    <Setter Property="Background" Value="#2A2E38" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ToggleButton.blackout:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
  </Style>

  <!-- A bare type selector matches that type alone, so the toggles wearing chip and mini are
       named as well — otherwise ▶ PLAY, SYNC CHECK, EDIT SAFE and WIDE sit at the theme's size. -->
  <Style Selector="Button.chip, ToggleButton.chip">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="#20242E" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- The tally on the Show panel's chips: green in the preview, red on air (air wins when both). -->
  <Style Selector="Button.chip.pvw">
    <Setter Property="Background" Value="#10241B" />
    <Setter Property="BorderBrush" Value="{StaticResource TallyPvwBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.chip.air">
    <Setter Property="Background" Value="#2A1316" />
    <Setter Property="BorderBrush" Value="{StaticResource TallyPgmBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- The Show panel chips' second line: what the chip is, or its tally while it is live (red outranks green) -->
  <Style Selector="TextBlock.chipLine">
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="TextBlock.chipLine.pvw">
    <Setter Property="Foreground" Value="{StaticResource TallyPvwBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.chipLine.air">
    <Setter Property="Foreground" Value="#FF9EB0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Library rows (Looks, Audio) with a tally edge, and the chip that names it. -->
  <Style Selector="Border.lookRow, Border.stingerRow">
    <Setter Property="Background" Value="{StaticResource PanelBg2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.lookRow.pvw">
    <Setter Property="Background" Value="#10241B" />
    <Setter Property="BorderBrush" Value="{StaticResource TallyPvwBrush}" />
  </Style>
  <Style Selector="Border.lookRow.air, Border.stingerRow.air">
    <Setter Property="Background" Value="#2A1316" />
    <Setter Property="BorderBrush" Value="{StaticResource TallyPgmBrush}" />
  </Style>
  <Style Selector="Border.tallyChip">
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{StaticResource TallyOffBrush}" />
  </Style>
  <Style Selector="Border.tallyChip.pvw">
    <Setter Property="Background" Value="{StaticResource TallyPvwBrush}" />
  </Style>
  <Style Selector="Border.tallyChip.air">
    <Setter Property="Background" Value="{StaticResource TallyPgmBrush}" />
  </Style>
  <Style Selector="Border.tallyChip > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.mini, ToggleButton.mini">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="2,0,0,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="#20242E" />
  </Style>

  <!-- The shell: five group buttons on the rail, a page strip over the layout, the
       PREP · SHOW · RUN selector in the header, and the SHOW CONTROLS drawer. -->
  <Style Selector="Border.rail">
    <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="8,12" />
    <Setter Property="Width" Value="94" />
  </Style>
  <Style Selector="Button.navGroup">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" Background="Transparent" CornerRadius="10" Padding="4,11"
                BorderThickness="1" BorderBrush="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.navGroup:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="#1E222B" />
  </Style>
  <Style Selector="Button.navGroup.on /template/ Border#bd">
    <Setter Property="Background" Value="#20303C" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
  </Style>
  <Style Selector="Button.navGroup TextBlock.navlabel">
    <Setter Property="Foreground" Value="#C8D0DC" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.5" />
  </Style>
  <Style Selector="Button.navGroup.on TextBlock.navlabel">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.pageChip">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="#1A1D24" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.pageChip.on">
    <Setter Property="Background" Value="#20303C" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.modeGroup">
    <Setter Property="Background" Value="#101318" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <!-- MODE (PREP · SHOW) and LAYOUT (RUN) each carry a caption, so the header says which is which. -->
  <Style Selector="TextBlock.modeCaption">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="Button.mode">
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#98A1B1" />
  </Style>
  <Style Selector="Button.mode.on">
    <Setter Property="Background" Value="#20303C" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.mode.prep.on">
    <Setter Property="Background" Value="#3A2E10" />
    <Setter Property="Foreground" Value="#FFC24D" />
  </Style>
  <Style Selector="Button.mode.run.on">
    <Setter Property="Background" Value="#137A4A" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Expander.drawer">
    <Setter Property="Background" Value="{StaticResource PanelBg2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- Each page's neon on its section bands and its panels' edges: the hue of its chip on the rail
       (the Shell.Pages table), as a bold heading on a ground of the same colour at a tenth, and a
       hairline at a quarter around a panel. The rail and the page strip underline the current
       group and page in the same hue. -->
  <Style Selector="Border.hueLine"><Setter Property="Opacity" Value="0" /></Style>
  <Style Selector="Border.hueLine.on"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector=":is(UserControl).hue-panel TextBlock.h2">
    <Setter Property="Foreground" Value="#2EE68A" />
    <Setter Property="Background" Value="#1A2EE68A" />
  </Style>
  <Style Selector=":is(UserControl).hue-panel Border.panel"><Setter Property="BorderBrush" Value="#402EE68A" /></Style>
  <Style Selector=":is(UserControl).hue-cues TextBlock.h2">
    <Setter Property="Foreground" Value="#6E9BFF" />
    <Setter Property="Background" Value="#1A6E9BFF" />
  </Style>
  <Style Selector=":is(UserControl).hue-cues Border.panel"><Setter Property="BorderBrush" Value="#406E9BFF" /></Style>
  <Style Selector=":is(UserControl).hue-looks TextBlock.h2">
    <Setter Property="Foreground" Value="#6E9BFF" />
    <Setter Property="Background" Value="#1A6E9BFF" />
  </Style>
  <Style Selector=":is(UserControl).hue-looks Border.panel"><Setter Property="BorderBrush" Value="#406E9BFF" /></Style>
  <Style Selector=":is(UserControl).hue-install TextBlock.h2">
    <Setter Property="Foreground" Value="#9AB4FF" />
    <Setter Property="Background" Value="#1A9AB4FF" />
  </Style>
  <Style Selector=":is(UserControl).hue-install Border.panel"><Setter Property="BorderBrush" Value="#409AB4FF" /></Style>
  <Style Selector=":is(UserControl).hue-pattern TextBlock.h2">
    <Setter Property="Foreground" Value="#3EC1F3" />
    <Setter Property="Background" Value="#1A3EC1F3" />
  </Style>
  <Style Selector=":is(UserControl).hue-pattern Border.panel"><Setter Property="BorderBrush" Value="#403EC1F3" /></Style>
  <Style Selector=":is(UserControl).hue-media TextBlock.h2">
    <Setter Property="Foreground" Value="#FF6EC7" />
    <Setter Property="Background" Value="#1AFF6EC7" />
  </Style>
  <Style Selector=":is(UserControl).hue-media Border.panel"><Setter Property="BorderBrush" Value="#40FF6EC7" /></Style>
  <Style Selector=":is(UserControl).hue-overlays TextBlock.h2">
    <Setter Property="Foreground" Value="#FFC24D" />
    <Setter Property="Background" Value="#1AFFC24D" />
  </Style>
  <Style Selector=":is(UserControl).hue-overlays Border.panel"><Setter Property="BorderBrush" Value="#40FFC24D" /></Style>
  <Style Selector=":is(UserControl).hue-lower-thirds TextBlock.h2">
    <Setter Property="Foreground" Value="#FFC24D" />
    <Setter Property="Background" Value="#1AFFC24D" />
  </Style>
  <Style Selector=":is(UserControl).hue-lower-thirds Border.panel"><Setter Property="BorderBrush" Value="#40FFC24D" /></Style>
  <Style Selector=":is(UserControl).hue-countdown TextBlock.h2">
    <Setter Property="Foreground" Value="#FFC24D" />
    <Setter Property="Background" Value="#1AFFC24D" />
  </Style>
  <Style Selector=":is(UserControl).hue-countdown Border.panel"><Setter Property="BorderBrush" Value="#40FFC24D" /></Style>
  <Style Selector=":is(UserControl).hue-particles TextBlock.h2">
    <Setter Property="Foreground" Value="#FFC24D" />
    <Setter Property="Background" Value="#1AFFC24D" />
  </Style>
  <Style Selector=":is(UserControl).hue-particles Border.panel"><Setter Property="BorderBrush" Value="#40FFC24D" /></Style>
  <Style Selector=":is(UserControl).hue-fractals TextBlock.h2">
    <Setter Property="Foreground" Value="#FFC24D" />
    <Setter Property="Background" Value="#1AFFC24D" />
  </Style>
  <Style Selector=":is(UserControl).hue-fractals Border.panel"><Setter Property="BorderBrush" Value="#40FFC24D" /></Style>
  <Style Selector=":is(UserControl).hue-branding TextBlock.h2">
    <Setter Property="Foreground" Value="#FFC24D" />
    <Setter Property="Background" Value="#1AFFC24D" />
  </Style>
  <Style Selector=":is(UserControl).hue-branding Border.panel"><Setter Property="BorderBrush" Value="#40FFC24D" /></Style>
  <Style Selector=":is(UserControl).hue-layers TextBlock.h2">
    <Setter Property="Foreground" Value="#E39BFF" />
    <Setter Property="Background" Value="#1AE39BFF" />
  </Style>
  <Style Selector=":is(UserControl).hue-layers Border.panel"><Setter Property="BorderBrush" Value="#40E39BFF" /></Style>
  <Style Selector=":is(UserControl).hue-library TextBlock.h2">
    <Setter Property="Foreground" Value="#C0CBDB" />
    <Setter Property="Background" Value="#1AC0CBDB" />
  </Style>
  <Style Selector=":is(UserControl).hue-library Border.panel"><Setter Property="BorderBrush" Value="#40C0CBDB" /></Style>
  <Style Selector=":is(UserControl).hue-assistant TextBlock.h2">
    <Setter Property="Foreground" Value="#7CF5C8" />
    <Setter Property="Background" Value="#1A7CF5C8" />
  </Style>
  <Style Selector=":is(UserControl).hue-assistant Border.panel"><Setter Property="BorderBrush" Value="#407CF5C8" /></Style>
  <Style Selector=":is(UserControl).hue-screens TextBlock.h2">
    <Setter Property="Foreground" Value="#B18CFF" />
    <Setter Property="Background" Value="#1AB18CFF" />
  </Style>
  <Style Selector=":is(UserControl).hue-screens Border.panel"><Setter Property="BorderBrush" Value="#40B18CFF" /></Style>
  <Style Selector=":is(UserControl).hue-audio TextBlock.h2">
    <Setter Property="Foreground" Value="#FF9E58" />
    <Setter Property="Background" Value="#1AFF9E58" />
  </Style>
  <Style Selector=":is(UserControl).hue-audio Border.panel"><Setter Property="BorderBrush" Value="#40FF9E58" /></Style>
  <Style Selector=":is(UserControl).hue-ndi TextBlock.h2">
    <Setter Property="Foreground" Value="#8FA5FF" />
    <Setter Property="Background" Value="#1A8FA5FF" />
  </Style>
  <Style Selector=":is(UserControl).hue-ndi Border.panel"><Setter Property="BorderBrush" Value="#408FA5FF" /></Style>
  <Style Selector=":is(UserControl).hue-stream TextBlock.h2">
    <Setter Property="Foreground" Value="#FF5C7A" />
    <Setter Property="Background" Value="#1AFF5C7A" />
  </Style>
  <Style Selector=":is(UserControl).hue-stream Border.panel"><Setter Property="BorderBrush" Value="#40FF5C7A" /></Style>
  <Style Selector=":is(UserControl).hue-remote TextBlock.h2">
    <Setter Property="Foreground" Value="#35E0D0" />
    <Setter Property="Background" Value="#1A35E0D0" />
  </Style>
  <Style Selector=":is(UserControl).hue-remote Border.panel"><Setter Property="BorderBrush" Value="#4035E0D0" /></Style>
  <Style Selector=":is(UserControl).hue-interactive TextBlock.h2">
    <Setter Property="Foreground" Value="#7CF5C8" />
    <Setter Property="Background" Value="#1A7CF5C8" />
  </Style>
  <Style Selector=":is(UserControl).hue-interactive Border.panel"><Setter Property="BorderBrush" Value="#407CF5C8" /></Style>
  <Style Selector=":is(UserControl).hue-machine TextBlock.h2">
    <Setter Property="Foreground" Value="#B8E356" />
    <Setter Property="Background" Value="#1AB8E356" />
  </Style>
  <Style Selector=":is(UserControl).hue-machine Border.panel"><Setter Property="BorderBrush" Value="#40B8E356" /></Style>
  <Style Selector=":is(UserControl).hue-help TextBlock.h2">
    <Setter Property="Foreground" Value="#C0CBDB" />
    <Setter Property="Background" Value="#1AC0CBDB" />
  </Style>
  <Style Selector=":is(UserControl).hue-help Border.panel"><Setter Property="BorderBrush" Value="#40C0CBDB" /></Style>
</Styles>
