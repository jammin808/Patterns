<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(PatternsTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Patterns.App.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.20" />
    <!-- Avalonia's Linux dependency group pins the 2.88 native; force it to match SkiaSharp 3.116. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Patterns.App\Patterns.App.csproj" />
    <Compile Include="..\Patterns.Core.Tests\EdidSamples.cs" Link="EdidSamples.cs" />
  </ItemGroup>

  <!-- The bench host (tools/Patterns.Bench): built before these tests, never linked into them. BenchHostTests start it
       as its own process from the build's output, whose path this build names in the assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Patterns.Bench\Patterns.Bench.csproj" ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PatternsBench</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\tools\Patterns.Bench\bin\$(Configuration)\$(TargetFramework)\Patterns.Bench.dll'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
